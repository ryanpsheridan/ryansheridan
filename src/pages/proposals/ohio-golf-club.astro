---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

// The index rail and the cover's tally both read from this, so a finding can't
// be renumbered in one place and not the other.
const findings = [
  {
    n: "01",
    label: "Hours aren't on your website",
    level: "critical",
    impact:
      "Eliminates friction for impulse visitors. When potential customers can instantly verify you\u2019re open, they drive over instead of second-guessing or choosing a competitor.",
  },
  {
    n: "02",
    label: "Two answers to the same price question",
    level: "upside",
    impact:
      "Captures high-intent AI and search traffic. Clear, structured pricing builds immediate trust and stops potential members from abandoning their search due to outdated directory prices.",
  },
  {
    n: "03",
    label: "Five pages, one hidden title",
    level: "upside",
    impact:
      "Improves click-through rates from search results. Specific, compelling headlines convince searchers to click your link instead of scrolling past to rival golf centers.",
  },
  {
    n: "04",
    label: "Services have no pages of their own",
    level: "upside",
    impact:
      "Creates a direct path to booking. Matching a user\u2019s exact search intent (\u201cgolf lessons\u201d) with a dedicated landing page and a clear booking button dramatically increases conversion rates compared to forcing them to search a generic homepage.",
  },
  {
    n: "05",
    label: "Wrong address and price elsewhere",
    level: "critical",
    impact:
      "Prevents lost sales and wasted trips. Correcting wrong addresses and outdated pricing ensures qualified leads don\u2019t get routed to the wrong location or turned off by incorrect costs.",
  },
  {
    n: "06",
    label: "Your 4.9 rating isn't on your site",
    level: "neutral",
    impact:
      "Leverages social proof at the decision point. Displaying your 80+ glowing reviews directly next to booking options reassures hesitant visitors and pushes them to commit.",
  },
  {
    n: "07",
    label: "No league page, and season is starting",
    level: "critical",
    impact:
      "Captures high-value seasonal revenue. A dedicated league page gives teams and solo players all rules, schedules, and signup forms in one shareable link, filling league spots faster.",
  },
  {
    n: "08",
    label: "Form submissions go nowhere",
    level: "neutral",
  },
];


// Each package line points back at the finding it resolves, so the proposal and
// the findings above can't drift apart.
const packages = [
  {
    option: "Option 1",
    name: "Core Search & Metadata Fixes",
    price: "$800 \u2013 $1,200",
    terms: "fixed fee",
    desc: "Fixes foundational search issues, duplicate metadata, and inaccurate business data.",
    lines: [
      { item: "01", text: "Add verified site hours to code and pages." },
      { item: "02", text: "Implement JSON-LD Schema markup for membership tiers and pricing." },
      { item: "03", text: "Add unique, targeted meta titles and descriptions for every existing page." },
      { item: "06", text: "Add a styled 4.9-star Google rating badge and review counter linking to live reviews." },
      { item: "05", label: "Bonus", text: "Delivery of a Directory Update Checklist for your team to submit to third-party sites." },
    ],
  },
  {
    option: "Option 2",
    name: "Full Optimization & Dedicated Pages",
    price: "$2,400 \u2013 $2,800",
    terms: "fixed fee",
    desc: "Includes everything in Option 1, plus dedicated landing pages to capture search traffic and drive signups.",
    lines: [
      { text: "Everything in Option 1 (metadata, schema, hours, review badge, directory checklist)." },
      { item: "04", text: "Build 5 dedicated service and landing pages: Lessons, Club Fitting, Memberships, Bay Rentals, Leagues." },
      { item: "07", text: "Build a dedicated League Season info and signup page, content provided by you." },
    ],
  },
];

const addons = [
  {
    item: "08",
    name: "Lead Capture & CRM Integration",
    price: "TBD, estimated $500 \u2013 $800",
    desc: "Routing website contact form submissions directly into Club Caddie or a lightweight CRM (Airtable or HubSpot). Scoped after the initial system review.",
  },
  {
    name: "Full Visual Redesign",
    price: "Custom quote",
    desc: "Complete update to site layout, branding, and visual design beyond the current Next.js structure.",
  },
];

const count = (level: string) => findings.filter((f) => f.level === level).length;
const impactOf = (n: string) => findings.find((f) => f.n === n)?.impact;
---

<!--
  A client proposal. Everything under /proposals is a private share rather than
  portfolio work: it carries noindex and the whole branch is filtered out of the
  sitemap in astro.config.mjs, so the two agree.
-->
<Layout
  title="Ohio Golf Club — Ryan Sheridan"
  description="A review of ohiogolfclubindoor.com and how the club shows up in Google and AI assistants."
  noindex={true}
>
  <Nav />
  <main class="review">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/proposals">Proposals</a>
      <span class="sep">/</span>
      <span class="current">Ohio Golf Club</span>
    </nav>

    <p class="eyebrow">Website review</p>
    <h1>Ohio Golf Club</h1>

    <header class="masthead">
      <p class="lede">
        I looked at <a href="https://www.ohiogolfclubindoor.com/" target="_blank" rel="noopener">ohiogolfclubindoor.com</a> and at how the club shows up in Google and AI assistants. Your reputation and your pro are doing the work, and doing it well. This is about getting the website to carry more of that load.
      </p>
      <p class="lede">
        Every claim has a link or a screenshot. Where I couldn&rsquo;t verify something, I&rsquo;ve said so.
      </p>
    </header>

    <div class="review-layout">
      <div class="review-main">
    <section>
      <div class="sec-head">
        <p class="eyebrow">Summary</p>
        <h2>The short version</h2>
      </div>
      <div class="two-up">
        <div class="box">
          <h3>Your information isn&rsquo;t all in the right places</h3>
          <p>
            Some facts aren&rsquo;t on the site at all, like your hours. Others are on the page but not
            written into the code in the format Google and AI assistants look for, so they fall back
            to directory sites. Those directories then repeat details that are out of date, including
            a price you don&rsquo;t charge and an address that isn&rsquo;t yours.
          </p>
        </div>
        <div class="box">
          <h3>You only have one page really competing</h3>
          <p>
            Lessons, fittings, memberships and leagues are all sections of your homepage. Giving each
            its own page creates more ways to be found, and lands people on the exact thing they
            searched for.
          </p>
        </div>
      </div>
    </section>

    <section>
      <div class="sec-head">
        <p class="eyebrow">Strengths</p>
        <h2>What you&rsquo;re already doing well</h2>
      </div>
      <div class="wins">
        <div class="win">
          <span class="m" aria-hidden="true">&#10003;</span>
          <h4>You&rsquo;re the top answer for the questions that matter</h4>
          <p>
            Tested 2 September: asking an AI assistant where to take indoor golf lessons near Akron,
            and where to get a serious TrackMan fitting, returned Ohio Golf Club first both times,
            ahead of GOLFTEC Fairlawn and Golf Galaxy.
          </p>
        </div>
        <div class="win">
          <span class="m" aria-hidden="true">&#10003;</span>
          <h4>4.9 stars, with listings showing 85 to 87 reviews</h4>
          <p>Your strongest marketing asset.</p>
        </div>
        <div class="win">
          <span class="m" aria-hidden="true">&#10003;</span>
          <h4>Your <a href="https://business.google.com/" target="_blank" rel="noopener">Google Business Profile</a> is doing real work</h4>
          <p>
            Rating, category, photos and open-now status all show up in map results. Whoever set it up
            did a good job.
          </p>
        </div>
        <div class="win">
          <span class="m" aria-hidden="true">&#10003;</span>
          <h4>The site is built on current technology</h4>
          <p>
            It runs on <a href="https://nextjs.org/" target="_blank" rel="noopener">Next.js</a>, a modern framework, not an aging template. That&rsquo;s a good foundation, and it makes everything below straightforward to add.
          </p>
        </div>
        <div class="win">
          <span class="m" aria-hidden="true">&#10003;</span>
          <h4>Booking is properly connected</h4>
          <p>
            Bays, lessons and memberships all run through <a href="https://clubcaddie.com/" target="_blank" rel="noopener">Club Caddie</a> rather than being pieced together.
          </p>
        </div>
        <div class="win">
          <span class="m" aria-hidden="true">&#10003;</span>
          <h4>Your credentials are genuinely differentiating</h4>
          <p>
            GOLFTEC certified, Titleist and Callaway master fitter, 7,500 lessons, 500 fittings. Golf
            Galaxy can&rsquo;t say that. It just isn&rsquo;t working as hard for you as it could.
          </p>
        </div>
      </div>
    </section>

    <section id="findings">
      <div class="sec-head">
        <p class="eyebrow">Findings, tagged by priority</p>
        <h2>What could work better</h2>
      </div>

      <div class="stack">

          <article class="item critical" id="finding-01">
            <div class="item-head">
              <span class="badge critical">Costing you now</span>
              <h3>01 - Your hours aren&rsquo;t on your website</h3>
            </div>
            <div class="b">
              <div>
                <p>
                  They&rsquo;re not on the <a href="https://www.ohiogolfclubindoor.com/" target="_blank" rel="noopener">homepage</a>, the <a href="https://www.ohiogolfclubindoor.com/contact-us" target="_blank" rel="noopener">contact page</a>, or anywhere else. Three directories publish hours for you instead, and no two agree.
                </p>
                <div class="tw">
                  <table>
                    <thead><tr><th>Where</th><th>Hours it shows</th></tr></thead>
                    <tbody>
                      <tr><td class="n-cell">Your website</td><td class="bad">Nothing listed</td></tr>
                      <tr><td class="n-cell"><a href="https://golfsimspot.com/golf-simulator-business/ohio-golf-club/" target="_blank" rel="noopener">Golf Sim Spot</a></td><td>Mon to Fri 9am to 8pm, weekends 9am to 5pm</td></tr>
                      <tr><td class="n-cell"><a href="https://teebly.io/venue/a290afbe-c14a-4e82-9706-c9399d45dd3a" target="_blank" rel="noopener">Teebly</a></td><td>Daily 8am to 10pm</td></tr>
                      <tr><td class="n-cell"><a href="https://screengolfers.com/usa/ohio/akron/ohio-golf-club-44333" target="_blank" rel="noopener">Screengolfers</a></td><td>Mon to Sat 8am to 10pm, Sun 8am to 8pm</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
              <figure>
                <div class="fig-head">
                  <p class="k">Asked for your hours, an AI assistant didn&rsquo;t read your site. It answered from a directory called GolfSimMap and said so.</p>
                  <a class="fig-open" href="/proposals/ohio-golf-club/screenshot-1.jpg" target="_blank" rel="noopener">Full size &nearr;</a>
                </div>
                <div class="shot">
                  <img
                    src="/proposals/ohio-golf-club/screenshot-1.jpg"
                    alt="Screenshot of an AI assistant listing Ohio Golf Club's hours and citing GolfSimMap as the source."
                    width="1080"
                    height="311"
                    loading="lazy"
                  />
                </div>
              </figure>
              <p>
                Someone deciding whether to drive over right now can&rsquo;t find out from you. Everyone
                answering that question on your behalf is reading someone else&rsquo;s page.
              </p>
              <div class="opts two">
                <div class="opt rec">
                  <div class="top"><span class="tag rec">Recommended</span><h4>Publish and correct everywhere</h4></div>
                  <p>
                    Hours on the site, written into the page code in the format search engines look
                    for, then your Google profile and the three directories updated to match.
                  </p>
                </div>
                <div class="opt alt">
                  <div class="top"><span class="tag alt">Partial</span><h4>Publish on the site only</h4></div>
                  <p>Visitors can see them. Search engines and AI assistants keep using the directory versions.</p>
                </div>
              </div>
              <aside class="impact">
                <p class="impact-k">Conversion impact</p>
                <p>{impactOf("01")}</p>
              </aside>
            </div>
          </article>

          <article class="item upside" id="finding-02">
            <div class="item-head">
              <span class="badge upside">Biggest upside</span>
              <h3>02 - Ask an AI your prices twice and you get two different answers</h3>
            </div>
            <div class="b">
              <div class="figs">
                <figure>
                  <div class="fig-head">
                    <p class="k">Asked one way, it listed every tier correctly, read from your own website.</p>
                    <a class="fig-open" href="/proposals/ohio-golf-club/screenshot-2.jpg" target="_blank" rel="noopener">Full size &nearr;</a>
                  </div>
                  <div class="shot">
                    <img
                      src="/proposals/ohio-golf-club/screenshot-2.jpg"
                      alt="Screenshot of an AI assistant correctly listing all four Ohio Golf Club membership tiers and prices."
                      width="1080"
                      height="758"
                      loading="lazy"
                    />
                  </div>
                </figure>
                <figure>
                  <div class="fig-head">
                    <p class="k">Asked another way the same day, it said your pricing &ldquo;is not published clearly online&rdquo; and offered to go hunting.</p>
                    <a class="fig-open" href="/proposals/ohio-golf-club/screenshot-3.jpg" target="_blank" rel="noopener">Full size &nearr;</a>
                  </div>
                  <div class="shot">
                    <img
                      src="/proposals/ohio-golf-club/screenshot-3.jpg"
                      alt="Screenshot of an AI assistant saying Ohio Golf Club's membership pricing is not published clearly online."
                      width="1080"
                      height="402"
                      loading="lazy"
                    />
                  </div>
                </figure>
              </div>
              <p>
                When Google or ChatGPT can&rsquo;t confidently read your page, they go looking elsewhere
                and land on a directory. That&rsquo;s how the wrong numbers spread, and you have no say in
                which version someone gets.
              </p>
              <div>
                <p class="k">The fix</p>
                <p>
                  A standard format, published at <a href="https://schema.org/" target="_blank" rel="noopener">schema.org</a>, for spelling the same facts out in your page&rsquo;s code. Google, Bing and the AI assistants all read it. Visitors never see it.
                </p>
                <div class="codes">
                  <div>
                    <p class="k">On the page today</p>
                    <pre class="code">&lt;h3&gt;Classic&lt;/h3&gt;
&lt;p&gt;$200/Month&lt;/p&gt;</pre>
                  </div>
                  <div>
                    <p class="k">Added alongside it</p>
                    <pre class="code good">&lbrace;
  "@type": "Offer",
  "name": "Classic Membership",
  "price": "200.00",
  "priceCurrency": "USD"
&rbrace;</pre>
                  </div>
                </div>
                <p class="cap">
                  Left, Google has to guess which line is the membership name and which is the price.
                  Right, it&rsquo;s spelled out and there&rsquo;s nothing to guess.
                  <em>Simplified example, not your actual code.</em>
                </p>
              </div>
              <div>
                <p class="k">Both put the same facts in the code. The difference is where that code comes from.</p>
                <div class="opts two">
                  <div class="opt rec">
                    <div class="top"><span class="tag rec">Recommended</span><h4>One place to edit</h4></div>
                    <p>Built from your page content, so there&rsquo;s one source. Change a price once and both update.</p>
                  </div>
                  <div class="opt alt">
                    <div class="top"><span class="tag alt">Partial</span><h4>Two places to edit</h4></div>
                    <p>Written separately, so every price change has to be made twice. Miss one and they disagree.</p>
                  </div>
                </div>
              </div>
              <aside class="impact">
                <p class="impact-k">Conversion impact</p>
                <p>{impactOf("02")}</p>
              </aside>
            </div>
          </article>

          <article class="item upside" id="finding-03">
            <div class="item-head">
              <span class="badge upside">Quick win</span>
              <h3>03 - All five pages carry the same hidden title</h3>
            </div>
            <div class="b">
              <p>
                Every page has a title and description written into its code. You don&rsquo;t see them on
                the page. They&rsquo;re what Google shows as the clickable blue headline in search results,
                and what appears on your browser tab.
              </p>
              <div>
                <p>Your visible headings are all different and fine. It&rsquo;s the hidden ones underneath that are identical across all five:</p>
                <ul>
                  <li><a href="https://www.ohiogolfclubindoor.com/" target="_blank" rel="noopener">Homepage</a></li>
                  <li><a href="https://www.ohiogolfclubindoor.com/team" target="_blank" rel="noopener">Our Team</a></li>
                  <li><a href="https://www.ohiogolfclubindoor.com/contact-us" target="_blank" rel="noopener">Contact Us</a></li>
                  <li><a href="https://www.ohiogolfclubindoor.com/events" target="_blank" rel="noopener">Events &amp; Bar</a></li>
                  <li><a href="https://www.ohiogolfclubindoor.com/carls-place" target="_blank" rel="noopener">Carl&rsquo;s Place</a>, your custom simulator installation page</li>
                </ul>
                <p class="after-list">All five say &ldquo;Ohio Golf Club | Premier Indoor Golf Experience&rdquo; with the same description underneath.</p>
              </div>
              <p>
                Google reads that as five copies of one page, so only your homepage really competes.
                Carl&rsquo;s Place is the clearest example: a separate business line selling home simulator
                installations, and Google can&rsquo;t tell it apart from your contact page.
              </p>
              <p><strong>The fix:</strong> each page gets its own title and description. No second option worth presenting, and the cheapest item here.</p>
              <aside class="impact">
                <p class="impact-k">Conversion impact</p>
                <p>{impactOf("03")}</p>
              </aside>
            </div>
          </article>

          <article class="item upside" id="finding-04">
            <div class="item-head">
              <span class="badge upside">Biggest upside</span>
              <h3>04 - Your services don&rsquo;t have pages of their own</h3>
            </div>
            <div class="b">
              <p>
                Lessons, fittings, memberships and bay rentals are sections of the homepage you reach
                by scrolling. Someone searching for golf lessons in Akron has no page of yours to land
                on. <a href="https://cornerclubgolf.com/" target="_blank" rel="noopener">The Corner Club</a> already runs separate pages for rates, technology, lessons and leagues.
              </p>
              <figure>
                <p class="k">Today every search funnels to one page. With service pages, each search lands on the thing it asked for.</p>
                <div class="dw">
                  <svg
                    viewBox="0 0 470 372"
                    role="img"
                    aria-label="Diagram comparing today, where several searches funnel into the homepage, with a proposed structure where each search lands on its own service page with its own booking action."
                    class="diagram"
                  >
                    <defs>
                      <marker id="ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><polygon points="0,1 8,4 0,7" fill="#a3302a"></polygon></marker>
                      <marker id="arb" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><polygon points="0,1 8,4 0,7" fill="#17663f"></polygon></marker>
                    </defs>
                    <g>
                      <text x="0" y="12" font-size="13" font-weight="500" fill="#a3302a">Today</text>
                      <g font-size="11.5" fill="#5c5c60" text-anchor="end">
                        <text x="150" y="42">&ldquo;golf lessons akron&rdquo;</text>
                        <text x="150" y="66">&ldquo;club fitting akron&rdquo;</text>
                        <text x="150" y="90">&ldquo;indoor golf akron&rdquo;</text>
                      </g>
                      <g stroke="#a3302a" stroke-width="1" fill="none">
                        <path d="M156 38 L184 62"></path>
                        <path d="M156 62 L184 62"></path>
                        <path d="M156 86 L184 62"></path>
                      </g>
                      <line x1="184" y1="62" x2="205" y2="62" stroke="#a3302a" stroke-width="1" marker-end="url(#ar)"></line>
                      <rect x="212" y="45" width="140" height="34" fill="#fbeeed" stroke="#eec9c6" stroke-width="1"></rect>
                      <text x="282" y="66" font-size="12.5" text-anchor="middle" fill="#111111">Homepage</text>
                      <text x="470" y="66" font-size="10.5" fill="#a3302a" text-anchor="end">everything lives here</text>
                      <line x1="0" y1="120" x2="470" y2="120" stroke="#e5e5e5" stroke-width="1"></line>
                      <text x="0" y="148" font-size="13" font-weight="500" fill="#17663f">With service pages</text>
                      <g font-size="11.5" fill="#5c5c60" text-anchor="end">
                        <text x="150" y="182">&ldquo;golf lessons akron&rdquo;</text>
                        <text x="150" y="220">&ldquo;club fitting akron&rdquo;</text>
                        <text x="150" y="258">&ldquo;golf membership akron&rdquo;</text>
                        <text x="150" y="296">&ldquo;simulator rental akron&rdquo;</text>
                        <text x="150" y="334">&ldquo;indoor golf league akron&rdquo;</text>
                      </g>
                      <g stroke="#17663f" stroke-width="1">
                        <line x1="158" y1="178" x2="205" y2="178" marker-end="url(#arb)"></line>
                        <line x1="158" y1="216" x2="205" y2="216" marker-end="url(#arb)"></line>
                        <line x1="158" y1="254" x2="205" y2="254" marker-end="url(#arb)"></line>
                        <line x1="158" y1="292" x2="205" y2="292" marker-end="url(#arb)"></line>
                        <line x1="158" y1="330" x2="205" y2="330" marker-end="url(#arb)"></line>
                      </g>
                      <g fill="#eaf4ee" stroke="#17663f" stroke-width="1">
                        <rect x="212" y="165" width="148" height="26"></rect>
                        <rect x="212" y="203" width="148" height="26"></rect>
                        <rect x="212" y="241" width="148" height="26"></rect>
                        <rect x="212" y="279" width="148" height="26"></rect>
                        <rect x="212" y="317" width="148" height="26"></rect>
                      </g>
                      <g font-size="12" fill="#111111">
                        <text x="222" y="182">Lessons</text>
                        <text x="222" y="220">Club fitting</text>
                        <text x="222" y="258">Memberships</text>
                        <text x="222" y="296">Bay rentals</text>
                        <text x="222" y="334">Leagues</text>
                      </g>
                      <g font-size="10.5" fill="#17663f">
                        <text x="370" y="182">Book</text>
                        <text x="370" y="220">Book</text>
                        <text x="370" y="258">Join</text>
                        <text x="370" y="296">Book</text>
                        <text x="370" y="334">Sign up</text>
                      </g>
                    </g>
                  </svg>
                </div>
              </figure>
              <div>
                <p class="k">Why this is the biggest one</p>
                <ul>
                  <li><strong>More doors.</strong> Each page can rank for its own searches. A homepage section can&rsquo;t.</li>
                  <li><strong>A shorter path to booking.</strong> Someone searching for club fitting lands on a fitting page with a fitting booking button, instead of your homepage where they have to scroll and work it out.</li>
                  <li><strong>A link you can send.</strong> One URL for lessons that works in an ad, an Instagram bio, or a text.</li>
                  <li><strong>Room to sell.</strong> A fitting page can explain why yours beats a big box store. That case can&rsquo;t be made in a homepage paragraph.</li>
                  <li><strong>You learn what people want.</strong> You&rsquo;d see whether fittings or memberships draw more interest, instead of guessing.</li>
                </ul>
              </div>
              <div class="opts two">
                <div class="opt rec">
                  <div class="top"><span class="tag rec">Recommended</span><h4>Five pages</h4></div>
                  <p>Lessons, club fitting, memberships, bay rentals, leagues. Everything you sell.</p>
                </div>
                <div class="opt alt">
                  <div class="top"><span class="tag alt">Smaller start</span><h4>Three pages</h4></div>
                  <p>Lessons, fitting and memberships first, the rest added later.</p>
                </div>
              </div>
              <aside class="impact">
                <p class="impact-k">Conversion impact</p>
                <p>{impactOf("04")}</p>
              </aside>
            </div>
          </article>

          <article class="item critical" id="finding-05">
            <div class="item-head">
              <span class="badge critical">Costing you now</span>
              <h3>05 - Other sites list the wrong address and price</h3>
            </div>
            <div class="b">
              <div>
                <p>All three are live right now, and none are under your control.</p>
                <div class="tw">
                  <table>
