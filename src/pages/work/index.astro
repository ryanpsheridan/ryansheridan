---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import Odometer from "../../components/Odometer.astro";
import { projects } from "../../data/projects";
import { SITE_URL, WEBSITE_ID, breadcrumbSchema } from "../../data/schema";

// Newest first. Array sort is stable, so projects from the same year keep
// their order from projects.ts.
const sortedProjects = [...projects].sort((a, b) => b.year - a.year);

const allTags = [...new Set(projects.flatMap((p) => p.tags))];

// The counter renders with the newest year already dialed in, so it reads
// correctly before the script runs (or if it never does).
const firstYear = sortedProjects[0]?.year ?? new Date().getFullYear();
const firstYearCount = sortedProjects.filter((p) => p.year === firstYear).length;
const projectCount = (n: number) => `${n} ${n === 1 ? "project" : "projects"}`;

const schema = [
  {
    "@type": "CollectionPage",
    name: "All work",
    isPartOf: { "@id": WEBSITE_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: sortedProjects.map((project, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE_URL}/work/${project.slug}`,
        name: project.title,
      })),
    },
  },
  breadcrumbSchema([{ name: "Work", path: "/work" }]),
];
---

<Layout
  title="Work — Ryan Sheridan"
  description="Case studies by Ryan Sheridan: multi-brand design systems, brand identities, Webflow and Makeswift websites, illustration, and AI design workflows."
  schema={schema}
>
  <Nav />
  <main class="work-page">
    <div class="work-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Work</span>
      </nav>
      <h1>All work</h1>

      <div class="filter-row">
        <label class="filter-label" for="type-filter">Project Types</label>
        <div class="select-wrapper">
          <select id="type-filter">
            <option value="all">All</option>
            {allTags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
          <svg class="select-chevron" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
            />
          </svg>
        </div>
      </div>

      <div class="year-bar" data-year-bar aria-hidden="true">
        <span class="year-bar-year"><Odometer value={firstYear} /></span>
        <span class="year-bar-count" data-year-count>{projectCount(firstYearCount)}</span>
      </div>

      <ul class="project-list">
        {
          sortedProjects.map((project) => (
            <li class="project-row" data-tags={project.tags.join(",")} data-year={project.year}>
              <a href={`/work/${project.slug}`} class="row-thumb" tabindex="-1" aria-hidden="true">
                {project.thumbnail && <Media src={project.thumbnail} alt="" />}
              </a>
              <div class="row-body">
                <h2>
                  <a href={`/work/${project.slug}`} class="row-link">{project.title}</a>
                </h2>
                <p class="visually-hidden"><time datetime={String(project.year)}>{project.year}</time></p>
                <div class="badge-list">
                  {project.tags.map((tag) => <span class="badge">{tag}</span>)}
                </div>
                <p class="row-description">{project.description}</p>
              </div>
              <span class="row-cta" aria-hidden="true">
                View project
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 10h12M11 5l5 5-5 5" />
                </svg>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: 80px var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .breadcrumbs {
    margin-bottom: 32px;
    font-family: var(--font-mono);
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--color-text);
  }

  .breadcrumbs .sep {
    color: var(--color-border);
  }

  .breadcrumbs .current {
    color: var(--color-text);
  }

  h1 {
    font-size: clamp(24px, 1.2rem + 1vw, 40px);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
  }

  .filter-row {
    margin-bottom: 40px;
    max-width: 360px;
  }

  .filter-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .select-wrapper {
    position: relative;
  }

  select {
    width: 100%;
    appearance: none;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 14px;
    padding-right: 36px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
  }

  select:focus {
    border-color: #999;
  }

  .select-chevron {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0 0 80px;
  }

  /* One project per row, split by a hairline: thumbnail on the left, then
     the name, tags and summary as one column, then the link out on its own at
     the far right. Generous gutters and padding keep each row breathing. */
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) auto;
    grid-template-areas: "thumb body cta";
    column-gap: var(--space-7);
    align-items: start;
    /* Halfway between the two largest steps: open, without the rows drifting
       apart. */
    padding: calc((var(--space-6) + var(--space-7)) / 2) 0;
    border-top: 1px solid var(--color-border);
  }

  .project-row.hidden {
    display: none;
  }

  .row-body {
    grid-area: body;
    /* Keeps the summary to a comfortable measure on wide screens, leaving
       open space between the text and the link. */
    max-width: 52ch;
  }

  .row-body h2 {
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0 0 var(--space-1);
  }

  .row-link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The title link covers the whole row, so the thumbnail and the CTA are
     click targets too, without nesting everything inside one long link. */
  .row-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .row-link:focus-visible {
    outline: none;
  }

  .row-link:focus-visible::after {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .row-body h2 + .visually-hidden + .badge-list {
    margin-top: var(--space-3);
  }

  /* Year counter. It sticks under the nav and rolls to the year of whichever
     project is passing beneath it; the rows are sorted newest first, so it
     counts down through the years as you scroll. Decorative: each row also
     carries its year as visually hidden text. */
  .year-bar {
    position: sticky;
    top: var(--nav-height);
    z-index: 10;
    display: flex;
    /* Year and count share a bottom line. */
    align-items: flex-end;
    /* Same above and below, so the bar is evenly padded once it sticks. */
    padding: 12px 0;
    background: var(--color-bg);
    /* Once stuck under the nav, a rule underneath separates it from the rows
       scrolling past. No rule above: it sits straight against the nav. */
    box-shadow: 0 1px 0 transparent;
    transition: box-shadow 0.2s;
  }

  .year-bar.is-stuck {
    box-shadow: 0 1px 0 var(--color-border);
  }

  .year-bar-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1;
    /* The odometer's digit window leaves a little more room under the year's
       baseline than this line box leaves under the count's, so lift the count
       by the difference to put both on one baseline. */
    margin-bottom: 0.17em;
  }

  .year-bar-year {
    display: flex;
    font-size: var(--text-md);
  }

  /* Same frame as the homepage cards: 16:10, cropped to fill. The thumbnail is
     its own link (hidden from assistive tech, since the title link already
     names the project) so a click on the image always lands, even while the
     hover zoom lifts it above the row-wide title link. */
  .row-thumb {
    grid-area: thumb;
    display: block;
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-tag-bg);
  }

  .row-thumb :global(img),
  .row-thumb :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
    transition: transform 0.4s ease;
  }

  .row-description {
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .row-cta {
    grid-area: cta;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-md);
    color: var(--color-text);
    white-space: nowrap;
  }

  .row-cta svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  @media (hover: hover) {
    .project-row:hover .row-cta svg {
      transform: translateX(4px);
    }

    .project-row:hover .row-thumb :global(img),
    .project-row:hover .row-thumb :global(video) {
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .year-bar,
    .row-cta svg,
    .row-thumb :global(img),
    .row-thumb :global(video) {
      transition: none;
    }
  }

  /* Tablet: the link drops under the summary so the image and text keep room. */
  @media (max-width: 1024px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "thumb body"
        "thumb cta";
      grid-template-rows: auto 1fr;
      column-gap: var(--space-5);
      row-gap: var(--space-4);
      padding: var(--space-6) 0;
    }
  }

  /* Phone: stack thumbnail, name and summary, link. */
  @media (max-width: 768px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "thumb"
        "body"
        "cta";
      grid-template-rows: none;
      gap: var(--space-4);
      padding: var(--space-5) 0;
    }
  }
</style>

<script>
  const filter = document.getElementById("type-filter") as HTMLSelectElement;
  const cards = document.querySelectorAll<HTMLLIElement>(".project-row");
  const list = document.querySelector<HTMLElement>(".project-list");
  const bar = document.querySelector<HTMLElement>("[data-year-bar]");
  const counters = document.querySelectorAll<HTMLElement>("[data-odometer]");
  const counts = document.querySelectorAll<HTMLElement>("[data-year-count]");
  const nav = document.querySelector<HTMLElement>("nav:not(.breadcrumbs)");

  // Stick flush under the nav. --nav-height is a round site-wide estimate,
  // so measure the real bar instead and follow it if it changes size.
  if (bar && nav) {
    const pin = () => bar.style.setProperty("top", `${nav.getBoundingClientRect().height}px`);
    pin();
    new ResizeObserver(pin).observe(nav);
  }

  let shownYear = "";

  const visibleCards = () => [...cards].filter((card) => !card.classList.contains("hidden"));

  // The current year belongs to the first row whose bottom is still below the
  // reading line, a third of the way down the space under the bar, so a year
  // never stays lit while its last row is mostly gone. Read on scroll through
  // rAF, so it stays cheap.
  function update() {
    if (!list || !bar) return;
    const visible = visibleCards();
    const barRect = bar.getBoundingClientRect();
    const line = barRect.bottom + (window.innerHeight - barRect.bottom) / 3;
    const navOffset = parseFloat(getComputedStyle(bar).top) || 0;
    bar.classList.toggle("is-stuck", barRect.top <= navOffset + 0.5);

    // At the very bottom the last rows may never reach the line, so hand the
    // counter to the last project rather than leaving its year dimmed.
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    const current = atBottom
      ? visible.at(-1)
      : visible.find((card) => card.getBoundingClientRect().bottom > line) ?? visible.at(-1);
    const year = current?.dataset.year;
    if (!year) return;

    const total = visible.filter((card) => card.dataset.year === year).length;
    counts.forEach((el) => (el.textContent = `${total} ${total === 1 ? "project" : "projects"}`));

    if (year === shownYear) return;
    shownYear = year;
    counters.forEach((counter) => {
      const digits = counter.querySelectorAll<HTMLElement>(".odometer-digit");
      year.split("").forEach((digit, i) => digits[i]?.style.setProperty("--d", digit));
    });
  }

  let ticking = false;
  const requestUpdate = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      update();
    });
  };

  window.addEventListener("scroll", requestUpdate, { passive: true });
  window.addEventListener("resize", requestUpdate);
  // Thumbnails and fonts settle row heights after first paint.
  if (list) new ResizeObserver(requestUpdate).observe(list);
  update();

  filter.addEventListener("change", () => {
    const value = filter.value;
    cards.forEach((card) => {
      if (value === "all") {
        card.classList.remove("hidden");
      } else {
        const tags = card.dataset.tags?.split(",") ?? [];
        card.classList.toggle("hidden", !tags.includes(value));
      }
    });
    update();
  });
</script>
