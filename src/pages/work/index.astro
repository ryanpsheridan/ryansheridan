---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import { projects } from "../../data/projects";
import { SITE_URL, WEBSITE_ID, breadcrumbSchema } from "../../data/schema";

const allTags = [...new Set(projects.flatMap((p) => p.tags))];

const schema = [
  {
    "@type": "CollectionPage",
    name: "All work",
    isPartOf: { "@id": WEBSITE_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: projects.map((project, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE_URL}/work/${project.slug}`,
        name: project.title,
      })),
    },
  },
  breadcrumbSchema([{ name: "Work", path: "/work" }]),
];
---

<Layout
  title="Work — Ryan Sheridan"
  description="Case studies by Ryan Sheridan: multi-brand design systems, brand identities, Webflow and Makeswift websites, illustration, and AI design workflows."
  schema={schema}
>
  <Nav />
  <main class="work-page">
    <div class="work-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Work</span>
      </nav>
      <h1>All work</h1>

      <div class="filter-row">
        <label class="filter-label" for="type-filter">Project Types</label>
        <div class="select-wrapper">
          <select id="type-filter">
            <option value="all">All</option>
            {allTags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
          <svg class="select-chevron" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
            />
          </svg>
        </div>
      </div>

      <ul class="project-list">
        {
          projects.map((project) => (
            <li class="project-row" data-tags={project.tags.join(",")}>
              <div class="row-heading">
                <h2>
                  <a href={`/work/${project.slug}`} class="row-link">{project.title}</a>
                </h2>
                <p class="row-label">{project.tags.join(" · ")}</p>
              </div>
              <div class="row-thumb">
                {project.thumbnail && <Media src={project.thumbnail} alt="" />}
              </div>
              <p class="row-description">{project.description}</p>
              <span class="row-cta" aria-hidden="true">
                View project
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 10h12M11 5l5 5-5 5" />
                </svg>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: 80px var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .breadcrumbs {
    margin-bottom: 32px;
    font-family: var(--font-mono);
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--color-text);
  }

  .breadcrumbs .sep {
    color: var(--color-border);
  }

  .breadcrumbs .current {
    color: var(--color-text);
  }

  h1 {
    font-size: clamp(24px, 1.2rem + 1vw, 40px);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
  }

  .filter-row {
    margin-bottom: 40px;
    max-width: 360px;
  }

  .filter-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .select-wrapper {
    position: relative;
  }

  select {
    width: 100%;
    appearance: none;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 14px;
    padding-right: 36px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
  }

  select:focus {
    border-color: #999;
  }

  .select-chevron {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0 0 80px;
  }

  /* One project per row, split by a hairline: name, thumbnail, summary, link. */
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2.2fr) minmax(0, 3fr) auto;
    grid-template-areas: "heading thumb description cta";
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
  }

  .project-row.hidden {
    display: none;
  }

  .row-heading {
    grid-area: heading;
  }

  .row-heading h2 {
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0 0 var(--space-2);
  }

  .row-link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The title link covers the whole row, so the thumbnail and the CTA are
     click targets too, without nesting everything inside one long link. */
  .row-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .row-link:focus-visible {
    outline: none;
  }

  .row-link:focus-visible::after {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .row-label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .row-thumb {
    grid-area: thumb;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-tag-bg);
  }

  .row-thumb :global(img),
  .row-thumb :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
    transition: transform 0.4s ease;
  }

  .row-description {
    grid-area: description;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
  }

  .row-cta {
    grid-area: cta;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-md);
    color: var(--color-text);
    white-space: nowrap;
  }

  .row-cta svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  @media (hover: hover) {
    .project-row:hover .row-cta svg {
      transform: translateX(4px);
    }

    .project-row:hover .row-thumb :global(img),
    .project-row:hover .row-thumb :global(video) {
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-cta svg,
    .row-thumb :global(img),
    .row-thumb :global(video) {
      transition: none;
    }
  }

  /* Tablet: the link drops under the summary so the three columns keep room. */
  @media (max-width: 1024px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.2fr);
      grid-template-areas:
        "heading thumb description"
        "heading thumb cta";
      grid-template-rows: auto 1fr;
      row-gap: var(--space-4);
    }
  }

  /* Phone: stack name, thumbnail, summary, link. */
  @media (max-width: 768px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "heading"
        "thumb"
        "description"
        "cta";
      grid-template-rows: none;
      gap: var(--space-3);
      padding: var(--space-5) 0;
    }

    .row-description {
      font-size: var(--text-base);
    }
  }
</style>

<script>
  const filter = document.getElementById("type-filter") as HTMLSelectElement;
  const cards = document.querySelectorAll<HTMLLIElement>(".project-row");

  filter.addEventListener("change", () => {
    const value = filter.value;
    cards.forEach((card) => {
      if (value === "all") {
        card.classList.remove("hidden");
      } else {
        const tags = card.dataset.tags?.split(",") ?? [];
        card.classList.toggle("hidden", !tags.includes(value));
      }
    });
  });
</script>
