---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import Select from "../../components/ui/Select.astro";
import WorkCard from "../../components/work/WorkCard.astro";
import FurtherBack from "../../components/work/FurtherBack.astro";
import { workProjects, projectTypes } from "../../data/work";
import { SITE_URL, WEBSITE_ID, breadcrumbSchema } from "../../data/schema";

// The newest nine show up front; the rest wait behind "Go further back".
const CAP = 9;
const archive = workProjects.slice(CAP);
const archiveYears = archive.map((p) => p.year);
const archiveRange =
  archive.length && Math.max(...archiveYears) !== Math.min(...archiveYears)
    ? `${Math.max(...archiveYears)} to ${Math.min(...archiveYears)}`
    : String(archiveYears[0] ?? "");

const schema = [
  {
    "@type": "CollectionPage",
    name: "All work",
    isPartOf: { "@id": WEBSITE_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: workProjects.map((project, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE_URL}/work/${project.slug}`,
        name: project.title,
      })),
    },
  },
  breadcrumbSchema([{ name: "Work", path: "/work" }]),
];
---

<Layout
  title="Work — Ryan Sheridan"
  description="Case studies by Ryan Sheridan: multi-brand design systems, brand identities, Webflow and Makeswift websites, illustration, and AI design workflows."
  schema={schema}
  noindex
>
  <Nav />
  <main id="main" class="work-page">
    <div class="work-inner" data-work-grid>
      {/* Title on the left, the type filter on the right, both sitting on
          the title's baseline. */}
      <header class="work-header">
        <div>
          <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Work" }]} />
          <h1>All work</h1>
        </div>
        <div class="work-filter">
          <label for="work-type" class="visually-hidden">Project type</label>
          <Select id="work-type" data-work-type>
            <option value="">All projects ({workProjects.length})</option>
            {projectTypes.map((t) => <option value={t.name}>{t.name} ({t.count})</option>)}
          </Select>
        </div>
      </header>
      <p class="visually-hidden" aria-live="polite" data-filter-status></p>

      <ul class="work-grid">
        {workProjects.map((project, i) => <WorkCard project={project} hidden={i >= CAP} />)}
      </ul>
      <p class="work-empty" data-filter-empty hidden>Nothing here yet.</p>

      <FurtherBack more={archive.length} range={archiveRange} />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: var(--page-top) var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-bottom: var(--space-8);
  }

  .work-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  h1 {
    font-size: var(--text-h2);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .work-filter {
    flex: 0 0 auto;
    width: 260px;
  }

  /* Three across on desktop, two on tablets, one on phones. */
  .work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7) var(--space-5);
  }

  .work-empty {
    padding: var(--space-7) 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-5);
    }
  }

  /* Phone: the filter drops under the title at full width. */
  @media (max-width: 640px) {
    .work-header {
      flex-direction: column;
      align-items: stretch;
    }

    .work-filter {
      width: 100%;
    }

    .work-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>

<script>
  import { initWorkGrid } from "../../scripts/work-grid";

  const root = document.querySelector<HTMLElement>("[data-work-grid]")!;
  const grid = initWorkGrid(root, 9);
  const select = root.querySelector<HTMLSelectElement>("[data-work-type]")!;
  const status = root.querySelector<HTMLElement>("[data-filter-status]");
  const empty = root.querySelector<HTMLElement>("[data-filter-empty]");

  // The choice lands in ?tag= so a filtered view can be shared.
  function apply(tag: string, animate: boolean) {
    const n = grid.setTag(tag, animate);
    if (empty) empty.hidden = n > 0;
    if (status && animate) status.textContent = tag ? `${grid.plural(n)} tagged ${tag}` : `All ${grid.plural(n)}`;
    const url = new URL(window.location.href);
    if (tag) url.searchParams.set("tag", tag);
    else url.searchParams.delete("tag");
    history.replaceState(history.state, "", url);
  }

  select.addEventListener("change", () => apply(select.value, true));

  const initial = new URLSearchParams(window.location.search).get("tag") ?? "";
  if (initial && [...select.options].some((o) => o.value === initial)) {
    select.value = initial;
    apply(initial, false);
  }
</script>
