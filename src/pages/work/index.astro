---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import { projects } from "../../data/projects";
import { SITE_URL, WEBSITE_ID, breadcrumbSchema } from "../../data/schema";

// Newest first. Array sort is stable, so projects from the same year keep
// their order from projects.ts.
const sortedProjects = [...projects].sort((a, b) => b.year - a.year);

const allTags = [...new Set(projects.flatMap((p) => p.tags))];

// One group per year, newest first, each with its own header.
const years = [...new Set(sortedProjects.map((p) => p.year))];
const yearGroups = years.map((year) => ({
  year,
  projects: sortedProjects.filter((p) => p.year === year),
}));
const projectCount = (n: number) => `${n} ${n === 1 ? "project" : "projects"}`;

const schema = [
  {
    "@type": "CollectionPage",
    name: "All work",
    isPartOf: { "@id": WEBSITE_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: sortedProjects.map((project, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE_URL}/work/${project.slug}`,
        name: project.title,
      })),
    },
  },
  breadcrumbSchema([{ name: "Work", path: "/work" }]),
];
---

<Layout
  title="Work — Ryan Sheridan"
  description="Case studies by Ryan Sheridan: multi-brand design systems, brand identities, Webflow and Makeswift websites, illustration, and AI design workflows."
  schema={schema}
>
  <Nav />
  <main class="work-page">
    <div class="work-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Work</span>
      </nav>
      <h1>All work</h1>

      <div class="filter-row">
        <label class="filter-label" for="type-filter">Project Types</label>
        <div class="select-wrapper">
          <select id="type-filter">
            <option value="all">All</option>
            {allTags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
          <svg class="select-chevron" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
            />
          </svg>
        </div>
      </div>

      {/* Each year's header sits just above its first project's divider and
          sticks under the nav while that year is on screen. The next year's
          header comes up from below and pushes it out, because each one only
          sticks within its own group. */}
      <div class="year-groups">
        {
          yearGroups.map((group) => (
            <section class="year-group" data-year-group={group.year}>
              <div class="year-bar" data-year-bar aria-hidden="true">
                <span class="year-bar-year">{group.year}</span>
                <span class="year-bar-count" data-year-count>{projectCount(group.projects.length)}</span>
              </div>
              <ul class="project-list">
                {
                  group.projects.map((project) => (
                    <li class="project-row" data-tags={project.tags.join(",")} data-year={project.year}>
                      <a href={`/work/${project.slug}`} class="row-thumb" tabindex="-1" aria-hidden="true">
                        {project.thumbnail && <Media src={project.thumbnail} alt="" />}
                      </a>
                      <div class="row-body">
                        <h2>
                          <a href={`/work/${project.slug}`} class="row-link">{project.title}</a>
                        </h2>
                        <p class="visually-hidden"><time datetime={String(project.year)}>{project.year}</time></p>
                        <div class="badge-list">
                          {project.tags.map((tag) => <span class="badge">{tag}</span>)}
                        </div>
                        <p class="row-description">{project.description}</p>
                      </div>
                      <span class="row-cta" aria-hidden="true">
                        View project
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 10h12M11 5l5 5-5 5" />
                        </svg>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: 80px var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .breadcrumbs {
    margin-bottom: 32px;
    font-family: var(--font-mono);
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--color-text);
  }

  .breadcrumbs .sep {
    color: var(--color-border);
  }

  .breadcrumbs .current {
    color: var(--color-text);
  }

  h1 {
    font-size: clamp(24px, 1.2rem + 1vw, 40px);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
  }

  .filter-row {
    margin-bottom: 40px;
    max-width: 360px;
  }

  .filter-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .select-wrapper {
    position: relative;
  }

  select {
    width: 100%;
    appearance: none;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 14px;
    padding-right: 36px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
  }

  select:focus {
    border-color: #999;
  }

  .select-chevron {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .year-groups {
    padding-bottom: 80px;
  }

  /* A little extra air where one year ends and the next begins, so the
     change of year reads as a break and not just another row. */
  .year-group + .year-group {
    margin-top: var(--space-5);
  }

  .year-group.hidden {
    display: none;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* One project per row, split by a hairline: thumbnail on the left, then
     the name, tags and summary as one column, then the link out on its own at
     the far right. Generous gutters and padding keep each row breathing. */
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) auto;
    grid-template-areas: "thumb body cta";
    column-gap: var(--space-7);
    align-items: start;
    /* Halfway between the two largest steps: open, without the rows drifting
       apart. */
    padding: calc((var(--space-6) + var(--space-7)) / 2) 0;
    border-top: 1px solid var(--color-border);
  }

  .project-row.hidden {
    display: none;
  }

  .row-body {
    grid-area: body;
    /* Keeps the summary to a comfortable measure on wide screens, leaving
       open space between the text and the link. */
    max-width: 52ch;
  }

  .row-body h2 {
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0 0 var(--space-1);
  }

  .row-link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The title link covers the whole row, so the thumbnail and the CTA are
     click targets too, without nesting everything inside one long link. */
  .row-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .row-link:focus-visible {
    outline: none;
  }

  .row-link:focus-visible::after {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .row-body h2 + .visually-hidden + .badge-list {
    margin-top: var(--space-3);
  }

  /* Year headers. Each sticks under the nav only within its own group, so
     as one year ends its header scrolls away and the next year's header,
     already on its way up, takes its place. Decorative: each row also
     carries its year as visually hidden text. */
  .year-bar {
    position: sticky;
    top: var(--nav-height);
    z-index: 10;
    display: flex;
    /* Year and count share a baseline. */
    align-items: baseline;
    /* Same above and below, so the bar is evenly padded once it sticks. */
    padding: 12px 0;
    background: var(--color-bg);
    /* Once stuck under the nav, a rule underneath separates it from the rows
       scrolling past. No rule above: it sits straight against the nav. */
    box-shadow: 0 1px 0 transparent;
    transition: box-shadow 0.2s;
  }

  .year-bar.is-stuck {
    box-shadow: 0 1px 0 var(--color-border);
  }

  .year-bar-year {
    font-size: var(--text-md);
    font-weight: 300;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .year-bar-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1;
  }

  /* Same frame as the homepage cards: 16:10, cropped to fill. The thumbnail is
     its own link (hidden from assistive tech, since the title link already
     names the project) so a click on the image always lands, even while the
     hover zoom lifts it above the row-wide title link. */
  .row-thumb {
    grid-area: thumb;
    display: block;
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-tag-bg);
  }

  .row-thumb :global(img),
  .row-thumb :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
    transition: transform 0.4s ease;
  }

  .row-description {
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .row-cta {
    grid-area: cta;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-md);
    color: var(--color-text);
    white-space: nowrap;
  }

  .row-cta svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  @media (hover: hover) {
    .project-row:hover .row-cta svg {
      transform: translateX(4px);
    }

    .project-row:hover .row-thumb :global(img),
    .project-row:hover .row-thumb :global(video) {
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .year-bar,
    .row-cta svg,
    .row-thumb :global(img),
    .row-thumb :global(video) {
      transition: none;
    }
  }

  /* Tablet: the link drops under the summary so the image and text keep room. */
  @media (max-width: 1024px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "thumb body"
        "thumb cta";
      grid-template-rows: auto 1fr;
      column-gap: var(--space-5);
      row-gap: var(--space-4);
      padding: var(--space-6) 0;
    }
  }

  /* Phone: stack thumbnail, name and summary, link. */
  @media (max-width: 768px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "thumb"
        "body"
        "cta";
      grid-template-rows: none;
      gap: var(--space-4);
      padding: var(--space-5) 0;
      /* Stacked rows read as separate cards on their own, so no rules. */
      border-top: none;
    }
  }
</style>

<script>
  const filter = document.getElementById("type-filter") as HTMLSelectElement;
  const cards = document.querySelectorAll<HTMLLIElement>(".project-row");
  const groups = document.querySelectorAll<HTMLElement>("[data-year-group]");
  const bars = document.querySelectorAll<HTMLElement>("[data-year-bar]");
  const nav = document.querySelector<HTMLElement>("nav:not(.breadcrumbs)");

  // Stick flush under the nav. --nav-height is a round site-wide estimate,
  // so measure the real bar instead and follow it if it changes size.
  let navHeight = 0;
  if (nav) {
    const pin = () => {
      navHeight = nav.getBoundingClientRect().height;
      bars.forEach((bar) => bar.style.setProperty("top", `${navHeight}px`));
      update();
    };
    new ResizeObserver(pin).observe(nav);
  }

  // A header is stuck once its group's top has scrolled up past the nav. It
  // keeps its rule while the next year pushes it out, so the two trade places
  // cleanly.
  function update() {
    groups.forEach((group) => {
      const bar = group.querySelector<HTMLElement>("[data-year-bar]");
      if (!bar) return;
      const groupTop = group.getBoundingClientRect().top;
      bar.classList.toggle("is-stuck", groupTop < navHeight - 0.5);
    });
  }

  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    },
    { passive: true },
  );
  update();

  // Filter rows, then hide any year left empty and recount the rest.
  filter.addEventListener("change", () => {
    const value = filter.value;
    cards.forEach((card) => {
      const tags = card.dataset.tags?.split(",") ?? [];
      card.classList.toggle("hidden", value !== "all" && !tags.includes(value));
    });
    groups.forEach((group) => {
      const shown = group.querySelectorAll(".project-row:not(.hidden)").length;
      group.classList.toggle("hidden", shown === 0);
      const count = group.querySelector("[data-year-count]");
      if (count) count.textContent = `${shown} ${shown === 1 ? "project" : "projects"}`;
    });
    update();
  });
</script>
