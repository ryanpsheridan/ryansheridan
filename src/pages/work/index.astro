---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import Odometer from "../../components/Odometer.astro";
import { projects } from "../../data/projects";
import { SITE_URL, WEBSITE_ID, breadcrumbSchema } from "../../data/schema";

// Newest first. Array sort is stable, so projects from the same year keep
// their order from projects.ts.
const sortedProjects = [...projects].sort((a, b) => b.year - a.year);

const allTags = [...new Set(projects.flatMap((p) => p.tags))];

// The counter renders with the newest year already dialed in, so it reads
// correctly before the script runs (or if it never does).
const firstYear = sortedProjects[0]?.year ?? new Date().getFullYear();
const firstYearCount = sortedProjects.filter((p) => p.year === firstYear).length;
const projectCount = (n: number) => `${n} ${n === 1 ? "project" : "projects"}`;

const schema = [
  {
    "@type": "CollectionPage",
    name: "All work",
    isPartOf: { "@id": WEBSITE_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: sortedProjects.map((project, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE_URL}/work/${project.slug}`,
        name: project.title,
      })),
    },
  },
  breadcrumbSchema([{ name: "Work", path: "/work" }]),
];
---

<Layout
  title="Work — Ryan Sheridan"
  description="Case studies by Ryan Sheridan: multi-brand design systems, brand identities, Webflow and Makeswift websites, illustration, and AI design workflows."
  schema={schema}
>
  <Nav />
  <main class="work-page">
    <div class="work-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Work</span>
      </nav>
      <h1>All work</h1>

      <div class="filter-row">
        <label class="filter-label" for="type-filter">Project Types</label>
        <div class="select-wrapper">
          <select id="type-filter">
            <option value="all">All</option>
            {allTags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
          <svg class="select-chevron" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
            />
          </svg>
        </div>
      </div>

      <div class="year-bar" data-year-bar aria-hidden="true">
        <span class="year-bar-label">Year</span>
        <span class="year-bar-year"><Odometer value={firstYear} /></span>
        <span class="year-bar-count" data-year-count>{projectCount(firstYearCount)}</span>
      </div>

      {/* Wide screens: a timeline in the left gutter. The track is a small map
          of the list with a tick where each year starts; it slides so the
          point you've scrolled to sits at the middle of the screen, beside the
          year. A tick crossing the middle is a new year's first project
          crossing it too, so the year rolls as that project lines up with it. */}
      <div class="year-rail" data-year-rail aria-hidden="true">
        <div class="rail-window">
          <div class="rail-track" data-rail-track>
            <div class="rail-fill" data-rail-fill></div>
          </div>
        </div>
        <span class="rail-connector"></span>
        <span class="rail-marker"></span>
        <div class="rail-readout">
          <span class="rail-year"><Odometer value={firstYear} /></span>
          <span class="rail-count" data-year-count>{projectCount(firstYearCount)}</span>
        </div>
      </div>

      <div class="list-wrap">
      {/* Wide screens: a bracket beside every project in the current year. The
          timeline's connector runs from the year into it. */}
      <div class="year-bracket" data-year-bracket aria-hidden="true"></div>
      <ul class="project-list">
        {
          sortedProjects.map((project) => (
            <li class="project-row" data-tags={project.tags.join(",")} data-year={project.year}>
              {/* Shown on the first project of each year (the script decides,
                  so it follows the filter), then hidden once the year it
                  names is the one on the counter. */}
              <span class="row-year-marker" aria-hidden="true">{project.year}</span>
              <div class="row-heading">
                <h2>
                  <a href={`/work/${project.slug}`} class="row-link">{project.title}</a>
                </h2>
                <p class="visually-hidden"><time datetime={String(project.year)}>{project.year}</time></p>
                <div class="badge-list">
                  {project.tags.map((tag) => <span class="badge">{tag}</span>)}
                </div>
              </div>
              <a href={`/work/${project.slug}`} class="row-thumb" tabindex="-1" aria-hidden="true">
                {project.thumbnail && <Media src={project.thumbnail} alt="" />}
              </a>
              <p class="row-description">{project.description}</p>
              <span class="row-cta" aria-hidden="true">
                View project
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 10h12M11 5l5 5-5 5" />
                </svg>
              </span>
            </li>
          ))
        }
      </ul>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: 80px var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .breadcrumbs {
    margin-bottom: 32px;
    font-family: var(--font-mono);
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--color-text);
  }

  .breadcrumbs .sep {
    color: var(--color-border);
  }

  .breadcrumbs .current {
    color: var(--color-text);
  }

  h1 {
    font-size: clamp(24px, 1.2rem + 1vw, 40px);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
  }

  .filter-row {
    margin-bottom: 40px;
    max-width: 360px;
  }

  .filter-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .select-wrapper {
    position: relative;
  }

  select {
    width: 100%;
    appearance: none;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 14px;
    padding-right: 36px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
  }

  select:focus {
    border-color: #999;
  }

  .select-chevron {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0 0 80px;
  }

  /* One project per row, split by a hairline: name, thumbnail, summary, link. */
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2.2fr) minmax(0, 3fr) auto;
    grid-template-areas: "heading thumb description cta";
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
  }

  .project-row.hidden {
    display: none;
  }

  /* Year label on the divider above each year's first project. On narrow
     screens it sits on the line itself; with the gutter timeline it sits out
     in the gutter, in line with the year on the counter, and hides as it
     reaches the middle so it reads as rolling into the counter. */
  .row-year-marker {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    transform: translateY(-50%);
    padding-right: var(--space-2);
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--color-text-muted);
    transition: opacity 0.25s ease;
  }

  .project-row.is-year-start .row-year-marker {
    display: block;
  }

  .row-year-marker.is-merged {
    opacity: 0;
  }

  .list-wrap {
    position: relative;
  }

  .year-bracket {
    display: none;
  }

  .row-heading {
    grid-area: heading;
  }

  .row-heading h2 {
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0 0 var(--space-1);
  }

  .row-link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The title link covers the whole row, so the thumbnail and the CTA are
     click targets too, without nesting everything inside one long link. */
  .row-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .row-link:focus-visible {
    outline: none;
  }

  .row-link:focus-visible::after {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .row-heading h2 + .visually-hidden + .badge-list {
    margin-top: var(--space-3);
  }

  /* Year counter. It sticks under the nav and rolls to the year of whichever
     project is passing beneath it; the rows are sorted newest first, so it
     counts down through the years as you scroll. Decorative: each row also
     carries its year as visually hidden text. */
  .year-bar {
    position: sticky;
    top: var(--nav-height);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    background: var(--color-bg);
    /* The divider between the nav and the counter. */
    border-top: 1px solid var(--color-border);
    box-shadow: 0 1px 0 transparent;
    transition: box-shadow 0.2s;
  }

  .year-bar.is-stuck {
    box-shadow: 0 1px 0 var(--color-border);
  }

  .year-bar-label,
  .year-bar-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .year-bar-count {
    margin-left: auto;
  }

  .year-bar-year {
    font-size: var(--text-xl);
  }

  /* Gutter timeline, for screens wide enough to have a gutter to put it in.
     Below that, the sticky bar above does the job. */
  .year-rail {
    display: none;
  }

  @media (min-width: 1440px) {
    .year-bar {
      display: none;
    }

    .year-rail {
      --rail-height: 56vh;
      display: block;
      position: fixed;
      top: calc(50% - var(--rail-height) / 2);
      /* 48px left of the content; the script measures the list and sets the
         exact spot, since 100vw counts the scrollbar. */
      left: calc((100vw - var(--max-width)) / 2 - 48px);
      height: var(--rail-height);
      width: 1px;
      z-index: 5;
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    .year-rail.is-visible {
      opacity: 1;
    }

    .row-year-marker {
      left: auto;
      right: calc(100% + 48px + 12px);
      padding-right: 0;
      background: none;
    }

    .year-bracket {
      display: block;
      position: absolute;
      left: -16px;
      width: 5px;
      top: var(--bracket-top, 0px);
      height: var(--bracket-height, 0px);
      border: 1px solid var(--color-text);
      border-right: none;
      opacity: 0;
      pointer-events: none;
      transition: top 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), height 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease;
    }

    .year-bracket.is-visible {
      opacity: 1;
    }
  }

  /* The track fades out toward both ends so it reads as a window onto a
     longer timeline. */
  .rail-window {
    position: absolute;
    inset: 0 -8px;
    overflow: hidden;
    mask-image: linear-gradient(transparent, #000 18%, #000 82%, transparent);
  }

  .rail-track {
    position: absolute;
    top: 50%;
    left: 8px;
    width: 1px;
    height: var(--track-length, 0px);
    background: var(--color-border);
    transform: translateY(calc(var(--track-offset, 0px) * -1));
  }

  .rail-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: var(--track-offset, 0px);
    background: var(--color-text);
  }

  .rail-track :global(.rail-tick) {
    position: absolute;
    left: -3px;
    width: 7px;
    height: 1px;
    background: var(--color-border);
    transition: background-color 0.3s;
  }

  .rail-track :global(.rail-tick.is-passed) {
    background: var(--color-text);
  }

  .rail-marker {
    position: absolute;
    top: 50%;
    left: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-text);
    transform: translateY(-50%);
  }

  /* From the dot on the timeline to the bracket beside the projects. */
  .rail-connector {
    position: absolute;
    top: 50%;
    left: 0;
    width: 32px;
    height: 1px;
    background: var(--color-text);
  }

  .rail-readout {
    position: absolute;
    top: 50%;
    right: 12px;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .rail-year {
    font-size: var(--text-lg);
  }

  .rail-count {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  /* Same frame as the homepage cards: 16:10, cropped to fill. The thumbnail is
     its own link (hidden from assistive tech, since the title link already
     names the project) so a click on the image always lands, even while the
     hover zoom lifts it above the row-wide title link. */
  .row-thumb {
    grid-area: thumb;
    display: block;
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-tag-bg);
  }

  .row-thumb :global(img),
  .row-thumb :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
    transition: transform 0.4s ease;
  }

  .row-description {
    grid-area: description;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  .row-cta {
    grid-area: cta;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-md);
    color: var(--color-text);
    white-space: nowrap;
  }

  .row-cta svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  @media (hover: hover) {
    .project-row:hover .row-cta svg {
      transform: translateX(4px);
    }

    .project-row:hover .row-thumb :global(img),
    .project-row:hover .row-thumb :global(video) {
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-year-marker,
    .year-bracket,
    .year-bar,
    .year-rail,
    .rail-track :global(.rail-tick),
    .row-cta svg,
    .row-thumb :global(img),
    .row-thumb :global(video) {
      transition: none;
    }
  }

  /* Tablet: the link drops under the summary so the three columns keep room. */
  @media (max-width: 1024px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.2fr);
      grid-template-areas:
        "heading thumb description"
        "heading thumb cta";
      grid-template-rows: auto 1fr;
      row-gap: var(--space-4);
    }
  }

  /* Phone: stack name, thumbnail, summary, link. */
  @media (max-width: 768px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "heading"
        "thumb"
        "description"
        "cta";
      grid-template-rows: none;
      gap: var(--space-3);
      padding: var(--space-5) 0;
    }
  }
</style>

<script>
  const filter = document.getElementById("type-filter") as HTMLSelectElement;
  const cards = document.querySelectorAll<HTMLLIElement>(".project-row");
  const list = document.querySelector<HTMLElement>(".project-list");
  const bar = document.querySelector<HTMLElement>("[data-year-bar]");
  const rail = document.querySelector<HTMLElement>("[data-year-rail]");
  const track = document.querySelector<HTMLElement>("[data-rail-track]");
  const bracket = document.querySelector<HTMLElement>("[data-year-bracket]");
  const counters = document.querySelectorAll<HTMLElement>("[data-odometer]");
  const counts = document.querySelectorAll<HTMLElement>("[data-year-count]");
  const nav = document.querySelector<HTMLElement>("nav:not(.breadcrumbs)");
  const wide = window.matchMedia("(min-width: 1440px)");

  // Stick flush under the nav. --nav-height is a round site-wide estimate,
  // so measure the real bar instead and follow it if it changes size.
  if (bar && nav) {
    const pin = () => bar.style.setProperty("top", `${nav.getBoundingClientRect().height}px`);
    pin();
    new ResizeObserver(pin).observe(nav);
  }

  let shownYear = "";
  let ticks: { el: HTMLElement; at: number }[] = [];

  const visibleCards = () => [...cards].filter((card) => !card.classList.contains("hidden"));

  // One tick per year, at the point in the list where that year's first
  // project starts, as a fraction of the list. Rebuilt on filter and resize.
  function buildTicks() {
    if (!track || !list) return;
    ticks.forEach((tick) => tick.el.remove());
    ticks = [];
    const listRect = list.getBoundingClientRect();
    let lastYear = "";
    for (const card of visibleCards()) {
      if (card.dataset.year === lastYear) continue;
      lastYear = card.dataset.year ?? "";
      const el = document.createElement("span");
      el.className = "rail-tick";
      track.append(el);
      ticks.push({ el, at: (card.getBoundingClientRect().top - listRect.top) / listRect.height });
    }
  }

  // The current year belongs to the first row whose bottom is still below the
  // reading line. With the gutter timeline that line is the middle of the
  // screen, where the year sits; with the sticky bar it's a third of the way
  // down the space under the bar, so a year never stays lit while its last
  // row is mostly gone. Read on scroll through rAF, so it stays cheap.
  function update() {
    if (!list) return;
    const visible = visibleCards();
    const listRect = list.getBoundingClientRect();
    let line: number;

    if (wide.matches && rail && track) {
      line = window.innerHeight / 2;
      rail.style.left = `${listRect.left - 48}px`;
      const length = rail.clientHeight * 1.5;
      const progress = Math.min(1, Math.max(0, (line - listRect.top) / listRect.height));
      rail.style.setProperty("--track-length", `${length}px`);
      rail.style.setProperty("--track-offset", `${progress * length}px`);
      ticks.forEach((tick) => {
        tick.el.style.top = `${tick.at * length}px`;
        tick.el.classList.toggle("is-passed", tick.at <= progress + 0.0005);
      });
      rail.classList.toggle(
        "is-visible",
        visible.length > 0 && listRect.top < window.innerHeight * 0.9 && listRect.bottom > window.innerHeight * 0.2,
      );
    } else {
      if (!bar) return;
      const barRect = bar.getBoundingClientRect();
      line = barRect.bottom + (window.innerHeight - barRect.bottom) / 3;
      const navOffset = parseFloat(getComputedStyle(bar).top) || 0;
      bar.classList.toggle("is-stuck", barRect.top <= navOffset + 0.5);
    }

    // At the very bottom the last rows may never reach the line, so hand the
    // counter to the last project rather than leaving its year dimmed.
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    const current = atBottom
      ? visible.at(-1)
      : visible.find((card) => card.getBoundingClientRect().bottom > line) ?? visible.at(-1);
    const year = current?.dataset.year;
    if (!year) return;

    const group = visible.filter((card) => card.dataset.year === year);

    // Year labels: on the first visible project of each year, hidden once
    // they pass the reading line, where their year takes over the counter.
    let lastYear = "";
    cards.forEach((card) => {
      const isStart = !card.classList.contains("hidden") && card.dataset.year !== lastYear;
      if (!card.classList.contains("hidden")) lastYear = card.dataset.year ?? "";
      card.classList.toggle("is-year-start", isStart);
      const marker = card.querySelector(".row-year-marker");
      marker?.classList.toggle("is-merged", card.getBoundingClientRect().top < line);
    });

    // The bracket spans the current year's projects, divider to divider,
    // pulled in a little so neighbouring years' brackets never touch.
    if (bracket && group.length) {
      const first = group[0];
      const last = group[group.length - 1];
      const inset = 12;
      bracket.style.setProperty("--bracket-top", `${first.offsetTop + inset}px`);
      bracket.style.setProperty("--bracket-height", `${last.offsetTop + last.offsetHeight - first.offsetTop - inset * 2}px`);
      bracket.classList.toggle("is-visible", !!rail?.classList.contains("is-visible"));
    }

    const total = group.length;
    counts.forEach((el) => (el.textContent = `${total} ${total === 1 ? "project" : "projects"}`));

    if (year === shownYear) return;
    shownYear = year;
    counters.forEach((counter) => {
      const digits = counter.querySelectorAll<HTMLElement>(".odometer-digit");
      year.split("").forEach((digit, i) => digits[i]?.style.setProperty("--d", digit));
    });
  }

  let ticking = false;
  const requestUpdate = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      update();
    });
  };

  const rebuild = () => {
    buildTicks();
    update();
  };

  window.addEventListener("scroll", requestUpdate, { passive: true });
  window.addEventListener("resize", rebuild);
  wide.addEventListener("change", rebuild);
  // Thumbnails and fonts settle row heights after first paint.
  if (list) new ResizeObserver(rebuild).observe(list);
  rebuild();

  filter.addEventListener("change", () => {
    const value = filter.value;
    cards.forEach((card) => {
      if (value === "all") {
        card.classList.remove("hidden");
      } else {
        const tags = card.dataset.tags?.split(",") ?? [];
        card.classList.toggle("hidden", !tags.includes(value));
      }
    });
    rebuild();
  });
</script>
