---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/projects";

const allTags = [...new Set(projects.flatMap((p) => p.tags))];
---

<Layout title="Work — Ryan Sheridan" description="Selected design work by Ryan Sheridan — brand systems, marketing sites, and design infrastructure.">
  <Nav />
  <main class="work-page">
    <div class="work-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Work</span>
      </nav>
      <h1>All work</h1>

      <div class="filter-row">
        <label class="filter-label" for="type-filter">Project Types</label>
        <div class="select-wrapper">
          <select id="type-filter">
            <option value="all">All</option>
            {allTags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
          <svg class="select-chevron" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
            />
          </svg>
        </div>
      </div>

      <div class="project-list">
        {
          projects.map((project, i) => (
            <a
              href={`/work/${project.slug}`}
              class="project-row"
              data-tags={project.tags.join(",")}
            >
              <div class="row-grid">
                <div class="cell cell-number">{String(i + 1).padStart(2, "0")}</div>
                <div class="cell cell-image">
                  {project.thumbnail && <img
                    src={project.thumbnail}
                    alt={project.title}
                    loading="lazy"
                  />}
                </div>
                <div class="cell cell-info">
                  <h3>{project.title}</h3>
                  <div class="badge-list tags">
                    {project.tags.map((tag) => <span class="badge">{tag}</span>)}
                  </div>
                </div>
                <div class="cell cell-client">{project.client}</div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: 80px var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .breadcrumbs {
    margin-bottom: 32px;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--color-text);
  }

  .breadcrumbs .sep {
    color: var(--color-border);
  }

  .breadcrumbs .current {
    color: var(--color-text);
  }

  h1 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
  }

  .filter-row {
    margin-bottom: 40px;
    max-width: 360px;
  }

  .filter-label {
    display: block;
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .select-wrapper {
    position: relative;
  }

  select {
    width: 100%;
    appearance: none;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 14px;
    padding-right: 36px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
  }

  select:focus {
    border-color: #999;
  }

  .select-chevron {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .project-list {
    padding-bottom: 80px;
  }

  .project-row {
    display: block;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.15s;
  }

  .project-row:first-child {
    border-top: 1px solid var(--color-border);
  }

  .project-row.hidden {
    display: none;
  }

  @media (hover: hover) {
    .project-row:hover {
      background: var(--color-tag-bg);
    }

    .project-row:hover .cell-image img {
      opacity: 0.85;
    }
  }

  .row-grid {
    display: grid;
    grid-template-columns: 56px 160px 1fr 180px;
    align-items: center;
    gap: 32px;
    padding: 28px 0;
  }

  .cell {
    min-width: 0;
  }

  .cell-number {
    font-size: 12px;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .cell-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-tag-bg);
    border-left: 1px solid var(--color-border);
    padding-left: 20px;
  }

  .cell-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s;
  }

  .cell-info {
    border-left: 1px solid var(--color-border);
    padding-left: 20px;
  }

  .cell-info h3 {
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .cell-client {
    font-size: 13px;
    color: var(--color-text-muted);
    text-align: right;
    border-left: 1px solid var(--color-border);
    padding-left: 20px;
  }

  @media (max-width: 768px) {
    .row-grid {
      grid-template-columns: 32px 1fr;
      grid-template-areas:
        "number image"
        "info info";
      row-gap: 16px;
      padding: 24px 0;
    }

    .cell-number {
      grid-area: number;
    }

    .cell-image {
      grid-area: image;
      aspect-ratio: 16 / 10;
      border-left: none;
      padding-left: 0;
    }

    .cell-info {
      grid-area: info;
      border-left: none;
      padding-left: 0;
    }

    .cell-client {
      display: none;
    }
  }
</style>

<script>
  const filter = document.getElementById("type-filter") as HTMLSelectElement;
  const cards = document.querySelectorAll<HTMLAnchorElement>(".project-row");

  filter.addEventListener("change", () => {
    const value = filter.value;
    cards.forEach((card) => {
      if (value === "all") {
        card.classList.remove("hidden");
      } else {
        const tags = card.dataset.tags?.split(",") ?? [];
        card.classList.toggle("hidden", !tags.includes(value));
      }
    });
  });
</script>
