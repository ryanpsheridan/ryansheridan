---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import { projects } from "../../data/projects";
import { SITE_URL, WEBSITE_ID, breadcrumbSchema } from "../../data/schema";

// Newest first. Array sort is stable, so projects from the same year keep
// their order from projects.ts.
const sortedProjects = [...projects].sort((a, b) => b.year - a.year);


// One group per year, newest first, each with its own header.
const years = [...new Set(sortedProjects.map((p) => p.year))];
const yearGroups = years.map((year) => ({
  year,
  projects: sortedProjects.filter((p) => p.year === year),
}));
const projectCount = (n: number) => `${n} ${n === 1 ? "project" : "projects"}`;

// Every tag in use, most common first, ties alphabetical.
const tagCounts = new Map<string, number>();
sortedProjects.forEach((p) => p.tags.forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)));
const tags = [...tagCounts]
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));

const schema = [
  {
    "@type": "CollectionPage",
    name: "All work",
    isPartOf: { "@id": WEBSITE_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: sortedProjects.map((project, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE_URL}/work/${project.slug}`,
        name: project.title,
      })),
    },
  },
  breadcrumbSchema([{ name: "Work", path: "/work" }]),
];
---

<Layout
  title="Work — Ryan Sheridan"
  description="Case studies by Ryan Sheridan: multi-brand design systems, brand identities, Webflow and Makeswift websites, illustration, and AI design workflows."
  schema={schema}
  noindex
>
  <Nav />
  <main id="main" class="work-page">
    <div class="work-inner">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Work" }]} />
      <h1>All work</h1>

      {/* Filter by discipline. Buttons rather than links: they only narrow
          what is already on the page. The choice also lands in ?tag= so a
          filtered view can be shared. */}
      <div class="work-filter" role="group" aria-label="Filter projects by type">
        <div class="filter-track">
          <button type="button" aria-pressed="true" data-filter="">
            <span class="filter-label">All</span> <span class="filter-count">{sortedProjects.length}</span>
          </button>
          {
            tags.map(({ tag, count }) => (
              <button type="button" aria-pressed="false" data-filter={tag}>
                <span class="filter-label">{tag}</span> <span class="filter-count">{count}</span>
              </button>
            ))
          }
        </div>
      </div>
      <p class="visually-hidden" aria-live="polite" data-filter-status></p>

      {/* Each year's header sits just above its projects and sticks under the
          nav while that year is on screen. The next year's header comes up
          from below and pushes it out, because each one only sticks within its
          own group. Once stuck, the rule under it fills as you read through
          that year. */}
      <div class="year-groups">
        {
          yearGroups.map((group) => (
            <section class="year-group" data-year-group={group.year}>
              <div class="year-bar" data-year-bar aria-hidden="true">
                <span class="year-bar-year">{group.year}</span>
                <span class="year-bar-count" data-year-count>{projectCount(group.projects.length)}</span>
                <span class="year-bar-progress" data-year-progress></span>
              </div>
              <ul class="project-grid">
                {
                  group.projects.map((project) => (
                    <li class="project-card" data-year={project.year} data-tags={project.tags.join("|")}>
                      <a href={`/work/${project.slug}`} class="card-thumb" tabindex="-1" aria-hidden="true">
                        {project.thumbnail && <Media src={project.thumbnail} alt="" />}
                        <span class="card-arrow">
                          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 14 14 6M7 6h7v7" />
                          </svg>
                        </span>
                      </a>
                      <p class="card-client overline">{project.client}</p>
                      <h2>
                        <a href={`/work/${project.slug}`} class="card-link">{project.title}</a>
                      </h2>
                      <p class="visually-hidden"><time datetime={String(project.year)}>{project.year}</time></p>
                      <p class="card-description">{project.description}</p>
                      <div class="badge-list">
                        {project.tags.map((tag) => <span class="badge">{tag}</span>)}
                      </div>
                    </li>
                  ))
                }
              </ul>
            </section>
          ))
        }
      </div>
      <p class="work-empty" data-filter-empty hidden>Nothing here yet.</p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: var(--page-top) var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  h1 {
    font-size: var(--text-h2);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-5);
  }

  /* Filter. Quiet mono labels in a row: the chosen one goes dark with an
     underline, the rest stay muted. Wraps on wide screens and scrolls
     sideways on phones, so it never pushes the page wider than the screen. */
  .work-filter {
    margin-bottom: var(--space-6);
  }

  .filter-track {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .filter-track button {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: var(--space-1) 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .filter-label {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .filter-track button:hover {
    color: var(--color-text);
  }

  .filter-track button[aria-pressed="true"] {
    color: var(--color-text);
  }

  .filter-track button[aria-pressed="true"] .filter-label {
    text-decoration-color: currentColor;
  }

  .filter-track button:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  /* Counts ride up like a footnote. */
  .filter-count {
    display: inline-block;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    transform: translateY(-0.35em);
  }

  .year-groups {
    padding-bottom: 80px;
  }

  .year-group + .year-group {
    margin-top: var(--space-7);
  }

  .year-group[hidden] {
    display: none;
  }

  /* Year headers. Each sticks under the nav only within its own group, so
     as one year ends its header scrolls away and the next year's header,
     already on its way up, takes its place. Decorative: each card also
     carries its year as visually hidden text. */
  .year-bar {
    position: sticky;
    top: var(--nav-height);
    z-index: var(--z-sticky);
    display: flex;
    align-items: baseline;
    padding: var(--space-2) 0;
    margin-bottom: var(--space-5);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .year-bar-year {
    font-size: var(--text-l);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .year-bar-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1;
  }

  /* Reading progress through the year: a darker rule that grows over the
     hairline while the header is stuck, and fades when it lets go. */
  .year-bar-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--color-text);
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .year-bar.is-stuck .year-bar-progress {
    opacity: 1;
  }

  /* Three across on desktop, two on tablets, one on phones. */
  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7) var(--space-5);
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .project-card[hidden] {
    display: none;
  }

  /* Cards that come back after a filter change rise into place, one after
     another. */
  .project-card.is-entering {
    animation: card-in var(--duration-slower) var(--ease-emphasized) both;
    animation-delay: calc(var(--i, 0) * 50ms);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* Same frame as the homepage cards: 16:10, cropped to fill. The thumbnail
     is its own link (hidden from assistive tech, since the title link already
     names the project) so a click on the image always lands, even while the
     hover zoom lifts it above the card-wide title link. */
  .card-thumb {
    display: block;
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-bottom: var(--space-4);
    background: var(--color-surface);
  }

  .card-thumb :global(img),
  .card-thumb :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .card-arrow {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--color-text);
    background: var(--color-bg);
    border-radius: var(--radius-full);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-moderate) var(--ease-emphasized);
  }

  .card-arrow svg {
    width: 16px;
    height: 16px;
  }

  .card-client {
    margin: 0 0 var(--space-1);
  }

  .project-card h2 {
    font-size: var(--text-h5);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin: 0;
  }

  .card-link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The title link covers the whole card, so the thumbnail and text are click
     targets too, without nesting everything inside one long link. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card-link:focus-visible::after {
    outline: 2px solid var(--color-text);
    outline-offset: 8px;
  }

  .card-description {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--text-s);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  /* Badges sit at the foot of each card, so they line up across a row. */
  .project-card .badge-list {
    margin-top: auto;
  }

  .work-empty {
    padding: var(--space-7) 0 var(--space-8);
    color: var(--color-text-muted);
  }

  @media (hover: hover) {
    .project-card:hover .card-thumb :global(img),
    .project-card:hover .card-thumb :global(video) {
      transform: scale(1.03);
    }

    .project-card:hover .card-arrow {
      opacity: 1;
      transform: none;
    }
  }

  .project-card:focus-within .card-arrow {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-arrow,
    .card-thumb :global(img),
    .card-thumb :global(video) {
      transition: none;
    }

    .project-card.is-entering {
      animation: none;
    }
  }

  @media (max-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-5);
    }
  }

  @media (max-width: 640px) {
    .work-filter {
      margin: 0 calc(var(--page-padding) * -1) var(--space-5);
      padding: 0 var(--page-padding);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .work-filter::-webkit-scrollbar {
      display: none;
    }

    .filter-track {
      flex-wrap: nowrap;
      width: max-content;
    }

    .project-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>

<script>
  const groups = [...document.querySelectorAll<HTMLElement>("[data-year-group]")];
  const bars = document.querySelectorAll<HTMLElement>("[data-year-bar]");
  const nav = document.querySelector<HTMLElement>("nav:not([aria-label=\"Breadcrumb\"])");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Stick flush under the nav. --nav-height is a round site-wide estimate,
  // so measure the real bar instead and follow it if it changes size.
  let navHeight = 0;
  if (nav) {
    const pin = () => {
      navHeight = nav.getBoundingClientRect().height;
      bars.forEach((bar) => bar.style.setProperty("top", `${navHeight}px`));
      update();
    };
    new ResizeObserver(pin).observe(nav);
  }

  // A header is stuck once its group's top has scrolled up past the nav.
  // Progress runs from that moment until the group's bottom reaches the
  // header's bottom edge, which is when the next year starts pushing it out.
  function update() {
    groups.forEach((group) => {
      const bar = group.querySelector<HTMLElement>("[data-year-bar]");
      const fill = group.querySelector<HTMLElement>("[data-year-progress]");
      if (!bar || !fill || group.hidden) return;
      const rect = group.getBoundingClientRect();
      const stuck = rect.top < navHeight - 0.5;
      bar.classList.toggle("is-stuck", stuck);
      const travel = rect.height - bar.offsetHeight;
      const progress = travel > 0 ? (navHeight - rect.top) / travel : 0;
      fill.style.setProperty("--progress", String(Math.min(1, Math.max(0, progress))));
    });
  }

  let ticking = false;
  const schedule = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      update();
    });
  };
  window.addEventListener("scroll", schedule, { passive: true });
  window.addEventListener("resize", schedule);
  update();

  // Filter
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const cards = [...document.querySelectorAll<HTMLElement>(".project-card")];
  const status = document.querySelector<HTMLElement>("[data-filter-status]");
  const empty = document.querySelector<HTMLElement>("[data-filter-empty]");
  const plural = (n: number) => `${n} ${n === 1 ? "project" : "projects"}`;

  function applyFilter(tag: string, animate: boolean) {
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === tag)));

    let shown = 0;
    let order = 0;
    cards.forEach((card) => {
      const match = !tag || (card.dataset.tags ?? "").split("|").includes(tag);
      card.hidden = !match;
      card.classList.remove("is-entering");
      if (!match) return;
      shown++;
      if (animate && !reduceMotion.matches) {
        card.style.setProperty("--i", String(Math.min(order++, 8)));
        // Restart the entrance on every change.
        void card.offsetWidth;
        card.classList.add("is-entering");
      }
    });

    groups.forEach((group) => {
      const visible = group.querySelectorAll(".project-card:not([hidden])").length;
      group.hidden = visible === 0;
      const count = group.querySelector<HTMLElement>("[data-year-count]");
      if (count) count.textContent = plural(visible);
    });

    if (empty) empty.hidden = shown > 0;
    if (status && animate) status.textContent = tag ? `${plural(shown)} tagged ${tag}` : `All ${plural(shown)}`;

    const url = new URL(window.location.href);
    if (tag) url.searchParams.set("tag", tag);
    else url.searchParams.delete("tag");
    history.replaceState(history.state, "", url);
    update();
  }

  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      const tag = button.dataset.filter ?? "";
      applyFilter(tag, true);
      // Bring the first result back into view when the filter has scrolled
      // out of sight behind the sticky headers.
      const filter = document.querySelector(".work-filter");
      if (filter && filter.getBoundingClientRect().top < 0) {
        filter.scrollIntoView({ behavior: reduceMotion.matches ? "auto" : "smooth", block: "start" });
      }
    }),
  );

  cards.forEach((card) => card.addEventListener("animationend", () => card.classList.remove("is-entering")));

  const initial = new URLSearchParams(window.location.search).get("tag") ?? "";
  if (initial && buttons.some((b) => b.dataset.filter === initial)) applyFilter(initial, false);
</script>
