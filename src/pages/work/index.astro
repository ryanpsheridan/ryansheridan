---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import { projects } from "../../data/projects";
import { SITE_URL, WEBSITE_ID, breadcrumbSchema } from "../../data/schema";

// Newest first. Array sort is stable, so projects from the same year keep
// their order from projects.ts.
const sortedProjects = [...projects].sort((a, b) => b.year - a.year);

const allTags = [...new Set(projects.flatMap((p) => p.tags))];

// The counter renders with the newest year already dialed in, so it reads
// correctly before the script runs (or if it never does).
const firstYear = sortedProjects[0]?.year ?? new Date().getFullYear();
const firstYearCount = sortedProjects.filter((p) => p.year === firstYear).length;
const projectCount = (n: number) => `${n} ${n === 1 ? "project" : "projects"}`;

const schema = [
  {
    "@type": "CollectionPage",
    name: "All work",
    isPartOf: { "@id": WEBSITE_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: sortedProjects.map((project, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE_URL}/work/${project.slug}`,
        name: project.title,
      })),
    },
  },
  breadcrumbSchema([{ name: "Work", path: "/work" }]),
];
---

<Layout
  title="Work — Ryan Sheridan"
  description="Case studies by Ryan Sheridan: multi-brand design systems, brand identities, Webflow and Makeswift websites, illustration, and AI design workflows."
  schema={schema}
>
  <Nav />
  <main class="work-page">
    <div class="work-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Work</span>
      </nav>
      <h1>All work</h1>

      <div class="filter-row">
        <label class="filter-label" for="type-filter">Project Types</label>
        <div class="select-wrapper">
          <select id="type-filter">
            <option value="all">All</option>
            {allTags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
          <svg class="select-chevron" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
            />
          </svg>
        </div>
      </div>

      <div class="year-bar" data-year-bar aria-hidden="true">
        <span class="year-bar-label">Year</span>
        <span class="odometer" data-odometer>
          {String(firstYear).split("").map((digit) => (
            <span class="odometer-digit" style={`--d: ${digit}`}>
              <span class="odometer-strip">
                {Array.from({ length: 10 }, (_, n) => <span>{n}</span>)}
              </span>
            </span>
          ))}
        </span>
        <span class="year-bar-count" data-year-count>{projectCount(firstYearCount)}</span>
      </div>

      <ul class="project-list">
        {
          sortedProjects.map((project) => (
            <li class="project-row" data-tags={project.tags.join(",")} data-year={project.year}>
              <div class="row-heading">
                <h2>
                  <a href={`/work/${project.slug}`} class="row-link">{project.title}</a>
                </h2>
                <p class="visually-hidden"><time datetime={String(project.year)}>{project.year}</time></p>
                <div class="badge-list">
                  {project.tags.map((tag) => <span class="badge">{tag}</span>)}
                </div>
              </div>
              <a href={`/work/${project.slug}`} class="row-thumb" tabindex="-1" aria-hidden="true">
                {project.thumbnail && <Media src={project.thumbnail} alt="" />}
              </a>
              <p class="row-description">{project.description}</p>
              <span class="row-cta" aria-hidden="true">
                View project
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 10h12M11 5l5 5-5 5" />
                </svg>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: 80px var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .breadcrumbs {
    margin-bottom: 32px;
    font-family: var(--font-mono);
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--color-text);
  }

  .breadcrumbs .sep {
    color: var(--color-border);
  }

  .breadcrumbs .current {
    color: var(--color-text);
  }

  h1 {
    font-size: clamp(24px, 1.2rem + 1vw, 40px);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
  }

  .filter-row {
    margin-bottom: 40px;
    max-width: 360px;
  }

  .filter-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .select-wrapper {
    position: relative;
  }

  select {
    width: 100%;
    appearance: none;
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 10px 14px;
    padding-right: 36px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
  }

  select:focus {
    border-color: #999;
  }

  .select-chevron {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0 0 80px;
  }

  /* One project per row, split by a hairline: name, thumbnail, summary, link. */
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2.2fr) minmax(0, 3fr) auto;
    grid-template-areas: "heading thumb description cta";
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
  }

  .project-row.hidden {
    display: none;
  }

  /* Once the counter is running, rows outside its year step back, so it's
     clear which year each project belongs to. Hovering one brings it back. */
  .project-row {
    transition: opacity 0.4s ease;
  }

  .project-row.is-dimmed {
    opacity: 0.3;
  }

  @media (hover: hover) {
    .project-row.is-dimmed:hover {
      opacity: 1;
    }
  }

  .row-heading {
    grid-area: heading;
  }

  .row-heading h2 {
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0 0 var(--space-1);
  }

  .row-link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The title link covers the whole row, so the thumbnail and the CTA are
     click targets too, without nesting everything inside one long link. */
  .row-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .row-link:focus-visible {
    outline: none;
  }

  .row-link:focus-visible::after {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .row-heading h2 + .visually-hidden + .badge-list {
    margin-top: var(--space-3);
  }

  /* Year counter. It sticks under the nav and rolls to the year of whichever
     project is passing beneath it; the rows are sorted newest first, so it
     counts down through the years as you scroll. Decorative: each row also
     carries its year as visually hidden text. */
  .year-bar {
    position: sticky;
    top: var(--nav-height);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    background: var(--color-bg);
    /* The divider between the nav and the counter. */
    border-top: 1px solid var(--color-border);
    box-shadow: 0 1px 0 transparent;
    transition: box-shadow 0.2s;
  }

  .year-bar.is-stuck {
    box-shadow: 0 1px 0 var(--color-border);
  }

  .year-bar-label,
  .year-bar-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .year-bar-count {
    margin-left: auto;
  }

  .odometer {
    display: inline-flex;
    font-size: var(--text-xl);
    font-weight: 300;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .odometer-digit {
    display: block;
    height: 1.2em;
    overflow: hidden;
  }

  .odometer-strip {
    display: flex;
    flex-direction: column;
    transform: translateY(calc(var(--d) * -10%));
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Right-hand digits settle last, like a mechanical counter. */
  .odometer-digit:nth-child(3) .odometer-strip { transition-delay: 0.04s; }
  .odometer-digit:nth-child(4) .odometer-strip { transition-delay: 0.08s; }

  .odometer-strip span {
    display: block;
    height: 1.2em;
  }

  /* Same frame as the homepage cards: 16:10, cropped to fill. The thumbnail is
     its own link (hidden from assistive tech, since the title link already
     names the project) so a click on the image always lands, even while the
     hover zoom lifts it above the row-wide title link. */
  .row-thumb {
    grid-area: thumb;
    display: block;
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-tag-bg);
  }

  .row-thumb :global(img),
  .row-thumb :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
    transition: transform 0.4s ease;
  }

  .row-description {
    grid-area: description;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  .row-cta {
    grid-area: cta;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-md);
    color: var(--color-text);
    white-space: nowrap;
  }

  .row-cta svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  @media (hover: hover) {
    .project-row:hover .row-cta svg {
      transform: translateX(4px);
    }

    .project-row:hover .row-thumb :global(img),
    .project-row:hover .row-thumb :global(video) {
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-row,
    .odometer-strip,
    .year-bar,
    .row-cta svg,
    .row-thumb :global(img),
    .row-thumb :global(video) {
      transition: none;
    }
  }

  /* Tablet: the link drops under the summary so the three columns keep room. */
  @media (max-width: 1024px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.2fr);
      grid-template-areas:
        "heading thumb description"
        "heading thumb cta";
      grid-template-rows: auto 1fr;
      row-gap: var(--space-4);
    }
  }

  /* Phone: stack name, thumbnail, summary, link. */
  @media (max-width: 768px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "heading"
        "thumb"
        "description"
        "cta";
      grid-template-rows: none;
      gap: var(--space-3);
      padding: var(--space-5) 0;
    }
  }
</style>

<script>
  const filter = document.getElementById("type-filter") as HTMLSelectElement;
  const cards = document.querySelectorAll<HTMLLIElement>(".project-row");
  const bar = document.querySelector<HTMLElement>("[data-year-bar]");
  const digits = document.querySelectorAll<HTMLElement>("[data-odometer] .odometer-digit");
  const count = document.querySelector<HTMLElement>("[data-year-count]");
  const nav = document.querySelector<HTMLElement>("nav:not(.breadcrumbs)");

  // Stick flush under the nav. --nav-height is a round site-wide estimate,
  // so measure the real bar instead and follow it if it changes size.
  if (bar && nav) {
    const pin = () => bar.style.setProperty("top", `${nav.getBoundingClientRect().height}px`);
    pin();
    new ResizeObserver(pin).observe(nav);
  }

  let shownYear = "";

  const visibleCards = () => [...cards].filter((card) => !card.classList.contains("hidden"));

  // The current year belongs to the first row whose bottom is still below a
  // reading line a third of the way down the space under the bar. Reading off
  // the bar's own edge would keep a year lit while its last row is mostly gone
  // and everything on screen is dimmed. Read on scroll through rAF, so it
  // stays cheap on long scrolls.
  function updateYear() {
    if (!bar) return;
    const barRect = bar.getBoundingClientRect();
    const line = barRect.bottom + (window.innerHeight - barRect.bottom) / 3;
    const navOffset = parseFloat(getComputedStyle(bar).top) || 0;
    bar.classList.toggle("is-stuck", barRect.top <= navOffset + 0.5);

    const visible = visibleCards();
    // At the very bottom the last rows may never reach the bar, so hand the
    // counter to the last project rather than leaving its year dimmed.
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    const current = atBottom
      ? visible.at(-1)
      : visible.find((card) => card.getBoundingClientRect().bottom > line) ?? visible.at(-1);
    const year = current?.dataset.year;
    if (!year) return;

    visible.forEach((card) => card.classList.toggle("is-dimmed", card.dataset.year !== year));

    const total = visible.filter((card) => card.dataset.year === year).length;
    if (count) count.textContent = `${total} ${total === 1 ? "project" : "projects"}`;

    if (year === shownYear) return;
    shownYear = year;
    year.split("").forEach((digit, i) => digits[i]?.style.setProperty("--d", digit));
  }

  let ticking = false;
  const requestUpdate = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      updateYear();
    });
  };

  window.addEventListener("scroll", requestUpdate, { passive: true });
  window.addEventListener("resize", requestUpdate);
  updateYear();

  filter.addEventListener("change", () => {
    const value = filter.value;
    cards.forEach((card) => {
      if (value === "all") {
        card.classList.remove("hidden");
      } else {
        const tags = card.dataset.tags?.split(",") ?? [];
        card.classList.toggle("hidden", !tags.includes(value));
      }
    });
    updateYear();
  });
</script>
