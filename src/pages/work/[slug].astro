---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/projects";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
};

const { project } = Astro.props;
---

<Layout title={`${project.title} — Ryan Sheridan`}>
  <Nav showBack={true} />
  <main class="project-page">
    <div class="project-inner">
      <header>
        <h1>{project.title}</h1>
        <div class="meta">
          <div class="meta-group">
            <span class="meta-label">Client</span>
            <span class="meta-value">{project.client}</span>
          </div>
          <div class="meta-group">
            <span class="meta-label">Type</span>
            <span class="meta-value">{project.tags.join(", ")}</span>
          </div>
          <div class="meta-group">
            <span class="meta-label">Tools</span>
            <span class="meta-value">{project.tools.join(", ")}</span>
          </div>
        </div>
      </header>

      <div class="hero-image">
        <img src={project.thumbnail} alt={project.title} />
      </div>

      {
        project.sections.map((section) => (
          <section class="content-section">
            {section.heading && <h2>{section.heading}</h2>}
            <div class="body" set:html={section.body} />
          </section>
        ))
      }

      <div class="back-link">
        <a href="/">&larr; Back to all work</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .project-page {
    padding: 80px var(--page-padding) 0;
  }

  .project-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  header {
    margin-bottom: 40px;
  }

  h1 {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }

  .meta {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }

  .meta-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .meta-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .meta-value {
    font-size: 14px;
  }

  .hero-image {
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 56px;
  }

  .hero-image img {
    width: 100%;
    display: block;
  }

  .content-section {
    margin-bottom: 56px;
  }

  h2 {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
  }

  .body {
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-text);
  }

  .body :global(p) {
    margin-bottom: 16px;
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }

  .body :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .body :global(a:hover) {
    color: var(--color-text-muted);
  }

  .body :global(strong) {
    font-weight: 600;
  }

  .body :global(blockquote) {
    border-left: 2px solid var(--color-border);
    padding-left: 20px;
    margin: 32px 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .body :global(blockquote p) {
    margin-bottom: 0;
  }

  .body :global(h3) {
    font-size: 17px;
    font-weight: 600;
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .body :global(img) {
    width: 100%;
    border-radius: 4px;
    margin: 24px 0;
  }

  .body :global(em) {
    color: var(--color-text-muted);
  }

  .back-link {
    padding: 40px 0;
    border-top: 1px solid var(--color-border);
  }

  .back-link a {
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .back-link a:hover {
    color: var(--color-text);
  }

  @media (max-width: 540px) {
    .project-page {
      padding: 60px var(--page-padding) 0;
    }
    .meta {
      gap: 20px;
    }
  }
</style>
