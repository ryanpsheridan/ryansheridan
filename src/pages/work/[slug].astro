  .pathway-option strong {
    font-weight: var(--weight-medium);
  }

  .pathway-option small {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .pathway-option.is-chosen {
    background: var(--color-accent-bg);
    border-color: var(--color-link);
    box-shadow: 0 0 0 1px var(--color-link);
  }

  .pathway-option.is-other {
    opacity: 0.6;
  }

  /* The drop from the chosen option, centred under the left column. */
  .pathway-link {
    width: var(--border-width);
    height: var(--space-6);
    margin-left: calc(25% - var(--space-3) / 4);
    background: var(--color-link);
    transform-origin: top;
    transition: transform var(--duration-moderate) var(--pathway-ease);
  }

  .pathway-panel {
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-accent-border);
    border-radius: var(--radius-lg);
    transition:
      opacity var(--duration-moderate) var(--pathway-ease),
      transform var(--duration-moderate) var(--pathway-ease);
  }

  .pathway-col {
    transition:
      opacity var(--duration-moderate) var(--pathway-ease),
      transform var(--duration-moderate) var(--pathway-ease);
  }

  .pathway figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Armed by script before it scrolls into view: start unselected, then
     play the choice and the reveal in sequence once it's on screen. */
  .pathway.is-armed .pathway-option {
    opacity: 0;
    transform: translateY(var(--space-2));
  }

  .pathway.is-armed .pathway-option.is-chosen {
    background: var(--color-surface);
    border-color: var(--color-border);
    box-shadow: none;
  }

  .pathway.is-armed .pathway-link {
    transform: scaleY(0);
  }

  .pathway.is-armed .pathway-panel,
  .pathway.is-armed .pathway-col {
    opacity: 0;
    transform: translateY(var(--space-3));
  }

  .pathway.is-armed.is-revealed .pathway-option {
    opacity: 1;
    transform: none;
  }

  .pathway.is-armed.is-revealed .pathway-option.is-other {
    opacity: 0.6;
  }

  .pathway.is-armed.is-revealed .pathway-option.is-chosen {
    background: var(--color-accent-bg);
    border-color: var(--color-link);
    box-shadow: 0 0 0 1px var(--color-link);
    transition-delay: 0s, 0s, 0.9s, 0.9s, 0.9s;
  }

  .pathway.is-armed.is-revealed .pathway-link {
    transform: none;
    transition-delay: 1.4s;
  }

  .pathway.is-armed.is-revealed .pathway-panel {
    opacity: 1;
    transform: none;
    transition-delay: 1.7s;
  }

  .pathway.is-armed.is-revealed .pathway-col {
    opacity: 1;
    transform: none;
  }

  .pathway.is-armed.is-revealed .pathway-col:nth-child(1) {
    transition-delay: 2s;
  }

  .pathway.is-armed.is-revealed .pathway-col:nth-child(2) {
    transition-delay: 2.25s;
  }

  @media (max-width: 640px) {
    .pathway-panel {
      padding: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pathway *,
    .pathway-link {
      transition: none !important;
    }
  }

  /* ---------- Copy beside a narrow image ---------- */

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: var(--space-6);
    align-items: start;
  }

  .split-image {
    margin: 0;
  }

  .split-image :global(img) {
    width: 100%;
    display: block;
    border: var(--border-width) solid var(--color-border);
  }

  @media (max-width: 640px) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .split-image {
      max-width: 13rem;
    }
  }

  /* ---------- Flow diagram ---------- */

  .flow {
    --flow-line: var(--color-border-strong);
    margin: 0 0 var(--space-6);
    max-width: 40rem;
  }

  .flow-node {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-align: center;
    font-size: var(--text-s);
    font-weight: var(--weight-medium);
    line-height: 1.35;
    color: var(--color-text);
  }

  .flow-node small {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
  }

  .flow-question {
    max-width: 16rem;
    margin: 0 auto;
  }

  /* Stem from the question, a bar across, and a drop into the middle of
     each column. Drawn for two columns, the only split in use. */
  .flow-split {
    position: relative;
    height: var(--space-5);
    background:
      linear-gradient(var(--flow-line), var(--flow-line)) 50% 0 / var(--border-width) 50% no-repeat,
      linear-gradient(var(--flow-line), var(--flow-line)) 50% 50% / calc(50% + var(--space-3) / 2) var(--border-width) no-repeat;
  }

  .flow-split::before,
  .flow-split::after {
    content: "";
    position: absolute;
    top: 50%;
    bottom: 0;
    width: var(--border-width);
    background: var(--flow-line);
  }

  .flow-split::before {
    left: calc(25% - var(--space-3) / 4);
  }

  .flow-split::after {
    right: calc(25% - var(--space-3) / 4);
  }

  .flow-cols {
    display: grid;
    grid-template-columns: repeat(var(--flow-cols), 1fr);
    column-gap: var(--space-3);
  }

  /* Each column shares the grid's rows, so titles, steps and results line
     up across columns even when one label wraps and its neighbour doesn't. */
  .flow-col {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
  }

  .flow-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .flow-step {
    flex: 1;
  }

  .flow-col.is-accent .flow-step {
    background: var(--color-accent-bg);
    border-color: var(--color-accent-border);
  }

  .flow-result {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: var(--color-bg);
    border-color: var(--color-border-strong);
  }

  .flow-arrow {
    height: var(--space-5);
    background: linear-gradient(var(--flow-line), var(--flow-line)) 50% 0 / var(--border-width) 100% no-repeat;
  }

  .flow figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .back-link-wrapper {
    margin-top: var(--space-6);
    padding: var(--space-5) 0;
    border-top: var(--border-width) solid var(--color-border);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: var(--text-s);
  }

  @media (max-width: 1024px) {
    .project-layout {
      flex-direction: column;
      gap: var(--space-6);
    }

    .project-sidebar {
      order: -1;
      width: 100%;
    }

    .sidebar-inner {
      position: static;
      flex-direction: column;
      gap: var(--space-5);
      padding-top: 0;
