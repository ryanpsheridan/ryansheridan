</style>

<script>
  const lightbox = document.getElementById("lightbox")!;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;

  const lightboxClose = lightbox.querySelector<HTMLButtonElement>(".lightbox-close")!;
  let lightboxReturn: HTMLElement | null = null;

  // A dialog: inert while closed, focus on its close button while open, and
  // back where it came from when it closes.
  document.querySelectorAll<HTMLImageElement>(".lightbox-trigger").forEach((img) => {
    img.addEventListener("click", () => {
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightboxReturn = document.activeElement as HTMLElement | null;
      lightbox.inert = false;
      lightbox.classList.add("open");
      document.body.style.overflow = "hidden";
      lightboxClose.focus();
    });
  });

  function closeLightbox() {
    if (!lightbox.classList.contains("open")) return;
    lightbox.classList.remove("open");
    lightbox.inert = true;
    document.body.style.overflow = "";
    lightboxReturn?.focus();
  }

  lightbox.addEventListener("click", closeLightbox);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const count = carousel.querySelector<HTMLElement>("[data-carousel-count]");
    if (!track || !prev || !next || !count) return;

    const items = Array.from(track.querySelectorAll<HTMLElement>(".carousel-item"));
    if (!items.length) return;

    const pad = (n: number) => String(n).padStart(2, "0");

    // Step by a whole slide, gap included, so snapping stays aligned.
    const step = () => {
      if (items.length < 2) return track.clientWidth;
      return items[1].offsetLeft - items[0].offsetLeft;
    };

    const update = () => {
      const current = Math.round(track.scrollLeft / step());
      const maxScroll = track.scrollWidth - track.clientWidth;
      count.textContent = `${pad(Math.min(current + 1, items.length))} / ${pad(items.length)}`;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= maxScroll - 1;
    };

    prev.addEventListener("click", () => track.scrollBy({ left: -step() }));
    next.addEventListener("click", () => track.scrollBy({ left: step() }));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });

  document.querySelectorAll<HTMLElement>(".compare-block").forEach((block) => {
    const tabs = block.querySelectorAll<HTMLButtonElement>(".compare-tab");
    const panes = block.querySelectorAll<HTMLElement>(".compare-pane");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.tab;
        tabs.forEach((t) => t.setAttribute("aria-pressed", String(t === tab)));
        panes.forEach((p) => p.classList.toggle("is-active", p.dataset.pane === target));
      });
    });
  });
</script>

<script>
  // Plays each pathway diagram once as it comes into view. Without this
  // script, or with reduced motion, the settled state shows from the start.
  const pathways = document.querySelectorAll<HTMLElement>("[data-pathway]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (pathways.length && !reduce && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-revealed");
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.35 },
    );
    for (const el of pathways) {
      el.classList.add("is-armed");
      io.observe(el);
    }
  }
</script>
