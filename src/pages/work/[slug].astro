---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/projects";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
};

const { project } = Astro.props;
---

<Layout title={`${project.title} — Ryan Sheridan`}>
  <Nav />
  <main class="project-page">
    <div class="project-header">
      <h1>{project.title}</h1>

      <div class="meta">
        <div class="meta-group">
          <span class="meta-label">Client / Company</span>
          <div class="meta-pills">
            <span class="pill">{project.client}</span>
          </div>
        </div>
        <div class="meta-group">
          <span class="meta-label">Project type</span>
          <div class="meta-pills">
            {project.tags.map((tag) => <span class="pill">{tag}</span>)}
          </div>
        </div>
        <div class="meta-group">
          <span class="meta-label">Tools</span>
          <div class="meta-pills">
            {project.tools.map((tool) => <span class="pill">{tool}</span>)}
          </div>
        </div>
      </div>
    </div>

    <div class="hero-image">
      <img src={project.thumbnail} alt={project.title} />
    </div>

    <div class="project-content">
      {
        project.sections.map((section) => (
          <section class="content-section">
            {section.heading && <h2>{section.heading}</h2>}
            <div class="body" set:html={section.body} />
          </section>
        ))
      }
    </div>

    <div class="back-link-wrapper">
      <a href="/work" class="back-link">&larr; All work</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .project-page {
    padding: 80px var(--page-padding) 0;
  }

  .project-header {
    max-width: var(--max-width);
    margin: 0 auto 48px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 400;
    letter-spacing: -0.03em;
    margin-bottom: 40px;
  }

  .meta {
    display: flex;
    gap: 64px;
    flex-wrap: wrap;
  }

  .meta-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .meta-label {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .meta-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    font-size: 13px;
    font-weight: 400;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 99px;
    color: var(--color-text);
  }

  .hero-image {
    max-width: var(--max-width);
    margin: 0 auto 64px;
    border-radius: 16px;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    display: block;
  }

  .project-content {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .content-section {
    margin-bottom: 56px;
  }

  h2 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }

  .body {
    font-size: 16px;
    line-height: 1.8;
    color: var(--color-text);
  }

  .body :global(p) {
    margin-bottom: 18px;
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }

  .body :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border);
  }

  .body :global(a:hover) {
    text-decoration-color: var(--color-text);
  }

  .body :global(strong) {
    font-weight: 600;
  }

  .body :global(blockquote) {
    border-left: 2px solid var(--color-border);
    padding-left: 24px;
    margin: 36px 0;
    color: var(--color-text-muted);
    font-style: italic;
    font-size: 17px;
  }

  .body :global(blockquote p) {
    margin-bottom: 0;
  }

  .body :global(h3) {
    font-size: 18px;
    font-weight: 600;
    margin-top: 40px;
    margin-bottom: 16px;
  }

  .body :global(img) {
    width: 100%;
    border-radius: 8px;
    margin: 28px 0;
  }

  .body :global(em) {
    color: var(--color-text-muted);
  }

  .back-link-wrapper {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 40px 0;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .meta {
      gap: 28px;
    }
  }
</style>
