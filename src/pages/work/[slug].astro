---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import { projects } from "../../data/projects";
import type { GetStaticPaths } from "astro";
import { breadcrumbSchema, projectSchema } from "../../data/schema";

export const getStaticPaths: GetStaticPaths = () => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
};

const { project } = Astro.props;

const schema = [
  projectSchema(project),
  breadcrumbSchema([
    { name: "Work", path: "/work" },
    { name: project.title, path: `/work/${project.slug}` },
  ]),
];
---

<Layout
  title={`${project.title} — Ryan Sheridan`}
  description={project.description}
  ogImage={project.ogImage ?? project.thumbnail}
  ogImageAlt={project.title}
  ogType="article"
  schema={schema}
  noindex
>
  <Nav />
  <main id="main" class="project-page">
    <Breadcrumbs
      class="page-crumbs"
      items={[{ label: "Home", href: "/" }, { label: "Work", href: "/work" }, { label: project.title }]}
    />

    <h1>{project.title}</h1>

    <div class="project-layout">
      <div class="project-main">
        {project.thumbnail && (
          <div class="hero-image">
            <Media src={project.thumbnail} alt={project.title} loading="eager" />
          </div>
        )}

        <div class="project-content">
          {
            project.content.map((block) => {
              if (block.type === "text") {
                return (
                  <section class="content-section">
                    {block.heading && <h2>{block.heading}</h2>}
                    {block.body && <div class="prose" set:html={block.body} />}
                  </section>
                );
              }

              if (block.type === "divider") {
                return <hr class="content-divider" />;
              }

              if (block.type === "imageGrid") {
                return (
                  <div class:list={["image-grid", { "is-framed": block.framed, "is-side-by-side": block.sideBySide }]}>
                    {block.images.map((img) => {
                      const src = typeof img === "string" ? img : img.src;
                      const caption = typeof img === "string" ? undefined : img.caption;
                      const alt = typeof img === "string" ? undefined : img.alt;
                      return (
                        <figure class="image-item">
                          {caption && <figcaption>{caption}</figcaption>}
                          <Media src={src} alt={alt ?? caption ?? ""} class="lightbox-trigger" />
                        </figure>
                      );
                    })}
                  </div>
                );
              }

              if (block.type === "carousel") {
                const perView = block.perView ?? 3;
                return (
                  <div
                    class:list={["carousel", { "is-contained": block.contain }]}
                    data-carousel
                    data-per-view={perView}
                  >
                    <div
                      class="carousel-track"
                      data-carousel-track
                      style={`--per-view: ${perView}${block.ratio ? `; --carousel-ratio: ${block.ratio}` : ""}`}
                      tabindex="0"
                      role="group"
                      aria-label="Photo carousel"
                    >
                      {block.images.map((img) => {
                        const src = typeof img === "string" ? img : img.src;
                        const caption = typeof img === "string" ? undefined : img.caption;
                        const alt = typeof img === "string" ? undefined : img.alt;
                        return (
                          <figure class="carousel-item">
                            <Media src={src} alt={alt ?? caption ?? ""} class="lightbox-trigger" />
                            {caption && <figcaption>{caption}</figcaption>}
                          </figure>
                        );
                      })}
                    </div>
                    <div class="carousel-controls">
                      <span class="carousel-count" data-carousel-count aria-live="polite" />
                      <div class="carousel-buttons">
                        <button type="button" class="icon-btn" data-carousel-prev aria-label="Previous photos">
                          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true">
                            <path d="M13.5 8H2.5M7 3.5 2.5 8 7 12.5" />
                          </svg>
                        </button>
                        <button type="button" class="icon-btn" data-carousel-next aria-label="Next photos">
                          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true">
                            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                );
              }

              if (block.type === "compare") {
                return (
                  <div class="compare-block">
                    <div class="compare-controls">
                      <div class="segmented" role="group" aria-label="Show version">
                        <button type="button" class="compare-tab" data-tab="before" aria-pressed="false">
                          {block.before.label || "Before"}
                        </button>
                        <button type="button" class="compare-tab" data-tab="after" aria-pressed="true">
                          {block.after.label || "After"}
                        </button>
                      </div>
                      {block.liveUrl && (
                        <a href={block.liveUrl} target="_blank" rel="noopener noreferrer" class="compare-live-link link-quiet">
                          View live page <span aria-hidden="true">&#8599;</span><span class="visually-hidden">(opens in a new tab)</span>
                        </a>
                      )}
                    </div>
                    <div class="compare-frame">
                      <div class="compare-pane" data-pane="before">
                        <Media src={block.before.src} alt={block.before.alt ?? block.before.label ?? "Before"} class="lightbox-trigger" />
                      </div>
                      <div class="compare-pane is-active" data-pane="after">
                        <Media src={block.after.src} alt={block.after.alt ?? block.after.label ?? "After"} class="lightbox-trigger" />
                      </div>
                    </div>
                  </div>
                );
              }

              if (block.type === "componentTable") {
                return (
                  <div class="component-table">
                    {block.intro && <p class="component-table-intro">{block.intro}</p>}
                    <div class="component-table-groups">
                      {block.groups.map((group) => (
                        <div class="component-table-group">
                          <h3>{group.category}</h3>
                          <div class="badge-list component-chip-list">
                            {group.items.map((item) => (
                              <span class="badge">{item}</span>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              }


              return null;
            })
          }
        </div>

        <div class="back-link-wrapper">
          <a href="/work" class="back-link link-quiet"><span aria-hidden="true">&larr;</span> All work</a>
        </div>
      </div>

      <aside class="project-sidebar">
        <div class="sidebar-inner">
          <div class="meta-group">
            <span class="overline">Client / Company</span>
            {project.clientUrl ? (
              <p class="meta-value">
                <a href={project.clientUrl} target="_blank" rel="noopener noreferrer" class="link-underline">
                  {project.client}<span class="client-link-arrow" aria-hidden="true">&#8599;</span><span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </p>
            ) : (
              <p class="meta-value">{project.client}</p>
            )}
          </div>
          <div class="meta-group">
            <span class="overline">Year</span>
            <p class="meta-value"><time datetime={String(project.year)}>{project.year}</time></p>
          </div>
          <div class="meta-group">
            <span class="overline">Project type</span>
            <div class="badge-list">
              {project.tags.map((tag) => <span class="badge">{tag}</span>)}
            </div>
          </div>
          <div class="meta-group">
            <span class="overline">Tools</span>
            <div class="badge-list">
              {project.tools.map((tool) => <span class="badge">{tool}</span>)}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged image" inert data-lenis-prevent>
    <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
  </div>

  <Footer />
</Layout>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: var(--color-scrim);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow-y: auto;
    padding: var(--space-7) 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-moderate) var(--ease-standard);
  }

  .lightbox.open {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox-img {
    width: min(var(--max-width), 92vw);
    height: auto;
    cursor: zoom-out;
  }

  .lightbox-close {
    position: fixed;
    top: var(--space-3);
    right: var(--space-4);
    background: none;
    border: none;
    width: var(--control-md);
    height: var(--control-md);
    color: #ffffff;
    font-size: var(--text-h3);
    font-weight: var(--weight-light);
    cursor: pointer;
    line-height: 1;
    opacity: 0.7;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .lightbox-close:hover,
  .lightbox-close:focus-visible {
    opacity: 1;
  }

  .lightbox-close:focus-visible {
    outline-color: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      transition: none;
    }
  }

  .lightbox-trigger {
    cursor: zoom-in;
  }
</style>

<style>
  .project-page {
    padding: var(--page-top) var(--page-padding) 0;
  }

  .page-crumbs {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  h1 {
    max-width: var(--max-width);
    margin: 0 auto var(--space-6);
    font-size: var(--text-display-1);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .project-layout {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: stretch;
    gap: var(--space-8);
  }

  .project-main {
    flex: 3 1 0%;
    min-width: 0;
  }

  .project-sidebar {
    flex: 1 1 0%;
    min-width: 0;
  }

  .sidebar-inner {
    position: sticky;
    top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-2);
  }

  .meta-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
  }

  .meta-group:first-child {
    padding-top: 0;
    border-top: none;
  }

  .meta-value {
    font-family: var(--font-mono);
    font-size: var(--text-m);
    line-height: 1.4;
    color: var(--color-text);
  }

  .client-link-arrow {
    font-size: var(--text-s);
    color: var(--color-text-muted);
    margin-left: var(--space-1);
  }

  .hero-image {
    margin: 0 0 var(--space-7);
    overflow: hidden;
  }

  .hero-image :global(img) {
    width: 100%;
    display: block;
    border: var(--border-width) solid var(--color-border);
  }

  .content-section {
    max-width: var(--content-width);
    margin: 0 0 var(--space-6);
  }

  .content-divider {
    max-width: var(--content-width);
    margin: 0 0 var(--space-6);
    border: none;
    border-top: var(--border-width) solid var(--color-border);
  }

  h2 {
    font-size: var(--text-h4);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-3);
  }

  .image-grid {
    margin: 0 0 var(--space-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .image-item {
    margin: 0;
  }

  .image-item figcaption {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .image-grid :global(img) {
    width: 100%;
    display: block;
    border: var(--border-width) solid var(--color-border);
  }

  .image-grid :global(video) {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: var(--media-ratio, auto);
    border: var(--border-width) solid var(--color-border);
  }

  .image-grid.is-framed {
    gap: var(--space-5);
  }

  .image-grid.is-side-by-side {
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 640px) {
    .image-grid.is-side-by-side {
      grid-template-columns: 1fr;
    }
  }

  .carousel {
    margin: 0 0 var(--space-6);
  }

  .carousel-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--space-3) * (var(--per-view) - 1)) / var(--per-view));
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-track:focus-visible {
    outline: 1px solid var(--color-text);
    outline-offset: 4px;
  }

  .carousel-item {
    margin: 0;
    scroll-snap-align: start;
  }

  .carousel-item :global(img) {
    width: 100%;
    aspect-ratio: var(--carousel-ratio, 3 / 4);
    object-fit: cover;
    display: block;
    border: var(--border-width) solid var(--color-border);
    cursor: zoom-in;
  }

  .carousel.is-contained .carousel-item :global(img) {
    object-fit: contain;
    background: #1e1e1e;
  }

  .carousel-item figcaption {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-3);
  }

  .carousel-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .carousel-buttons {
    display: flex;
    gap: var(--space-2);
  }

  @media (max-width: 1024px) {
    .carousel-track {
      grid-auto-columns: calc((100% - var(--space-3)) / 2);
    }
  }

  @media (max-width: 640px) {
    .carousel-track {
      grid-auto-columns: 80%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      scroll-behavior: auto;
    }
  }

  .compare-block {
    margin: 0 0 var(--space-6);
  }

  .compare-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .compare-live-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .compare-frame {
    position: relative;
    max-height: 640px;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
  }

  .compare-pane {
    display: none;
  }

  .compare-pane.is-active {
    display: block;
  }

  .compare-pane :global(img) {
    width: 100%;
    display: block;
    cursor: zoom-in;
  }

  .component-table {
    margin: 0 0 var(--space-6);
  }

  .component-table-intro {
    font-size: var(--text-m);
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .component-table-groups {
    display: flex;
    flex-direction: column;
    border-top: var(--border-width) solid var(--color-border);
  }

  .component-table-group {
    display: grid;
    grid-template-columns: 224px 1fr;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .component-table-group h3 {
    font-size: var(--text-l);
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0;
  }

  /* Chips here are the global .badge component so the article and the
     project sidebar stay visually identical. This only adds the grid
     alignment the component table needs. */
  .component-chip-list {
    align-content: flex-start;
  }

  @media (max-width: 640px) {
    .component-table-group {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  .back-link-wrapper {
    margin-top: var(--space-6);
    padding: var(--space-5) 0;
    border-top: var(--border-width) solid var(--color-border);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: var(--text-s);
  }

  @media (max-width: 1024px) {
    .project-layout {
      flex-direction: column;
      gap: var(--space-6);
    }

    .project-sidebar {
      order: -1;
      width: 100%;
    }

    .sidebar-inner {
      position: static;
      flex-direction: column;
      gap: var(--space-5);
      padding-top: 0;
    }

    .meta-group {
      padding-top: 0;
      border-top: none;
    }
  }

</style>

<script>
  const lightbox = document.getElementById("lightbox")!;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;

  const lightboxClose = lightbox.querySelector<HTMLButtonElement>(".lightbox-close")!;
  let lightboxReturn: HTMLElement | null = null;

  // A dialog: inert while closed, focus on its close button while open, and
  // back where it came from when it closes.
  document.querySelectorAll<HTMLImageElement>(".lightbox-trigger").forEach((img) => {
    img.addEventListener("click", () => {
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightboxReturn = document.activeElement as HTMLElement | null;
      lightbox.inert = false;
      lightbox.classList.add("open");
      document.body.style.overflow = "hidden";
      lightboxClose.focus();
    });
  });

  function closeLightbox() {
    if (!lightbox.classList.contains("open")) return;
    lightbox.classList.remove("open");
    lightbox.inert = true;
    document.body.style.overflow = "";
    lightboxReturn?.focus();
  }

  lightbox.addEventListener("click", closeLightbox);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const count = carousel.querySelector<HTMLElement>("[data-carousel-count]");
    if (!track || !prev || !next || !count) return;

    const items = Array.from(track.querySelectorAll<HTMLElement>(".carousel-item"));
    if (!items.length) return;

    const pad = (n: number) => String(n).padStart(2, "0");

    // Step by a whole slide, gap included, so snapping stays aligned.
    const step = () => {
      if (items.length < 2) return track.clientWidth;
      return items[1].offsetLeft - items[0].offsetLeft;
    };

    const update = () => {
      const current = Math.round(track.scrollLeft / step());
      const maxScroll = track.scrollWidth - track.clientWidth;
      count.textContent = `${pad(Math.min(current + 1, items.length))} / ${pad(items.length)}`;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= maxScroll - 1;
    };

    prev.addEventListener("click", () => track.scrollBy({ left: -step() }));
    next.addEventListener("click", () => track.scrollBy({ left: step() }));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });

  document.querySelectorAll<HTMLElement>(".compare-block").forEach((block) => {
    const tabs = block.querySelectorAll<HTMLButtonElement>(".compare-tab");
    const panes = block.querySelectorAll<HTMLElement>(".compare-pane");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.tab;
        tabs.forEach((t) => t.setAttribute("aria-pressed", String(t === tab)));
        panes.forEach((p) => p.classList.toggle("is-active", p.dataset.pane === target));
      });
    });
  });
</script>
