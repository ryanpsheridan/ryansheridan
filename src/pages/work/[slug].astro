---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/projects";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
};

const { project } = Astro.props;
---

<Layout title={`${project.title} — Ryan Sheridan`} description={`${project.title} — a ${project.tags.join(", ").toLowerCase()} project by Ryan Sheridan.`} ogImage={project.thumbnail || "/project-new-office1.png"}>
  <Nav />
  <main class="project-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/work">Work</a>
      <span class="sep">/</span>
      <span class="current">{project.title}</span>
    </nav>

    <div class="project-header">
      <h1>{project.title}</h1>

      <table class="meta-table">
        <tbody>
          <tr>
            <th>Client / Company</th>
            <td>{project.client}</td>
          </tr>
          <tr>
            <th>Project type</th>
            <td>
              <div class="badge-list">
                {project.tags.map((tag) => <span class="badge">{tag}</span>)}
              </div>
            </td>
          </tr>
          <tr>
            <th>Tools</th>
            <td>
              <div class="badge-list">
                {project.tools.map((tool) => <span class="badge">{tool}</span>)}
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    {project.thumbnail && (
      <div class="hero-image">
        <img src={project.thumbnail} alt={project.title} />
      </div>
    )}

    <div class="project-content">
      {
        project.content.map((block) =>
          block.type === "text" ? (
            <section class="content-section">
              {block.heading && <h2>{block.heading}</h2>}
              <div class="body" set:html={block.body} />
            </section>
          ) : (
            <div class="image-grid">
              {block.images.map((img) => {
                const src = typeof img === "string" ? img : img.src;
                const caption = typeof img === "string" ? undefined : img.caption;
                return (
                  <figure class="image-item">
                    {caption && <figcaption>{caption}</figcaption>}
                    <img src={src} alt="" class="lightbox-trigger" />
                  </figure>
                );
              })}
            </div>
          )
        )
      }
    </div>

    <div class="back-link-wrapper">
      <a href="/work" class="back-link">&larr; All work</a>
    </div>
  </main>

  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" aria-label="Close">&times;</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
  </div>

  <Footer />
</Layout>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    cursor: zoom-out;
  }

  .lightbox.open {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
  }

  .lightbox-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    background: none;
    border: none;
    color: #fff;
    font-size: 32px;
    cursor: pointer;
    line-height: 1;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  .lightbox-trigger {
    cursor: zoom-in;
  }
</style>

<style>
  .project-page {
    padding: 80px var(--page-padding) 0;
  }

  .breadcrumbs {
    max-width: var(--max-width);
    margin: 0 auto var(--space-5);
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--color-text);
  }

  .breadcrumbs .sep {
    color: var(--color-border);
  }

  .breadcrumbs .current {
    color: var(--color-text);
  }

  .project-header {
    max-width: var(--max-width);
    margin: 0 auto var(--space-6);
  }

  h1 {
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
  }

  .meta-table {
    border-collapse: collapse;
    width: 100%;
    max-width: 640px;
    border-top: 1px solid var(--color-border);
  }

  .meta-table tr {
    border-bottom: 1px solid var(--color-border);
  }

  .meta-table th,
  .meta-table td {
    text-align: left;
    font-weight: 400;
    padding: var(--space-3) 0;
    vertical-align: top;
  }

  .meta-table th {
    width: 176px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    border-right: 1px solid var(--color-border);
    padding-right: var(--space-4);
  }

  .meta-table td {
    font-size: var(--text-sm);
    color: var(--color-text);
    padding-left: var(--space-4);
  }

  .hero-image {
    max-width: var(--max-width);
    margin: 0 auto var(--space-7);
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    display: block;
  }

  .project-content {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .content-section {
    max-width: var(--content-width);
    margin: 0 auto var(--space-6);
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  .body {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text);
  }

  .body :global(p) {
    margin-bottom: var(--space-3);
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }

  .body :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border);
  }

  .body :global(a:hover) {
    text-decoration-color: var(--color-text);
  }

  .body :global(strong) {
    font-weight: 500;
  }

  .body :global(blockquote) {
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-4);
    margin: var(--space-5) 0;
    color: var(--color-text-muted);
    font-style: italic;
    font-size: var(--text-md);
  }

  .body :global(blockquote p) {
    margin-bottom: 0;
  }

  .body :global(h3) {
    font-size: var(--text-md);
    font-weight: 500;
    margin-top: var(--space-5);
    margin-bottom: var(--space-3);
  }

  .body :global(img) {
    width: 100%;
    margin: var(--space-4) 0;
  }

  .body :global(em) {
    color: var(--color-text-muted);
  }

  .image-grid {
    margin: 0 auto var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .image-item {
    margin: 0;
  }

  .image-item figcaption {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .image-grid img {
    width: 100%;
    display: block;
  }

  .back-link-wrapper {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .meta-table th {
      width: 40%;
      padding-right: 16px;
    }

    .meta-table td {
      padding-left: 16px;
    }
  }
</style>

<script>
  const lightbox = document.getElementById("lightbox")!;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;

  document.querySelectorAll<HTMLImageElement>(".lightbox-trigger").forEach((img) => {
    img.addEventListener("click", () => {
      lightboxImg.src = img.src;
      lightbox.classList.add("open");
      document.body.style.overflow = "hidden";
    });
  });

  function closeLightbox() {
    lightbox.classList.remove("open");
    document.body.style.overflow = "";
  }

  lightbox.addEventListener("click", closeLightbox);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });
</script>
