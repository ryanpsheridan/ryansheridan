---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/projects";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
};

const { project } = Astro.props;
---

<Layout title={`${project.title} — Ryan Sheridan`} description={`${project.title} — a ${project.tags.join(", ").toLowerCase()} project by Ryan Sheridan.`} ogImage={project.thumbnail || "/project-new-office1.png"}>
  <Nav />
  <main class="project-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/work">Work</a>
      <span class="sep">/</span>
      <span class="current">{project.title}</span>
    </nav>

    <h1>{project.title}</h1>

    <div class="project-layout">
      <div class="project-main">
        {project.thumbnail && (
          <div class="hero-image">
            <img src={project.thumbnail} alt={project.title} />
          </div>
        )}

        <div class="project-content">
          {
            project.content.map((block) => {
              if (block.type === "text") {
                return (
                  <section class="content-section">
                    {block.heading && <h2>{block.heading}</h2>}
                    <div class="body" set:html={block.body} />
                  </section>
                );
              }

              if (block.type === "imageGrid") {
                return (
                  <div class="image-grid">
                    {block.images.map((img) => {
                      const src = typeof img === "string" ? img : img.src;
                      const caption = typeof img === "string" ? undefined : img.caption;
                      return (
                        <figure class="image-item">
                          {caption && <figcaption>{caption}</figcaption>}
                          <img src={src} alt="" class="lightbox-trigger" />
                        </figure>
                      );
                    })}
                  </div>
                );
              }

              if (block.type === "compare") {
                return (
                  <div class="compare-block">
                    <div class="compare-controls">
                      <div class="compare-tabs" role="tablist">
                        <button type="button" class="compare-tab" data-tab="before">
                          {block.before.label || "Before"}
                        </button>
                        <button type="button" class="compare-tab is-active" data-tab="after">
                          {block.after.label || "After"}
                        </button>
                      </div>
                      {block.liveUrl && (
                        <a href={block.liveUrl} target="_blank" rel="noopener noreferrer" class="compare-live-link">
                          View live page &#8599;
                        </a>
                      )}
                    </div>
                    <div class="compare-frame" data-lenis-prevent>
                      <div class="compare-pane" data-pane="before">
                        <img src={block.before.src} alt={block.before.label || "Before"} class="lightbox-trigger" />
                      </div>
                      <div class="compare-pane is-active" data-pane="after">
                        <img src={block.after.src} alt={block.after.label || "After"} class="lightbox-trigger" />
                      </div>
                    </div>
                    <p class="compare-hint">Click the image to see the full page.</p>
                  </div>
                );
              }

              if (block.type === "componentTable") {
                return (
                  <div class="component-table">
                    {block.intro && <p class="component-table-intro">{block.intro}</p>}
                    <div class="component-table-groups">
                      {block.groups.map((group) => (
                        <div class="component-table-group">
                          <h3>{group.category}</h3>
                          <div class="component-chip-list">
                            {group.items.map((item) => (
                              <span class="component-chip">{item}</span>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              }


              return null;
            })
          }
        </div>

        <div class="back-link-wrapper">
          <a href="/work" class="back-link">&larr; All work</a>
        </div>
      </div>

      <aside class="project-sidebar">
        <div class="sidebar-inner">
          <div class="meta-group">
            <span class="meta-label">Client / Company</span>
            <p class="meta-value">{project.client}</p>
          </div>
          <div class="meta-group">
            <span class="meta-label">Project type</span>
            <div class="badge-list">
              {project.tags.map((tag) => <span class="badge">{tag}</span>)}
            </div>
          </div>
          <div class="meta-group">
            <span class="meta-label">Tools</span>
            <div class="badge-list">
              {project.tools.map((tool) => <span class="badge">{tool}</span>)}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <div class="lightbox" id="lightbox" data-lenis-prevent>
    <button class="lightbox-close" aria-label="Close">&times;</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
  </div>

  <Footer />
</Layout>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow-y: auto;
    padding: 64px 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .lightbox.open {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox-img {
    width: min(1100px, 92vw);
    height: auto;
    cursor: zoom-out;
  }

  .lightbox-close {
    position: fixed;
    top: var(--space-3);
    right: var(--space-4);
    background: none;
    border: none;
    color: #fff;
    font-size: 32px;
    cursor: pointer;
    line-height: 1;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  .lightbox-trigger {
    cursor: zoom-in;
  }
</style>

<style>
  .project-page {
    padding: 80px var(--page-padding) 0;
  }

  .breadcrumbs {
    max-width: var(--max-width);
    margin: 0 auto var(--space-5);
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--color-text);
  }

  .breadcrumbs .sep {
    color: var(--color-border);
  }

  .breadcrumbs .current {
    color: var(--color-text);
  }

  h1 {
    max-width: var(--max-width);
    margin: 0 auto var(--space-6);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .project-layout {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: stretch;
    gap: var(--space-8);
  }

  .project-main {
    flex: 3 1 0%;
    min-width: 0;
  }

  .project-sidebar {
    flex: 1 1 0%;
    min-width: 0;
  }

  .sidebar-inner {
    position: sticky;
    top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-2);
  }

  .meta-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .meta-group:first-child {
    padding-top: 0;
    border-top: none;
  }

  .meta-label {
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .meta-value {
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .hero-image {
    margin: 0 0 var(--space-7);
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    display: block;
  }

  .content-section {
    max-width: var(--content-width);
    margin: 0 0 var(--space-6);
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  .body {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text);
  }

  .body :global(p) {
    margin-bottom: var(--space-3);
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }

  .body :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border);
  }

  .body :global(a:hover) {
    text-decoration-color: var(--color-text);
  }

  .body :global(strong) {
    font-weight: 500;
  }

  .body :global(blockquote) {
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-4);
    margin: var(--space-5) 0;
    color: var(--color-text-muted);
    font-style: italic;
    font-size: var(--text-md);
  }

  .body :global(blockquote p) {
    margin-bottom: 0;
  }

  .body :global(h3) {
    font-size: var(--text-md);
    font-weight: 500;
    margin-top: var(--space-5);
    margin-bottom: var(--space-3);
  }

  .body :global(img) {
    width: 100%;
    margin: var(--space-4) 0;
  }

  .body :global(em) {
    color: var(--color-text-muted);
  }

  .image-grid {
    margin: 0 0 var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .image-item {
    margin: 0;
  }

  .image-item figcaption {
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .image-grid img {
    width: 100%;
    display: block;
  }

  .compare-block {
    margin: 0 0 var(--space-6);
  }

  .compare-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .compare-tabs {
    display: inline-flex;
    gap: var(--space-2);
    padding: 4px;
    background: var(--color-surface, rgba(127, 127, 127, 0.08));
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .compare-live-link {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1px;
    transition: color 0.2s, border-color 0.2s;
  }

  .compare-live-link:hover {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  .compare-tab {
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    background: none;
    border: none;
    padding: 6px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .compare-tab:hover {
    color: var(--color-text);
  }

  .compare-tab.is-active {
    background: var(--color-text);
    color: var(--color-bg, #fff);
  }

  .compare-frame {
    position: relative;
    max-height: 640px;
    overflow-y: auto;
    border: 1px solid var(--color-border);
  }

  .compare-pane {
    display: none;
  }

  .compare-pane.is-active {
    display: block;
  }

  .compare-pane img {
    width: 100%;
    display: block;
    cursor: zoom-in;
  }

  .compare-hint {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .component-table {
    margin: 0 0 var(--space-6);
  }

  .component-table-intro {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .component-table-groups {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  .component-table-group {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .component-table-group h3 {
    font-size: var(--text-md);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0;
  }

  .component-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-content: flex-start;
  }

  .component-chip {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1;
    padding: 7px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  @media (max-width: 640px) {
    .component-table-group {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  .back-link-wrapper {
    margin-top: var(--space-6);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  @media (max-width: 900px) {
    .project-layout {
      flex-direction: column;
      gap: var(--space-6);
    }

    .project-sidebar {
      order: -1;
      width: 100%;
    }

    .sidebar-inner {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-5);
      padding-top: 0;
    }

    .meta-group {
      flex: 1 1 160px;
      padding-top: 0;
      border-top: none;
    }
  }
</style>

<script>
  const lightbox = document.getElementById("lightbox")!;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;

  document.querySelectorAll<HTMLImageElement>(".lightbox-trigger").forEach((img) => {
    img.addEventListener("click", () => {
      lightboxImg.src = img.src;
      lightbox.classList.add("open");
      document.body.style.overflow = "hidden";
    });
  });

  function closeLightbox() {
    lightbox.classList.remove("open");
    document.body.style.overflow = "";
  }

  lightbox.addEventListener("click", closeLightbox);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });

  document.querySelectorAll<HTMLElement>(".compare-block").forEach((block) => {
    const tabs = block.querySelectorAll<HTMLButtonElement>(".compare-tab");
    const panes = block.querySelectorAll<HTMLElement>(".compare-pane");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.tab;
        tabs.forEach((t) => t.classList.toggle("is-active", t === tab));
        panes.forEach((p) => p.classList.toggle("is-active", p.dataset.pane === target));
        block.querySelector(".compare-frame")?.scrollTo({ top: 0 });
      });
    });
  });
</script>
