    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-align: center;
    font-size: var(--text-s);
    transition:
      opacity var(--duration-moderate) var(--pathway-ease),
      transform var(--duration-moderate) var(--pathway-ease),
      background-color var(--duration-moderate) var(--pathway-ease),
      border-color var(--duration-moderate) var(--pathway-ease),
      box-shadow var(--duration-moderate) var(--pathway-ease);
