---
import Layout from "../layouts/Layout.astro";
import Cover from "../components/unexpected-detail/Cover.astro";
import Lines from "../components/unexpected-detail/Lines.astro";
import Wordmark from "../components/unexpected-detail/Wordmark.astro";

/*
  unexpected detail: identity presentation. Private share, noindex, and kept
  out of the sitemap by the allowlist in astro.config.mjs. Rounds 01 to 05
  of the exploration live on at /unexpected-detail/round-1.

  The logo is live type, not an image: the staggered Gloock lockup from
  round 05 (tiles 01 and 02), drawn by components/unexpected-detail. That is
  what lets the explorer at the end switch the dot and the typeface without
  approximating the artwork.

  Everything above the explorer is fixed to the recommended direction
  (RECOMMENDED below). Only the explorer changes, and its state lives in the
  URL so a copied link reopens the same version.
*/

const RECOMMENDED = { font: "gloock", dot: "i", palette: "02" } as const;
const INK = "#141414";
const PAPER = "#FAF9F6";

// WCAG 2 contrast. The explorer script carries a copy.
const lum = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  const c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => {
    const s = v / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const contrast = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
  return (x + 0.05) / (y + 0.05);
};
const onColor = (hex: string) => (contrast(hex, INK) >= contrast(hex, PAPER) ? INK : PAPER);
const vars = (p: string, s: string) =>
  `--ud-primary:${p};--ud-secondary:${s};--ud-on-secondary:${onColor(s)};--ud-on-primary:${onColor(p)}`;

/*
  Twenty directions, from the brief. Six were retuned so the dot holds at
  least 3:1 on its own field (09, 12, 13, 14, 16, 18); the rest are as given.
*/
const palettes = [
  { name: "Peach & Cocoa", p: "#E9A58D", s: "#49352F", mood: "Warm, approachable" },
  { name: "Tomato & Ink", p: "#E6533F", s: "#252A38", mood: "Bold, confident" },
  { name: "Marigold & Forest", p: "#E9BC48", s: "#294A3B", mood: "Curious, distinctive" },
  { name: "Cobalt & Bone", p: "#3158C8", s: "#F0EDE3", mood: "Modern, editorial" },
  { name: "Pink & Oxblood", p: "#E7A0B5", s: "#642E43", mood: "Expressive, sophisticated" },
  { name: "Mint & Plum", p: "#A9D4BD", s: "#593B62", mood: "Playful, unconventional" },
  { name: "Tangerine & Aubergine", p: "#E98242", s: "#493149", mood: "Energetic, artistic" },
  { name: "Butter & Charcoal", p: "#F0D98B", s: "#333330", mood: "Quiet, confident" },
  { name: "Sky & Rust", p: "#A9CBE0", s: "#8E3F29", mood: "Unexpected, balanced" },
  { name: "Lavender & Espresso", p: "#B8A5D0", s: "#493A36", mood: "Creative, thoughtful" },
  { name: "Lime & Navy", p: "#B9CB58", s: "#283C58", mood: "Contemporary, bold" },
  { name: "Coral & Teal", p: "#EE8B7E", s: "#1F5452", mood: "Vibrant, approachable" },
  { name: "Lilac & Tomato", p: "#D9CCF0", s: "#B33A2C", mood: "Artistic, energetic" },
  { name: "Olive & Cream", p: "#6B6A3A", s: "#F2EBDD", mood: "Organic, understated" },
  { name: "Electric Blue & Sand", p: "#4169D8", s: "#E6D8BD", mood: "Distinctive, modern" },
  { name: "Dusty Rose & Moss", p: "#DFA19D", s: "#3E4934", mood: "Natural, warm" },
  { name: "Lemon & Burgundy", p: "#E8D65C", s: "#713C49", mood: "Unexpected, expressive" },
  { name: "Periwinkle & Brick", p: "#B9C2EC", s: "#8A3B2D", mood: "Contemporary, creative" },
  { name: "Sage & Ink", p: "#A8B8A0", s: "#293B38", mood: "Restrained, timeless" },
  { name: "Fuchsia & Chocolate", p: "#D66BA3", s: "#49332F", mood: "Playful, distinctive" },
].map((c, i) => ({ ...c, no: String(i + 1).padStart(2, "0") }));

const rec = palettes.find((p) => p.no === RECOMMENDED.palette)!;
const recVars = vars(rec.p, rec.s);

const fonts = [
  { id: "gloock", name: "Gloock" },
  { id: "dm", name: "DM Serif Display" },
] as const;

// The opening's falling line, as HTML so the row stretches to any width
// without skewing the angle. Every other line drops out on phones; the
// fallen one is odd, so it stays.
const heroLines = 37;
const heroFall = 25;

const fontsHref = "https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Gloock&display=swap";
---

<Layout
  title="unexpected detail, identity | Ryan Sheridan"
  description="Identity presentation for the unexpected detail podcast."
  noindex={true}
>
  <link rel="stylesheet" href={fontsHref} />
  <div class="ub" id="ub" data-font={RECOMMENDED.font} data-dot={RECOMMENDED.dot} style={recVars}>
    <main id="main">
      <!-- 01 Introduction -->
      <section class="intro tone-field" aria-label="unexpected detail, identity presentation">
        <a class="intro-skip" href="#explore">Skip to the explorer</a>
        <header class="intro-meta">
          <p class="intro-name">unexpected detail</p>
          <ul class="intro-tags">
            <li>Brand identity</li>
            <li>Podcast</li>
            <li>2026</li>
          </ul>
          <p class="intro-draft">Identity exploration, draft 02</p>
        </header>
        <div class="intro-lines" aria-hidden="true">
          {Array.from({ length: heroLines }, (_, i) => <span class:list={{ fall: i + 1 === heroFall }} />)}
        </div>
        <div class="intro-foot">
          <p class="intro-desc">
            An identity for an unscripted conversation show about the things people leave off their
            résumé. Quiet type, one line out of step, and a single dot of color in a place you have
            to look for.
          </p>
          <Wordmark class="intro-wm" size="13.6cqi" />
        </div>
      </section>

      <!-- 02 Identity -->
      <section class="spread s-id" aria-labelledby="id-h">
        <div class="wrap">
          <div class="slabel reveal"><span>02</span><h2 id="id-h">Identity</h2></div>
          <div class="id-primary reveal">
            <div class="construct">
              <Wordmark size="1em" />
              <span class="g g-edge" aria-hidden="true"><em>flush right</em></span>
              <span class="g g-step" aria-hidden="true"><em>steps in 1.2 em</em></span>
              <span class="g g-base" aria-hidden="true"></span>
            </div>
            <p class="id-cap">
              <strong>The primary logo.</strong> Lowercase Gloock in two lines, set flush right.
              “unexpected” steps in from the edge, so the name turns like a conversation that went
              somewhere nobody planned.
            </p>
          </div>
        </div>
        <div class="split">
          <figure class="split-half tone-field">
            <div class="split-art"><Wordmark size="6.4cqi" line /></div>
            <figcaption><strong>Alternate.</strong> One line, for web headers, video and anywhere height is short.</figcaption>
          </figure>
          <figure class="split-half split-half--mark">
            <div class="split-art"><span class="wm mark" role="img" aria-label="The i mark"><span class="wm-i">i</span></span></div>
            <figcaption><strong>Mark.</strong> The i on its own, for app icons and favicons. The whole idea in one letter.</figcaption>
          </figure>
        </div>
      </section>

      <!-- 03 The unexpected detail -->
      <section class="detail tone-field" aria-labelledby="detail-h">
        <div class="wrap">
          <div class="slabel reveal"><span>03</span><h2 id="detail-h">The unexpected detail</h2></div>
          <div class="detail-head reveal">
            <p class="detail-say">Everyone has one.</p>
            <p class="detail-copy">
              The show goes looking for the one thing about a guest that doesn’t behave the way you
              expect. The identity has one too: a single dot, in color, sitting where the i keeps it.
            </p>
          </div>
        </div>
        <div class="detail-word" aria-hidden="true"><Wordmark size="31cqi" line class="detail-wm" /></div>
      </section>

      <section class="ab" aria-label="Two places for the dot">
        <figure class="ab-half" data-dot="period">
          <p class="ab-tag"><span>A</span>The period</p>
          <div class="ab-art"><Wordmark size="9.4cqi" /></div>
          <figcaption>
            A full stop that won’t stop: it hangs past the edge of the type. Clear and familiar, and
            it reads as a statement.
          </figcaption>
          <div class="ab-small"><Cover tone="field" style="width:64px" /><Cover tone="paper" style="width:40px" /><span>64 and 40 px</span></div>
        </figure>
        <figure class="ab-half" data-dot="i">
          <p class="ab-tag"><span>B</span>The dot of the i <b>Recommended</b></p>
          <div class="ab-art"><Wordmark size="9.4cqi" /></div>
          <figcaption>
            Hidden inside the word. Nothing is added to the name, so you find the detail rather
            than being shown it. The closest to what the show does.
          </figcaption>
          <div class="ab-small"><Cover tone="field" style="width:64px" /><Cover tone="paper" style="width:40px" /><span>64 and 40 px</span></div>
        </figure>
      </section>

      <!-- 04 Typography -->
      <section class="spread s-type" aria-labelledby="type-h">
        <div class="wrap">
          <div class="slabel reveal"><span>04</span><h2 id="type-h">Typography</h2></div>
          <div class="faces">
            {fonts.map((f) => (
              <article class="face reveal" data-font={f.id}>
                <header class="face-head">
                  <h3 class="face-name">{f.name}</h3>
                  <p class="face-role">{f.id === "gloock" ? "Display · recommended" : "Display · alternate"}</p>
                </header>
                <div class="face-wm"><Wordmark size="1em" /></div>
                <p class="face-title">a cartographer of places that never existed</p>
                <p class="face-say">Curiosity flips the frame.</p>
                <p class="face-note">
                  {f.id === "gloock"
                    ? "Sharp, high contrast, a little severe. It reads as editorial, and keeps its edge at thumbnail size."
                    : "Rounder and softer, with a friendlier ball on the i. Warmer, and closer to what other shows already use."}
                </p>
              </article>
            ))}
          </div>
          <div class="sans reveal">
            <header class="face-head">
              <h3 class="sans-name">Geist</h3>
              <p class="face-role">Supporting sans</p>
            </header>
            <div class="sans-body">
              <p class="sans-meta">ep. 12 · 61 min · with Guest Name</p>
              <p class="sans-copy">
                She has drawn more than four hundred maps of towns, coastlines and train lines that
                were only ever proposed. We talk about the one she will never finish, and why the
                blank parts are her favorite.
              </p>
            </div>
            <p class="sans-pair">
              <strong>Recommended pairing.</strong> Gloock is the voice of the show. Geist does the
              quiet work around it: show notes, guest details, captions, small print.
            </p>
          </div>
        </div>
      </section>

      <!-- 05 Visual language -->
      <section class="spread s-lang" aria-labelledby="lang-h">
        <div class="divider" aria-hidden="true">
          <Lines vw={300} vh={16} count={60} fall={38} x={4} gap={4.9} y={3} len={10} w={0.32} />
        </div>
        <div class="wrap">
          <div class="slabel reveal"><span>05</span><h2 id="lang-h">The falling line</h2></div>
          <p class="lang-lead reveal">
            A row of upright lines with one that has tipped over. It supports the logo and never
            replaces it. One falls, always the same way, and color stays with the dot.
          </p>
          <div class="lang-grid">
            <figure class="lang-page reveal">
              <div class="page">
                <div class="page-rule"><Lines vw={100} vh={8} count={22} fall={15} x={0.4} gap={4.73} y={0.5} len={6} w={0.22} /></div>
                <p class="page-kicker">Show notes · ep. 12</p>
                <p class="page-title">a cartographer of places that never existed</p>
                <div class="page-cols">
                  <p>She has drawn more than four hundred maps of towns, coastlines and train lines that were only ever proposed. Some were planned by city councils, some by children, one by a man who wanted a canal past his house.</p>
                  <p>We talk about the one she will never finish, why the blank parts are her favorite, and the strangest thing anyone has asked her to draw.</p>
                </div>
              </div>
              <figcaption><strong>Editorial.</strong> As a header rule on show notes and newsletters.</figcaption>
            </figure>
            <figure class="lang-graphic reveal">
              <div class="frame frame--1 tone-field">
                <Lines count={14} fall={9} x={11.4} y={10} len={66} />
                <p class="lg-ep">ep. 12</p>
              </div>
              <figcaption><strong>Graphic.</strong> On its own, it carries an episode graphic without the logo.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- 06 Color -->
      <section class="spread s-color" aria-labelledby="color-h">
        <div class="wrap">
          <div class="slabel reveal"><span>06</span><h2 id="color-h">Color directions</h2></div>
          <div class="color-head reveal">
            <p class="color-say">Twenty directions.</p>
            <div>
              <p class="color-copy">
                Each pairs a primary, used only for the dot, with a secondary for the ground. Choose
                one to load it into the explorer at the end of the page.
              </p>
              <p class="color-status" id="color-status" aria-live="polite"></p>
            </div>
          </div>
          <ol class="pals">
            {palettes.map((c) => (
              <li>
                <button
                  type="button"
                  class="pal"
                  style={vars(c.p, c.s)}
                  data-palette={c.no}
                  data-p={c.p}
                  data-s={c.s}
                  data-name={c.name}
                  aria-pressed="false"
                >
                  <Cover tone="field" />
                  <span class="pal-meta">
                    <span class="pal-no">{c.no}</span>
                    <span class="pal-name">{c.name}</span>
                    <span class="pal-chips" aria-hidden="true">
                      <i style={`background:${c.p}`}></i><i style={`background:${c.s}`}></i>
                    </span>
                    <span class="pal-mood">{c.mood}</span>
                    {c.no === RECOMMENDED.palette && <span class="pal-rec">Starting direction</span>}
                  </span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 07 Applications -->
      <section class="spread s-apps" aria-labelledby="apps-h">
        <div class="wrap">
          <div class="slabel reveal"><span>07</span><h2 id="apps-h">In use</h2></div>

          <div class="apps-cover">
            <figure class="ac-main reveal">
              <Cover tone="field" label="Podcast cover, dark" />
            </figure>
            <div class="ac-side reveal">
              <Cover tone="paper" label="Podcast cover, light" />
              <p class="cap"><strong>Podcast cover.</strong> 3000 px square for Apple Podcasts, Spotify and YouTube. Dark leads; light is for press and partners.</p>
            </div>
          </div>

          <figure class="apps-small reveal">
            <div class="sizes">
              {[120, 80, 56, 40].map((s) => (
                <span class="size"><Cover tone="field" style={`width:${s}px`} /><span>{s}</span></span>
              ))}
              {[32, 16].map((s) => (
                <span class="size">
                  <span class="fav tone-field" style={`width:${s}px;height:${s}px`} aria-hidden="true">
                    <span class="wm mark"><span class="wm-i">i</span></span>
                  </span>
                  <span>{s}</span>
                </span>
              ))}
            </div>
            <figcaption class="cap"><strong>Small sizes.</strong> The cover down to 40 px in a feed, then the i mark for app icons and favicons.</figcaption>
          </figure>

          <div class="apps-row">
            <figure class="app-wide reveal">
              <div class="frame frame--169 tone-field">
                <Lines vw={178} vh={100} count={13} fall={9} x={8} y={14} len={62} w={0.6} />
                <div class="ep-text">
                  <p class="ep-no">ep. 12</p>
                  <p class="ep-guest">Guest Name</p>
                  <p class="ep-topic">a cartographer of places that never existed</p>
                </div>
                <Wordmark class="ep-wm" size="5.4cqi" />
              </div>
              <figcaption class="cap"><strong>Episode thumbnail.</strong> 1280 × 720 for YouTube and clips.</figcaption>
            </figure>
            <figure class="app-avatar reveal">
              <div class="avatar tone-field"><Wordmark size="13cqi" /></div>
              <figcaption class="cap"><strong>Profile.</strong> Social platforms crop to a circle, so the wordmark centers.</figcaption>
            </figure>
          </div>

          <div class="apps-social">
            <figure class="app-post reveal">
              <div class="frame frame--45 tone-paper">
                <Lines vw={100} vh={125} count={9} fall={6} x={8} gap={2.4} y={8} len={12} w={0.45} />
                <blockquote class="post-quote">“I have never told anyone this, but I alphabetize my spices by mood.”</blockquote>
                <p class="post-cite">Guest Name, ep. 12</p>
                <Wordmark class="post-wm" size="6.6cqi" />
              </div>
              <figcaption class="cap"><strong>Quote post.</strong> 1080 × 1350.</figcaption>
            </figure>
            <figure class="app-story reveal">
              <div class="frame frame--916 tone-field">
                <Wordmark class="story-wm" size="9cqi" />
                <Lines vw={100} vh={178} count={10} fall={6} x={10} gap={8.9} y={52} len={64} w={0.8} />
                <div class="story-text">
                  <p class="story-new">New episode</p>
                  <p class="story-guest">Guest Name</p>
                  <p class="story-topic">a cartographer of places that never existed</p>
                </div>
              </div>
              <figcaption class="cap"><strong>Story.</strong> 1080 × 1920.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- 08 Explorer -->
      <section class="xp-intro tone-field" id="explore" aria-labelledby="xp-h">
        <div class="wrap">
          <div class="slabel"><span>08</span><p>Explorer</p></div>
          <h2 id="xp-h" class="xp-say">Make it your own.</h2>
          <p class="xp-copy">
            Explore a few different expressions of the identity. Change the unexpected detail,
            experiment with typography, and find a color direction that feels right.
          </p>
        </div>
      </section>

      <section class="xp" id="xp" aria-label="Identity explorer" data-font={RECOMMENDED.font} data-dot={RECOMMENDED.dot} style={recVars}>
        <div class="wrap xp-grid">
          <div class="xp-main tone-field" role="img" aria-label="Live preview of the logo">
            <Lines vw={100} vh={75} count={14} fall={9} x={11.4} y={9} len={30} />
            <Wordmark class="xp-wm" size="13cqi" />
          </div>

          <form class="xp-ctl" onsubmit="return false" aria-label="Explorer settings">
            <fieldset class="opt">
              <legend><span>A</span>The unexpected detail</legend>
              <div class="choice">
                <button type="button" data-set-dot="period" aria-pressed="false">
                  <span class="choice-art" data-dot="period"><Wordmark size="1em" line /></span>
                  <span class="choice-label">Period</span>
                </button>
                <button type="button" data-set-dot="i" aria-pressed="true">
                  <span class="choice-art" data-dot="i"><Wordmark size="1em" line /></span>
                  <span class="choice-label">Dot above the i</span>
                </button>
              </div>
            </fieldset>

            <fieldset class="opt">
              <legend><span>B</span>Typeface</legend>
              <div class="choice">
                {fonts.map((f) => (
                  <button type="button" data-set-font={f.id} aria-pressed={f.id === RECOMMENDED.font ? "true" : "false"}>
                    <span class="choice-aa" data-font={f.id}>Aa</span>
                    <span class="choice-label">{f.name}</span>
                  </button>
                ))}
              </div>
            </fieldset>

            <fieldset class="opt">
              <legend><span>C</span>Color <em id="xp-pal-name">{rec.no} {rec.name}</em></legend>
              <div class="dots" role="group" aria-label="Color directions">
                {palettes.map((c) => (
                  <button
                    type="button"
                    class="dotsw"
                    style={`--sp:${c.p};--ss:${c.s}`}
                    data-palette={c.no}
                    data-p={c.p}
                    data-s={c.s}
                    data-name={c.name}
                    aria-pressed={c.no === RECOMMENDED.palette ? "true" : "false"}
                    aria-label={`${c.no} ${c.name}`}
                    title={`${c.no} ${c.name}`}
                  />
                ))}
              </div>
              <div class="hexes">
                <label class="hex">
                  <span class="hex-label">Primary</span>
                  <span class="hex-field">
                    <input type="color" id="xp-primary-pick" value={rec.p.toLowerCase()} aria-label="Pick the primary color" />
                    <input type="text" id="xp-primary" value={rec.p} spellcheck="false" autocomplete="off" maxlength="7" aria-describedby="xp-hex-msg" />
                  </span>
                </label>
                <label class="hex">
                  <span class="hex-label">Secondary</span>
                  <span class="hex-field">
                    <input type="color" id="xp-secondary-pick" value={rec.s.toLowerCase()} aria-label="Pick the secondary color" />
                    <input type="text" id="xp-secondary" value={rec.s} spellcheck="false" autocomplete="off" maxlength="7" aria-describedby="xp-hex-msg" />
                  </span>
                </label>
              </div>
              <p class="hex-msg" id="xp-hex-msg" aria-live="polite"></p>
            </fieldset>

            <div class="xp-actions">
              <button type="button" class="btn" id="xp-copy">Copy link to this version</button>
              <button type="button" class="link" id="xp-reset">Reset to recommended</button>
              <p class="xp-status" id="xp-status" aria-live="polite"></p>
            </div>
          </form>

          <div class="xp-sub">
            <div class="xp-paper tone-paper">
              <p class="xp-kicker">ep. 12 · with Guest Name</p>
              <p class="xp-title">a cartographer of places that never existed</p>
              <p class="xp-line">Curiosity flips the frame.</p>
              <Wordmark class="xp-paper-wm" size="5.2cqi" />
            </div>
            <div class="xp-cover"><Cover tone="field" /></div>
          </div>
        </div>
      </section>

      <footer class="end tone-field">
        <div class="wrap end-row">
          <p>Prepared by Ryan Sheridan for Marcy · November 2026</p>
          <p><a href="/unexpected-detail/round-1">Rounds 01 to 05</a></p>
        </div>
      </footer>
    </main>
  </div>
</Layout>

<script>
  type Font = "gloock" | "dm";
  type Dot = "period" | "i";
  type State = { font: Font; dot: Dot; primary: string; secondary: string };

  const INK = "#141414";
  const PAPER = "#FAF9F6";
  const root = document.getElementById("ub")!;
  const xp = document.getElementById("xp")!;
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const $$ = (s: string) => Array.from(document.querySelectorAll<HTMLElement>(s));

  const palBtns = $$("[data-palette]");
  const recBtn = palBtns.find((b) => b.dataset.palette === "02")!;
  const RECOMMENDED: State = { font: "gloock", dot: "i", primary: recBtn.dataset.p!, secondary: recBtn.dataset.s! };

  const normalize = (v: string): string | null => {
    let h = v.trim().replace(/^#/, "");
    if (/^[0-9a-f]{3}$/i.test(h)) h = h.replace(/./g, (c) => c + c);
    return /^[0-9a-f]{6}$/i.test(h) ? `#${h.toUpperCase()}` : null;
  };
  const lum = (hex: string) => {
    const n = parseInt(hex.slice(1), 16);
    const c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => {
      const s = v / 255;
      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
  };
  const contrast = (a: string, b: string) => {
    const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
    return (x + 0.05) / (y + 0.05);
  };
  const onColor = (hex: string) => (contrast(hex, INK) >= contrast(hex, PAPER) ? INK : PAPER);

  // A shared link opens on its own settings, in any browser.
  const q = new URLSearchParams(location.search);
  const state: State = {
    font: q.get("font") === "dm" ? "dm" : q.get("font") === "gloock" ? "gloock" : RECOMMENDED.font,
    dot: q.get("dot") === "period" ? "period" : q.get("dot") === "i" ? "i" : RECOMMENDED.dot,
    primary: normalize(q.get("primary") ?? "") ?? RECOMMENDED.primary,
    secondary: normalize(q.get("secondary") ?? "") ?? RECOMMENDED.secondary,
  };

  const fields = {
    primary: { pick: $<HTMLInputElement>("#xp-primary-pick"), hex: $<HTMLInputElement>("#xp-primary") },
    secondary: { pick: $<HTMLInputElement>("#xp-secondary-pick"), hex: $<HTMLInputElement>("#xp-secondary") },
  };
  const hexMsg = $("#xp-hex-msg");
  const status = $("#xp-status");
  const palName = $("#xp-pal-name");
  const colorStatus = $("#color-status");

  const isRecommended = () =>
    state.font === RECOMMENDED.font &&
    state.dot === RECOMMENDED.dot &&
    state.primary === RECOMMENDED.primary &&
    state.secondary === RECOMMENDED.secondary;

  const query = () => {
    if (isRecommended()) return "";
    const p = new URLSearchParams({
      dot: state.dot,
      font: state.font,
      primary: state.primary.slice(1),
      secondary: state.secondary.slice(1),
    });
    return `?${p}`;
  };
  const shareUrl = () => `${location.origin}${location.pathname}${query()}#explore`;

  function render(opts: { skip?: HTMLInputElement; url?: boolean } = {}) {
    xp.dataset.font = state.font;
    xp.dataset.dot = state.dot;
    xp.style.setProperty("--ud-primary", state.primary);
    xp.style.setProperty("--ud-secondary", state.secondary);
    xp.style.setProperty("--ud-on-secondary", onColor(state.secondary));
    xp.style.setProperty("--ud-on-primary", onColor(state.primary));

    $$("[data-set-dot]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setDot === state.dot)));
    $$("[data-set-font]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setFont === state.font)));

    const match = palBtns.find((b) => b.dataset.p === state.primary && b.dataset.s === state.secondary);
    palBtns.forEach((b) => b.setAttribute("aria-pressed", String(!!match && b.dataset.palette === match.dataset.palette)));
    palName.textContent = match ? `${match.dataset.palette} ${match.dataset.name}` : "Custom";

    for (const key of ["primary", "secondary"] as const) {
      const f = fields[key];
      if (f.hex !== opts.skip) {
        f.hex.value = state[key];
        f.hex.removeAttribute("aria-invalid");
      }
      if (f.pick !== opts.skip) f.pick.value = state[key].toLowerCase();
    }
    if (!opts.skip) hexMsg.textContent = "";

    if (opts.url !== false) history.replaceState(null, "", `${location.pathname}${query()}${location.hash}`);
    status.textContent = "";
  }

  $$("[data-set-dot]").forEach((b) => b.addEventListener("click", () => ((state.dot = b.dataset.setDot as Dot), render())));
  $$("[data-set-font]").forEach((b) => b.addEventListener("click", () => ((state.font = b.dataset.setFont as Font), render())));

  palBtns.forEach((b) =>
    b.addEventListener("click", () => {
      state.primary = b.dataset.p!;
      state.secondary = b.dataset.s!;
      render();
      if (b.classList.contains("pal")) {
        colorStatus.innerHTML = `${b.dataset.palette} ${b.dataset.name} is loaded in the explorer. <a href="#explore">See it there</a>`;
      }
    }),
  );

  for (const key of ["primary", "secondary"] as const) {
    const f = fields[key];
    f.pick.addEventListener("input", () => {
      state[key] = normalize(f.pick.value)!;
      render({ skip: f.pick });
    });
    f.hex.addEventListener("input", () => {
      const v = normalize(f.hex.value);
      if (v) {
        state[key] = v;
        f.hex.removeAttribute("aria-invalid");
        hexMsg.textContent = "";
        render({ skip: f.hex });
      } else {
        f.hex.setAttribute("aria-invalid", "true");
        hexMsg.textContent = "Use a hex value like #E6533F.";
      }
    });
    f.hex.addEventListener("blur", () => render());
  }

  $("#xp-reset").addEventListener("click", () => {
    Object.assign(state, RECOMMENDED);
    render();
    status.textContent = "Back to the recommended version.";
  });

  $("#xp-copy").addEventListener("click", async () => {
    const url = shareUrl();
    try {
      await navigator.clipboard.writeText(url);
      status.textContent = "Link copied. It opens on this exact version.";
    } catch {
      status.textContent = `Copy this link: ${url}`;
    }
  });

  render({ url: false });

  // Gentle entrances, once each, and only when motion is welcome.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    root.classList.add("motion");
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }),
      { rootMargin: "0px 0px -8% 0px" },
    );
    $$(".reveal").forEach((el) => io.observe(el));
  }
</script>

