  .wm-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .panel {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    container-type: inline-size;
    display: grid;
    place-items: center;
  }
  .panel.tone-paper,
  .clear,
  .rule-card .clear {
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }
  .panel figcaption {
    position: absolute;
    left: 20px;
    bottom: 16px;
    font-size: 12px;
    opacity: 0.6;
  }
  .wm-rules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 16px;
  }
  .rule-card {
    margin: 0;
  }
  .rule-card figcaption {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ud-muted);
    max-width: 48ch;
  }
  .rule-card strong {
    color: var(--ud-ink);
    font-weight: 500;
  }
  .clear {
    aspect-ratio: 2 / 1;
    container-type: inline-size;
    display: grid;
    place-items: center;
  }
  .clear-box {
    display: inline-block;
    padding: 0.42em 0.42em 0.38em;
    font-size: calc(var(--wm-scale) * 8cqi);
    outline: 1px dashed var(--ud-primary);
    outline-offset: 0;
    background:
      linear-gradient(var(--ud-paper), var(--ud-paper)) content-box,
      repeating-linear-gradient(45deg, transparent 0 4px, color-mix(in srgb, var(--ud-primary) 22%, transparent) 4px 5px);
  }
  .clear-box .wm {
    font-size: 1em !important;
    vertical-align: top;
  }
  @media (max-width: 760px) {
    .wm-pair,
    .wm-rules {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 03 the detail ---------- */
  .matrix {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px 24px;
  }
  .mx {
    margin: 0;
  }
  .mx-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .mx-tiles .tone-paper {
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }
  .mx-cap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
    font-size: 14px;
  }
  .mx-cap strong {
    font-weight: 500;
  }
  @media (max-width: 860px) {
    .matrix {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 04 color ---------- */
  .swatches {
    display: grid;
    grid-template-columns: 1.4fr 1.4fr 1fr 1fr;
    gap: 8px;
  }
  .sw {
    min-height: 260px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .sw--primary {
    background: var(--ud-primary);
    color: var(--ud-on-primary, var(--ud-ink));
  }
  .sw--secondary {
    background: var(--ud-secondary);
    color: var(--ud-on-secondary);
  }
  .sw--ink {
    background: var(--ud-ink);
    color: var(--ud-paper);
  }
  .sw--paper {
    background: var(--ud-paper);
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }
  .sw-role {
    font-size: 13px;
    opacity: 0.8;
  }
  .sw-hex {
    font-family: var(--font-mono);
    font-size: 15px;
  }
  .contrast {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 24px 0 0;
  }
  .contrast > div {
    border-top: 1px solid var(--ud-line);
    padding-top: 12px;
  }
  .contrast dt {
    font-size: 13px;
    color: var(--ud-muted);
  }
  .contrast dd {
    margin: 4px 0 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--ud-display);
    font-size: 32px;
  }
  .flag {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgb(20 20 20 / 0.06);
  }
  .flag[data-ok="false"] {
    background: #fbe3df;
    color: #8c1d12;
  }
  @media (max-width: 860px) {
    .swatches {
      grid-template-columns: 1fr 1fr;
    }
    .sw {
      min-height: 160px;
    }
    .contrast {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 05 combos ---------- */
  .combos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 16px;
  }
  .combo {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .combo .cover {
    width: 100%;
  }
  .combo-paper {
    display: grid;
    place-items: center;
    aspect-ratio: 2.4 / 1;
    container-type: inline-size;
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }
  .combo-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 10px;
    margin-top: 12px;
    font-size: 14px;
  }
  .combo-no {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ud-muted);
    padding-top: 2px;
  }
  .combo-name {
    font-weight: 500;
  }
  .combo-hex {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ud-muted);
  }
  .combo-hex i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(20 20 20 / 0.15);
  }
  .combo-hex i + i,
  .combo-hex i:nth-of-type(2) {
    margin-left: 6px;
  }
  .combo:hover .cover,
  .combo:focus-visible .cover {
    outline: 1px solid var(--ud-ink);
    outline-offset: 3px;
  }
  .combo[aria-pressed="true"] .cover {
    outline: 2px solid var(--ud-ink);
    outline-offset: 3px;
  }
  .combo[aria-pressed="true"] .combo-name::after {
    content: "In use";
    margin-left: 8px;
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--ud-ink);
    color: var(--ud-paper);
    vertical-align: 2px;
  }
  @media (max-width: 1000px) {
    .combos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .combos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- 06 type ---------- */
  .type-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .type-card {
    padding: clamp(24px, 3vw, 40px);
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }
  .type-aa {
    font-size: clamp(96px, 12vw, 180px);
    line-height: 1;
    margin: 24px 0 16px;
    letter-spacing: -0.02em;
  }
  .display {
    font-family: var(--ud-display);
  }
  .sans {
    font-family: var(--font-sans);
    font-weight: 400;
  }
  .type-set {
    font-size: clamp(16px, 1.6vw, 22px);
    line-height: 1.35;
    word-break: break-all;
  }
  .type-use {
    margin-top: 24px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ud-muted);
  }
  .hier {
    margin-top: 16px;
    padding: clamp(28px, 5vw, 72px);
  }
  .hier-meta {
    font-size: 13px;
    opacity: 0.65;
  }
  .hier-title {
    margin-top: 16px;
    font-family: var(--ud-display);
    font-weight: 400;
    font-size: clamp(36px, 1rem + 4vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .hier-guest {
    margin-top: 20px;
    font-size: 18px;
    font-weight: 500;
  }
  .hier-body {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.6;
    max-width: 58ch;
    opacity: 0.75;
  }
  @media (max-width: 760px) {
    .type-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 07 the falling line ---------- */
  .band {
    position: relative;
    aspect-ratio: 5 / 1;
    box-shadow: inset 0 0 0 1px var(--ud-line);
    overflow: hidden;
  }
  .band--field {
    margin-top: 8px;
    box-shadow: none;
  }
  .principles {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 32px;
  }
  .principles li {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ud-muted);
    border-top: 1px solid var(--ud-ink);
    padding-top: 14px;
  }
  .principles strong {
    display: block;
    margin-bottom: 4px;
    font-family: var(--ud-display);
    font-weight: 400;
    font-size: 22px;
    color: var(--ud-ink);
  }
  @media (max-width: 760px) {
    .band {
      aspect-ratio: 3 / 1;
    }
    .principles {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 08 in use ---------- */
  .apps {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 56px 24px;
    align-items: start;
  }
  .app {
    margin: 0;
    grid-column: span 6;
    min-width: 0;
  }
  .app figcaption {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ud-muted);
    max-width: 56ch;
  }
  .app figcaption strong {
    color: var(--ud-ink);
    font-weight: 500;
  }
  .app--cover {
    grid-column: 1 / -1;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pair .tone-paper,
  .feed .tone-paper,
  .frame.tone-paper {
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }
  .app--feed {
    grid-column: span 7;
  }
  .app--player {
    grid-column: span 5;
  }
  .feed {
    display: grid;
    gap: 20px;
    padding: 24px;
    background: #f0eee9;
  }
  .feed-row {
    display: flex;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
  }
  .feed-cell {
    display: grid;
    justify-items: start;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ud-muted);
  }
  .feed-cell .cover {
    border-radius: 6px;
  }

  .player {
    background: #fff;
    border-radius: 18px;
    padding: 20px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 12px 32px rgb(0 0 0 / 0.08);
    font-family: -apple-system, system-ui, sans-serif;
  }
  .player .cover {
    border-radius: 8px;
  }
  .player-show {
    display: flex;
    gap: 16px;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid #eee;
  }
  .player-title {
    font-size: 18px;
    font-weight: 600;
  }
  .player-sub {
    font-size: 12px;
    color: #777;
    margin-top: 2px;
  }
  .player-follow {
    display: inline-block;
    margin-top: 10px;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 999px;
    background: #141414;
    color: #fff;
  }
  .player-eps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .player-eps li {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #f1f1f1;
  }
  .player-eps li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .player-eps .cover {
    border-radius: 5px;
  }
  .player-ep {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
  }

  .frame {
    position: relative;
    overflow: hidden;
    container-type: inline-size;
  }
  .frame--169 {
    aspect-ratio: 16 / 9;
  }
  .frame--45 {
    aspect-ratio: 4 / 5;
  }
  .frame--916 {
    aspect-ratio: 9 / 16;
  }

  .app--wide {
    grid-column: span 8;
  }
  .app--avatar {
    grid-column: span 4;
  }
  .ep-text {
    position: absolute;
    left: 56cqi;
    top: 8.5cqi;
    right: 5cqi;
  }
  .ep-no {
    font-size: 2cqi;
    opacity: 0.7;
  }
  .ep-guest {
    margin-top: 1.4cqi;
    font-family: var(--ud-display);
    font-size: 6.4cqi;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ep-topic {
    margin-top: 1.6cqi;
    font-size: 2.2cqi;
    line-height: 1.35;
    opacity: 0.8;
    max-width: 30ch;
  }
  .ep-wm {
    position: absolute;
    right: 5cqi;
    bottom: 6cqi;
  }

  .avatar {
    width: min(100%, 320px);
    margin-inline: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    container-type: inline-size;
    display: grid;
    place-items: center;
  }

  .app--post,
  .app--story,
  .app--sticker {
    grid-column: span 4;
  }
  .post-quote {
    position: absolute;
    left: 8cqi;
    right: 8cqi;
    top: 30cqi;
    margin: 0;
    font-family: var(--ud-display);
    font-size: 8.4cqi;
    line-height: 1.08;
    letter-spacing: -0.015em;
  }
  .post-cite {
    position: absolute;
    left: 8cqi;
    bottom: 9cqi;
    font-size: 3cqi;
    opacity: 0.65;
  }
  .post-wm {
    position: absolute;
    right: 8cqi;
    bottom: 8cqi;
  }
  .app--story .frame {
    width: min(100%, 300px);
  }
  .story-wm {
    position: absolute;
    right: 9cqi;
    top: 11cqi;
  }
  .story-text {
    position: absolute;
    left: 10cqi;
    right: 10cqi;
    bottom: 12cqi;
  }
  .story-new {
    display: inline-block;
    font-size: 3.6cqi;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 1.6cqi 3.4cqi;
    border-radius: 999px;
    background: var(--ud-primary);
    color: var(--ud-on-primary, var(--ud-ink));
  }
  .story-guest {
    margin-top: 5cqi;
    font-family: var(--ud-display);
    font-size: 12cqi;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .story-topic {
    margin-top: 3cqi;
    font-size: 4.2cqi;
    line-height: 1.35;
    opacity: 0.8;
  }

  .sticker-wrap {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: #f0eee9;
  }
  .sticker {
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ud-primary);
    color: var(--ud-on-primary, var(--ud-ink));
    container-type: inline-size;
    display: grid;
    place-items: center;
    box-shadow:
      0 0 0 8px #fff,
      0 10px 24px rgb(0 0 0 / 0.14);
    transform: rotate(-8deg);
  }
  .sticker p {
    font-family: var(--ud-display);
    font-size: 16cqi;
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .app--cards {
    grid-column: span 7;
  }
  .app--mic {
    grid-column: span 5;
  }
  .cards {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: clamp(24px, 4vw, 48px);
    background: #e9e6df;
  }
  .card {
    position: relative;
    aspect-ratio: 3.5 / 2;
    container-type: inline-size;
    overflow: hidden;
    border-radius: 3px;
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.08),
      0 8px 20px rgb(0 0 0 / 0.12);
  }
  .card-wm {
    position: absolute;
    right: 7cqi;
    bottom: 8cqi;
  }
  .card-dot {
    position: absolute;
    right: 8cqi;
    top: 9cqi;
    width: 3.4cqi;
    height: 3.4cqi;
    border-radius: 50%;
    background: var(--ud-primary);
  }
  .card-name {
    position: absolute;
    left: 8cqi;
    top: 8cqi;
    font-family: var(--ud-display);
    font-size: 8cqi;
    line-height: 1;
  }
  .card-role {
    position: absolute;
    left: 8cqi;
    top: 18.5cqi;
    font-size: 3.2cqi;
    opacity: 0.65;
  }
  .card-contact {
    position: absolute;
    left: 8cqi;
    bottom: 8cqi;
    font-size: 3.2cqi;
    line-height: 1.5;
  }

  .mic-scene {
    --cube: 150px;
    position: relative;
    display: grid;
    justify-items: center;
    padding: 40px 0 0;
    background: #e9e6df;
    height: 420px;
    overflow: hidden;
    perspective: 900px;
  }
  .mic-head {
    width: calc(var(--cube) * 0.62);
    height: calc(var(--cube) * 0.95);
    border-radius: 999px 999px 18px 18px;
    background:
      radial-gradient(circle, rgb(255 255 255 / 0.22) 1.2px, transparent 1.8px) 0 0 / 7px 7px,
      linear-gradient(90deg, #2a2a2a, #4a4a4a 45%, #222);
    position: relative;
    z-index: 1;
    margin-bottom: -8px;
  }
  .cube {
    position: relative;
    width: var(--cube);
    height: var(--cube);
    transform-style: preserve-3d;
    transform: rotateX(-14deg) rotateY(-32deg);
    z-index: 2;
  }
  .face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    container-type: inline-size;
    overflow: hidden;
    backface-visibility: hidden;
  }
  .face--front {
    transform: translateZ(calc(var(--cube) / 2));
  }
  .face--side {
    transform: rotateY(90deg) translateZ(calc(var(--cube) / 2));
    filter: brightness(0.9);
  }
  .face--top {
    transform: rotateX(90deg) translateZ(calc(var(--cube) / 2));
    background: radial-gradient(circle, #111 0 22%, var(--ud-secondary) 23%);
    filter: brightness(0.75);
  }
  .face--front .wm {
    margin-top: 4cqi;
  }
  .mic-stem {
    width: 38px;
    flex: 1;
    height: 200px;
    background: linear-gradient(90deg, #222, #444 50%, #1c1c1c);
    border-radius: 0 0 14px 14px;
    margin-top: -6px;
    clip-path: polygon(8% 0, 92% 0, 80% 100%, 20% 100%);
  }

  .app--tote {
    grid-column: span 5;
  }
  .app--lower {
    grid-column: span 7;
  }
  .tote {
    display: grid;
    justify-items: center;
    padding: 56px 0 40px;
    background: #e9e6df;
  }
  .tote-handle {
    width: 46%;
    max-width: 150px;
    aspect-ratio: 1 / 1.1;
    border: 14px solid #d9cfba;
    border-bottom: 0;
    border-radius: 999px 999px 0 0;
    margin-bottom: -40px;
  }
  .tote-bag {
    position: relative;
    width: 76%;
    max-width: 320px;
    aspect-ratio: 1 / 1.1;
    background: var(--ud-canvas);
    color: var(--ud-ink);
    container-type: inline-size;
    overflow: hidden;
    box-shadow: 0 14px 30px rgb(0 0 0 / 0.12);
    background-image: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.025) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.02) 0 1px, transparent 1px 3px);
  }
  .tote-wm {
    position: absolute;
    right: 14cqi;
    bottom: 14cqi;
  }

  .video {
    background:
      radial-gradient(ellipse 60% 70% at 70% 30%, #6b5a4a 0%, transparent 70%),
      radial-gradient(ellipse 50% 60% at 15% 80%, #3a2d26 0%, transparent 70%),
      linear-gradient(#2a221e, #1a1512);
    color: var(--ud-paper);
  }
  .video-person {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 44cqi;
    height: 46cqi;
    transform: translateX(-30%);
    background:
      radial-gradient(circle at 50% 24%, #4b3d33 0 11cqi, transparent 11.2cqi),
      radial-gradient(ellipse 50% 46% at 50% 100%, #3b2f28 0 99%, transparent 100%);
    filter: blur(0.6px);
  }
  .video-bug {
    position: absolute;
    right: 4cqi;
    top: 4cqi;
    opacity: 0.85;
  }
  .lower {
    position: absolute;
    left: 5cqi;
    bottom: 7cqi;
    padding: 2cqi 3cqi 2.2cqi;
    border-left: 0.8cqi solid var(--ud-primary);
  }
  .lower-name {
    font-family: var(--ud-display);
    font-size: 4cqi;
    line-height: 1;
