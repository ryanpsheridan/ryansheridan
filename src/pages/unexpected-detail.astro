/*
  Type pattern, after the hang tag Marcy sent: the name repeated in rows that
  run off both edges, each row stepped sideways, with one word picked out in
  peach. `rows` is one entry per line: how far it shifts left (em) and its
  words. "@{...}" marks the one phrase that turns peach and takes the period.
*/
const typePattern = (style: string, rows: { shift: number; words: string }[]) =>
  mark(
    `position:absolute;${style}`,
    rows
      .map(
        (r) =>
          `<span style="display:block;margin-left:${-r.shift}em">${r.words.replace(
            /@\{([^}]+)\}/,
            `<span style="color:var(--ud-peach)">$1</span>${peachDot}`,
          )}</span>`,
      )
      .join(""),
  );
