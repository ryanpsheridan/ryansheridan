  html: typePattern(
    "left:-34cqi;top:-16cqi;transform:rotate(-8deg);font-family:'Fraunces',serif;font-size:9cqi;font-weight:600;line-height:1.22;letter-spacing:-.01em;font-variation-settings:'SOFT' 100",
    Array.from({ length: 14 }, (_, i) => ({
      shift: i === 5 ? -2.6 : [0, 3.4, 1.2, 4.6, 2.3, 5.5][i % 6],
      words: i === 5 ? `detail @{unexpected detail} ${twice(pair, 3)}` : twice(pair),
    })),
  ),
};
const patternAlt: Thumb = {
  id: "",
  tag: ALT,
  name: "Type pattern, one detail",
  source: "Reference: the repeated word hang tag",
  note: "Straight rows of “unexpected” in a heavier serif. One line breaks the pattern with “unexpected detail” in peach.",
  bg: "var(--ud-paper)",
  color: "var(--ud-ink)",
  html: typePattern(
    "left:0;top:-4cqi;font-family:'DM Serif Display',serif;font-size:11.5cqi;line-height:1.08;letter-spacing:-.015em",
    Array.from({ length: 9 }, (_, i) => ({
      shift: [0.9, 3.6, 2.1, 4.8, -0.4, 3.1, 0.5, 4.2, 2.6][i],
      words: i === 4 ? "@{unexpected detail} unexpected unexpected" : twice("unexpected"),
    })),
  ),
};

const r2Rows: Thumb[][] = [
  [
    { ...tile("T4"), prev: "T4", tag: PICK },
    {
      id: "",
      tag: ALT,
      name: "Rings, right flush",
      source: "Wordmark from 04, hanging period",
      note: "The rings move to the left and the wordmark takes the right flush setting, with the period hanging outside the edge.",
      bg: "var(--ud-paper)",
      color: "var(--ud-ink)",
      html:
        art(
          `<g fill="none" stroke="currentColor" stroke-width=".6">` +
            [7, 14, 21, 28, 35].map((r, i) => `<circle cx="${i === 2 ? 22 : 26}" cy="${i === 2 ? 32 : 29}" r="${r}"/>`).join("") +
            "</g>",
        ) +
        mark(
          "position:absolute;right:11.4cqi;bottom:9cqi;text-align:right;font-family:'DM Serif Display',serif;font-size:12.5cqi;line-height:.9;letter-spacing:-.015em",
          `unexpected<br>detail${hangingDot}`,
        ),
    },
    { ...tile("T4"), tag: DARK, name: "Rings, dark", bg: cocoa, color: "var(--ud-paper)" },
  ],
  [
    { ...tile("T5"), prev: "T5", tag: PICK },
    {
      id: "",
      tag: ALT,
      name: "Dots, one stroke wordmark",
      source: "Wordmark from pick 07 (prev. 21)",
      note: "Same grid and the same peach dot, with the one stroke wordmark from the logo picks underneath.",
      bg: "var(--ud-paper)",
      color: "var(--ud-ink)",
      html:
        artOf(tile("T5")) +
        mark(
          "position:absolute;left:11.4cqi;bottom:9cqi;font-family:'Geist',sans-serif;font-size:13cqi;font-weight:500;line-height:.84;letter-spacing:-.04em",
          '<span style="display:block;padding-left:.0594em">unexpected</span><span style="display:block">detail</span>',
        ),
    },
    { ...tile("T5"), tag: DARK, name: "Dots, dark", bg: cocoa, color: "var(--ud-paper)" },
  ],
  [
    { ...tile("T8"), prev: "T8", tag: PICK },
    { ...tile("T12"), prev: "T12", tag: ALT },
    { ...tile("T8"), tag: DARK, name: "Missing dot, dark", bg: cocoa, color: "var(--ud-paper)" },
  ],
  [
    { ...tile("T10"), prev: "T10", tag: PICK },
    {
      id: "",
      tag: ALT,
      name: "Turned square, right flush",
      source: "Wordmark from 04, hanging period",
      note: "The same grid with the wordmark on two lines, flush right against the edge of the squares, and the period hanging outside it.",
      bg: "var(--ud-paper)",
      color: "var(--ud-ink)",
      html:
        artOf(tile("T10")) +
        mark(
          "position:absolute;right:11.4cqi;bottom:9cqi;text-align:right;font-family:'DM Serif Display',serif;font-size:12.5cqi;line-height:.9;letter-spacing:-.015em",
          `unexpected<br>detail${hangingDot}`,
        ),
    },
    { ...tile("T10"), tag: DARK, name: "Turned square, dark", bg: cocoa, color: "var(--ud-paper)" },
  ],
  [
    { ...tile("T11"), prev: "T11", tag: PICK },
    {
      id: "",
      tag: ALT,
      name: "Leaning line, stacked",
      source: "Wordmark in Fraunces, as pick 05 (prev. 18)",
      note: "The same lines with a heavier two-line wordmark and no hook, for a tile that holds up better at small sizes.",
      bg: "var(--ud-paper)",
      color: "var(--ud-ink)",
      html:
        artOf(tile("T11")) +
        mark(
          "position:absolute;left:11.4cqi;bottom:9cqi;font-family:'Fraunces',serif;font-size:12.5cqi;font-weight:800;line-height:.9;letter-spacing:-.025em;font-variation-settings:'SOFT' 100",
          `unexpected<br>detail${peachDot}`,
        ),
    },
    { ...tile("T11"), tag: DARK, name: "Leaning line, dark", bg: cocoa, color: "var(--ud-paper)" },
  ],
  [patternTile, patternAlt, { ...patternTile, tag: DARK, name: "Type pattern, dark", bg: cocoa, color: "var(--ud-paper)" }],
];
const r2Tiles: Thumb[] = r2Rows.flat().map((t, i) => ({
  ...t,
  note: t.tag === DARK ? "" : t.note,
  id: pad(r2Logos.length + i + 1),
}));

type LogoSection = { kind: "logos"; id: string; heading: string; intro: string; items: Logo[] };
type TileSection = { kind: "tiles"; id: string; heading: string; intro: string; items: Thumb[] };
type Round = { id: string; title: string; intro: string; r2?: boolean; sections: (LogoSection | TileSection)[] };

const rounds: Round[] = [
  {
    id: "round-02",
    title: "Round 02",
    intro: "Included are picks from round 1, each beside a close alternate.",
    r2: true,
    sections: [
      {
        kind: "logos",
        id: "r2-logos",
        heading: "Logos",
        intro: "Pick on the left, alternate on the right.",
        items: r2Logos,
      },
      {
        kind: "tiles",
        id: "r2-tiles",
        heading: "Thumbnails",
        intro: 'Each row is a pick or a new direction, an alternate, and a dark version. Color takes are under <a href="#color-heading">Color and atmosphere directions</a>.',
        items: r2Tiles,
      },
    ],
  },
  {
    id: "round-01",
    title: "Round 01",
    intro: "Everything from the first round, with its original numbers.",
    sections: [
      {
        kind: "logos",
        id: "explore-heading",
        heading: "Logo explorations",
        intro: "Type and alignment studies, shown light and dark.",
        items: studies.map((l) => (pickedLogos.includes(l.no) ? { ...l, tag: "Picked for round 02" } : l)),
      },
      {
        kind: "tiles",
        id: "thumbs-heading",
        heading: "Thumbnail directions",
        intro: "How the wordmark could live on a podcast tile.",
        items: thumbs.map((t) => (pickedTiles.includes(t.id) ? { ...t, tag: "Picked for round 02" } : t)),
      },
      {
        kind: "tiles",
        id: "color-heading",
        heading: "Color and atmosphere directions",
        intro: "Concepts based on Marcy's references.",
        items: colorThumbs,
      },
    ],
  },
];

const pageNav = [
  ...rounds.map((r) => ({
    title: r.title,
    items: r.sections.map((sec) => ({ href: `#${sec.id}`, label: sec.heading, count: sec.items.length as number | undefined })),
  })),
  {
    title: "Reference",
    items: [
      { href: "#brief", label: "Brief", count: undefined },
      { href: "#direction", label: "Direction from kickoff", count: undefined },
    ],
  },
];

const periodLine = (logo: Logo) => logo.periodOn ?? logo.lines.length - 1;


const fontsHref =
  "https://fonts.googleapis.com/css2" +
  "?family=Bricolage+Grotesque:opsz,wght@12..96,700" +
  "&family=Corben:wght@700" +
  "&family=DM+Serif+Display" +
  "&family=EB+Garamond:wght@500" +
  "&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1" +
  "&family=Gloock" +
  "&family=Instrument+Serif:ital@0;1" +
    "&family=Playfair+Display:ital,wght@0,900;1,900" +
  "&family=Source+Serif+4:ital,opsz,wght@1,8..60,600" +
  "&family=Young+Serif" +
  "&display=swap";
---

<Layout
  title="unexpected detail — Ryan Sheridan"
  description="Working canvas for the unexpected detail podcast identity."
  noindex={true}
>
  <link rel="stylesheet" href={fontsHref} />
  <Nav />
  <main id="main" class="ud-page">
    <div class="ud-inner">
      <header class="ud-header">
        <p class="label">Podcast identity · working canvas</p>
        <h1>unexpected detail</h1>
        <p class="intro">
          An unscripted conversation show hosted by Marcy. Every episode is a detour with someone
          remarkable, past the résumé and into the left turns, half-baked ideas, and quiet
          obsessions kept off camera.
        </p>
      </header>

      <div class="ud-layout">
        <div class="ud-main">
          {
            rounds.map((round) => (
              <div class:list={["ud-round", { r2: round.r2 }]} id={round.id}>
                <header class="round-head">
                  <h2 class="round-title">{round.title}</h2>
                  <p class="section-note">{round.intro}</p>
                </header>
                {
                  round.sections.map((section) => (
                    <section class="ud-section" aria-labelledby={section.id}>
                      <h3 id={section.id} class="label">{section.heading}</h3>
                      <p class="section-note" set:html={section.intro} />

                      {section.kind === "logos" && (
                        <ol class="logo-list">
                          {section.items.map((logo) => (
                            <li class="logo-item">
                              <div class="tiles">
                                {(["light", "dark"] as const).map((theme) => (
                                  <div
                                    class={`tile tile--${theme}`}
                                    style={logo.place ? `place-items:${logo.place}` : undefined}
                                    role="img"
                                    aria-label={`${logo.name}, ${theme}`}
                                  >
                                    <p
                                      class:list={["lockup", { "lockup--free": logo.free }]}
                                      aria-hidden="true"
                                      style={`font-family:${logo.family};text-align:${logo.align ?? "center"};${logo.style ?? ""}`}
                                    >
                                      {logo.lines.map((line, j) => (
                                        <span class="line" style={line.style}>
                                          <Fragment set:html={line.text} />
                                          {logo.period && j === periodLine(logo) && (
                                            <span
                                              class={`dot dot--${logo.period}`}
                                              style={dotVars(`font-family:${logo.family};${logo.style ?? ""}`)}
                                            >.</span>
                                          )}
                                        </span>
                                      ))}
                                      {logo.extra && <Fragment set:html={logo.extra} />}
                                    </p>
                                  </div>
                                ))}
                              </div>
                              <div class="logo-meta">
                                {logo.tag && <p class:list={["tag", { "tag--pick": logo.tag !== ALT }]}>{logo.tag}</p>}
                                <p class="logo-title">
                                  <span class="num">{logo.label ?? pad(logo.no)}</span>
                                  <span>
                                    {logo.name}
                                    {logo.prev && <span class="prev">(prev. {logo.prev})</span>}
                                  </span>
                                </p>
                                {logo.note && <p class="logo-note">{logo.note}</p>}
                                <p class="font-badge">{logo.font}</p>
                              </div>
                            </li>
                          ))}
                        </ol>
                      )}

                      {section.kind === "tiles" && (
                        <>
                          <ol class="thumb-list">
                            {section.items.map((t) => (
                              <li class="logo-item">
                                <div
                                  class="tile thumb"
                                  style={`background:${t.bg};color:${t.color}`}
                                  role="img"
                                  aria-label={`${t.id}, ${t.name}`}
                                >
                                  <Fragment set:html={t.html} />
                                </div>
                                <div class="logo-meta">
                                  {t.tag && <p class:list={["tag", { "tag--pick": t.tag === PICK || t.tag.startsWith("Picked") }]}>{t.tag}</p>}
                                  <p class="logo-title">
                                    <span class="num">{t.id}</span>
                                    <span>
                                      {t.name}
                                      {t.prev && <span class="prev">(prev. {t.prev})</span>}
                                    </span>
                                  </p>
                                  {t.note && <p class="logo-note">{t.note}</p>}
                                  <p class="font-badge">{fontOf(t)}</p>
                                </div>
                              </li>
                            ))}
                          </ol>

                          <div class="size-test">
                            <h4 class="label">Size test, 60px</h4>
                            <p class="size-note">The same tiles at feed size.</p>
                            <ul class="size-row">
                              {section.items.map((t) => (
                                <li>
                                  <div
                                    class="tile thumb"
                                    style={`background:${t.bg};color:${t.color}`}
                                    role="img"
                                    aria-label={`${t.id}, ${t.name}, at 60 pixels`}
                                  >
                                    <Fragment set:html={t.html} />
                                  </div>
                                  <span class="num">{t.id}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        </>
                      )}
                    </section>
                  ))
                }
              </div>
            ))
          }

          <div class="ud-round" id="reference">
            <header class="round-head">
              <h2 class="round-title">Reference</h2>
            </header>
            <section class="ud-brief" id="brief" aria-labelledby="brief-heading">
              <h3 id="brief-heading" class="label">Brief</h3>
              <dl class="brief-list">
                {
                  brief.map((item) => (
                    <div>
                      <dt>{item.label}</dt>
                      <dd>{item.lead}</dd>
                    </div>
                  ))
                }
              </dl>
            </section>

            <section class="ud-brief" id="direction" aria-labelledby="direction-heading">
              <h3 id="direction-heading" class="label">Direction from kickoff</h3>
              <ul class="direction">
                {direction.map((d) => <li>{d}</li>)}
              </ul>
            </section>
          </div>
        </div>

        <aside class="ud-sidebar">
          <div class="sidebar-inner">
            <nav class="meta-group" aria-label="On this page">
              <span class="label">On this page</span>
              {
                pageNav.map((group) => (
                  <div class="nav-group">
                    <span class="nav-title">{group.title}</span>
                    <ul class="page-nav">
                      {group.items.map((item) => (
                        <li>
                          <a href={item.href}>
                            {item.label}
                            {item.count && <span class="count">{item.count}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </nav>
            {
              taglines.map((t) => (
                <div class="meta-group">
                  <span class="label">{t.label}</span>
                  <p class="meta-value">{t.line}</p>
                </div>
              ))
            }
            <div class="meta-group">
              <span class="label">Pillars</span>
              <ul class="pillars">
                {pillars.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .ud-page {
    --ud-ink: #141414;
    --ud-cocoa: #15100d;
    --ud-paper: #faf9f6;
    --ud-peach: #f08a6c;
    --ud-gap: clamp(120px, 6rem + 6vw, 220px);
    padding: clamp(96px, 5rem + 6vw, 200px) var(--page-padding) var(--ud-gap);
  }

  .ud-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .ud-header {
    margin-bottom: var(--space-7);
  }

  h1 {
    font-size: clamp(32px, 1.4rem + 2.4vw, 64px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: var(--space-4) 0 var(--space-5);
  }

  .intro {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  /* Same shape as a project page: main column plus a sticky right rail. */
  .ud-layout {
    display: flex;
    align-items: stretch;
    gap: var(--space-8);
  }

  .ud-main {
    flex: 3 1 0%;
    min-width: 0;
  }

  .ud-sidebar {
    flex: 1 1 0%;
    min-width: 0;
  }

  .sidebar-inner {
    position: sticky;
    top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .meta-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .meta-group:first-child {
    padding-top: 0;
    border-top: none;
  }

  .meta-value {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.4;
  }

  .page-nav,
  .pillars {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pillars li {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.4;
  }

  .page-nav a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .page-nav a:hover,
  .page-nav a[aria-current="true"] {
    color: var(--color-text);
  }

  .page-nav .count {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  /* Brief and kickoff notes, kept short so the page opens on the designs. */
  .ud-brief {
    padding-bottom: var(--space-7);
    margin-bottom: var(--space-7);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: var(--space-8);
  }

  .ud-brief h3 {
    margin-bottom: var(--space-4);
  }

  .brief-list {
    display: grid;
    gap: var(--space-4);
  }

  .brief-list dt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .brief-list dd {
    font-size: var(--text-sm);
    margin: 0;
    max-width: 36ch;
  }

  .ud-section {
    margin-bottom: var(--ud-gap);
  }

  .ud-section > .label {
    scroll-margin-top: var(--space-8);
    margin-bottom: var(--space-7);
  }

  .ud-section:last-child {
    margin-bottom: 0;
  }

  /* Rounds: newest first, earlier rounds kept whole underneath. */
  .ud-round {
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--ud-gap);
    scroll-margin-top: var(--space-8);
  }

  .ud-round:first-child {
    padding-top: 0;
    border-top: none;
  }

  .round-head {
    margin-bottom: var(--space-8);
  }

  .round-title {
    font-size: clamp(26px, 1.2rem + 1.4vw, 44px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .round-head .section-note {
    margin: 0;
  }

  .section-note :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Round 02 dark tiles: a dark chocolate pulled most of the way to black. */
  .r2 .tile--dark {
    --tile-bg: var(--ud-cocoa);
    background: var(--ud-cocoa);
  }

  .tag {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .tag--pick {
    color: var(--color-text);
  }

  .tag--pick::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ud-peach);
  }

  .prev {
    color: var(--color-text-muted);
    margin-left: 0.4em;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .nav-title {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.4;
  }

  .nav-group .page-nav {
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-border);
  }

  .section-note {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 52ch;
    margin: calc(var(--space-7) * -1 + var(--space-4)) 0 var(--space-8);
  }

  .direction {
    list-style: none;
    display: grid;
    gap: var(--space-2);
    max-width: 64ch;
    counter-reset: dir;
  }

  .direction li {
    counter-increment: dir;
    display: grid;
    grid-template-columns: 3ch 1fr;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .direction li::before {
    content: counter(dir, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 12px;
    padding-top: 0.2em;
  }

  /* Logo studies */

  .logo-list {
    list-style: none;
    display: grid;
    gap: var(--space-8) var(--space-6);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  /* Fixed paper and ink regardless of site theme: these are artboards. */
  .tile {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .tile--light {
    --tile-bg: var(--ud-paper);
    background: var(--ud-paper);
    color: var(--ud-ink);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  .tile--dark {
    --tile-bg: var(--ud-ink);
    background: var(--ud-ink);
    color: var(--ud-paper);
  }

  .lockup {
    position: relative;
    font-kerning: normal;
    font-synthesis: none;
  }

  .line {
    display: block;
    white-space: nowrap;
  }

