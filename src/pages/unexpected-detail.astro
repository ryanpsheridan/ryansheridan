---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// Working canvas for the unexpected detail podcast identity. Private share,
// noindex, and kept out of the sitemap by the allowlist in astro.config.mjs.
// The brief below is lifted from the client's Working Creative Guide deck.
// The page itself uses the portfolio type; only the logo tiles change fonts.

const brief = [
  {
    label: "The Mission",
    lead: "To rescue human conversation from the résumé.",
    body: "Uncovering the unspoken quirks, wild turns, and quiet fascinations that make people who they truly are.",
  },
  {
    label: "Listener Promise",
    lead: "A fresh, indelible view into a mind you thought you knew.",
    body: "Leave every conversation with a surprising insight, an unprompted laugh, and proof that people are richer than their bios.",
  },
  {
    label: "The North Star",
    lead: "Break the talking-points loop. Uncover the eccentric truths.",
    body: "Strip away canned press tours and rehearsed answers. Catch brilliant people off guard, mid-laugh, sharing the obsessions that actually ignite them.",
  },
];

const taglines = [
  { label: "Primary hook", line: "Curiosity flips the frame." },
  { label: "Secondary invitation", line: "Everyone has one." },
];

const pillars = ["The Detour Over the Script", "Substance Without Pretense", "Generous Curiosity"];

// Notes from the kickoff call that should steer the logo work.
const direction = [
  "Lowercase, minimal, soft serif. The deck's typeface is a placeholder, not the answer.",
  "Explore stacking and alignment. Test the period, and whether it carries the color.",
  "Keep the wordmark simple. Color, texture, pattern, or photography in the cover tile is what makes it stand out in a podcast feed.",
  "Open to color and to an unconventional host photo.",
  "No tagline or description needed on the cover tile. Discovery happens in the show title and metadata.",
  "Needs to read at thumbnail size in a square tile, even though “unexpected” is a long word.",
];

/*
  Each lockup is drawn in a square tile twice, light and dark. Sizes are in
  cqi (percent of the tile's width), so a lockup keeps its proportions at any
  tile size, down to a podcast thumbnail.

  font:   CSS font-family for the whole lockup.
  lines:  one entry per line; `style` adds per-line CSS.
  period: "peach" | "ink" | undefined, appended to the last line (or periodOn).
  free:   lines are placed absolutely in the tile, for corner and edge layouts.
  align:  text-align inside the lockup.
  place:  where the lockup sits in the tile (CSS place-items).
  style:  extra CSS on the lockup (size, weight, leading, tracking).
*/
type Line = { text: string; style?: string };
type Logo = {
  /** Fixed study number, so feedback keeps pointing at the same study. */
  no: number;
  /** Extra HTML drawn inside the lockup, positioned in em from its top left. */
  extra?: string;
  name: string;
  font: string;
  note: string;
  family: string;
  lines: Line[];
  period?: "peach" | "ink";
  /** Which line carries the period. Defaults to the last. */
  periodOn?: number;
  /** Position each line absolutely in the tile through its own style. */
  free?: boolean;
  align?: "left" | "center" | "right";
  place?: string;
  style?: string;
};

/*
  Joins the p in "unexpected" to the l in "detail" as one straight stroke.
  A patch in the tile color hides the p's foot serif and the l's flag, then a
  bar the width of the stem bridges the two. All values are em from the
  lockup's top left, measured from the glyphs at the exact font settings on
  that study (optical size is pinned so the stem width holds at any tile size).
*/
type Join = { x: number; w: number; y1: number; y2: number; mx1: number; mx2: number; my1: number; my2: number };
const join = (j: Join) =>
  `<span style="position:absolute;left:${j.mx1}em;top:${j.my1}em;width:${(j.mx2 - j.mx1).toFixed(4)}em;height:${(j.my2 - j.my1).toFixed(4)}em;background:var(--tile-bg)"></span>` +
  `<span style="position:absolute;left:${j.x}em;top:${j.y1}em;width:${j.w}em;height:${(j.y2 - j.y1).toFixed(4)}em;background:currentColor"></span>`;

const logos: Logo[] = [
  {
    no: 1,
    name: "Classic stack",
    font: "Fraunces Black",
    note: "Her deck's direction, tightened. Centered stack, peach period.",
    family: '"Fraunces", serif',
    lines: [{ text: "unexpected" }, { text: "detail" }],
    period: "peach",
    style: "font-size:14cqi;font-weight:850;line-height:.88;letter-spacing:-.02em;font-variation-settings:'SOFT' 50",
  },
  {
    no: 3,
    name: "Stagger",
    font: "Gloock",
    note: "Second line steps right, so the stack reads like a turn in the road.",
    family: '"Gloock", serif',
    lines: [{ text: "unexpected" }, { text: "detail", style: "padding-left:1.6em" }],
    period: "peach",
    align: "left",
    style: "font-size:13cqi;line-height:.95;letter-spacing:-.01em",
  },
  {
    no: 4,
    name: "Single line, italic turn",
    font: "Instrument Serif",
    note: "One line. The italic on “detail” is the unexpected moment.",
    family: '"Instrument Serif", serif',
    lines: [{ text: "unexpected <i>detail</i>" }],
    period: "peach",
    style: "font-size:10.5cqi;line-height:1;letter-spacing:-.015em",
  },
  {
    no: 5,
    name: "Heavy italic",
    font: "Playfair Display Black",
    note: "Upright over italic in the same weight. High contrast, editorial.",
    family: '"Playfair Display", serif',
    lines: [{ text: "unexpected" }, { text: "<i>detail</i>" }],
    style: "font-size:13cqi;font-weight:900;line-height:.92;letter-spacing:-.02em",
  },
  {
    no: 6,
    name: "Scale shift",
    font: "Fraunces",
    note: "“unexpected” whispers, “detail” shouts. Strongest at thumbnail size.",
    family: '"Fraunces", serif',
    lines: [
      { text: "unexpected", style: "font-size:.32em;font-weight:400;letter-spacing:0;margin-bottom:.06em;padding-left:.12em" },
      { text: "detail" },
    ],
    period: "peach",
    align: "left",
    style: "font-size:24cqi;font-weight:850;line-height:.85;letter-spacing:-.03em;font-variation-settings:'SOFT' 50",
  },
  {
    no: 7,
    name: "Right flush",
    font: "DM Serif Display",
    note: "Ragged left, flush right. Pulls the eye to the period.",
    family: '"DM Serif Display", serif',
    lines: [{ text: "unexpected" }, { text: "detail" }],
    period: "peach",
    align: "right",
    style: "font-size:14cqi;line-height:.9;letter-spacing:-.015em",
  },
  {
    no: 9,
    name: "Climb",
    font: "Corben",
    note: "Both words horizontal now. A small “unexpected” sits on the shoulder of a large “detail”, one step up at the end of the word.",
    family: '"Corben", serif',
    lines: [
      { text: "unexpected", style: "font-size:.3em;letter-spacing:0;margin-bottom:.5em;padding-right:.5em" },
      { text: "detail" },
    ],
    period: "peach",
    align: "right",
    style: "font-size:19cqi;font-weight:700;line-height:.9;letter-spacing:-.02em",
  },
  {
    no: 11,
    name: "Full width",
    font: "Playfair Display Black",
    note: "“detail” set as large as the tile allows with even margins on both sides. Nothing cropped.",
    family: '"Playfair Display", serif',
    lines: [
      { text: "unexpected", style: "font-size:.24em;letter-spacing:0;margin-bottom:.1em;padding-left:.2em" },
      { text: "detail" },
    ],
    period: "peach",
    align: "left",
    style: "font-size:27cqi;font-weight:900;line-height:.9;letter-spacing:-.02em",
  },
  {
    no: 12,
    name: "Rounded serif",
    font: "Young Serif",
    note: "Soft, chunky, warm. The closest match to “soft serif.”",
    family: '"Young Serif", serif',
    lines: [{ text: "unexpected" }, { text: "detail" }],
    period: "peach",
    style: "font-size:12.5cqi;line-height:.98;letter-spacing:-.02em",
  },
  {
    no: 13,
    name: "Light stack",
    font: "Fraunces Light",
    note: "A plain two-line stack in a light weight. The p drops straight into the l as one clean line, with the serifs taken off where they meet.",
    family: '"Fraunces", serif',
    lines: [{ text: "unexpected", style: "padding-left:.0119em" }, { text: "detail" }],
    extra: join({ x: 2.1498, w: 0.0675, y1: 0.651, y2: 1.531, mx1: 2.062, mx2: 2.31, my1: 0.871, my2: 1.185 }),
    period: "peach",
    align: "left",
    style: "font-size:15cqi;font-weight:300;line-height:.98;letter-spacing:-.03em;font-variation-settings:'SOFT' 100,'opsz' 40",
  },
  {
    no: 15,
    name: "Grotesk counterpoint",
    font: "Bricolage Grotesque",
    note: "A sans for contrast. Quirky ink traps keep it from feeling corporate.",
    family: '"Bricolage Grotesque", sans-serif',
    lines: [{ text: "unexpected" }, { text: "detail" }],
    period: "peach",
    align: "left",
    style: "font-size:14cqi;font-weight:700;line-height:.88;letter-spacing:-.045em;font-variation-settings:'opsz' 96",
  },
  {
    no: 16,
    name: "Clean sans",
    font: "Geist",
    note: "Neutral and modern. Useful as a baseline to judge the serifs against.",
    family: '"Geist", sans-serif',
    lines: [{ text: "unexpected" }, { text: "detail" }],
    period: "peach",
    align: "left",
    style: "font-size:14cqi;font-weight:500;line-height:.92;letter-spacing:-.05em",
  },
  {
    no: 18,
    name: "Echo",
    font: "Fraunces ExtraBold",
    note: "Two very faint repeats fade up from a quiet “unexpected”, and one solid “detail” lands underneath.",
    family: '"Fraunces", serif',
    lines: [
      { text: "unexpected", style: "opacity:.07" },
      { text: "unexpected", style: "opacity:.16" },
      { text: "unexpected", style: "opacity:.5" },
      { text: "detail" },
    ],
    period: "peach",
    align: "left",
    style: "font-size:14cqi;font-weight:800;line-height:.94;letter-spacing:-.025em;font-variation-settings:'SOFT' 100",
  },
  {
    no: 19,
    name: "Corner lockup",
    font: "EB Garamond",
    note: "Pinned bottom left, leaving open field for a photo or pattern later.",
    family: '"EB Garamond", serif',
    lines: [{ text: "unexpected" }, { text: "detail" }],
    period: "peach",
    align: "left",
    place: "end start",
    style: "font-size:11cqi;font-weight:500;line-height:.92;letter-spacing:-.02em;margin:0 0 8cqi 8cqi",
  },
  {
    no: 20,
    name: "Monogram",
    font: "Fraunces + Geist",
    note: "A “ud.” mark for the tile, with the full name small beneath.",
    family: '"Fraunces", serif',
    lines: [
      { text: "ud", style: "font-size:1em" },
      { text: "unexpected detail", style: "font-family:'Geist',sans-serif;font-size:.11em;font-weight:500;letter-spacing:.02em;margin-top:.25em" },
    ],
    period: "peach",
    periodOn: 0,
    style: "font-size:38cqi;font-weight:850;line-height:.8;letter-spacing:-.04em;font-variation-settings:'SOFT' 100",
  },
];

/*
  Studies that each hide one deliberate detail, after the
  accidental one in study 19 where the p's descender lands on the l. The em
  offsets below are measured glyph widths for the exact font, weight and
  tracking on that study, so retune them if any of those change.
*/
const peach = (text: string) => `<span style="color:var(--ud-peach)">${text}</span>`;

const details: Logo[] = [
  {
    no: 21,
    name: "One stroke",
    font: "Geist Medium",
    note: "Study 19's accident, made deliberate. The p's descender and the l sit on exactly the same axis and fuse into one long stroke.",
    family: '"Geist", sans-serif',
    lines: [{ text: "unexpected", style: "padding-left:.0594em" }, { text: "detail" }],
    period: "peach",
    align: "left",
    style: "font-size:15cqi;font-weight:500;line-height:.84;letter-spacing:-.04em",
  },
  {
    no: 22,
    name: "Shared d",
    font: "Fraunces SemiBold",
    note: "“unexpected” ends on the letter “detail” starts with, so one d does both jobs. It carries the peach and the period steps aside.",
    family: '"Fraunces", serif',
    lines: [{ text: `unexpecte${peach("d")}etail` }],
    style: "font-size:11.5cqi;font-weight:600;line-height:1;letter-spacing:-.02em;font-variation-settings:'SOFT' 100",
  },
  {
    no: 23,
    name: "Domino",
    font: "Gloock",
    note: "The second line starts exactly under the last letter of the first. d sits on d, like two tiles matched end to end.",
    family: '"Gloock", serif',
    lines: [{ text: "unexpected" }, { text: "detail", style: "padding-left:4.62em" }],
    period: "peach",
    align: "left",
    style: "font-size:11cqi;line-height:.95;letter-spacing:-.01em",
  },
  {
    no: 24,
    name: "Stacked t",
    font: "DM Serif Display",
    note: "“detail” slides right until its t stands directly under the t in “unexpected”. One vertical runs through both words.",
    family: '"DM Serif Display", serif',
    lines: [{ text: "unexpected" }, { text: "detail", style: "padding-left:2.616em" }],
    period: "peach",
    align: "left",
    style: "font-size:13cqi;line-height:.86;letter-spacing:-.015em",
  },
  {
    no: 25,
    name: "Fallen dot",
    font: "Fraunces Soft",
    note: "The i has lost its dot. It dropped to the baseline, turned peach, and became the period.",
    family: '"Fraunces", serif',
    lines: [{ text: "unexpected" }, { text: "detaıl" }],
    period: "peach",
    style: "font-size:14cqi;font-weight:650;line-height:.9;letter-spacing:-.02em;font-variation-settings:'SOFT' 100",
  },
  {
    no: 28,
    name: "Mirror hinge",
    font: "Young Serif",
    note: "The name hides a mirror: “ted” closes one word and “det” opens the next. The period lifts off the baseline to mark the hinge.",
    family: '"Young Serif", serif',
    lines: [
      { text: `unexpected<span style="color:var(--ud-peach);position:relative;top:-.2em;margin:0 .03em">.</span>detail` },
    ],
    style: "font-size:9.4cqi;line-height:1;letter-spacing:-.02em",
  },
  {
    no: 29,
    name: "Runaway period",
    font: "Young Serif",
    note: "The wordmark sits bottom left with nothing after it. Its period has wandered to the opposite corner.",
    family: '"Young Serif", serif',
    free: true,
    lines: [
      { text: '<span style="display:block;width:.24em;height:.24em;border-radius:50%;background:var(--ud-peach)"></span>', style: "right:8cqi;top:8cqi" },
      { text: "unexpected", style: "left:8cqi;bottom:20cqi" },
      { text: "detail", style: "left:8cqi;bottom:8cqi" },
    ],
    style: "font-size:12.5cqi;line-height:1;letter-spacing:-.02em",
  },
];

// One list. Numbers are fixed so feedback keeps pointing at the same study,
// which leaves gaps where a study has been cut.
const studies = [...logos, ...details];

/*
  How the wordmark could live on a podcast tile. Each tile is an HTML string
  with inline styles (still sized in cqi) so the same artwork can be drawn
  twice: once large, once at 60px in the size test row. Only ink, paper and
  peach, and line work stays thin.
*/
type Thumb = { id: string; name: string; source: string; note: string; bg: string; color: string; html: string };

const peachDot = '<span style="color:var(--ud-peach)">.</span>';
const art = (inner: string) =>
  `<svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%" aria-hidden="true">${inner}</svg>`;
const mark = (style: string, inner: string) =>
  `<p style="margin:0;white-space:nowrap;font-kerning:normal;font-synthesis:none;${style}">${inner}</p>`;

// The primary hook, set small. Only on tiles with open space for it and a
// visual that already says the same thing.
const hook = (style: string) =>
  mark(
    `position:absolute;font-family:'Geist',sans-serif;font-size:3.4cqi;font-weight:400;line-height:1.2;letter-spacing:0;opacity:.75;${style}`,
    taglines[0].line,
  );

const dots = (fill: (row: number, col: number) => string) =>
  [14, 28, 42, 56]
    .flatMap((y, row) =>
      [15, 29, 43, 57, 71, 85].map((x, col) => `<circle cx="${x}" cy="${y}" r="3.6" fill="${fill(row, col)}"/>`),
    )
    .join("");

const sprockets = Array.from({ length: 18 }, (_, i) => {
  const x = 1.5 + i * 5.6;
  return `<rect x="${x}" y="24.2" width="2.8" height="2.2" rx=".5"/><rect x="${x}" y="53.6" width="2.8" height="2.2" rx=".5"/>`;
}).join("");

const thumbs: Thumb[] = [
  {
    id: "T3",
    name: "Contact sheet",
    source: "Wordmark from study 04",
    note: "A film strip reduced to thin outlines, running off both edges, with one frame circled in peach. Wordmark below.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(
        `<g fill="none" stroke="currentColor" stroke-width=".6">` +
          '<path d="M-2 23H102M-2 57H102"/>' +
          [-10, 17, 44, 71, 98].map((x) => `<rect x="${x}" y="30" width="24" height="20"/>`).join("") +
          `<path d="${Array.from({ length: 18 }, (_, i) => `M${(2.9 + i * 5.6).toFixed(1)} 25.2v2.6M${(2.9 + i * 5.6).toFixed(1)} 52.2v2.6`).join("")}"/>` +
          "</g>" +
          '<path d="M41 41 C41 24 70 21 72 39 C74 56 47 60 41 45 C37 34 49 23 62 24" fill="none" stroke="var(--ud-peach)" stroke-width="1" stroke-linecap="round"/>',
      ) +
      mark(
        "position:absolute;left:0;right:0;bottom:15cqi;text-align:center;font-family:'Instrument Serif',serif;font-size:10.5cqi;line-height:1;letter-spacing:-.015em",
        `unexpected <i style="font-style:italic">detail</i>${peachDot}`,
      ),
  },
  {
    id: "T4",
    name: "Rings, one off center",
    source: "Wordmark in Source Serif 4 Italic",
    note: "Was the object macro. Now thin concentric rings cropped by the tile edge, with one ring that has slipped out of line.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(
        `<g fill="none" stroke="currentColor" stroke-width=".6">` +
          [8, 16, 24, 32, 40].map((r, i) => `<circle cx="${i === 2 ? 78 : 74}" cy="${i === 2 ? 35 : 32}" r="${r}"/>`).join("") +
          "</g>",
      ) +
      mark(
        "position:absolute;left:11.4cqi;bottom:11cqi;font-family:'Source Serif 4',serif;font-style:italic;font-size:9cqi;font-weight:600;line-height:1;letter-spacing:-.015em",
        `unexpected detail${peachDot}`,
      ),
  },
  {
    id: "T5",
    name: "Pattern with one break",
    source: "Wordmark from study 01",
    note: "A regular grid of dots where one turns peach. It stands in for the period, so the wordmark drops its own.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(dots((row, col) => (row === 1 && col === 4 ? "var(--ud-peach)" : "currentColor"))) +
      mark(
        "position:absolute;left:11.4cqi;bottom:9cqi;font-family:'Fraunces',serif;font-size:12.5cqi;font-weight:850;line-height:.88;letter-spacing:-.02em;font-variation-settings:'SOFT' 50",
        "unexpected<br>detail",
      ),
  },
  {
    id: "T8",
    name: "Missing dot",
    source: "Wordmark from study 12",
    note: "The same grid with one dot gone. It turns up at the end of the wordmark as the period.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(dots((row, col) => (row === 2 && col === 1 ? "none" : "currentColor"))) +
      mark(
        "position:absolute;left:11.4cqi;bottom:9cqi;font-family:'Young Serif',serif;font-size:12cqi;line-height:.98;letter-spacing:-.02em",
        `unexpected<br>detail${peachDot}`,
      ),
  },
  {
    id: "T9",
    name: "Slipped stripe",
    source: "Wordmark from study 07",
    note: "Seven thin rules, one of them slid sideways and running off the edge. No extra color needed.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(
        [12, 19.5, 27, 34.5, 42, 49.5, 57]
          .map((y, i) => `<rect x="${i === 4 ? 30 : 11.4}" y="${y}" width="77.2" height=".7" rx=".35" fill="currentColor"/>`)
          .join(""),
      ) +
      mark(
        "position:absolute;left:11.4cqi;bottom:9cqi;font-family:'DM Serif Display',serif;font-size:12.5cqi;line-height:.9;letter-spacing:-.015em",
        `unexpected<br>detail${peachDot}`,
      ),
  },
  {
    id: "T10",
    name: "Turned square",
    source: "Wordmark from study 05",
    note: "A grid of outlined squares where one has turned on its corner. The break is in the shape, and the period keeps the peach.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(
        [14, 31, 48]
          .flatMap((y, row) =>
            [11.4, 28.4, 45.4, 62.4, 79.4].map((x, col) =>
              `<rect x="${x}" y="${y}" width="9.2" height="9.2" fill="none" stroke="currentColor" stroke-width=".6"${row === 1 && col === 3 ? ` transform="rotate(45 ${x + 4.6} ${y + 4.6})"` : ""}/>`,
            ),
          )
          .join(""),
      ) +
      mark(
        "position:absolute;left:11.4cqi;bottom:9cqi;font-family:'Playfair Display',serif;font-size:12cqi;font-weight:900;line-height:.92;letter-spacing:-.02em",
        `unexpected<br>detail${peachDot}`,
      ),
  },
  {
    id: "T11",
    name: "Leaning line",
    source: "Wordmark in Source Serif 4 Italic",
    note: "A row of upright lines with one that leans. The wordmark sits on a single italic line with the primary hook beneath it, since the leaning line is the frame being flipped.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(
        Array.from({ length: 14 }, (_, i) => {
          const x = 11.4 + i * 5.83;
          return `<rect x="${x}" y="14" width=".7" height="46" rx=".35" fill="currentColor"${i === 9 ? ` transform="rotate(14 ${x + 0.35} 60)"` : ""}/>`;
        }).join(""),
      ) +
      mark(
        "position:absolute;left:11.4cqi;bottom:16cqi;font-family:'Source Serif 4',serif;font-style:italic;font-size:9cqi;font-weight:600;line-height:1;letter-spacing:-.015em",
        `unexpected detail${peachDot}`,
      ) +
      hook("left:11.4cqi;bottom:9.5cqi"),
  },
  {
    id: "T12",
    name: "Missing dot, period size",
    source: "Wordmark from study 12",
    note: "Every dot in the grid is exactly the size of the period. One is missing from the grid, and that same dot sits after “detail” in peach.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(
        Array.from({ length: 7 }, (_, row) =>
          Array.from({ length: 12 }, (_, col) =>
            row === 3 && col === 8
              ? ""
              : `<circle cx="${(12.42 + col * 6.833).toFixed(2)}" cy="${(13 + row * 6.833).toFixed(2)}" r="1.02" fill="currentColor"/>`,
          ).join(""),
        ).join(""),
      ) +
      // The period is drawn, not typed, so it matches the grid dots exactly:
      // .17em of a 12cqi font is 2.04cqi, the diameter of r=1.02 above.
      mark(
        "position:absolute;left:11.4cqi;bottom:9cqi;font-family:'Young Serif',serif;font-size:12cqi;line-height:.98;letter-spacing:-.02em",
        'unexpected<br>detail<span style="display:inline-block;width:.17em;height:.17em;border-radius:50%;background:var(--ud-peach);margin-left:.05em"></span>',
      ),
  },
  {
    id: "T13",
    name: "Ruled lines, right flush",
    source: "Wordmark from study 07",
    note: "The leaning line turned on its side. Thin rules like a notebook page, one of them tilting, with the wordmark flush right.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(
        Array.from({ length: 8 }, (_, i) => {
          const y = 14 + i * 6;
          return `<rect x="11.4" y="${y}" width="77.2" height=".7" rx=".35" fill="currentColor"${i === 4 ? ` transform="rotate(-5 11.4 ${y})"` : ""}/>`;
        }).join(""),
      ) +
      mark(
        "position:absolute;right:11.4cqi;bottom:9cqi;text-align:right;font-family:'DM Serif Display',serif;font-size:12.5cqi;line-height:.9;letter-spacing:-.015em",
        `unexpected<br>detail${peachDot}`,
      ),
  },
  {
    id: "T14",
    name: "Leaning line, opposite corners",
    source: "Wordmark in Corben, split to opposite corners",
    note: "The leaning line on ink. The words split to opposite corners and the lines run through the gap between them.",
    bg: "var(--ud-ink)",
    color: "var(--ud-paper)",
    html:
      art(
        Array.from({ length: 14 }, (_, i) => {
          const x = 11.4 + i * 5.83;
          return `<rect x="${x}" y="33" width=".7" height="34" rx=".35" fill="currentColor"${i === 4 ? ` transform="rotate(14 ${x + 0.35} 67)"` : ""}/>`;
        }).join(""),
      ) +
      mark(
        "position:absolute;left:11.4cqi;top:8cqi;font-family:'Corben',serif;font-size:10.5cqi;font-weight:700;line-height:1;letter-spacing:-.02em",
        "unexpected",
      ) +
      mark(
        "position:absolute;right:11.4cqi;bottom:8cqi;font-family:'Corben',serif;font-size:10.5cqi;font-weight:700;line-height:1;letter-spacing:-.02em",
        `detail${peachDot}`,
      ),
  },
  {
    id: "T15",
    name: "Grid, one cell filled",
    source: "Wordmark from study 13",
    note: "A thin grid with a single peach cell, which stands in for the period. The wordmark moves to the top left in a light weight.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(
        '<rect x="62.87" y="62.83" width="12.87" height="12.87" fill="var(--ud-peach)"/>' +
          `<path fill="none" stroke="currentColor" stroke-width=".5" d="${
            Array.from({ length: 7 }, (_, i) => `M${(11.4 + i * 12.867).toFixed(2)} 37.1V88.57`).join("") +
            Array.from({ length: 5 }, (_, i) => `M11.4 ${(37.1 + i * 12.867).toFixed(2)}H88.6`).join("")
          }"/>`,
      ) +
      mark(
        "position:absolute;left:11.4cqi;top:8cqi;font-family:'Fraunces',serif;font-size:12.5cqi;font-weight:300;line-height:.98;letter-spacing:-.03em;font-variation-settings:'SOFT' 100",
        "unexpected<br>detail",
      ),
  },
  {
    id: "T16",
    name: "Detour",
    source: "Wordmark from study 19",
    note: "One thin line crosses the whole tile and takes a single detour on the way. The wordmark sits on the line and the primary hook sits under it.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art('<path d="M-2 60H58l5 -9h10l5 9H102" fill="none" stroke="currentColor" stroke-width=".7" stroke-linejoin="round"/>') +
      mark(
        "position:absolute;left:11.4cqi;bottom:43cqi;font-family:'EB Garamond',serif;font-size:12cqi;font-weight:500;line-height:.92;letter-spacing:-.02em",
        `unexpected<br>detail${peachDot}`,
      ) +
      hook("left:11.4cqi;top:66cqi"),
  },
];

/*
  Color and atmosphere directions, after the five references Marcy sent:
  gradient depth (Fat Mascara), deep indigo with rings (Twenty Thousand
  Hertz), slate and mint (Design Matters), and diagonal pattern with legible
  lettering (Articles of Interest). These are the only tiles that leave the
  ink, paper and peach palette.
*/
const indigo = "#170d38";
const plum = "#4a1a7a";
const magenta = "#d6249f";
const violet = "#8f6bff";
const sky = "#5c9bff";
const slate = "#47484b";
const mint = "#a6e3d8";

// Film grain for depth. Sized in px, so it stays fine at any tile size.
const grain = (opacity: number) =>
  `<svg style="position:absolute;inset:0;width:100%;height:100%;mix-blend-mode:soft-light;opacity:${opacity}" aria-hidden="true"><filter id="ud-grain"><feTurbulence type="fractalNoise" baseFrequency=".85" numOctaves="2" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#ud-grain)"/></svg>`;

const stack = (style: string, period = peachDot) => mark(style, `unexpected<br>detail${period}`);
const bottomLeft = "position:absolute;left:11.4cqi;bottom:9cqi;";

const colorThumbs: Thumb[] = [
  {
    id: "C1",
    name: "Dusk gradient",
    source: "Reference: Fat Mascara, background depth",
    note: "A soft gradient with grain, peach glowing at the top and falling to indigo. The type stays a plain upright serif, nothing curvy.",
    bg: `linear-gradient(190deg,var(--ud-peach) 0%,#c0268f 42%,${plum} 72%,${indigo} 100%)`,
    color: "var(--ud-paper)",
    html:
      grain(0.55) +
      stack(bottomLeft + "font-family:'Fraunces',serif;font-size:13cqi;font-weight:850;line-height:.88;letter-spacing:-.02em;font-variation-settings:'SOFT' 50"),
  },
  {
    id: "C2",
    name: "Dusk, leaning line",
    source: "Reference: Fat Mascara, background depth",
    note: "The leaning line on a glow that comes in from one corner. The one line that leans picks up the peach.",
    bg: `radial-gradient(130% 100% at 15% 0%,${magenta} 0%,#6a1f96 40%,${indigo} 85%)`,
    color: "var(--ud-paper)",
    html:
      grain(0.5) +
      art(
        Array.from({ length: 14 }, (_, i) => {
          const x = 11.4 + i * 5.83;
          return `<rect x="${x}" y="14" width=".7" height="46" rx=".35" fill="${i === 9 ? "var(--ud-peach)" : "currentColor"}"${i === 9 ? ` transform="rotate(14 ${x + 0.35} 60)"` : ""}/>`;
        }).join(""),
      ) +
      mark(
        "position:absolute;left:11.4cqi;bottom:11cqi;font-family:'Source Serif 4',serif;font-style:italic;font-size:9cqi;font-weight:600;line-height:1;letter-spacing:-.015em",
        `unexpected detail${peachDot}`,
      ),
  },
  {
    id: "C3",
    name: "Grain and a dot",
    source: "Reference: Fat Mascara, texture",
    note: "Heavier grain on a slow indigo to plum fade. The wordmark sits light at the top and the period grows into a single peach dot below, with the primary hook small beside it.",
    bg: `linear-gradient(155deg,${indigo} 0%,${plum} 60%,#a0238f 115%)`,
    color: "var(--ud-paper)",
    html:
      grain(0.8) +
      '<span style="position:absolute;right:11.4cqi;bottom:11.4cqi;width:26cqi;height:26cqi;border-radius:50%;background:var(--ud-peach)"></span>' +
      mark(
        "position:absolute;left:11.4cqi;top:8cqi;font-family:'Fraunces',serif;font-size:13cqi;font-weight:300;line-height:.98;letter-spacing:-.03em;font-variation-settings:'SOFT' 100",
        "unexpected<br>detail",
      ) +
      hook("left:11.4cqi;bottom:11.4cqi"),
  },
  {
    id: "C4",
    name: "Indigo rings",
    source: "Reference: Twenty Thousand Hertz, atmosphere and palette",
    note: "Broken rings in magenta, violet and blue on deep indigo. One ring has slipped off center and turned peach.",
    bg: `radial-gradient(circle at 68% 28%,#3b1774 0%,${indigo} 62%)`,
    color: "var(--ud-paper)",
    html:
      art(
        `<g fill="none" stroke-width="1.3" stroke-linecap="round">` +
          [
            [6, magenta, "26 12", 20],
            [11.5, violet, "50 22", 200],
            [17, sky, "58 49", 80],
            [22.5, "var(--ud-peach)", "96 45", 310],
            [28, magenta, "120 56", 140],
            [33.5, violet, "72 138", 250],
            [39, sky, "160 85", 30],
          ]
            .map(([r, c, dash, rot], i) => {
              const cx = i === 3 ? 72 : 68, cy = i === 3 ? 31 : 28;
              return `<circle cx="${cx}" cy="${cy}" r="${r}" stroke="${c}" stroke-dasharray="${dash}" transform="rotate(${rot} ${cx} ${cy})"/>`;
            })
            .join("") +
          "</g>",
      ) +
      stack(bottomLeft + "bottom:8cqi;font-family:'DM Serif Display',serif;font-size:12cqi;line-height:.9;letter-spacing:-.015em"),
  },
  {
    id: "C5",
    name: "Indigo, missing dot",
    source: "Reference: Twenty Thousand Hertz, palette",
    note: "The period-size dot grid in violet on indigo. One dot is missing from the grid and sits after “detail” in peach.",
    bg: `linear-gradient(180deg,#24124f 0%,${indigo} 100%)`,
    color: "var(--ud-paper)",
    html:
      art(
        Array.from({ length: 7 }, (_, row) =>
          Array.from({ length: 12 }, (_, col) =>
            row === 3 && col === 8
              ? ""
              : `<circle cx="${(12.42 + col * 6.833).toFixed(2)}" cy="${(13 + row * 6.833).toFixed(2)}" r="1.02" fill="${violet}"/>`,
          ).join(""),
        ).join(""),
      ) +
      mark(
        bottomLeft + "font-family:'Young Serif',serif;font-size:12cqi;line-height:.98;letter-spacing:-.02em",
        'unexpected<br>detail<span style="display:inline-block;width:.17em;height:.17em;border-radius:50%;background:var(--ud-peach);margin-left:.05em"></span>',
      ),
  },
  {
    id: "C6",
    name: "Indigo detour",
    source: "Reference: Twenty Thousand Hertz, palette",
    note: "One line crosses the tile and takes a detour, fading from magenta to blue as it goes. The wordmark sits on it.",
    bg: `radial-gradient(120% 90% at 80% 100%,#3b1774 0%,${indigo} 60%)`,
    color: "var(--ud-paper)",
    html:
      art(
        `<defs><linearGradient id="ud-detour" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="${magenta}"/><stop offset="1" stop-color="${sky}"/></linearGradient></defs>` +
          '<path d="M-2 60H58l5 -9h10l5 9H102" fill="none" stroke="url(#ud-detour)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"/>',
      ) +
      stack("position:absolute;left:11.4cqi;bottom:43cqi;font-family:'EB Garamond',serif;font-size:12cqi;font-weight:500;line-height:.92;letter-spacing:-.02em"),
  },
  {
    id: "C7",
    name: "Slate and mint",
    source: "Reference: Design Matters, color scheme",
    note: "Mint type on slate, set large at the top left. The peach period has left the wordmark for the opposite corner, and the primary hook sits in paper across from it.",
    bg: slate,
    color: mint,
    html:
      '<span style="position:absolute;right:11.4cqi;bottom:11.4cqi;width:3.6cqi;height:3.6cqi;border-radius:50%;background:var(--ud-peach)"></span>' +
      mark(
        "position:absolute;left:11.4cqi;top:8cqi;font-family:'Fraunces',serif;font-size:14.5cqi;font-weight:850;line-height:.88;letter-spacing:-.02em;font-variation-settings:'SOFT' 50",
        "unexpected<br>detail",
      ) +
      `<span style="color:var(--ud-paper)">${hook("left:11.4cqi;bottom:11.4cqi")}</span>`,
  },
  {
    id: "C8",
    name: "Slate, slipped rule",
    source: "Reference: Design Matters, color scheme",
    note: "Thin mint rules on slate with one that has slid off the edge. Wordmark in paper, period in peach.",
    bg: slate,
    color: "var(--ud-paper)",
    html:
      art(
        [12, 19.5, 27, 34.5, 42, 49.5, 57]
          .map((y, i) => `<rect x="${i === 4 ? 30 : 11.4}" y="${y}" width="77.2" height=".7" rx=".35" fill="${mint}"/>`)
          .join(""),
      ) +
      stack(bottomLeft + "font-family:'DM Serif Display',serif;font-size:12.5cqi;line-height:.9;letter-spacing:-.015em"),
  },
  {
    id: "C9",
    name: "Diagonal blocks",
    source: "Reference: Articles of Interest, pattern concept",
    note: "Blocks of diagonal stripes that change direction like fabric swatches, with one block in peach. The name gets its own solid panel so it stays easy to read.",
    bg: "var(--ud-paper)",
    color: "var(--ud-paper)",
    html:
      art(
        `<defs>` +
          `<pattern id="ud-diag-a" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="2" height="5" fill="${indigo}"/></pattern>` +
          `<pattern id="ud-diag-b" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)"><rect width="2" height="5" fill="${indigo}"/></pattern>` +
          `<pattern id="ud-diag-c" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="2" height="5" fill="var(--ud-peach)"/></pattern>` +
          `</defs>` +
          '<rect x="0" y="0" width="34" height="31" fill="url(#ud-diag-a)"/>' +
          '<rect x="34" y="0" width="33" height="31" fill="url(#ud-diag-b)"/>' +
          '<rect x="67" y="0" width="33" height="31" fill="url(#ud-diag-a)"/>' +
          '<rect x="0" y="31" width="34" height="31" fill="url(#ud-diag-b)"/>' +
          '<rect x="34" y="31" width="33" height="31" fill="url(#ud-diag-c)"/>' +
          '<rect x="67" y="31" width="33" height="31" fill="url(#ud-diag-b)"/>' +
          `<rect x="0" y="62" width="100" height="38" fill="${indigo}"/>`,
      ) +
      stack(bottomLeft + "bottom:7.5cqi;font-family:'Playfair Display',serif;font-size:12cqi;font-weight:900;line-height:.92;letter-spacing:-.02em"),
  },
  {
    id: "C10",
    name: "Diagonal, one thread",
    source: "References: Articles of Interest pattern, Design Matters color",
    note: "A full field of fine mint diagonals on slate with a single peach thread running through. The wordmark sits on a clear panel cut out of the pattern.",
    bg: slate,
    color: "var(--ud-paper)",
    html:
      art(
        `<defs><pattern id="ud-diag-m" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width=".8" height="6" fill="${mint}"/></pattern></defs>` +
          '<rect width="100" height="100" fill="url(#ud-diag-m)"/>' +
          '<g transform="rotate(45)"><rect x="96" y="-100" width=".8" height="300" fill="var(--ud-peach)"/></g>' +
          `<rect x="0" y="58" width="80" height="34" fill="${slate}"/>`,
      ) +
      stack("position:absolute;left:11.4cqi;bottom:12.5cqi;font-family:'Young Serif',serif;font-size:12cqi;line-height:.98;letter-spacing:-.02em"),
  },
];

const tileSections = [
  {
    id: "thumbs-heading",
    heading: "Thumbnail directions",
    intro: "How the wordmark could live on a podcast tile. Each direction has one thing that is off, cropped, or out of place. Ink, paper, and peach only.",
    items: thumbs,
  },
  {
    id: "color-heading",
    heading: "Color and atmosphere directions",
    intro: "Concepts that follow Marcy's references: gradient depth and grain, deep indigo with rings, slate and mint, and diagonal pattern with lettering that stays legible. The idea underneath is the same, one thing off or out of place.",
    items: colorThumbs,
  },
];

const pageNav = [
  { href: "#brief", label: "Brief" },
  { href: "#direction", label: "Direction from kickoff" },
  { href: "#explore-heading", label: "Logo explorations", count: studies.length },
  ...tileSections.map((t) => ({ href: `#${t.id}`, label: t.heading, count: t.items.length })),
];

const periodLine = (logo: Logo) => logo.periodOn ?? logo.lines.length - 1;

const pad = (n: number) => String(n).padStart(2, "0");

const fontsHref =
  "https://fonts.googleapis.com/css2" +
  "?family=Bricolage+Grotesque:opsz,wght@12..96,700" +
  "&family=Corben:wght@700" +
  "&family=DM+Serif+Display" +
  "&family=EB+Garamond:wght@500" +
  "&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1" +
  "&family=Gloock" +
  "&family=Instrument+Serif:ital@0;1" +
    "&family=Playfair+Display:ital,wght@0,900;1,900" +
  "&family=Source+Serif+4:ital,opsz,wght@1,8..60,600" +
  "&family=Young+Serif" +
  "&display=swap";
---

<Layout
  title="unexpected detail — Ryan Sheridan"
  description="Working canvas for the unexpected detail podcast identity."
  noindex={true}
>
  <link rel="stylesheet" href={fontsHref} />
  <Nav />
  <main id="main" class="ud-page">
    <div class="ud-inner">
      <header class="ud-header">
        <p class="label">Podcast identity · working canvas</p>
        <h1>unexpected detail</h1>
        <p class="intro">
          An unscripted conversation show hosted by Marcy. Every episode is a detour with someone
          remarkable, past the résumé and into the left turns, half-baked ideas, and quiet
          obsessions kept off camera.
        </p>
      </header>

      <div class="ud-layout">
        <div class="ud-main">
      <section class="ud-brief" id="brief" aria-labelledby="brief-heading">
        <h2 id="brief-heading" class="label">Brief</h2>
        <dl class="brief-list">
          {
            brief.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.lead}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="ud-brief" id="direction" aria-labelledby="direction-heading">
        <h2 id="direction-heading" class="label">Direction from kickoff</h2>
        <ul class="direction">
          {direction.map((d) => <li>{d}</li>)}
        </ul>
      </section>

      <section class="ud-section" aria-labelledby="explore-heading">
        <h2 id="explore-heading" class="label">Logo explorations</h2>
        <p class="section-note">
          Type, alignment, and small deliberate details in the letters, each shown light and dark.
          Numbers stay fixed between rounds, so a gap is a study that was cut.
        </p>

        <ol class="logo-list">
          {
            studies.map((logo) => (
              <li class="logo-item">
                <div class="tiles">
                  {(["light", "dark"] as const).map((theme) => (
                    <div
                      class={`tile tile--${theme}`}
                      style={logo.place ? `place-items:${logo.place}` : undefined}
                      role="img"
                      aria-label={theme === "light" ? `${logo.name}, light` : `${logo.name}, dark`}
                    >
                      <p
                        class:list={["lockup", { "lockup--free": logo.free }]}
                        aria-hidden="true"
                        style={`font-family:${logo.family};text-align:${logo.align ?? "center"};${logo.style ?? ""}`}
                      >
                        {logo.lines.map((line, j) => (
                          <span class="line" style={line.style}>
                            <Fragment set:html={line.text} />
                            {logo.period && j === periodLine(logo) && (
                              <span class={`dot dot--${logo.period}`}>.</span>
                            )}
                          </span>
                        ))}
                        {logo.extra && <Fragment set:html={logo.extra} />}
                      </p>
                    </div>
                  ))}
                </div>
                <div class="logo-meta">
                  <p class="logo-title">
                    <span class="num">{pad(logo.no)}</span>
                    {logo.name}
                  </p>
                  <p class="logo-font">{logo.font}</p>
                  <p class="logo-note">{logo.note}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      {
        tileSections.map((section) => (
      <section class="ud-section" aria-labelledby={section.id}>
        <h2 id={section.id} class="label">{section.heading}</h2>
        <p class="section-note">{section.intro}</p>

        <ol class="thumb-list">
          {
            section.items.map((t) => (
              <li class="logo-item">
                <div
                  class="tile thumb"
                  style={`background:${t.bg};color:${t.color}`}
                  role="img"
                  aria-label={`${t.id}, ${t.name}`}
                >
                  <Fragment set:html={t.html} />
                </div>
                <div class="logo-meta">
                  <p class="logo-title">
                    <span class="num">{t.id}</span>
                    {t.name}
                  </p>
                  <p class="logo-font">{t.source}</p>
                  <p class="logo-note">{t.note}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="size-test">
          <h3 class="label">Size test, 60px</h3>
          <p class="size-note">
            The same tiles at feed size.
          </p>
          <ul class="size-row">
            {
              section.items.map((t) => (
                <li>
                  <div
                    class="tile thumb"
                    style={`background:${t.bg};color:${t.color}`}
                    role="img"
                    aria-label={`${t.id}, ${t.name}, at 60 pixels`}
                  >
                    <Fragment set:html={t.html} />
                  </div>
                  <span class="num">{t.id}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
        ))
      }
        </div>

        <aside class="ud-sidebar">
          <div class="sidebar-inner">
            <nav class="meta-group" aria-label="On this page">
              <span class="label">On this page</span>
              <ul class="page-nav">
                {
                  pageNav.map((item) => (
                    <li>
                      <a href={item.href}>
                        {item.label}
                        {item.count && <span class="count">{item.count}</span>}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
            {
              taglines.map((t) => (
                <div class="meta-group">
                  <span class="label">{t.label}</span>
                  <p class="meta-value">{t.line}</p>
                </div>
              ))
            }
            <div class="meta-group">
              <span class="label">Pillars</span>
              <ul class="pillars">
                {pillars.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .ud-page {
    --ud-ink: #141414;
    --ud-paper: #faf9f6;
    --ud-peach: #f08a6c;
    --ud-gap: clamp(120px, 6rem + 6vw, 220px);
