const rounds = [
  {
    id: "explore-heading",
    heading: "Logo explorations, round 01",
    note: "Twenty type and alignment studies, each shown light and dark. Color stays out of it for now apart from the peach period. Backgrounds, patterns, and photography come next.",
    logos,
    start: 1,
  },
  {
    id: "details-heading",
    heading: "Hidden details, round 03",
    note: "Ten more, each built around one deliberate detail in the letters themselves. They pick up from study 19, where the p in “unexpected” lands on the l in “detail”.",
    logos: details,
    start: logos.length + 1,
  },
];

/*
  Round 02: how the wordmark could live on a podcast tile. Each tile is an
  HTML string with inline styles (still sized in cqi) so the same artwork can
  be drawn twice: once large, once at 60px in the size test row. Photos are
  gray placeholder blocks, labeled with `.ph`, which the size test hides.
*/
type Thumb = { name: string; source: string; note: string; bg: string; color: string; html: string };

const peachDot = '<span style="color:var(--ud-peach)">.</span>';
const ph = (text: string, style: string) => `<span class="ph" style="${style}">${text}</span>`;
const art = (inner: string) =>
  `<svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%" aria-hidden="true">${inner}</svg>`;
const mark = (style: string, inner: string) =>
  `<p style="margin:0;white-space:nowrap;font-kerning:normal;font-synthesis:none;${style}">${inner}</p>`;

const dotGrid = [14, 28, 42, 56]
  .flatMap((y, row) =>
    [15, 29, 43, 57, 71, 85].map((x, col) => {
      const odd = row === 1 && col === 4;
      return `<circle cx="${x}" cy="${y}" r="3.6" fill="${odd ? "var(--ud-peach)" : "currentColor"}"/>`;
    }),
  )
  .join("");

const sprockets = Array.from({ length: 18 }, (_, i) => {
  const x = 1.5 + i * 5.6;
  return `<rect x="${x}" y="24.2" width="2.8" height="2.2" rx=".5"/><rect x="${x}" y="53.6" width="2.8" height="2.2" rx=".5"/>`;
}).join("");

const thumbs: Thumb[] = [
  {
    name: "Color field",
    source: "Wordmark from study 01",
    note: "One saturated field and nothing else. The peach period is the only accent.",
    bg: "#2438c9",
    color: "var(--ud-paper)",
    html: mark(
      "font-family:'Fraunces',serif;font-size:14cqi;font-weight:850;line-height:.88;letter-spacing:-.02em;font-variation-settings:'SOFT' 50;text-align:center",
      `unexpected<br>detail${peachDot}`,
    ),
  },
  {
    name: "Detail crop",
    source: "Wordmark from study 19",
    note: "A portrait pushed so far to the edge that only half a face and an earring stay in frame. Wordmark pinned bottom left.",
    bg: "#d2cfc9",
    color: "var(--ud-ink)",
    html:
      art(
        '<ellipse cx="104" cy="128" rx="62" ry="46" fill="#aaa69f"/>' +
          '<rect x="88" y="66" width="20" height="26" fill="#b3afa8"/>' +
          '<circle cx="102" cy="42" r="37" fill="#b3afa8"/>' +
          '<ellipse cx="66" cy="47" rx="5" ry="9" fill="#aaa69f"/>' +
          '<circle cx="65.5" cy="62" r="3.4" fill="none" stroke="var(--ud-paper)" stroke-width="1.3"/>',
      ) +
      ph("Placeholder photo", "left:8cqi;top:8cqi") +
      mark(
        "position:absolute;left:8cqi;bottom:8cqi;font-family:'EB Garamond',serif;font-size:11cqi;font-weight:500;line-height:.92;letter-spacing:-.02em",
        `unexpected<br>detail${peachDot}`,
      ),
  },
  {
    name: "Contact sheet",
    source: "Wordmark from study 04",
    note: "A strip of frames running off both edges, one circled in peach grease pencil. Wordmark below.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(
        '<rect x="-2" y="22" width="104" height="36" fill="#141414"/>' +
          `<g fill="#faf9f6" opacity=".85">${sprockets}</g>` +
          '<rect x="-10" y="29" width="24" height="22" fill="#8f8b85"/>' +
          '<rect x="17" y="29" width="24" height="22" fill="#b7b3ad"/>' +
          '<rect x="44" y="29" width="24" height="22" fill="#a39f98"/>' +
          '<rect x="71" y="29" width="24" height="22" fill="#c4c1bb"/>' +
          '<rect x="98" y="29" width="24" height="22" fill="#8f8b85"/>' +
          '<path d="M41 41 C41 24 70 21 72 39 C74 56 47 60 41 45 C37 34 49 23 62 24" fill="none" stroke="var(--ud-peach)" stroke-width="1.7" stroke-linecap="round"/>',
      ) +
      ph("Placeholder frames", "left:8cqi;top:11cqi") +
      mark(
        "position:absolute;left:0;right:0;bottom:15cqi;text-align:center;font-family:'Instrument Serif',serif;font-size:10.5cqi;line-height:1;letter-spacing:-.015em",
        `unexpected <i style="font-style:italic">detail</i>${peachDot}`,
      ),
  },
  {
    name: "Object macro",
    source: "Wordmark from study 14",
    note: "One object shot so close it stops reading as itself. The wordmark stays small and lets the crop carry the tile.",
    bg: "#cbc8c2",
    color: "var(--ud-ink)",
    html:
      art(
        '<circle cx="72" cy="34" r="58" fill="#b9b5ae"/>' +
          '<circle cx="72" cy="34" r="44" fill="#a8a49d"/>' +
          '<circle cx="72" cy="34" r="39" fill="#b1ada6"/>' +
          '<circle cx="72" cy="34" r="13" fill="#96928b"/>',
      ) +
      ph("Placeholder photo", "left:8cqi;top:8cqi") +
      mark(
        "position:absolute;left:8cqi;bottom:8cqi;font-family:'Source Serif 4',serif;font-style:italic;font-size:8.5cqi;font-weight:600;line-height:1;letter-spacing:-.015em",
        `unexpected detail${peachDot}`,
      ),
  },
  {
    name: "Pattern with one break",
    source: "Wordmark from study 03",
    note: "A regular grid of dots where one turns peach. It stands in for the period, so the wordmark drops its own.",
    bg: "var(--ud-paper)",
    color: "var(--ud-ink)",
    html:
      art(dotGrid) +
      mark(
        "position:absolute;left:11.4cqi;bottom:8cqi;font-family:'Gloock',serif;font-size:13cqi;line-height:.95;letter-spacing:-.01em",
        'unexpected<br><span style="padding-left:1.6em">detail</span>',
      ),
  },
  {
    name: "Flipped frame",
    source: "Wordmark from study 02",
    note: "An inner frame knocked a few degrees off square, inverted against the field, with the wordmark sitting inside it.",
    bg: "var(--ud-ink)",
    color: "var(--ud-ink)",
    html:
      '<div style="position:absolute;inset:15cqi;background:var(--ud-paper);transform:rotate(-7deg);display:grid;place-items:center">' +
      mark(
        "font-family:'Fraunces',serif;font-size:10.5cqi;font-weight:650;line-height:.9;letter-spacing:-.025em;font-variation-settings:'SOFT' 100,'WONK' 1;text-align:left",
        `unexpected<br>detail${peachDot}`,
      ) +
      "</div>",
  },
  {
    name: "Photo in the dot",
    source: "Wordmark from study 17",
    note: "The big dot becomes a window. A cropped photo sits inside it, on a flat peach field.",
    bg: "var(--ud-peach)",
    color: "var(--ud-ink)",
    html:
      '<div style="position:absolute;right:8cqi;top:8cqi;width:42cqi;height:42cqi;border-radius:50%;overflow:hidden;background:#d2cfc9">' +
      art(
        '<ellipse cx="78" cy="118" rx="60" ry="44" fill="#aaa69f"/>' +
          '<rect x="62" y="64" width="24" height="24" fill="#b3afa8"/>' +
          '<circle cx="74" cy="40" r="34" fill="#b3afa8"/>',
      ) +
      "</div>" +
      ph("Placeholder photo", "left:8cqi;top:8cqi") +
      mark(
        "position:absolute;left:8cqi;bottom:8cqi;font-family:'Shrikhand',serif;font-size:13cqi;line-height:1.08;letter-spacing:-.01em",
        "unexpected<br>detail",
      ),
  },
];

const periodLine = (logo: Logo) => logo.periodOn ?? logo.lines.length - 1;

const pad = (n: number) => String(n).padStart(2, "0");

const fontsHref =
  "https://fonts.googleapis.com/css2" +
  "?family=Abril+Fatface" +
    "&family=Bricolage+Grotesque:opsz,wght@12..96,700" +
  "&family=Bree+Serif" +
  "&family=Corben:wght@700" +
  "&family=DM+Serif+Display" +
  "&family=EB+Garamond:wght@500" +
  "&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1" +
  "&family=Gloock" +
  "&family=Instrument+Serif:ital@0;1" +
    "&family=Playfair+Display:ital,wght@0,900;1,900" +
  "&family=Source+Serif+4:ital,opsz,wght@1,8..60,600" +
  "&family=Shrikhand" +
  "&family=Yeseva+One" +
  "&family=Young+Serif" +
  "&display=swap";
---

<Layout
  title="unexpected detail — Ryan Sheridan"
  description="Working canvas for the unexpected detail podcast identity."
  noindex={true}
>
  <link rel="stylesheet" href={fontsHref} />
  <Nav />
  <main id="main" class="ud-page">
    <div class="ud-inner">
      <header class="ud-header">
        <p class="label">Podcast identity · working canvas</p>
        <h1>unexpected detail</h1>
        <p class="intro">
          An unscripted conversation show hosted by Marcy. Every episode is a detour with someone
          remarkable, past the résumé and into the left turns, half-baked ideas, and quiet
          obsessions kept off camera.
        </p>
      </header>

      <div class="ud-context">
        <details class="acc">
          <summary><span class="label">Brief</span><span class="acc-icon" aria-hidden="true"></span></summary>
          <div class="acc-body">
            <div class="taglines">
              {
                taglines.map((t) => (
                  <div>
                    <p class="label">{t.label}</p>
                    <p class="tag-line">“{t.line}”</p>
                  </div>
                ))
              }
            </div>

            <div class="brief-grid">
              {
                brief.map((item) => (
                  <article>
                    <p class="label">{item.label}</p>
                    <p class="brief-lead">{item.lead}</p>
                    <p class="brief-body">{item.body}</p>
                  </article>
                ))
              }
            </div>

            <ul class="pillars" aria-label="Brand pillars">
              {pillars.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        </details>
        <details class="acc">
          <summary><span class="label">Direction from kickoff</span><span class="acc-icon" aria-hidden="true"></span></summary>
          <div class="acc-body">
            <ul class="direction">
              {direction.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </details>
      </div>

      {
        rounds.map((round) => (
      <section class="ud-section" aria-labelledby={round.id}>
        <h2 id={round.id} class="label">{round.heading}</h2>
        <p class="section-note">{round.note}</p>

        <ol class="logo-list">
          {
            round.logos.map((logo, i) => (
              <li class="logo-item">
                <div class="tiles">
                  {(["light", "dark"] as const).map((theme) => (
                    <div
                      class={`tile tile--${theme}`}
                      style={logo.place ? `place-items:${logo.place}` : undefined}
                      role="img"
                      aria-label={theme === "light" ? `${logo.name}, light` : `${logo.name}, dark`}
                    >
                      <p
                        class:list={["lockup", { "lockup--free": logo.free }]}
                        aria-hidden="true"
                        style={`font-family:${logo.family};text-align:${logo.align ?? "center"};${logo.style ?? ""}`}
                      >
                        {logo.lines.map((line, j) => (
                          <span class="line" style={line.style}>
                            <Fragment set:html={line.text} />
                            {logo.period && j === periodLine(logo) && (
                              <span class={`dot dot--${logo.period}`}>.</span>
                            )}
                          </span>
                        ))}
                      </p>
                    </div>
                  ))}
                </div>
                <div class="logo-meta">
                  <p class="logo-title">
                    <span class="num">{pad(round.start + i)}</span>
                    {logo.name}
                  </p>
                  <p class="logo-font">{logo.font}</p>
                  <p class="logo-note">{logo.note}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>
        ))
      }

      <section class="ud-section" aria-labelledby="thumbs-heading">
        <h2 id="thumbs-heading" class="label">Thumbnail directions, round 02</h2>
        <p class="section-note">
          How the wordmark could live on a podcast tile. Each direction has one thing that is off,
          cropped, or out of place.
        </p>

        <ol class="thumb-list">
          {
            thumbs.map((t, i) => (
              <li class="logo-item">
                <div
                  class="tile thumb"
                  style={`background:${t.bg};color:${t.color}`}
                  role="img"
                  aria-label={`T${i + 1}, ${t.name}`}
                >
                  <Fragment set:html={t.html} />
                </div>
                <div class="logo-meta">
                  <p class="logo-title">
                    <span class="num">T{i + 1}</span>
                    {t.name}
                  </p>
                  <p class="logo-font">{t.source}</p>
                  <p class="logo-note">{t.note}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="size-test">
          <h3 class="label">Size test, 60px</h3>
          <p class="size-note">
            The same seven tiles at feed size. Placeholder labels are hidden here.
          </p>
          <ul class="size-row">
            {
              thumbs.map((t, i) => (
                <li>
                  <div
                    class="tile thumb"
                    style={`background:${t.bg};color:${t.color}`}
                    role="img"
                    aria-label={`T${i + 1}, ${t.name}, at 60 pixels`}
                  >
                    <Fragment set:html={t.html} />
                  </div>
                  <span class="num">T{i + 1}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .ud-page {
    --ud-ink: #141414;
    --ud-paper: #faf9f6;
    --ud-peach: #f08a6c;
    --ud-gap: clamp(120px, 6rem + 6vw, 220px);
    padding: clamp(96px, 5rem + 6vw, 200px) var(--page-padding) var(--ud-gap);
  }

  .ud-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .ud-header {
    margin-bottom: var(--space-8);
  }

  h1 {
    font-size: clamp(32px, 1.4rem + 2.4vw, 64px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: var(--space-4) 0 var(--space-5);
  }

  .intro {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  /* Brief and kickoff notes, collapsed so the page opens on the designs. */
  .ud-context {
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--ud-gap);
  }

  .acc {
    border-top: 1px solid var(--color-border);
  }

  .acc summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) 0;
  }

  .acc summary::-webkit-details-marker {
    display: none;
  }

  .acc summary:hover .label {
    color: var(--color-text);
  }

  .acc-icon {
    position: relative;
    width: 12px;
    height: 12px;
    color: var(--color-text-muted);
  }

  .acc-icon::before,
  .acc-icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 12px;
    height: 1px;
    background: currentColor;
    transition: transform 0.2s;
  }

  .acc-icon::after {
    transform: rotate(90deg);
  }

  .acc[open] .acc-icon::after {
    transform: rotate(0deg);
  }

  .acc-body {
    padding: var(--space-5) 0 var(--space-8);
  }

  @media (prefers-reduced-motion: reduce) {
    .acc-icon::before,
    .acc-icon::after {
      transition: none;
    }
  }

  .ud-section {
    margin-bottom: var(--ud-gap);
  }

  .ud-section > h2 {
    margin-bottom: var(--space-7);
  }

  .section-note {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    max-width: 52ch;
    margin: calc(var(--space-7) * -1 + var(--space-4)) 0 var(--space-8);
  }

  .taglines {
    display: grid;
    gap: var(--space-7);
    margin-bottom: var(--space-8);
  }

  .tag-line {
    font-size: clamp(24px, 1.1rem + 1.4vw, 40px);
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-top: var(--space-3);
  }

  .brief-grid {
    display: grid;
    gap: var(--space-7);
  }

  .brief-lead {
    font-size: var(--text-base);
    font-weight: 400;
    margin: var(--space-3) 0 var(--space-2);
  }

  .brief-body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 40ch;
  }

  .pillars {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }

  .pillars li {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 4px 14px;
  }

  .direction {
    list-style: none;
    max-width: 60ch;
    display: grid;
    gap: var(--space-4);
    counter-reset: dir;
  }

  .direction li {
    counter-increment: dir;
    display: grid;
    grid-template-columns: 3ch 1fr;
    gap: var(--space-3);
  }

  .direction li::before {
    content: counter(dir, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    padding-top: 0.35em;
  }

  /* Logo studies */

  .logo-list {
    list-style: none;
    display: grid;
    gap: var(--space-8) var(--space-6);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  /* Fixed paper and ink regardless of site theme: these are artboards. */
  .tile {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .tile--light {
    background: var(--ud-paper);
    color: var(--ud-ink);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  .tile--dark {
    background: var(--ud-ink);
    color: var(--ud-paper);
  }

  .lockup {
    font-kerning: normal;
    font-synthesis: none;
  }

  .line {
    display: block;
    white-space: nowrap;
  }

  .lockup--free {
    position: absolute;
    inset: 0;
  }

  .lockup--free .line {
    position: absolute;
  }

  .lockup :global(i) {
    font-style: italic;
  }

  .dot--peach {
    color: var(--ud-peach);
  }

  .dot--ink {
    color: inherit;
  }

  .logo-meta {
    margin-top: var(--space-4);
  }

  .logo-title {
    font-size: var(--text-base);
    font-weight: 400;
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .logo-font {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    margin: var(--space-1) 0 var(--space-2);
  }

  .logo-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 44ch;
  }

  /* Thumbnail directions */

  .thumb-list {
    list-style: none;
    display: grid;
    gap: var(--space-8) var(--space-6);
  }

  .thumb {
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  .thumb :global(.ph) {
    position: absolute;
    font-family: var(--font-mono);
    font-size: max(3cqi, 9px);
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--ud-ink);
    opacity: 0.6;
  }

  .size-test {
    margin-top: var(--ud-gap);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .size-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: var(--space-3) 0 var(--space-6);
  }

  .size-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .size-row li {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .size-row .tile {
    width: 60px;
  }

  .size-row :global(.ph) {
    display: none;
  }

  @media (min-width: 700px) {
    .thumb-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .taglines {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .brief-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .thumb-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .logo-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
