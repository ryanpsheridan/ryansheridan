// One list. Numbers are fixed so feedback keeps pointing at the same study,
// which leaves gaps where a study has been cut.
const studies = [...logos, ...details];

/*
  How the wordmark could live on a podcast tile. Each tile is an HTML string
  with inline styles (still sized in cqi) so the same artwork can be drawn
  twice: once large, once at 60px in the size test row. Only ink, paper and
  peach, and line work stays thin.
*/
type Thumb = { prev?: string; tag?: string; id: string; name: string; source: string; note: string; bg: string; color: string; html: string };

// Period tokens for tile HTML. mark() fills in the geometry for its font.
const peachDot = '<span class="pd">.</span>';
const hangingDot = '<span class="pd hang">.</span>';
const art = (inner: string) =>
  `<svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%" aria-hidden="true">${inner}</svg>`;
const mark = (style: string, inner: string) =>
  `<p style="margin:0;white-space:nowrap;font-kerning:normal;font-synthesis:none;${style}">${inner.replace(
    /<span class="pd( hang)?">/g,
    (m) => `${m.slice(0, -1)} style="${dotVars(style)}">`,
  )}</p>`;

// The primary hook, set small. Only on tiles with open space for it and a
// visual that already says the same thing.
const hook = (style: string) =>
  mark(
    `position:absolute;font-family:'Geist',sans-serif;font-size:3.4cqi;font-weight:400;line-height:1.2;letter-spacing:0;opacity:.75;${style}`,
    taglines[0].line,
  );

const dots = (fill: (row: number, col: number) => string) =>
  [14, 28, 42, 56]
    .flatMap((y, row) =>
      [15, 29, 43, 57, 71, 85].map((x, col) => `<circle cx="${x}" cy="${y}" r="3.6" fill="${fill(row, col)}"/>`),
    )
    .join("");

const sprockets = Array.from({ length: 18 }, (_, i) => {
  const x = 1.5 + i * 5.6;
  return `<rect x="${x}" y="24.2" width="2.8" height="2.2" rx=".5"/><rect x="${x}" y="53.6" width="2.8" height="2.2" rx=".5"/>`;
}).join("");

