  }
  .ub-controls-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 12px 24px;
    padding-block: 12px;
  }
  .ctl {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .ctl legend,
  .ctl-label {
    display: block;
    padding: 0;
