---
import Layout from "../layouts/Layout.astro";
import Cover from "../components/unexpected-detail/Cover.astro";
import Lines from "../components/unexpected-detail/Lines.astro";
import Wordmark from "../components/unexpected-detail/Wordmark.astro";

/*
  Brand book for the unexpected detail podcast. Private share: noindex, and
  kept out of the sitemap by the allowlist in astro.config.mjs. Rounds 01 to
  05 of the exploration live on at /unexpected-detail/round-1.

  The direction is the pair Marcy picked from round 05: the falling line with
  the staggered wordmark (01 light, 02 dark). Everything open after that call
  is a control at the top of the page: where the dot sits (the period, or the
  dot of the i), the wordmark typeface (Gloock or DM Serif Display), and the
  primary and secondary colors. The settings live in the URL so a link keeps
  them. Every example on the page draws from the same custom properties, so a
  change reaches all of it at once.
*/

const DEFAULTS = { font: "gloock", dot: "period", primary: "#F08A6C", secondary: "#15100D" } as const;
const INK = "#141414";
const PAPER = "#FAF9F6";

// Relative luminance and contrast, WCAG 2. The script below has a copy.
const lum = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  const c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => {
    const s = v / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const contrast = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
  return (x + 0.05) / (y + 0.05);
};
// Ink or paper, whichever reads better on a color.
const onColor = (hex: string) => (contrast(hex, INK) >= contrast(hex, PAPER) ? INK : PAPER);
const vars = (p: string, s: string) =>
  `--ud-primary:${p};--ud-secondary:${s};--ud-on-secondary:${onColor(s)};--ud-on-primary:${onColor(p)}`;

const brief = [
  { label: "the mission", lead: "To rescue human conversation from the résumé.", body: "Uncovering the unspoken quirks, wild turns, and quiet fascinations that make people who they truly are." },
  { label: "the promise", lead: "A fresh, indelible view into a mind you thought you knew.", body: "Leave every conversation with a surprising insight, an unprompted laugh, and proof that people are richer than their bios." },
  { label: "the north star", lead: "Break the talking-points loop. Uncover the eccentric truths.", body: "Strip away canned press tours and rehearsed answers. Catch brilliant people off guard, mid-laugh, sharing the obsessions that actually ignite them." },
];

const fonts = [
  { id: "gloock", name: "Gloock" },
  { id: "dm", name: "DM Serif Display" },
] as const;
const dots = [
  { id: "period", name: "Period", hint: "detail." },
  { id: "i", name: "Dot of the i", hint: "detail" },
] as const;

// Sixteen pairs to react to. Primary is the dot; secondary is the field.
const combos = [
  { name: "Peach and cocoa", p: "#F08A6C", s: "#15100D" },
  { name: "Tomato and navy", p: "#FF5A36", s: "#13213C" },
  { name: "Marigold and forest", p: "#F2B134", s: "#1E3B2F" },
  { name: "Chartreuse and ink", p: "#C6E04A", s: "#161616" },
  { name: "Coral and deep teal", p: "#FF7B6B", s: "#0E4744" },
  { name: "Cobalt and bone", p: "#2F55F0", s: "#EFE8DA" },
  { name: "Pink and oxblood", p: "#FF9EC4", s: "#4A1020" },
  { name: "Oxblood and blush", p: "#8A1E2E", s: "#F6D5CC" },
  { name: "Vermilion and sand", p: "#E8432A", s: "#E7DAC2" },
  { name: "Mint and plum", p: "#9FE3C9", s: "#3B1F4A" },
  { name: "Lilac and espresso", p: "#B9A6FF", s: "#2A1C14" },
  { name: "Saffron and aubergine", p: "#FFB000", s: "#2E1533" },
  { name: "Sky and rust", p: "#A9D0FF", s: "#8A3A1E" },
  { name: "Magenta and midnight", p: "#E6338C", s: "#0E1230" },
  { name: "Olive and cream", p: "#6E7D23", s: "#F3EBD8" },
  { name: "Persimmon and sage", p: "#F26B3A", s: "#C5D1B8" },
].map((c, i) => ({ ...c, no: String(i + 1).padStart(2, "0") }));

const matrix = fonts.flatMap((f) => dots.map((d) => ({ font: f, dot: d })));

const feedSizes = [160, 96, 64, 48, 40];
const episodes = [
  { no: 14, guest: "Guest Name", title: "The spreadsheet she keeps of every dog she has met", time: "52 min" },
  { no: 13, guest: "Guest Name", title: "Why he still writes letters to his high school band", time: "47 min" },
  { no: 12, guest: "Guest Name", title: "A cartographer of places that never existed", time: "61 min" },
];

const fontsHref = "https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Gloock&display=swap";
---

<Layout
  title="unexpected detail brand book | Ryan Sheridan"
  description="Brand book for the unexpected detail podcast: wordmark, color, type, and the identity in use."
  noindex={true}
>
  <link rel="stylesheet" href={fontsHref} />
  <div
    class="ub"
    id="ub"
    data-font={DEFAULTS.font}
    data-dot={DEFAULTS.dot}
    data-defaults={JSON.stringify(DEFAULTS)}
    style={vars(DEFAULTS.primary, DEFAULTS.secondary)}
  >
    <header class="ub-top">
      <div class="ub-wrap ub-top-row">
        <p class="ub-top-name">unexpected detail<span class="ub-top-sep" aria-hidden="true"></span>brand book</p>
        <p class="ub-top-meta">
          <span>Draft 01 · November 2026</span>
          <a href="/unexpected-detail/round-1">Rounds 01 to 05</a>
        </p>
      </div>
    </header>

    <form class="ub-controls" id="ub-controls" aria-label="Brand settings" onsubmit="return false">
      <div class="ub-wrap ub-controls-row">
        <fieldset class="ctl">
          <legend>The dot</legend>
          <div class="seg">
            {dots.map((d) => (
              <button type="button" data-set-dot={d.id} aria-pressed={d.id === DEFAULTS.dot ? "true" : "false"}>{d.name}</button>
            ))}
          </div>
        </fieldset>
        <fieldset class="ctl">
          <legend>Typeface</legend>
          <div class="seg">
            {fonts.map((f) => (
              <button type="button" data-set-font={f.id} aria-pressed={f.id === DEFAULTS.font ? "true" : "false"}>{f.name}</button>
            ))}
          </div>
        </fieldset>
        <div class="ctl">
          <label class="ctl-label" for="ub-primary-hex">Primary</label>
          <div class="hex">
            <input type="color" id="ub-primary-pick" value={DEFAULTS.primary.toLowerCase()} aria-label="Pick the primary color" />
            <input type="text" id="ub-primary-hex" value={DEFAULTS.primary} spellcheck="false" autocomplete="off" maxlength="7" />
          </div>
        </div>
        <div class="ctl">
          <label class="ctl-label" for="ub-secondary-hex">Secondary</label>
          <div class="hex">
            <input type="color" id="ub-secondary-pick" value={DEFAULTS.secondary.toLowerCase()} aria-label="Pick the secondary color" />
            <input type="text" id="ub-secondary-hex" value={DEFAULTS.secondary} spellcheck="false" autocomplete="off" maxlength="7" />
          </div>
        </div>
        <div class="ctl ctl-actions">
          <button type="button" class="act" id="ub-swap" title="Swap primary and secondary">Swap</button>
          <button type="button" class="act" id="ub-reset">Reset</button>
          <button type="button" class="act act--solid" id="ub-copy">Copy link</button>
        </div>
      </div>
    </form>

    <main id="main">
      <section class="hero tone-field" aria-label="unexpected detail">
        <Lines class="hero-lines hero-lines--wide" vw={200} vh={100} count={30} fall={19} x={8} y={11} len={36} w={0.55} animate />
        <Lines class="hero-lines hero-lines--tall" vw={100} vh={125} count={14} fall={9} x={11.4} y={12} len={62} animate />
        <Wordmark class="hero-wm" size="var(--hero-wm)" />
      </section>

      <div class="ub-wrap">
        <section class="intro">
          <p class="intro-lead">
            An unscripted conversation show hosted by Marcy. Every episode is a detour with someone
            remarkable, past the résumé and into the left turns, half-baked ideas, and quiet
            obsessions kept off camera.
          </p>
          <p class="intro-how">
            Use the bar above to move the dot, switch the typeface, or try your own colors with hex
            values. Everything on this page follows along. <strong>Copy link</strong> keeps your
            settings, so you can send back exactly what you are looking at.
          </p>
        </section>

        <!-- 01 -->
        <section class="chapter" id="show" aria-labelledby="show-h">
          <header class="ch-head">
            <p class="ch-no">01</p>
            <h2 id="show-h">the show</h2>
          </header>
          <div class="brief">
            {brief.map((b) => (
              <article class="brief-item">
                <h3 class="eyebrow">{b.label}</h3>
                <p class="brief-lead">{b.lead}</p>
                <p class="brief-body">{b.body}</p>
              </article>
            ))}
          </div>
          <div class="hooks">
            <div class="hook tone-paper">
              <p class="eyebrow">primary hook</p>
              <p class="hook-line">Curiosity flips the frame<span class="tdot">.</span></p>
            </div>
            <div class="hook tone-field">
              <p class="eyebrow">secondary invitation</p>
              <p class="hook-line">Everyone has one<span class="tdot">.</span></p>
            </div>
          </div>
        </section>

        <!-- 02 -->
        <section class="chapter" id="wordmark" aria-labelledby="wordmark-h">
          <header class="ch-head">
            <p class="ch-no">02</p>
            <h2 id="wordmark-h">the wordmark</h2>
            <p class="ch-note">
              Lowercase, two lines, flush right. “unexpected” steps in from the edge, so the stack
              turns like a road. The dot is the only thing in color.
            </p>
          </header>
          <div class="wm-pair">
            <figure class="panel tone-paper">
              <Wordmark size="13cqi" />
              <figcaption>On paper</figcaption>
            </figure>
            <figure class="panel tone-field">
              <Wordmark size="13cqi" />
              <figcaption>On secondary</figcaption>
            </figure>
          </div>
          <div class="wm-rules">
            <figure class="rule-card">
              <div class="clear tone-paper">
                <span class="clear-box"><Wordmark size="8cqi" /></span>
              </div>
              <figcaption>
                <strong>Clear space.</strong> Keep a margin the height of the “x” in “unexpected” on
                every side. Nothing else enters the dashed line.
              </figcaption>
            </figure>
            <figure class="rule-card">
              <div class="clear tone-paper clear--line">
                <Wordmark size="7cqi" line />
              </div>
              <figcaption>
                <strong>One line.</strong> For narrow spaces like a web header or the footer of a
                video, the same words run on one line. The stack stays the main mark.
              </figcaption>
            </figure>
          </div>
        </section>

        <!-- 03 -->
        <section class="chapter" id="detail" aria-labelledby="detail-h">
          <header class="ch-head">
            <p class="ch-no">03</p>
            <h2 id="detail-h">the detail</h2>
            <p class="ch-note">
              From the last call: what if the unexpected detail is the dot of the i, in color, with
              no period? And does the stagger hold up in DM Serif Display as well as Gloock? All
              four, side by side. Choose one to set it for the whole page.
            </p>
          </header>
          <div class="matrix">
            {matrix.map((m) => (
              <figure class="mx" data-font={m.font.id} data-dot={m.dot.id}>
                <div class="mx-tiles">
                  <Cover tone="paper" label={`${m.font.name}, ${m.dot.name.toLowerCase()}, on paper`} />
                  <Cover tone="field" label={`${m.font.name}, ${m.dot.name.toLowerCase()}, on secondary`} />
                </div>
                <figcaption class="mx-cap">
                  <span><strong>{m.font.name}</strong> · {m.dot.name.toLowerCase()}</span>
                  <button type="button" class="act" data-apply-font={m.font.id} data-apply-dot={m.dot.id}>Use this</button>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>

        <!-- 04 -->
        <section class="chapter" id="color" aria-labelledby="color-h">
          <header class="ch-head">
            <p class="ch-no">04</p>
            <h2 id="color-h">color</h2>
            <p class="ch-note">
              Two brand colors and two neutrals. The primary is used sparingly, mostly as the dot,
              so it lands as the one surprise in the frame. The secondary is the field the dark
              versions sit on. Change either in the bar above.
            </p>
          </header>
          <div class="swatches">
            <div class="sw sw--primary">
              <p class="sw-role">primary · the dot</p>
              <p class="sw-hex" data-bind="primary">{DEFAULTS.primary}</p>
            </div>
            <div class="sw sw--secondary">
              <p class="sw-role">secondary · the field</p>
              <p class="sw-hex" data-bind="secondary">{DEFAULTS.secondary}</p>
            </div>
            <div class="sw sw--ink">
              <p class="sw-role">ink · type and lines</p>
              <p class="sw-hex">{INK}</p>
            </div>
            <div class="sw sw--paper">
              <p class="sw-role">paper · the light ground</p>
              <p class="sw-hex">{PAPER}</p>
            </div>
          </div>
          <dl class="contrast" aria-live="polite">
            <div>
              <dt>Dot on paper</dt>
              <dd><span data-bind="c-paper"></span><span class="flag" data-flag="c-paper"></span></dd>
            </div>
            <div>
              <dt>Dot on secondary</dt>
              <dd><span data-bind="c-field"></span><span class="flag" data-flag="c-field"></span></dd>
            </div>
            <div>
              <dt>Wordmark on secondary</dt>
              <dd><span data-bind="c-type"></span><span class="flag" data-flag="c-type"></span></dd>
            </div>
          </dl>
          <p class="fine">
            Contrast ratios. The dot is a graphic, so 3:1 is the floor for it to hold its own; the
            wordmark is type, so it wants 4.5:1. Type on the secondary switches between ink and paper
            on its own.
          </p>
        </section>

        <!-- 05 -->
        <section class="chapter" id="combos" aria-labelledby="combos-h">
          <header class="ch-head">
            <p class="ch-no">05</p>
            <h2 id="combos-h">sixteen pairs</h2>
            <p class="ch-note">
              Starting points for the primary and secondary. Each one shows the cover on its field
              and the wordmark on paper. Choose one to try it across the page, then fine tune the hex
              values in the bar.
            </p>
          </header>
          <ol class="combos">
            {combos.map((c) => (
              <li>
                <button type="button" class="combo" style={vars(c.p, c.s)} data-p={c.p} data-s={c.s} aria-pressed="false">
                  <Cover tone="field" />
                  <span class="combo-paper tone-paper">
                    <Wordmark size="12cqi" />
                  </span>
                  <span class="combo-meta">
                    <span class="combo-no">{c.no}</span>
                    <span class="combo-name">{c.name}</span>
                    <span class="combo-hex">
                      <i style={`background:${c.p}`}></i>{c.p}
                      <i style={`background:${c.s}`}></i>{c.s}
                    </span>
                  </span>
                </button>
              </li>
            ))}
          </ol>
        </section>

        <!-- 06 -->
        <section class="chapter" id="type" aria-labelledby="type-h">
          <header class="ch-head">
            <p class="ch-no">06</p>
            <h2 id="type-h">typography</h2>
            <p class="ch-note">
              A soft, high contrast serif for the voice of the show, and a plain sans to do the
              quiet work around it.
            </p>
          </header>
          <div class="type-grid">
            <article class="type-card tone-paper">
              <p class="eyebrow">display · <span data-bind="font-name">Gloock</span></p>
              <p class="type-aa display">Aa</p>
              <p class="type-set display">abcdefghijklmnopqrstuvwxyz<br />ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />0123456789 &amp; ? ! “ ”</p>
              <p class="type-use">The wordmark, episode titles, guest names, and pull quotes. Set it lowercase where it can be.</p>
            </article>
            <article class="type-card tone-paper">
              <p class="eyebrow">text · Geist</p>
              <p class="type-aa sans">Aa</p>
              <p class="type-set sans">abcdefghijklmnopqrstuvwxyz<br />ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />0123456789 &amp; ? ! “ ”</p>
              <p class="type-use">Show notes, metadata, captions, and small print. Never for the wordmark.</p>
            </article>
          </div>
          <article class="hier tone-field">
            <p class="hier-meta">ep. 12 · 61 min</p>
            <h3 class="hier-title">a cartographer of places that never existed</h3>
            <p class="hier-guest">with Guest Name</p>
            <p class="hier-body">
              She has drawn more than four hundred maps of towns, coastlines, and train lines that
              were only ever proposed. We talk about the one she will never finish, and why the
              blank parts are her favorite.
            </p>
          </article>
        </section>

        <!-- 07 -->
        <section class="chapter" id="line" aria-labelledby="line-h">
          <header class="ch-head">
            <p class="ch-no">07</p>
            <h2 id="line-h">the falling line</h2>
            <p class="ch-note">
              A row of upright lines with one that has tipped over. It is the conversation that goes
              somewhere nobody planned, and it gives every surface the same signature without
              repeating the logo.
            </p>
          </header>
          <div class="band tone-paper">
            <Lines vw={300} vh={60} count={48} fall={31} x={6} y={10} len={40} w={0.55} />
          </div>
          <div class="band band--field tone-field">
            <Lines vw={300} vh={60} count={48} fall={12} x={6} y={10} len={40} w={0.55} />
          </div>
          <ul class="principles">
            <li><strong>One falls.</strong> Never two, and always the same way, pivoting on its foot.</li>
            <li><strong>Hairline and quiet.</strong> The lines take the color of the type. Color belongs to the dot.</li>
            <li><strong>Any length.</strong> The row runs as long as the format needs, from a cover to a banner.</li>
          </ul>
        </section>

        <!-- 08 -->
        <section class="chapter" id="use" aria-labelledby="use-h">
          <header class="ch-head">
            <p class="ch-no">08</p>
            <h2 id="use-h">in use</h2>
            <p class="ch-note">
              The identity across the places the show will live. Names, episodes, and contact details
              are placeholders.
            </p>
          </header>

          <div class="apps">
            <figure class="app app--cover">
              <div class="pair">
                <Cover tone="paper" label="Podcast cover on paper" />
                <Cover tone="field" label="Podcast cover on secondary" />
              </div>
              <figcaption><strong>Podcast cover.</strong> 3000 × 3000 px for Apple Podcasts, Spotify, and YouTube Music. Light and dark.</figcaption>
            </figure>

            <figure class="app app--feed">
              <div class="feed">
                {(["paper", "field"] as const).map((tone) => (
                  <div class="feed-row">
                    {feedSizes.map((s) => (
                      <div class="feed-cell">
                        <Cover tone={tone} style={`width:${s}px`} />
                        <span>{s}</span>
                      </div>
                    ))}
                  </div>
                ))}
              </div>
              <figcaption><strong>In the feed.</strong> The cover has to hold up at the size people actually see it: a 40 to 160 px square next to a dozen other shows.</figcaption>
            </figure>

            <figure class="app app--player">
              <div class="player">
                <div class="player-show">
                  <Cover tone="field" style="width:104px" />
                  <div>
                    <p class="player-title">unexpected detail</p>
                    <p class="player-sub">Marcy</p>
                    <p class="player-sub">Society &amp; Culture · Weekly</p>
                    <span class="player-follow">Follow</span>
                  </div>
                </div>
                <ol class="player-eps">
                  {episodes.map((e) => (
                    <li>
                      <Cover tone="field" style="width:44px" />
                      <div>
                        <p class="player-ep">{e.title}</p>
                        <p class="player-sub">ep. {e.no} · {e.guest} · {e.time}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
              <figcaption><strong>Show page.</strong> A generic podcast app, to see the cover among real interface.</figcaption>
            </figure>

            <figure class="app app--wide">
              <div class="frame frame--169 tone-field">
                <Lines vw={178} vh={100} count={13} fall={9} x={8} y={14} len={62} w={0.6} />
                <div class="ep-text">
                  <p class="ep-no">ep. 12</p>
                  <p class="ep-guest">Guest Name</p>
                  <p class="ep-topic">a cartographer of places that never existed</p>
                </div>
                <Wordmark class="ep-wm" size="5.4cqi" />
              </div>
              <figcaption><strong>Episode thumbnail.</strong> 1280 × 720 px for YouTube and video clips.</figcaption>
            </figure>

            <figure class="app app--avatar">
              <div class="avatar tone-field">
                <Wordmark size="13cqi" />
              </div>
              <figcaption><strong>Profile picture.</strong> Social accounts crop to a circle, so the wordmark centers and the lines step back.</figcaption>
            </figure>

            <figure class="app app--post">
              <div class="frame frame--45 tone-paper">
                <Lines vw={100} vh={125} count={9} fall={6} x={8} gap={2.4} y={8} len={12} w={0.45} />
                <blockquote class="post-quote">“I have never told anyone this, but I alphabetize my spices by mood.”</blockquote>
                <p class="post-cite">Guest Name, ep. 12</p>
                <Wordmark class="post-wm" size="6.6cqi" />
              </div>
              <figcaption><strong>Quote post.</strong> 1080 × 1350 px for Instagram and LinkedIn.</figcaption>
            </figure>

            <figure class="app app--story">
              <div class="frame frame--916 tone-field">
                <Wordmark class="story-wm" size="9cqi" />
                <Lines vw={100} vh={178} count={10} fall={6} x={10} gap={8.9} y={52} len={64} w={0.8} />
                <div class="story-text">
                  <p class="story-new">new episode</p>
                  <p class="story-guest">Guest Name</p>
                  <p class="story-topic">a cartographer of places that never existed</p>
                </div>
              </div>
              <figcaption><strong>Story.</strong> 1080 × 1920 px.</figcaption>
            </figure>

            <figure class="app app--sticker">
              <div class="sticker-wrap">
                <div class="sticker">
                  <p>everyone<br />has one.</p>
                </div>
              </div>
              <figcaption><strong>Sticker.</strong> The secondary invitation on the primary color. A small giveaway for guests.</figcaption>
            </figure>

            <figure class="app app--cards">
              <div class="cards">
                <div class="card card--front tone-field">
                  <Lines vw={175} vh={100} count={12} fall={8} x={8} y={12} len={44} w={0.6} />
                  <Wordmark class="card-wm" size="7.4cqi" />
                </div>
                <div class="card card--back tone-paper">
                  <span class="card-dot" aria-hidden="true"></span>
                  <p class="card-name">Marcy</p>
                  <p class="card-role">host</p>
                  <p class="card-contact">hello@unexpecteddetail.fm<br />unexpecteddetail.fm</p>
                </div>
              </div>
              <figcaption><strong>Business card.</strong> 3.5 × 2 in. The front is the cover; the back has a single dot in the primary.</figcaption>
            </figure>

            <figure class="app app--mic">
              <div class="mic-scene" aria-hidden="true">
                <div class="mic-head"></div>
                <div class="cube">
                  <div class="face face--front tone-field"><Wordmark size="11.5cqi" /></div>
