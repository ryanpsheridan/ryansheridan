---
import Layout from "../layouts/Layout.astro";
import Cover from "../components/unexpected-detail/Cover.astro";
import Lines from "../components/unexpected-detail/Lines.astro";
import Wordmark from "../components/unexpected-detail/Wordmark.astro";

/*
  unexpected detail: identity presentation. Private share, noindex, and kept
  out of the sitemap by the allowlist in astro.config.mjs. Rounds 01 to 05
  of the exploration live on at /unexpected-detail/round-1.

  Five chapters: identity, details, applications, color, explore. The logo
  is live type (the staggered Gloock lockup from round 05), drawn by
  components/unexpected-detail, which is what lets the explorer switch the
  dot and the typeface without approximating the artwork.

  One state drives the whole page: the detail, the typeface and the palette.
  The color chapter and the explorer both write to it, the page re-colors
  from it, and the URL carries it so a copied link reopens the same version.
  A few comparisons pin their own setting (the A/B of the detail, the type
  specimens).
*/

const RECOMMENDED = { font: "gloock", dot: "i", palette: "01" } as const;
const INK = "#141414";
const PAPER = "#FAF9F6";
// Below this contrast a dot stops reading against its ground, and the
// palette's other color (or the type color) takes its place there.
const DOT_MIN = 2.25;

// WCAG 2 contrast. The script below carries a copy of all of this.
const lum = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  const c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => {
    const s = v / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const contrast = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
  return (x + 0.05) / (y + 0.05);
};
const onColor = (hex: string) => (contrast(hex, INK) >= contrast(hex, PAPER) ? INK : PAPER);

/*
  A palette is a primary (the dot) and a secondary (the field). The system
  derives a second ground for every palette so each one has a light and a
  dark expression: a dark field pairs with paper; a light field pairs with
  the primary when it is near black (the black and white palettes), or ink.
  The dot on each ground is the primary when it reads there, then the
  secondary, then the type color.
*/
const system = (p: string, s: string) => {
  const fFg = onColor(s);
  const fieldDark = fFg === PAPER;
  const c = fieldDark ? PAPER : lum(p) < 0.045 ? p : INK;
  const cFg = onColor(c);
  const dotOn = (g: string, fg: string) => [p, s].find((x) => contrast(x, g) >= DOT_MIN) ?? fg;
  const f = { bg: s, fg: fFg, dot: dotOn(s, fFg) };
  const k = { bg: c, fg: cFg, dot: dotOn(c, cFg) };
  const [d, l] = fieldDark ? [f, k] : [k, f];
  return { f, k, d, l };
};
const vars = (p: string, s: string) => {
  const { f, k, d, l } = system(p, s);
  return Object.entries({ f, c: k, d, l })
    .flatMap(([n, t]) => [`--${n}-bg:${t.bg}`, `--${n}-fg:${t.fg}`, `--${n}-dot:${t.dot}`])
    .join(";");
};

/*
  Twenty directions, weighted toward what the client wears: black and
  white, warm neutrals, then yellow, and a few quiet greens and blues. No
  reds or oranges. Two primaries were deepened so the dot holds on its own
  light field (12 mustard, 19 dusty blue); the rest are as briefed.
*/
const groups = [
  { name: "Black and white", items: [
    { name: "Black & Paper", p: "#171717", s: "#F5F4EF", mood: "Timeless, minimal" },
    { name: "Soft Charcoal", p: "#555555", s: "#E9E8E2", mood: "Understated, modern" },
    { name: "Ink & Chalk", p: "#22282A", s: "#F1F0EA", mood: "Editorial, sophisticated" },
    { name: "Graphite & White", p: "#343434", s: "#FFFFFF", mood: "Clean, confident" },
  ] },
  { name: "Warm neutrals", items: [
    { name: "Sand & Espresso", p: "#D8C9B4", s: "#40362F", mood: "Warm, grounded" },
    { name: "Stone & Ink", p: "#B8B5AA", s: "#30312E", mood: "Minimal, architectural" },
    { name: "Oat & Charcoal", p: "#E4DAC8", s: "#383732", mood: "Soft, approachable" },
    { name: "Mushroom & Cocoa", p: "#B7AA9B", s: "#4A4039", mood: "Quiet, refined" },
    { name: "Bone & Slate", p: "#EAE5D9", s: "#50545A", mood: "Contemporary, neutral" },
  ] },
  { name: "Yellow", items: [
    { name: "Butter & Ink", p: "#F1D879", s: "#292929", mood: "Warm, optimistic" },
    { name: "Pale Butter & Charcoal", p: "#F5E9AA", s: "#353532", mood: "Subtle, understated" },
    { name: "Mustard & Cream", p: "#B8953A", s: "#F4F0E6", mood: "Distinctive, mature" },
    { name: "Golden Yellow & Ink", p: "#D6B52F", s: "#222222", mood: "Confident, expressive" },
    { name: "Lemon & Graphite", p: "#E9E4A5", s: "#393A35", mood: "Fresh, contemporary" },
  ] },
  { name: "Greens", items: [
    { name: "Sage & Forest", p: "#B0BDA7", s: "#34443A", mood: "Organic, calm" },
    { name: "Olive & Bone", p: "#969477", s: "#F1EBDD", mood: "Natural, understated" },
    { name: "Eucalyptus & Charcoal", p: "#A9BDB4", s: "#343D39", mood: "Soft, modern" },
  ] },
  { name: "Blues and lavender", items: [
    { name: "Slate & Cloud", p: "#AAB6C2", s: "#353F4A", mood: "Cool, editorial" },
    { name: "Dusty Blue & Bone", p: "#8497AC", s: "#F0ECE3", mood: "Quiet, sophisticated" },
    { name: "Lavender & Ink", p: "#B6AFC7", s: "#34313C", mood: "Subtle, distinctive" },
  ] },
];
let n = 0;
const grouped = groups.map((g) => ({ ...g, items: g.items.map((c) => ({ ...c, no: String(++n).padStart(2, "0") })) }));
const palettes = grouped.flatMap((g) => g.items);
const pal = (no: string) => palettes.find((p) => p.no === no)!;
const rec = pal(RECOMMENDED.palette);

const fonts = [
  { id: "gloock", name: "Gloock" },
  { id: "dm", name: "DM Serif Display" },
] as const;

const chapters = [
  { id: "identity", no: "01", name: "Identity" },
  { id: "details", no: "02", name: "Details" },
  { id: "applications", no: "03", name: "Applications" },
  { id: "color", no: "04", name: "Color" },
  { id: "explore", no: "05", name: "Explore" },
];

// The opening's falling line, as HTML so the row stretches to any width
// without skewing the angle. Every other line drops out on phones; the
// fallen one is odd, so it stays.
const heroLines = 37;
const heroFall = 25;

const fontsHref = "https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Gloock&display=swap";
---

<Layout
  title="unexpected detail, identity | Ryan Sheridan"
  description="Identity presentation for the unexpected detail podcast."
  noindex={true}
>
  <link rel="stylesheet" href={fontsHref} />
  <div
    class="ub"
    id="ub"
    data-font={RECOMMENDED.font}
    data-dot={RECOMMENDED.dot}
    data-rec={JSON.stringify({ font: RECOMMENDED.font, dot: RECOMMENDED.dot, primary: rec.p, secondary: rec.s })}
    style={vars(rec.p, rec.s)}
  >
    <nav class="chap-nav" id="chap-nav" aria-label="Chapters">
      <a class="chap-home" href="#identity">unexpected detail</a>
      <ol>
        {chapters.map((c) => (
          <li><a href={`#${c.id}`} data-chap={c.id}><span>{c.no}</span><b>{c.name}</b></a></li>
        ))}
      </ol>
    </nav>

    <main id="main">
      <!-- ============ 01 IDENTITY ============ -->
      <section class="intro tone-dark" aria-label="unexpected detail, identity presentation">
        <a class="intro-skip" href="#explore">Skip to the explorer</a>
        <header class="intro-meta">
          <p class="intro-name">unexpected detail</p>
          <ul class="intro-tags">
            <li>Brand identity</li>
            <li>Podcast</li>
            <li>2026</li>
          </ul>
          <p class="intro-draft">Identity exploration, draft 03</p>
        </header>
        <div class="intro-lines" aria-hidden="true">
          {Array.from({ length: heroLines }, (_, i) => <span class:list={{ fall: i + 1 === heroFall }} />)}
        </div>
        <div class="intro-foot">
          <p class="intro-desc">
            An identity for an unscripted conversation show about the things people leave off their
            résumé. Quiet type, one line out of step, and one small detail you have to look for.
          </p>
          <Wordmark class="intro-wm" size="13.6cqi" />
        </div>
      </section>

      <section class="chapter" id="identity" data-chapter="identity" aria-labelledby="identity-h">
        <div class="wrap">
          <header class="ch-head reveal">
            <p class="ch-no">01</p>
            <h2 class="ch-title" id="identity-h">The identity</h2>
            <p class="ch-lede">
              An unscripted conversation show hosted by Marcy. Every episode is a detour with someone
              remarkable, past the résumé and into the left turns, half-baked ideas and quiet
              obsessions kept off camera.
            </p>
          </header>
          <dl class="brief reveal">
            <div>
              <dt>Mission</dt>
              <dd>To rescue human conversation from the résumé.</dd>
            </div>
            <div>
              <dt>Promise</dt>
              <dd>A fresh, indelible view into a mind you thought you knew.</dd>
            </div>
            <div>
              <dt>North star</dt>
              <dd>Break the talking-points loop. Uncover the eccentric truths.</dd>
            </div>
          </dl>
          <div class="id-primary reveal">
            <div class="construct">
              <Wordmark size="1em" />
              <span class="g g-edge" aria-hidden="true"><em>flush right</em></span>
              <span class="g g-step" aria-hidden="true"><em>steps in 1.2 em</em></span>
              <span class="g g-base" aria-hidden="true"></span>
            </div>
            <div class="id-cap">
              <h3 class="sub">Primary logo</h3>
              <p>
                Lowercase, two lines, set flush right. “unexpected” steps in from the edge, so the
                name turns like a conversation that went somewhere nobody planned.
              </p>
            </div>
          </div>
        </div>
        <div class="split">
          <figure class="split-half tone-dark">
            <div class="split-art"><Wordmark size="6.4cqi" line /></div>
            <figcaption><b>Alternate.</b> One line, for web headers, video and anywhere height is short.</figcaption>
          </figure>
          <figure class="split-half tone-light split-half--mark">
            <div class="split-art"><span class="wm mark" role="img" aria-label="The i mark"><span class="wm-i">i</span></span></div>
            <figcaption><b>Mark.</b> The i on its own, for app icons and favicons.</figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ 02 DETAILS ============ -->
      <section class="chapter" id="details" data-chapter="details" aria-labelledby="details-h">
        <div class="wrap">
          <header class="ch-head reveal">
            <p class="ch-no">02</p>
            <h2 class="ch-title" id="details-h">The details</h2>
            <p class="ch-lede">
              Three things carry the identity beyond the name: the detail itself, a pairing of two
              typefaces, and the falling line.
            </p>
          </header>
        </div>

        <div class="detail tone-dark">
          <div class="wrap">
            <div class="detail-head reveal">
              <p class="sub-no">2.1 The unexpected detail</p>
              <p class="statement">Everyone has one.</p>
              <p class="detail-copy">
                The show looks for the one thing about a guest that doesn’t behave the way you expect.
                The identity has one too: a single dot, sitting where you have to look for it.
              </p>
            </div>
          </div>
          <div class="detail-word annotate" aria-hidden="true"><Wordmark size="31cqi" line class="detail-wm" /></div>
        </div>

        <div class="ab annotate" aria-label="Two places for the dot">
          <figure class="ab-half" data-dot="period">
            <p class="ab-tag"><span>A</span>The period</p>
            <div class="ab-art"><Wordmark size="9.4cqi" /></div>
            <figcaption>A full stop that won’t stop: it hangs past the edge of the type. Clear, familiar, and it reads as a statement.</figcaption>
          </figure>
          <figure class="ab-half" data-dot="i">
            <p class="ab-tag"><span>B</span>The dot of the i <b>Recommended</b></p>
            <div class="ab-art"><Wordmark size="9.4cqi" /></div>
            <figcaption>Hidden inside the word. Nothing is added to the name, so you find the detail rather than being shown it. In black and white it is pure shape; give the palette a color and the dot is where it appears.</figcaption>
          </figure>
        </div>

        <div class="wrap">
          <div class="type reveal">
            <p class="sub-no">2.2 Typography</p>
            <div class="type-pair">
              <article class="type-face" data-font="gloock">
                <p class="type-aa display">Aa</p>
                <h3 class="sub">Gloock <span>Expressive</span></h3>
                <p class="type-use">The wordmark, large statements, and episode titles when they get room to breathe. Used sparingly, so it always means something.</p>
              </article>
              <article class="type-face">
                <p class="type-aa sans">Aa</p>
                <h3 class="sub">Geist <span>Workhorse</span></h3>
                <p class="type-use">Everything else: headings, show notes, guest details, captions, navigation and interface. Clean and quiet, so the serif stands out.</p>
              </article>
              <article class="type-sample" data-font="gloock">
                <p class="ts-meta">ep. 12 · 61 min · with Guest Name</p>
                <p class="ts-title">a cartographer of places that never existed</p>
                <p class="ts-body">She has drawn more than four hundred maps of towns, coastlines and train lines that were only ever proposed. We talk about the one she will never finish.</p>
              </article>
            </div>
            <p class="fine">DM Serif Display is kept as an alternate for the wordmark. Try it in the explorer.</p>
          </div>

          <div class="lang reveal">
            <p class="sub-no">2.3 The falling line</p>
            <div class="lang-grid">
              <div class="lang-text">
                <p class="lang-lead">A row of upright lines with one that has tipped over. It supports the logo and never replaces it.</p>
                <ul class="rules">
                  <li>One line falls, always the same way.</li>
                  <li>Hairline, in the type color.</li>
                  <li>Any length, from a cover to a divider.</li>
                </ul>
              </div>
              <figure class="lang-page">
                <div class="page tone-light">
                  <div class="page-rule"><Lines vw={100} vh={8} count={22} fall={15} x={0.4} gap={4.73} y={0.5} len={6} w={0.22} /></div>
                  <p class="page-kicker">Show notes · ep. 12</p>
                  <p class="page-title">a cartographer of places that never existed</p>
                  <p class="page-body">She has drawn more than four hundred maps of towns, coastlines and train lines that were only ever proposed. Some were planned by city councils, some by children, one by a man who wanted a canal past his house.</p>
                </div>
                <figcaption>As a header rule on show notes and newsletters.</figcaption>
              </figure>
              <figure class="lang-graphic">
                <div class="frame frame--1 tone-dark">
                  <Lines count={14} fall={9} x={11.4} y={10} len={66} />
                  <p class="lg-ep">ep. 12</p>
                </div>
                <figcaption>On its own, for an episode graphic.</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ 03 APPLICATIONS ============ -->
      <section class="chapter tone-stone" id="applications" data-chapter="applications" aria-labelledby="apps-h">
        <div class="wrap">
          <header class="ch-head reveal">
            <p class="ch-no">03</p>
            <h2 class="ch-title" id="apps-h">In application</h2>
            <p class="ch-lede">Where the show actually lives: podcast apps, YouTube and social feeds.</p>
          </header>

          <div class="apps-cover">
            <figure class="ac-main reveal">
              <Cover tone="field" class="tone-dark" label="Podcast cover, dark" />
            </figure>
            <div class="ac-side reveal">
              <Cover tone="paper" class="tone-light" label="Podcast cover, light" />
              <p class="cap"><b>Podcast cover.</b> 3000 px square for Apple Podcasts, Spotify and YouTube, in dark and light.</p>
              <div class="sizes" aria-hidden="true">
                {[64, 40].map((s) => <Cover tone="field" class="tone-dark" style={`width:${s}px`} />)}
                <span>At 64 and 40 px in a feed</span>
              </div>
            </div>
          </div>

          <div class="apps-row">
            <figure class="app-wide reveal">
              <div class="frame frame--169 tone-dark">
                <Lines vw={178} vh={100} count={13} fall={9} x={8} y={14} len={62} w={0.6} />
                <div class="ep-text">
                  <p class="ep-no">ep. 12</p>
                  <p class="ep-guest">Guest Name</p>
                  <p class="ep-topic">a cartographer of places that never existed</p>
                </div>
                <Wordmark class="ep-wm" size="5.4cqi" />
              </div>
              <figcaption class="cap"><b>Episode thumbnail.</b> 1280 × 720 for YouTube and clips.</figcaption>
            </figure>
            <figure class="app-avatar reveal">
              <div class="avatar tone-dark"><Wordmark size="13cqi" /></div>
              <figcaption class="cap"><b>Profile.</b> Platforms crop to a circle, so the wordmark centers.</figcaption>
            </figure>
          </div>

          <div class="apps-social">
            <figure class="app-post reveal">
              <div class="frame frame--45 tone-light">
                <Lines vw={100} vh={125} count={9} fall={6} x={8} gap={2.4} y={8} len={12} w={0.45} />
                <blockquote class="post-quote">“I have never told anyone this, but I alphabetize my spices by mood.”</blockquote>
                <p class="post-cite">Guest Name, ep. 12</p>
                <Wordmark class="post-wm" size="6.6cqi" />
              </div>
              <figcaption class="cap"><b>Quote post.</b> 1080 × 1350.</figcaption>
            </figure>
            <figure class="app-story reveal">
              <div class="frame frame--916 tone-dark">
                <Wordmark class="story-wm" size="9cqi" />
                <Lines vw={100} vh={178} count={10} fall={6} x={10} gap={8.9} y={52} len={64} w={0.8} />
                <div class="story-text">
                  <p class="story-new">New episode</p>
                  <p class="story-guest">Guest Name</p>
                  <p class="story-topic">a cartographer of places that never existed</p>
                </div>
              </div>
              <figcaption class="cap"><b>Story.</b> 1080 × 1920.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- ============ 04 COLOR ============ -->
      <section class="chapter" id="color" data-chapter="color" aria-labelledby="color-h">
        <div class="wrap">
          <header class="ch-head reveal">
            <p class="ch-no">04</p>
            <h2 class="ch-title" id="color-h">Color</h2>
            <p class="ch-lede">
              Black and white is the identity at its simplest, and the recommended starting point.
              The other nineteen keep the same restraint and let one color in, mostly through the dot.
            </p>
          </header>

          <div class="picker">
            <div class="picker-preview" aria-live="polite">
              <div class="pp-covers">
                <Cover tone="field" class="tone-field" label="Selected palette, field" />
                <Cover tone="paper" class="tone-counter" label="Selected palette, counter" />
              </div>
              <p class="pp-name"><span data-bind="pal-no">{rec.no}</span> <span data-bind="pal-name">{rec.name}</span></p>
              <p class="pp-mood" data-bind="pal-mood">{rec.mood}</p>
            </div>
            <div class="picker-list" role="group" aria-label="Twenty color directions">
              {grouped.map((g) => (
                <div class="pl-group">
                  <p class="pl-head">{g.name}</p>
                  <ul>
                    {g.items.map((c) => (
                      <li>
                        <button
                          type="button"
                          class="pl-item"
                          data-palette={c.no}
                          data-p={c.p}
                          data-s={c.s}
                          data-name={c.name}
                          data-mood={c.mood}
                          aria-pressed={c.no === RECOMMENDED.palette ? "true" : "false"}
                        >
                          <span class="sw" style={`--sp:${c.p};--ss:${c.s}`} aria-hidden="true"></span>
                          <span class="pl-no">{c.no}</span>
                          <span class="pl-name">{c.name}</span>
                          <span class="pl-mood">{c.mood}</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <a class="to-explore" href="#explore">Keep going in the explorer</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ 05 EXPLORE ============ -->
      <section class="chapter chapter--explore" id="explore" data-chapter="explore" aria-labelledby="xp-h">
        <div class="xp-intro tone-dark">
          <div class="wrap">
            <p class="ch-no">05</p>
            <h2 id="xp-h" class="xp-say">Make it your own.</h2>
            <p class="xp-copy">
              Explore different expressions of the identity. Change the unexpected detail, try the
              alternate typeface, and find a color direction that feels right. Everything here updates
              as you go.
            </p>
          </div>
        </div>

        <div class="wrap xp-grid">
          <div class="xp-main tone-field" role="img" aria-label="Live preview of the logo">
            <Lines vw={100} vh={75} count={14} fall={9} x={11.4} y={9} len={30} />
            <Wordmark class="xp-wm" size="13cqi" />
          </div>

          <form class="xp-ctl" onsubmit="return false" aria-label="Explorer settings">
            <fieldset class="opt">
              <legend><span>A</span>The unexpected detail</legend>
              <div class="choice">
                <button type="button" data-set-dot="period" aria-pressed="false">
                  <span class="choice-art annotate" data-dot="period"><Wordmark size="1em" line /></span>
                  <span class="choice-label">Period</span>
                </button>
                <button type="button" data-set-dot="i" aria-pressed="true">
                  <span class="choice-art annotate" data-dot="i"><Wordmark size="1em" line /></span>
                  <span class="choice-label">Dot above the i</span>
                </button>
              </div>
            </fieldset>

            <fieldset class="opt">
              <legend><span>B</span>Typeface</legend>
              <div class="choice">
                {fonts.map((f) => (
                  <button type="button" data-set-font={f.id} aria-pressed={f.id === RECOMMENDED.font ? "true" : "false"}>
                    <span class="choice-aa" data-font={f.id}>Aa</span>
                    <span class="choice-label">{f.name}</span>
                  </button>
                ))}
              </div>
            </fieldset>

            <fieldset class="opt opt--color">
              <legend><span>C</span>Color</legend>
              <p class="xc-current"><span data-bind="pal-no">{rec.no}</span> <b data-bind="pal-name">{rec.name}</b> <em data-bind="pal-mood">{rec.mood}</em></p>
              <div class="dots" role="group" aria-label="Color directions">
                {palettes.map((c) => (
                  <button
                    type="button"
                    class="dotsw sw"
                    style={`--sp:${c.p};--ss:${c.s}`}
                    data-palette={c.no}
                    data-p={c.p}
                    data-s={c.s}
                    data-name={c.name}
                    data-mood={c.mood}
                    aria-pressed={c.no === RECOMMENDED.palette ? "true" : "false"}
                    aria-label={`${c.no} ${c.name}`}
                    title={`${c.no} ${c.name}`}
                  />
                ))}
              </div>
              <div class="hexes">
                <label class="hex">
                  <span class="hex-label">Primary, the dot</span>
                  <span class="hex-field">
                    <input type="color" id="xp-primary-pick" value={rec.p.toLowerCase()} aria-label="Pick the primary color" />
                    <input type="text" id="xp-primary" value={rec.p} spellcheck="false" autocomplete="off" maxlength="7" aria-describedby="xp-hex-msg" />
                  </span>
                </label>
                <label class="hex">
                  <span class="hex-label">Secondary, the field</span>
                  <span class="hex-field">
                    <input type="color" id="xp-secondary-pick" value={rec.s.toLowerCase()} aria-label="Pick the secondary color" />
                    <input type="text" id="xp-secondary" value={rec.s} spellcheck="false" autocomplete="off" maxlength="7" aria-describedby="xp-hex-msg" />
                  </span>
                </label>
              </div>
              <p class="hex-msg" id="xp-hex-msg" aria-live="polite"></p>
            </fieldset>

            <div class="xp-actions">
              <button type="button" class="btn" id="xp-copy">Copy link to this version</button>
              <button type="button" class="link" id="xp-reset">Reset to recommended</button>
              <p class="xp-status" id="xp-status" aria-live="polite"></p>
            </div>
          </form>

          <div class="xp-sub">
            <div class="xp-paper tone-light">
              <p class="xp-kicker">ep. 12 · with Guest Name</p>
              <p class="xp-title">a cartographer of places that never existed</p>
              <p class="xp-line">Curiosity flips the frame.</p>
              <Wordmark class="xp-paper-wm" size="5.2cqi" />
            </div>
            <div class="xp-cover"><Cover tone="paper" class="tone-counter" /></div>
          </div>
        </div>
      </section>

      <footer class="end tone-dark">
        <div class="wrap end-row">
          <p>Prepared by Ryan Sheridan for Marcy · November 2026</p>
          <p><a href="/unexpected-detail/round-1">Rounds 01 to 05</a></p>
        </div>
      </footer>
    </main>
  </div>
</Layout>

<script>
  type Font = "gloock" | "dm";
  type Dot = "period" | "i";
  type State = { font: Font; dot: Dot; primary: string; secondary: string };

  const INK = "#141414";
  const PAPER = "#FAF9F6";
  const DOT_MIN = 2.25;
  const root = document.getElementById("ub")!;
  const RECOMMENDED: State = JSON.parse(root.dataset.rec!);
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const $$ = (s: string) => Array.from(document.querySelectorAll<HTMLElement>(s));

  const normalize = (v: string): string | null => {
    let h = v.trim().replace(/^#/, "");
    if (/^[0-9a-f]{3}$/i.test(h)) h = h.replace(/./g, (c) => c + c);
    return /^[0-9a-f]{6}$/i.test(h) ? `#${h.toUpperCase()}` : null;
  };
  const lum = (hex: string) => {
    const n = parseInt(hex.slice(1), 16);
    const c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => {
      const s = v / 255;
      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
  };
  const contrast = (a: string, b: string) => {
    const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
    return (x + 0.05) / (y + 0.05);
  };
  const onColor = (hex: string) => (contrast(hex, INK) >= contrast(hex, PAPER) ? INK : PAPER);
  // Same derivation as the page's frontmatter: see the comment on system().
  const system = (p: string, s: string) => {
    const fFg = onColor(s);
    const fieldDark = fFg === PAPER;
    const c = fieldDark ? PAPER : lum(p) < 0.045 ? p : INK;
    const cFg = onColor(c);
    const dotOn = (g: string, fg: string) => [p, s].find((x) => contrast(x, g) >= DOT_MIN) ?? fg;
    const f = { bg: s, fg: fFg, dot: dotOn(s, fFg) };
    const k = { bg: c, fg: cFg, dot: dotOn(c, cFg) };
    const [d, l] = fieldDark ? [f, k] : [k, f];
    return { f, c: k, d, l };
  };

  // A shared link opens on its own settings, in any browser.
  const q = new URLSearchParams(location.search);
  const state: State = {
    font: q.get("font") === "dm" ? "dm" : q.get("font") === "gloock" ? "gloock" : RECOMMENDED.font,
    dot: q.get("dot") === "period" ? "period" : q.get("dot") === "i" ? "i" : RECOMMENDED.dot,
    primary: normalize(q.get("primary") ?? "") ?? RECOMMENDED.primary,
    secondary: normalize(q.get("secondary") ?? "") ?? RECOMMENDED.secondary,
  };

  const palBtns = $$("[data-palette]");
  const fields = {
    primary: { pick: $<HTMLInputElement>("#xp-primary-pick"), hex: $<HTMLInputElement>("#xp-primary") },
    secondary: { pick: $<HTMLInputElement>("#xp-secondary-pick"), hex: $<HTMLInputElement>("#xp-secondary") },
  };
  const hexMsg = $("#xp-hex-msg");
  const status = $("#xp-status");
  const bind = (key: string, text: string) => $$(`[data-bind="${key}"]`).forEach((el) => (el.textContent = text));

  const isRecommended = () =>
    state.font === RECOMMENDED.font &&
    state.dot === RECOMMENDED.dot &&
    state.primary === RECOMMENDED.primary &&
    state.secondary === RECOMMENDED.secondary;
  const query = () =>
    isRecommended()
      ? ""
      : `?${new URLSearchParams({ dot: state.dot, font: state.font, primary: state.primary.slice(1), secondary: state.secondary.slice(1) })}`;
  const shareUrl = () => `${location.origin}${location.pathname}${query()}#explore`;

  function render(opts: { skip?: HTMLInputElement; url?: boolean } = {}) {
    root.dataset.font = state.font;
    root.dataset.dot = state.dot;
    const sys = system(state.primary, state.secondary);
    for (const [k, t] of Object.entries(sys)) {
      root.style.setProperty(`--${k}-bg`, t.bg);
      root.style.setProperty(`--${k}-fg`, t.fg);
      root.style.setProperty(`--${k}-dot`, t.dot);
    }

    $$("[data-set-dot]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setDot === state.dot)));
    $$("[data-set-font]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setFont === state.font)));

    const match = palBtns.find((b) => b.dataset.p === state.primary && b.dataset.s === state.secondary);
    palBtns.forEach((b) => b.setAttribute("aria-pressed", String(!!match && b.dataset.palette === match.dataset.palette)));
    bind("pal-no", match ? match.dataset.palette! : "");
    bind("pal-name", match ? match.dataset.name! : "Custom");
    bind("pal-mood", match ? match.dataset.mood! : `${state.primary} and ${state.secondary}`);

    for (const key of ["primary", "secondary"] as const) {
      const f = fields[key];
      if (f.hex !== opts.skip) {
        f.hex.value = state[key];
        f.hex.removeAttribute("aria-invalid");
      }
      if (f.pick !== opts.skip) f.pick.value = state[key].toLowerCase();
    }
    if (!opts.skip) hexMsg.textContent = "";

    if (opts.url !== false) history.replaceState(null, "", `${location.pathname}${query()}${location.hash}`);
    status.textContent = "";
  }

  $$("[data-set-dot]").forEach((b) => b.addEventListener("click", () => ((state.dot = b.dataset.setDot as Dot), render())));
  $$("[data-set-font]").forEach((b) => b.addEventListener("click", () => ((state.font = b.dataset.setFont as Font), render())));
  palBtns.forEach((b) =>
    b.addEventListener("click", () => {
      state.primary = b.dataset.p!;
      state.secondary = b.dataset.s!;
      render();
    }),
  );

  for (const key of ["primary", "secondary"] as const) {
    const f = fields[key];
    f.pick.addEventListener("input", () => {
      state[key] = normalize(f.pick.value)!;
      render({ skip: f.pick });
    });
    f.hex.addEventListener("input", () => {
      const v = normalize(f.hex.value);
      if (v) {
        state[key] = v;
        f.hex.removeAttribute("aria-invalid");
        hexMsg.textContent = "";
        render({ skip: f.hex });
      } else {
        f.hex.setAttribute("aria-invalid", "true");
        hexMsg.textContent = "Use a hex value like #F1D879.";
      }
    });
    f.hex.addEventListener("blur", () => render());
  }

  $("#xp-reset").addEventListener("click", () => {
    Object.assign(state, RECOMMENDED);
    render();
    status.textContent = "Back to the recommended version.";
  });
  $("#xp-copy").addEventListener("click", async () => {
    const url = shareUrl();
    try {
      await navigator.clipboard.writeText(url);
      status.textContent = "Link copied. It opens on this exact version.";
    } catch {
      status.textContent = `Copy this link: ${url}`;
    }
  });

  render({ url: false });

  // Chapter navigation: appears once the opening has scrolled away, and
  // marks the chapter in view.
  const nav = $("#chap-nav");
  const intro = $(".intro");
  new IntersectionObserver(([e]) => nav.classList.toggle("is-on", !e.isIntersecting), { rootMargin: "-30% 0px 0px 0px" }).observe(intro);
  const links = $$("[data-chap]");
  const seen = new Map<string, boolean>();
  const chapterIo = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => seen.set((e.target as HTMLElement).dataset.chapter!, e.isIntersecting));
      const current = [...document.querySelectorAll<HTMLElement>("[data-chapter]")].map((c) => c.dataset.chapter!).filter((id) => seen.get(id)).pop();
      if (current) links.forEach((l) => (l.dataset.chap === current ? l.setAttribute("aria-current", "true") : l.removeAttribute("aria-current")));
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  $$("[data-chapter]").forEach((c) => chapterIo.observe(c));

  // Gentle entrances, once each, and only when motion is welcome.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    root.classList.add("motion");
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }),
      { rootMargin: "0px 0px -8% 0px" },
    );
    $$(".reveal").forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  /* 0 or 1: how much of the i's dot takes the dot color. A number, so the
     switch animates and each element mixes its own --dot. */
  @property --i-on {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  .ub {
    --ud-ink: #141414;
    --ud-paper: #faf9f6;
    --ud-stone: #eeece6;
    --ud-line: rgb(20 20 20 / 0.14);
    --ud-muted: rgb(20 20 20 / 0.64);
    --gutter: clamp(16px, 4.4vw, 64px);
    --nav-h: 44px;
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    --dot: var(--l-dot);
    background: var(--ud-paper);
    color: var(--ud-ink);
    font-family: var(--font-sans);
    overflow-x: clip;
  }
  .ub *,
  .ub *::before,
  .ub *::after {
    box-sizing: border-box;
  }
  /* Zero specificity, so every class below can set its own margins. */
  :where(.ub) :where(p, h2, h3, figure, blockquote, dl, dd, ul, ol) {
    margin: 0;
  }
  :where(.ub) :where(ul, ol) {
    padding: 0;
    list-style: none;
  }
  html:has(.ub) {
    scroll-padding-top: var(--nav-h);
  }

  /* Typeface settings. Inherited, so the nearest data-font wins. */
  .ub [data-font="gloock"],
  .ub[data-font="gloock"] {
    --ud-display: "Gloock", Georgia, serif;
    --wm-scale: 1;
    --wm-lh: 0.92;
    --wm-track: -0.01em;
    --dd: 0.1688em;
    --dl: 0.0406em;
    --db: 0.2119em;
    --isplit: 0.257em;
    --idot: 0.1425em;
  }
  .ub [data-font="dm"],
  .ub[data-font="dm"] {
    --ud-display: "DM Serif Display", Georgia, serif;
    --wm-scale: 1.04;
    --wm-lh: 0.9;
    --wm-track: -0.015em;
    --dd: 0.1713em;
    --dl: 0.0644em;
    --db: 0.3206em;
    --isplit: 0.2775em;
    --idot: 0.175em;
  }
  .ub [data-dot="period"],
  .ub[data-dot="period"] {
    --pd-on: 1;
    --i-on: 0;
  }
  .ub [data-dot="i"],
  .ub[data-dot="i"] {
    --pd-on: 0;
    --i-on: 1;
  }

  /* Grounds. Each palette resolves to a field and a counter, and to which
     of the two is dark and which is light (see system() above). */
  .ub .tone-field {
    background-color: var(--f-bg);
    color: var(--f-fg);
    --dot: var(--f-dot);
  }
  .ub .tone-counter {
    background-color: var(--c-bg);
    color: var(--c-fg);
    --dot: var(--c-dot);
  }
  .ub .tone-dark {
    background-color: var(--d-bg);
    color: var(--d-fg);
    --dot: var(--d-dot);
  }
  .ub .tone-light {
    background-color: var(--l-bg);
    color: var(--l-fg);
    --dot: var(--l-dot);
  }
  .ub .tone-stone {
    background-color: var(--ud-stone);
  }
  .ub .tone-field,
  .ub .tone-counter,
  .ub .tone-dark,
  .ub .tone-light {
    transition:
      background-color 0.5s var(--ease),
      color 0.5s var(--ease);
  }

  .ub .wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* ---------- the wordmark ---------- */
  .ub .wm {
    display: inline-block;
    font-family: var(--ud-display);
    font-weight: 400;
    line-height: var(--wm-lh);
    letter-spacing: var(--wm-track);
    text-align: right;
    white-space: nowrap;
    font-kerning: normal;
    font-synthesis: none;
  }
  .ub .wm-a {
    display: block;
    padding-right: 1.2em;
  }
  .ub .wm-b {
    display: block;
  }
  .ub .wm--line .wm-a,
  .ub .wm--line .wm-b {
    display: inline;
    padding: 0;
  }
  .ub .wm--line .wm-a::after {
    content: " ";
  }
  /* The i keeps its own glyph; above the gap between dot and stem it takes
     the dot color when the detail is the dot of the i. The box is an
     inline-block at the lockup's line-height, which --isplit and --idot are
     measured against. */
  .ub .wm-i {
    position: relative;
    display: inline-block;
    line-height: var(--wm-lh);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--dot) calc(var(--i-on) * 100%), currentColor) 0 var(--isplit),
      currentColor var(--isplit)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: --i-on 0.45s var(--ease);
  }
  /* The period hangs past the edge, so showing or hiding it moves nothing. */
  .ub .wm-pd {
    position: relative;
    -webkit-text-fill-color: transparent;
    margin-right: calc((var(--dd) + 2 * var(--dl)) * -1);
  }
  .ub .wm-pd::after {
    content: "";
    position: absolute;
    left: var(--dl);
    bottom: var(--db);
    width: var(--dd);
    height: var(--dd);
    border-radius: 50%;
    background: var(--dot);
    opacity: var(--pd-on);
    transform: scale(var(--pd-on));
    transition:
      opacity 0.35s var(--ease),
      transform 0.45s var(--ease),
      background-color 0.5s var(--ease);
  }
  .ub .mark {
    line-height: var(--wm-lh);
  }
  /* Drawn rings that point at the detail, wherever it sits. They read in
     black and white, where the dot has no color to give it away. */
  .ub .annotate .wm-i::after,
  .ub .annotate .wm-pd::before {
    content: "";
    position: absolute;
    width: 0.3em;
    height: 0.3em;
    border: max(1px, 0.012em) solid currentColor;
    border-radius: 50%;
    -webkit-text-fill-color: initial;
    transition: opacity 0.35s var(--ease);
  }
  .ub .annotate .wm-i::after {
    left: 50%;
    top: var(--idot);
    transform: translate(-50%, -50%);
    opacity: calc(var(--i-on) * 0.55);
  }
  .ub .annotate .wm-pd::before {
    left: calc(var(--dl) + var(--dd) / 2);
    bottom: calc(var(--db) + var(--dd) / 2);
    transform: translate(-50%, 50%);
    opacity: calc(var(--pd-on) * 0.55);
  }

  /* ---------- the falling line (SVG) ---------- */
  .ub .ud-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .ub .ud-fall {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: rotate(var(--fall));
  }
  .ub .cover {
    position: relative;
    aspect-ratio: 1;
    container-type: inline-size;
    overflow: hidden;
    flex: none;
  }
  .ub .cover-wm {
    position: absolute;
    right: 11.4cqi;
    bottom: 9cqi;
  }
  /* A light ground next to page paper needs an edge. */
  .ub .cover.tone-light,
  .ub .cover.tone-field,
  .ub .cover.tone-counter,
  .ub .frame.tone-light {
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }

  /* ---------- type system ---------- */
  .ub .ch-no,
  .ub .sub-no {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    opacity: 0.6;
  }
  .ub .ch-title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(34px, 3.6vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .ub .ch-lede {
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.55;
    color: var(--ud-muted);
    max-width: 46ch;
  }
  .ub .sub {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .ub .statement {
    font-family: var(--ud-display);
    font-weight: 400;
    font-size: clamp(44px, 6.4vw, 104px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .ub .cap,
  .ub figcaption {
    font-size: 13px;
    line-height: 1.55;
  }
  .ub .cap {
    margin-top: 14px;
    color: var(--ud-muted);
    max-width: 44ch;
  }
  .ub .cap b,
  .ub figcaption b {
    font-weight: 500;
    color: var(--ud-ink);
  }
  .ub [class*="tone-"] figcaption b {
    color: inherit;
  }
  .ub .fine {
    margin-top: 20px;
    font-size: 13px;
    color: var(--ud-muted);
  }
  .ub a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }
  .ub :focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .ub.motion .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.9s var(--ease),
      transform 0.9s var(--ease);
  }
  .ub.motion .reveal.is-in {
    opacity: 1;
    transform: none;
  }

  /* ---------- chapter navigation ---------- */
  .chap-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 var(--gutter);
    background: var(--ud-paper);
    border-bottom: 1px solid var(--ud-line);
    font-size: 12px;
    transform: translateY(-101%);
    transition: transform 0.4s var(--ease);
  }
  .chap-nav.is-on,
  .chap-nav:focus-within {
    transform: none;
  }
  .chap-home {
    font-weight: 500;
    text-decoration: none !important;
    white-space: nowrap;
  }
  .chap-nav ol {
    display: flex;
    gap: clamp(12px, 2.2vw, 32px);
  }
  .chap-nav li a {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 0;
    color: var(--ud-muted);
    text-decoration: none;
  }
  .chap-nav li a span {
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .chap-nav li a b {
    font-weight: 400;
  }
  .chap-nav li a[aria-current] {
    color: var(--ud-ink);
  }
  .chap-nav li a[aria-current] span::before {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 6px;
    border-radius: 50%;
    background: currentColor;
    vertical-align: 2px;
  }
  @media (max-width: 760px) {
    .chap-home {
      display: none;
    }
    .chap-nav {
      justify-content: center;
    }
    .chap-nav li a:not([aria-current]) b {
      display: none;
    }
  }

  /* ---------- opening ---------- */
  .intro {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 28px var(--gutter) clamp(28px, 5vw, 64px);
    container-type: inline-size;
    overflow: hidden;
  }
  .intro-meta {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    align-items: baseline;
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  .intro-name {
    font-weight: 500;
    font-size: 13px;
  }
  .intro-tags {
    display: flex;
    gap: 28px;
    opacity: 0.7;
  }
  .intro-draft {
    justify-self: end;
    opacity: 0.7;
  }
  .intro-lines {
    align-self: start;
    display: flex;
    justify-content: space-between;
    height: clamp(140px, 27svh, 300px);
    margin-top: clamp(48px, 10svh, 120px);
  }
  .intro-lines span {
    width: 1px;
    background: currentColor;
    transform-origin: 50% 100%;
  }
  .intro-lines .fall {
    transform: rotate(14deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .intro-lines .fall {
      animation: ud-tip 1.3s cubic-bezier(0.6, 0, 0.4, 1) 0.7s both;
    }
  }
  @keyframes ud-tip {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(14deg);
    }
  }
  .intro-foot {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: end;
    margin-top: 40px;
  }
  .intro-desc {
    position: absolute;
    left: 0;
    bottom: 0.4em;
    max-width: 32ch;
    font-size: clamp(13px, 1.05vw, 15px);
    line-height: 1.55;
    opacity: 0.75;
  }
  .intro-skip {
    position: absolute;
    left: var(--gutter);
    top: 4px;
    z-index: 2;
    font-size: 12px;
    transform: translateY(-300%);
  }
  .intro-skip:focus {
    transform: none;
  }
  @media (max-width: 760px) {
    .intro {
      min-height: 92svh;
    }
    .intro-meta {
      grid-template-columns: 1fr auto;
    }
    .intro-tags {
      display: none;
    }
    .intro-lines span:nth-child(even) {
      display: none;
    }
    .intro-foot {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }
    .intro-desc {
      position: static;
    }
    .intro-wm {
      align-self: flex-end;
    }
  }

  /* ---------- chapters ---------- */
  .chapter {
    padding-top: clamp(88px, 10vw, 152px);
  }
  .ch-head {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 12px 32px;
    align-items: baseline;
    padding-top: 16px;
    border-top: 1px solid currentColor;
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  @media (max-width: 860px) {
    .ch-head {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 01 identity ---------- */
  .brief {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 32px;
  }
  .brief > div {
    padding-top: 12px;
    border-top: 1px solid var(--ud-line);
  }
  .brief dt {
    font-size: 12px;
    color: var(--ud-muted);
  }
  .brief dd {
    margin-top: 8px;
    font-size: clamp(17px, 1.4vw, 21px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    max-width: 24ch;
  }
  .id-primary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
    gap: 48px;
    align-items: end;
    padding-block: clamp(96px, 12vw, 180px) clamp(64px, 8vw, 120px);
  }
  .construct {
    position: relative;
    justify-self: center;
    font-size: clamp(50px, 8.6vw, 132px);
  }
  .construct .g {
    position: absolute;
    pointer-events: none;
    color: var(--ud-muted);
  }
  .construct .g em {
    position: absolute;
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 11px;
    white-space: nowrap;
  }
  .g-edge {
    right: 0;
    top: -0.35em;
    bottom: -0.3em;
    border-right: 1px dashed currentColor;
  }
  .g-edge em {
    right: 8px;
    top: -2px;
  }
  .g-step {
    right: 0;
    top: 0.12em;
    width: 1.2em;
    height: 0.62em;
    border: 1px dashed currentColor;
    border-right: 0;
  }
  .g-step em {
    left: 0;
    bottom: calc(100% + 6px);
  }
  .g-base {
    left: -0.2em;
    right: -0.4em;
    top: calc(var(--wm-lh) * 2em - 0.085em);
    border-top: 1px dashed currentColor;
    opacity: 0.7;
  }
  .id-cap p {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ud-muted);
  }
  .split {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
  }
  .split-half {
    position: relative;
    min-height: clamp(340px, 40vw, 560px);
    display: grid;
    grid-template-rows: 1fr auto;
    padding: clamp(24px, 3.4vw, 48px);
    container-type: inline-size;
  }
  .split-art {
    display: grid;
    place-items: center;
  }
  .split-half figcaption {
    max-width: 40ch;
    opacity: 0.8;
  }
  .split-half--mark {
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }
  .split-half--mark .mark {
    font-size: 46cqi;
  }
  @media (max-width: 860px) {
    .brief,
    .id-primary,
    .split {
      grid-template-columns: 1fr;
    }
    .construct {
      justify-self: end;
      margin-right: 6px;
    }
    .construct .g em {
      display: none;
    }
    .split-half {
      min-height: 300px;
    }
    .split-half .wm--line {
      font-size: calc(var(--wm-scale) * 8.4cqi) !important;
    }
  }

  /* ---------- 02 details ---------- */
  .detail {
    padding-top: clamp(64px, 8vw, 120px);
    overflow: hidden;
  }
  .detail-head {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    grid-template-areas:
      "no no"
      "say copy";
    gap: 32px 64px;
    align-items: end;
  }
  .detail-head .sub-no {
    grid-area: no;
  }
  .detail-head .statement {
    grid-area: say;
  }
  .detail-copy {
    grid-area: copy;
    font-size: 15px;
    line-height: 1.6;
    max-width: 40ch;
    opacity: 0.78;
  }
  /* The word sits on the bottom edge: its baseline is the band's last
     pixel, and "detail" has no descenders to lose. */
  .detail-word {
    container-type: inline-size;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    margin-top: clamp(40px, 6vw, 88px);
  }
  .detail-wm {
    margin-bottom: -0.085em;
    letter-spacing: -0.03em !important;
  }
  .detail-wm .wm-a {
    display: none !important;
  }
  .ab {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--ud-line);
  }
  .ab-half {
    container-type: inline-size;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 24px;
    min-height: clamp(400px, 42vw, 600px);
    padding: clamp(28px, 4vw, 56px);
  }
  .ab-half + .ab-half {
    border-left: 1px solid var(--ud-line);
  }
  .ab-tag {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 13px;
    font-weight: 500;
  }
  .ab-tag span {
    font-family: var(--font-mono);
    font-weight: 400;
    opacity: 0.6;
  }
  .ab-tag b {
    margin-left: auto;
    font-size: 12px;
    font-weight: 400;
    color: var(--ud-muted);
  }
  .ab-art {
    display: grid;
    place-items: center;
  }
  .ab-half figcaption {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ud-muted);
    max-width: 46ch;
  }
  .type,
  .lang {
    padding-top: clamp(80px, 10vw, 144px);
  }
  .type-pair {
    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    gap: 32px clamp(24px, 3vw, 48px);
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--ud-line);
    align-items: start;
  }
  .type-aa {
    font-size: clamp(88px, 10vw, 160px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .display {
    font-family: var(--ud-display);
  }
  .sans {
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: -0.06em;
  }
  .type-face .sub span {
    margin-left: 8px;
    font-weight: 400;
    color: var(--ud-muted);
  }
  .type-use {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ud-muted);
    max-width: 36ch;
  }
  .type-sample {
    padding: clamp(24px, 3vw, 40px);
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }
  .ts-meta {
    font-size: 12px;
    color: var(--ud-muted);
  }
  .ts-title {
    margin-top: 14px;
    font-family: var(--ud-display);
    font-size: clamp(30px, 2.8vw, 44px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .ts-body {
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.6;
  }
  .lang-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    gap: 32px clamp(24px, 3vw, 48px);
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--ud-line);
    align-items: start;
  }
  .lang-lead {
    font-size: clamp(18px, 1.5vw, 22px);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  .rules {
    margin-top: 20px;
    display: grid;
    gap: 8px;
    font-size: 14px;
    color: var(--ud-muted);
  }
  .rules li::before {
    content: "";
    display: inline-block;
    width: 1px;
    height: 0.9em;
    margin-right: 10px;
    background: currentColor;
    vertical-align: -0.1em;
  }
  .page {
    padding: clamp(20px, 3vw, 36px);
    container-type: inline-size;
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }
  .page-rule {
    position: relative;
    height: 6.6cqi;
  }
  .page-kicker {
    margin-top: 5cqi;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .page-title {
    margin-top: 2cqi;
    font-family: var(--ud-display);
    font-size: 7.6cqi;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .page-body {
    margin-top: 5cqi;
    font-size: 13px;
    line-height: 1.6;
    opacity: 0.7;
  }
  .lang figcaption {
    margin-top: 12px;
    color: var(--ud-muted);
  }
  .frame {
    position: relative;
    overflow: hidden;
    container-type: inline-size;
  }
  .frame--1 {
    aspect-ratio: 1;
  }
  .frame--169 {
    aspect-ratio: 16 / 9;
  }
  .frame--45 {
    aspect-ratio: 4 / 5;
  }
  .frame--916 {
    aspect-ratio: 9 / 16;
  }
  .lg-ep {
    position: absolute;
    left: 11.4cqi;
    bottom: 9cqi;
    font-size: 6cqi;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  @media (max-width: 960px) {
    .type-pair,
    .lang-grid {
      grid-template-columns: 1fr 1fr;
    }
    .type-sample,
    .lang-text {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 760px) {
    .detail-head {
      grid-template-columns: 1fr;
      grid-template-areas: "no" "say" "copy";
    }
    .ab {
      grid-template-columns: 1fr;
    }
    .ab-half {
      min-height: 0;
    }
    .ab-half + .ab-half {
      border-left: 0;
      border-top: 1px solid var(--ud-line);
    }
    .ab-art .wm {
      font-size: calc(var(--wm-scale) * 15cqi) !important;
      padding-block: 24px;
    }
  }
  @media (max-width: 560px) {
    .type-pair,
    .lang-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 03 applications ---------- */
  #applications {
    padding-bottom: clamp(88px, 10vw, 152px);
  }
  .apps-cover {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
  }
  .sizes {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    margin-top: 28px;
    font-size: 12px;
    color: var(--ud-muted);
  }
  .sizes > span {
    margin-left: 6px;
  }
  .apps-row {
    display: grid;
    grid-template-columns: 8fr 4fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    margin-top: clamp(64px, 8vw, 120px);
  }
  .ep-text {
    position: absolute;
    left: 56cqi;
    top: 8.5cqi;
    right: 5cqi;
  }
  .ep-no {
    font-size: 2cqi;
    opacity: 0.7;
  }
  .ep-guest {
    margin-top: 1.4cqi;
    font-family: var(--ud-display);
    font-size: 6.4cqi;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ep-topic {
    margin-top: 1.6cqi;
    font-size: 2.2cqi;
    line-height: 1.35;
    opacity: 0.8;
    max-width: 30ch;
  }
  .ep-wm {
    position: absolute;
    right: 5cqi;
    bottom: 6cqi;
  }
  .avatar {
    aspect-ratio: 1;
    border-radius: 50%;
    container-type: inline-size;
    display: grid;
    place-items: center;
  }
  .apps-social {
    display: grid;
    grid-template-columns: 5fr 3fr 3fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
    margin-top: clamp(64px, 8vw, 120px);
  }
  .app-story {
    margin-top: clamp(40px, 8vw, 120px);
  }
  .post-quote {
    position: absolute;
    left: 8cqi;
    right: 8cqi;
    top: 30cqi;
    font-family: var(--ud-display);
    font-size: 8.4cqi;
    line-height: 1.08;
    letter-spacing: -0.015em;
  }
  .post-cite {
    position: absolute;
    left: 8cqi;
    bottom: 9cqi;
    font-size: 3cqi;
    opacity: 0.65;
  }
  .post-wm {
    position: absolute;
    right: 8cqi;
    bottom: 8cqi;
  }
  .story-wm {
    position: absolute;
    right: 9cqi;
    top: 11cqi;
  }
  .story-text {
    position: absolute;
    left: 10cqi;
    right: 10cqi;
    bottom: 12cqi;
  }
  .story-new {
    font-size: 3.6cqi;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .story-new::before {
    content: "";
    display: inline-block;
    width: 2.4cqi;
    height: 2.4cqi;
    margin-right: 2cqi;
    border-radius: 50%;
    background: var(--dot);
    vertical-align: 0.2em;
  }
  .story-guest {
    margin-top: 4cqi;
    font-size: 10.5cqi;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .story-topic {
    margin-top: 3cqi;
    font-size: 4.2cqi;
    line-height: 1.35;
    opacity: 0.8;
  }
  @media (max-width: 860px) {
    .apps-cover,
    .apps-row {
      grid-template-columns: 1fr;
    }
    .app-avatar {
      width: min(100%, 300px);
    }
    .apps-social {
      grid-template-columns: 1fr 1fr;
    }
    .app-post {
      grid-column: 1 / -1;
    }
    .app-story {
      margin-top: 0;
    }
    .ac-side {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 16px;
      align-items: end;
    }
    .ac-side .cap {
      margin-top: 0;
    }
    .sizes {
      grid-column: 1 / -1;
    }
  }

  /* ---------- 04 color ---------- */
  .picker {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    padding-bottom: clamp(88px, 10vw, 152px);
    align-items: start;
  }
  .picker-preview {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }
  .pp-covers {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 8px;
    align-items: end;
  }
  .pp-name {
    margin-top: 20px;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .pp-name span:first-child {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    color: var(--ud-muted);
    margin-right: 6px;
  }
  .pp-mood {
    margin-top: 4px;
    font-size: 14px;
    color: var(--ud-muted);
  }
  .picker-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 24px;
  }
  .pl-group:nth-child(1),
  .pl-group:nth-child(2) {
    grid-row: span 2;
  }
  .pl-head {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ud-ink);
    font-size: 12px;
    font-weight: 500;
  }
  .pl-item {
    width: 100%;
    display: grid;
    grid-template-columns: 36px auto 1fr;
    grid-template-areas:
      "sw no name"
      "sw no mood";
    column-gap: 12px;
    align-items: center;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid var(--ud-line);
    background: none;
    color: var(--ud-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .pl-item .sw {
    grid-area: sw;
    width: 36px;
  }
  .pl-no {
    grid-area: no;
    align-self: start;
    padding-top: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ud-muted);
  }
  .pl-name {
    grid-area: name;
    font-size: 14px;
    font-weight: 500;
  }
  .pl-mood {
    grid-area: mood;
    font-size: 12px;
    color: var(--ud-muted);
  }
  .pl-item:hover .pl-name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .pl-item[aria-pressed="true"] .sw {
    outline: 2px solid var(--ud-ink);
    outline-offset: 2px;
  }
  .pl-item[aria-pressed="true"] .pl-name::after {
    content: "Selected";
    margin-left: 8px;
    font-size: 11px;
    font-weight: 400;
    color: var(--ud-muted);
  }
  .to-explore {
    grid-column: 1 / -1;
    justify-self: start;
    font-size: 15px;
    font-weight: 500;
  }
  .to-explore::after {
    content: " ↓";
  }
  /* A palette swatch: the field with the dot at its center. */
  .ub .sw {
    position: relative;
    display: block;
    aspect-ratio: 1;
    background: var(--ss);
    box-shadow: inset 0 0 0 1px rgb(20 20 20 / 0.1);
  }
  .ub .sw::after {
    content: "";
    position: absolute;
    inset: 33%;
    border-radius: 50%;
    background: var(--sp);
  }
  @media (max-width: 960px) {
    .picker {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    /* The preview rides along while the list scrolls under it. */
    .picker-preview {
      top: var(--nav-h);
      z-index: 4;
      margin-inline: calc(var(--gutter) * -1);
      padding: 12px var(--gutter);
      background: var(--ud-paper);
      border-bottom: 1px solid var(--ud-line);
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0 16px;
      align-items: end;
    }
    .pp-covers {
      width: min(52vw, 260px);
      grid-row: span 2;
    }
    .pp-name {
      margin-top: 0;
      font-size: 17px;
    }
  }
  @media (max-width: 700px) {
    .picker-list {
      grid-template-columns: 1fr;
    }
    .pl-group:nth-child(1),
    .pl-group:nth-child(2) {
      grid-row: auto;
    }
  }

  /* ---------- 05 explore ---------- */
  .chapter--explore {
    padding-top: 0;
    padding-bottom: clamp(80px, 10vw, 152px);
  }
  .xp-intro {
    padding-block: clamp(72px, 8vw, 120px) clamp(56px, 6vw, 96px);
    margin-bottom: clamp(40px, 5vw, 80px);
  }
  .xp-say {
    margin-top: clamp(40px, 6vw, 88px);
    font-family: var(--ud-display);
    font-weight: 400;
    font-size: clamp(56px, 11vw, 184px);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .xp-copy {
    margin-top: clamp(28px, 3vw, 44px);
    margin-left: auto;
    max-width: 44ch;
    font-size: 17px;
    line-height: 1.6;
    opacity: 0.8;
  }
  .xp-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    grid-template-areas:
      "main ctl"
      "sub ctl";
    gap: 16px clamp(28px, 4vw, 64px);
    align-items: start;
  }
  .xp-main {
    grid-area: main;
    position: relative;
    aspect-ratio: 4 / 3;
    container-type: inline-size;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }
  .xp-wm {
    position: absolute;
    right: 9cqi;
    bottom: 8cqi;
  }
  .xp-sub {
    grid-area: sub;
    display: grid;
    grid-template-columns: 1fr minmax(0, 0.62fr);
    gap: 16px;
  }
  .xp-paper {
    position: relative;
    container-type: inline-size;
    padding: clamp(22px, 3vw, 44px);
    box-shadow: inset 0 0 0 1px var(--ud-line);
  }
  .xp-kicker {
    font-size: 12px;
    opacity: 0.64;
  }
  .xp-title {
    margin-top: 12px;
