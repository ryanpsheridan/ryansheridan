<script>
  // Marks the section in view in the right rail.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".page-nav a")];
  const targets = links
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute("href") ?? ""))
    .filter((el): el is HTMLElement => !!el);

  if (targets.length && "IntersectionObserver" in window) {
    const setCurrent = () => {
      const line = window.innerHeight * 0.3;
      let current = targets[0];
      for (const t of targets) if (t.getBoundingClientRect().top <= line) current = t;
      links.forEach((a) => {
        if (a.getAttribute("href") === `#${current.id}`) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      });
    };
    new IntersectionObserver(setCurrent, { rootMargin: "-30% 0px -69% 0px" }).observe(document.body);
    targets.forEach((t) => new IntersectionObserver(setCurrent, { rootMargin: "-30% 0px -69% 0px" }).observe(t));
    addEventListener("scroll", setCurrent, { passive: true });
    setCurrent();
  }
</script>
