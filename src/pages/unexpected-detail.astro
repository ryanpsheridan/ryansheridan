<script>
  type Font = "gloock" | "dm";
  type Dot = "period" | "i";
  type State = { font: Font; dot: Dot; primary: string; secondary: string };

  const root = document.getElementById("ub")!;
  const DEFAULTS: State = JSON.parse(root.dataset.defaults!);
  const INK = "#141414";
  const PAPER = "#FAF9F6";
  const FONT_NAMES: Record<Font, string> = { gloock: "Gloock", dm: "DM Serif Display" };

  const normalize = (v: string): string | null => {
    let h = v.trim().replace(/^#/, "");
    if (/^[0-9a-f]{3}$/i.test(h)) h = h.replace(/./g, (c) => c + c);
    return /^[0-9a-f]{6}$/i.test(h) ? `#${h.toUpperCase()}` : null;
  };
  const lum = (hex: string) => {
    const n = parseInt(hex.slice(1), 16);
    const c = [n >> 16, (n >> 8) & 255, n & 255].map((v) => {
      const s = v / 255;
      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
  };
  const contrast = (a: string, b: string) => {
    const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
    return (x + 0.05) / (y + 0.05);
  };
  const onColor = (hex: string) => (contrast(hex, INK) >= contrast(hex, PAPER) ? INK : PAPER);

  // Start from the URL, so a copied link opens on the same settings.
  const q = new URLSearchParams(location.search);
  const state: State = {
    font: q.get("font") === "dm" ? "dm" : q.get("font") === "gloock" ? "gloock" : DEFAULTS.font,
    dot: q.get("dot") === "i" ? "i" : q.get("dot") === "period" ? "period" : DEFAULTS.dot,
    primary: normalize(q.get("primary") ?? "") ?? DEFAULTS.primary,
    secondary: normalize(q.get("secondary") ?? "") ?? DEFAULTS.secondary,
  };

  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;
  const $$ = (sel: string) => Array.from(document.querySelectorAll<HTMLElement>(sel));
  const fields = {
    primary: { pick: $<HTMLInputElement>("#ub-primary-pick"), hex: $<HTMLInputElement>("#ub-primary-hex") },
    secondary: { pick: $<HTMLInputElement>("#ub-secondary-pick"), hex: $<HTMLInputElement>("#ub-secondary-hex") },
  };

  const bind = (key: string, text: string) => $$(`[data-bind="${key}"]`).forEach((el) => (el.textContent = text));
  const flag = (key: string, ratio: number, floor: number) => {
    bind(key, `${ratio.toFixed(1)}:1`);
    $$(`[data-flag="${key}"]`).forEach((el) => {
      el.textContent = ratio >= floor ? "holds" : "low";
      el.dataset.ok = String(ratio >= floor);
    });
  };

  function render(opts: { url?: boolean; skip?: HTMLInputElement } = {}) {
    root.dataset.font = state.font;
    root.dataset.dot = state.dot;
    const onSecondary = onColor(state.secondary);
    root.style.setProperty("--ud-primary", state.primary);
    root.style.setProperty("--ud-secondary", state.secondary);
    root.style.setProperty("--ud-on-secondary", onSecondary);
    root.style.setProperty("--ud-on-primary", onColor(state.primary));

    $$("[data-set-font]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setFont === state.font)));
    $$("[data-set-dot]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setDot === state.dot)));
    $$("[data-apply-font]").forEach((b) => {
      const on = b.dataset.applyFont === state.font && b.dataset.applyDot === state.dot;
      b.setAttribute("aria-pressed", String(on));
      b.textContent = on ? "In use" : "Use this";
    });
    $$(".combo").forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.p === state.primary && b.dataset.s === state.secondary)),
    );

    for (const key of ["primary", "secondary"] as const) {
      const f = fields[key];
      if (f.hex !== opts.skip) f.hex.value = state[key];
      f.hex.removeAttribute("aria-invalid");
      if (f.pick !== opts.skip) f.pick.value = state[key].toLowerCase();
      bind(key, state[key]);
    }
    bind("font-name", FONT_NAMES[state.font]);
    flag("c-paper", contrast(state.primary, PAPER), 3);
    flag("c-field", contrast(state.primary, state.secondary), 3);
    flag("c-type", contrast(onSecondary, state.secondary), 4.5);

    if (opts.url !== false) {
      const p = new URLSearchParams();
      if (state.font !== DEFAULTS.font) p.set("font", state.font);
      if (state.dot !== DEFAULTS.dot) p.set("dot", state.dot);
      if (state.primary !== DEFAULTS.primary) p.set("primary", state.primary.slice(1));
      if (state.secondary !== DEFAULTS.secondary) p.set("secondary", state.secondary.slice(1));
      const s = p.toString();
      history.replaceState(null, "", s ? `?${s}${location.hash}` : location.pathname + location.hash);
    }
  }

  $$("[data-set-font]").forEach((b) => b.addEventListener("click", () => ((state.font = b.dataset.setFont as Font), render())));
  $$("[data-set-dot]").forEach((b) => b.addEventListener("click", () => ((state.dot = b.dataset.setDot as Dot), render())));
  $$("[data-apply-font]").forEach((b) =>
    b.addEventListener("click", () => {
      state.font = b.dataset.applyFont as Font;
      state.dot = b.dataset.applyDot as Dot;
      render();
    }),
  );
  $$(".combo").forEach((b) =>
    b.addEventListener("click", () => {
      state.primary = b.dataset.p!;
      state.secondary = b.dataset.s!;
      render();
    }),
  );

  for (const key of ["primary", "secondary"] as const) {
    const f = fields[key];
    f.pick.addEventListener("input", () => {
      state[key] = normalize(f.pick.value)!;
      render({ skip: f.pick });
    });
    f.hex.addEventListener("input", () => {
      const v = normalize(f.hex.value);
      if (v) {
        state[key] = v;
        render({ skip: f.hex });
      } else f.hex.setAttribute("aria-invalid", "true");
    });
    f.hex.addEventListener("blur", () => render());
  }

  $("#ub-swap").addEventListener("click", () => {
    [state.primary, state.secondary] = [state.secondary, state.primary];
    render();
  });
  $("#ub-reset").addEventListener("click", () => {
    Object.assign(state, DEFAULTS);
    render();
  });
  const copy = $<HTMLButtonElement>("#ub-copy");
  copy.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      copy.textContent = "Copied";
    } catch {
      copy.textContent = "Copy from the address bar";
    }
    setTimeout(() => (copy.textContent = "Copy link"), 1800);
  });

  render({ url: false });
</script>

<style is:global>
  /* Everything is scoped under .ub; the components are markup only. */
  .ub {
    --ud-ink: #141414;
    --ud-paper: #faf9f6;
    --ud-line: rgb(20 20 20 / 0.12);
    --ud-muted: rgb(20 20 20 / 0.6);
    --ud-canvas: #e7dfcf;
    --ud-wrap: 1240px;
    --ud-gutter: clamp(16px, 4vw, 48px);
    background: var(--ud-paper);
    color: var(--ud-ink);
    font-family: var(--font-sans);
    min-height: 100vh;
  }

  /* Typeface settings for the wordmark and display type. Each value is
     inherited, so a section with its own data-font overrides the page. */
  .ub [data-font="gloock"],
  .ub[data-font="gloock"] {
    --ud-display: "Gloock", Georgia, serif;
    --wm-scale: 1;
    --wm-lh: 0.92;
    --wm-track: -0.01em;
    --dd: 0.1688em;
    --dl: 0.0406em;
    --db: 0.2119em;
    --isplit: 0.257em;
  }
  .ub [data-font="dm"],
  .ub[data-font="dm"] {
    --ud-display: "DM Serif Display", Georgia, serif;
    --wm-scale: 1.04;
    --wm-lh: 0.9;
    --wm-track: -0.015em;
    --dd: 0.1713em;
    --dl: 0.0644em;
    --db: 0.3206em;
    --isplit: 0.2775em;
  }
  .ub [data-dot="period"],
  .ub[data-dot="period"] {
    --pd-display: inline;
    --i-top: currentColor;
  }
  .ub [data-dot="i"],
  .ub[data-dot="i"] {
    --pd-display: none;
    --i-top: var(--ud-primary);
  }

  .ub .tone-paper {
    background: var(--ud-paper);
    color: var(--ud-ink);
  }
  .ub .tone-field {
    background: var(--ud-secondary);
    color: var(--ud-on-secondary);
  }

  .ub-wrap {
    max-width: var(--ud-wrap);
    margin: 0 auto;
    padding: 0 var(--ud-gutter);
  }

  /* ---------- wordmark ---------- */
  .ub .wm {
    display: inline-block;
    font-family: var(--ud-display);
    font-weight: 400;
    line-height: var(--wm-lh);
    letter-spacing: var(--wm-track);
    text-align: right;
    white-space: nowrap;
    font-kerning: normal;
    font-synthesis: none;
  }
  .ub .wm-a {
    display: block;
    padding-right: 1.2em;
  }
  .ub .wm-b {
    display: block;
  }
  .ub .wm--line .wm-a,
  .ub .wm--line .wm-b {
    display: inline;
    padding: 0;
  }
  .ub .wm--line .wm-a::after {
    content: " ";
  }
  /* The i keeps its own glyph. Above the gap between dot and stem it is
     painted in --i-top, which is the primary in "i" mode. */
  .ub .wm-i {
    /* An inline-block at the lockup's own line-height, so the split is
       measured from a box that doesn't depend on the font's ascent. */
    display: inline-block;
    background: linear-gradient(to bottom, var(--i-top) 0 var(--isplit), currentColor var(--isplit));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  /* The period hangs: it gives back its own width, so the words align. */
  .ub .wm-pd {
    display: var(--pd-display);
    position: relative;
    -webkit-text-fill-color: transparent;
    margin-right: calc((var(--dd) + 2 * var(--dl)) * -1);
  }
  .ub .wm-pd::after {
    content: "";
    position: absolute;
    left: var(--dl);
    bottom: var(--db);
    width: var(--dd);
    height: var(--dd);
    border-radius: 50%;
    background: var(--ud-primary);
  }
  .ub .wm--line .wm-pd {
    margin-right: 0;
  }

  /* ---------- the falling line ---------- */
  .ub .ud-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .ub .ud-fall {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: rotate(var(--fall));
  }
  .ub .is-animated .ud-fall {
    animation: ud-fall 1.5s 0.5s both;
  }
  @keyframes ud-fall {
    0% {
      transform: rotate(0deg);
      animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.4);
    }
    62% {
      transform: rotate(var(--fall));
      animation-timing-function: ease-out;
    }
    78% {
      transform: rotate(calc(var(--fall) - 2.2deg));
      animation-timing-function: ease-in;
    }
    100% {
      transform: rotate(var(--fall));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ub .is-animated .ud-fall {
      animation: none;
    }
  }

  /* ---------- cover ---------- */
