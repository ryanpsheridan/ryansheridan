---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import MazeField from "../components/MazeField.astro";
---

<Layout
  title="Not found — Ryan Sheridan"
  description="That page doesn't exist."
>
  <Nav />
  <MazeField
    cell={34}
    color="#ebebeb"
    activeColor="#d8d8d8"
    ballRadius={5}
    speed={7}
    glow={170}
    trail={48}
    fade={0.8}
    exit
    exitX={0.78}
    exitY={0.56}
    exitLabel="EXIT"
    fixed
  />
  <main class="not-found">
    <div class="nf-inner">
      <p class="nf-code">404 / dead end</p>
      <h1>You've taken a wrong turn.</h1>
      <p class="nf-body">
        This page doesn't exist. The link may be out of date, or the page may
        have moved. The work is all still here, two doors down.
      </p>

      <div class="nf-links">
        <a href="/work" class="nf-button">View all work</a>
        <a href="/" class="nf-plain">Back home <span class="arrow">&nearr;</span></a>
      </div>
    </div>
  </main>

  <!--
    What the exit turns into. Hidden until the maze is solved, so it is out of
    the tab order for everyone who never plays, and the page works exactly the
    same without it: it is a second way to a link that is already on the page.
  -->
  <a class="nf-door" data-door href="/" hidden>
    <span class="nf-door-label">Home</span>
    <span class="nf-door-arrow" aria-hidden="true">&nearr;</span>
  </a>

  <Footer />
</Layout>

<script>
  /**
   * The maze dissolves itself when the ball reaches the exit and tells us
   * where the exit was. Put the door there, and let the walls finish clearing
   * before it arrives, so the two read as one movement rather than a swap.
   */
  function armDoor() {
    const door = document.querySelector<HTMLAnchorElement>("[data-door]");
    if (!door || door.dataset.armed === "true") return;
    door.dataset.armed = "true";

    document.addEventListener(
      "mazefield:solved",
      (event) => {
        const detail = (event as CustomEvent).detail || {};
        if (typeof detail.x !== "number" || typeof detail.y !== "number") return;

        door.style.left = `${detail.x}px`;
        door.style.top = `${detail.y}px`;
        door.hidden = false;

        window.setTimeout(
          // Two frames: one for the browser to lay the door out, one for the
          // transition to have a state to run from.
          () => requestAnimationFrame(() => door.classList.add("is-shown")),
          Math.max(Number(detail.settleIn) || 0, 0) * 0.62,
        );
      },
      { once: true },
    );
  }

  armDoor();
  document.addEventListener("astro:page-load", armDoor);
</script>

<style>
  .not-found {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 120px var(--page-padding) 160px;
    min-height: calc(100vh - var(--nav-height) - 200px);
    display: flex;
    align-items: center;
  }

  .nf-inner {
    max-width: 520px;
  }

  .nf-code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: clamp(32px, 1.7rem + 1.2vw, 52px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .nf-body {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .nf-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .nf-button {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-bg);
    background: var(--color-text);
    border: 1px solid var(--color-text);
    border-radius: 999px;
    padding: 12px 22px;
    transition: background 0.2s, border-color 0.2s;
  }

  .nf-button:hover {
    background: #333333;
    border-color: #333333;
  }

  .nf-plain {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .nf-plain:hover {
    color: var(--color-text);
  }

  .arrow {
    font-size: var(--text-xs);
  }

  /* Fixed, because the field it replaces was fixed: the door stands where the
     ring stood. Centered on that point rather than hung off it. */
  .nf-door {
    position: fixed;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 104px;
    height: 104px;
    margin: -52px 0 0 -52px;
    border: 1px solid var(--color-text);
    border-radius: 50%;
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    opacity: 0;
    transform: scale(0.82);
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.2s ease,
      color 0.2s ease;
  }

  .nf-door.is-shown {
    opacity: 1;
    transform: none;
  }

  .nf-door:hover,
  .nf-door:focus-visible {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .nf-door-arrow {
    font-size: 11px;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-door {
      transition: opacity 0.2s ease;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .not-found {
      padding: 72px var(--page-padding) 96px;
      min-height: 0;
    }
  }
</style>
