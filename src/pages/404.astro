---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CursorField from "../components/CursorField.astro";
---

<Layout
  title="Not found — Ryan Sheridan"
  description="That page doesn't exist."
  noindex
>
  <Nav />
  <CursorField variant="compass" region="vignette" fixed />
  <main id="main" class="not-found">
    <div class="nf-inner">
      <p class="nf-code">404 / dead end</p>
      <h1>You've taken a wrong turn.</h1>
      <p class="nf-body">
        This page doesn't exist. The link may be out of date, or the page may
        have moved. The work is all still here, two doors down.
      </p>

      <div class="nf-links">
        <a href="/work" class="nf-button btn btn-primary">View all work</a>
        <a href="/" class="nf-plain link-quiet">Back home <span class="arrow" aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .not-found {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 120px var(--page-padding) 160px;
    min-height: calc(100vh - var(--nav-height) - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nf-inner {
    max-width: 560px;
    text-align: center;
  }

  .nf-code {
    font-family: var(--font-mono);
    font-size: var(--text-s);
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--text-h1);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .nf-body {
    font-size: var(--text-m);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .nf-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .nf-plain {
    font-family: var(--font-mono);
    font-size: var(--text-s);
  }

  .arrow {
    font-size: var(--text-xs);
  }

  @media (max-width: 640px) {
    .not-found {
      padding: 72px var(--page-padding) 96px;
      min-height: 0;
    }
  }
</style>
