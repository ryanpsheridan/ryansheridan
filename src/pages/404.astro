---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import MazeField from "../components/MazeField.astro";
---

<Layout
  title="Not found — Ryan Sheridan"
  description="That page doesn't exist."
>
  <Nav />
  <MazeField
    cell={34}
    color="#ebebeb"
    activeColor="#d8d8d8"
    ballRadius={5}
    speed={7}
    glow={170}
    trail={48}
    exit
    exitX={0.78}
    exitY={0.56}
    exitLabel="EXIT"
    fixed
  />
  <main class="not-found">
    <div class="nf-inner">
      <p class="nf-code">404 / dead end</p>
      <h1>You've taken a wrong turn.</h1>
      <p class="nf-body">
        This page doesn't exist. The link may be out of date, or the page may
        have moved. The work is all still here, two doors down.
      </p>

      <div class="nf-links">
        <a href="/work" class="nf-button">View all work</a>
        <a href="/" class="nf-plain">Back home <span class="arrow">&nearr;</span></a>
      </div>

      <!-- The dot and the marked exit explain themselves; this is the only
           acknowledgement that anyone worked it out. -->
      <p class="nf-solved" data-solved role="status">Out. Nicely done.</p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // The maze fires this once, when the ball reaches the exit. Everything on
  // the page works without it; this is the reward for playing along.
  function armMaze() {
    const solved = document.querySelector<HTMLElement>("[data-solved]");
    if (!solved || solved.dataset.armed === "true") return;
    solved.dataset.armed = "true";

    document.addEventListener(
      "mazefield:solved",
      () => solved.classList.add("is-shown"),
      { once: true },
    );
  }

  armMaze();
  document.addEventListener("astro:page-load", armMaze);
</script>

<style>
  .not-found {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 120px var(--page-padding) 160px;
    min-height: calc(100vh - var(--nav-height) - 200px);
    display: flex;
    align-items: center;
  }

  .nf-inner {
    position: relative;
    max-width: 520px;
  }

  .nf-code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: clamp(32px, 1.7rem + 1.2vw, 52px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .nf-body {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  /* Out of flow, under the links: appearing must not shove anything while
     someone is steering the dot toward it. */
  .nf-solved {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .nf-solved.is-shown {
    opacity: 1;
    transform: none;
  }

  .nf-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .nf-button {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-bg);
    background: var(--color-text);
    border: 1px solid var(--color-text);
    border-radius: 999px;
    padding: 12px 22px;
    transition: background 0.2s, border-color 0.2s;
  }

  .nf-button:hover {
    background: #333333;
    border-color: #333333;
  }

  .nf-plain {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .nf-plain:hover {
    color: var(--color-text);
  }

  .arrow {
    font-size: var(--text-xs);
  }

  /* Matches the cutoffs MazeField hides itself at: no maze, nothing that
     could ever be solved. */
  @media (max-width: 640px), (hover: none), (pointer: coarse) {
    .nf-solved {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-solved {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .not-found {
      padding: 72px var(--page-padding) 96px;
      min-height: 0;
    }
  }
</style>
