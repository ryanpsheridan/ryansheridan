---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Contact — Ryan Sheridan">
  <Nav />
  <main class="contact-page">
    <div class="contact-inner">
      <div class="contact-content">
        <h1>Let's work together</h1>
        <p class="contact-text">
          Have a project in mind or just want to say hello? I'd love to hear
          from you.
        </p>
        <a href="mailto:ryansheridandesign@gmail.com" class="contact-email">
          ryansheridandesign@gmail.com
        </a>
        <div class="contact-links">
          <a
            href="https://www.linkedin.com/in/ryansheridandesign/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn <span class="arrow">&nearr;</span>
          </a>
        </div>
      </div>
      <div class="contact-photo">
        <img src="/images/profile-photo.png" alt="Ryan Sheridan" />
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .contact-page {
    padding: 80px var(--page-padding) 0;
  }

  .contact-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    min-height: 60vh;
  }

  h1 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .contact-text {
    font-size: 16px;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 420px;
  }

  .contact-email {
    display: inline-block;
    font-size: 18px;
    font-weight: 500;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2px;
    margin-bottom: 24px;
    transition: border-color 0.2s;
  }

  .contact-email:hover {
    border-color: var(--color-text);
  }

  .contact-links {
    margin-top: 8px;
  }

  .contact-links a {
    font-size: 15px;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .contact-links a:hover {
    color: var(--color-text);
  }

  .arrow {
    font-size: 13px;
  }

  .contact-photo {
    border-radius: 12px;
    overflow: hidden;
  }

  .contact-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 768px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .contact-photo {
      max-width: 400px;
    }
  }
</style>
