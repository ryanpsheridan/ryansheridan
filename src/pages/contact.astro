---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CursorField from "../components/CursorField.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import Button from "../components/ui/Button.astro";
import { PERSON_ID, breadcrumbSchema } from "../data/schema";

const email = "ryansheridandesign@gmail.com";

const schema = [
  { "@type": "ContactPage", about: { "@id": PERSON_ID } },
  breadcrumbSchema([{ name: "Contact", path: "/contact" }]),
];
---

<Layout
  title="Contact — Ryan Sheridan"
  description="Contact Ryan Sheridan about design systems, brand identity, or a new website. Email directly, or start a website project and share what you need."
  schema={schema}
>
  <Nav />
  <CursorField variant="compass" region="vignette" fixed />
  <main id="main" class="contact-page">
    <Breadcrumbs class="page-crumbs" items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />

    <div class="contact-hero">
      <h1>Let's work together.</h1>
      <p class="intro">
        Have a project in mind? The fastest way to reach me is email. Send
        over a few details and I'll get back to you. Planning a new website?
        Start a website project and tell me what you need.
      </p>
      <div class="cta-group">
        <Button href={`mailto:${email}`} size="lg">
          Email me <span class="arrow" aria-hidden="true">&nearr;</span>
        </Button>
        <a href="/start-a-project" class="questionnaire-link link-quiet">
          Start a website project <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <p class="email-plain">{email}</p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .contact-page {
    padding: var(--page-top) var(--page-padding) var(--page-bottom);
    /* Sit above the fixed CursorField. It has no background of its own, so
       the page still reads as plain white. */
    position: relative;
    z-index: 1;
  }

  .page-crumbs,
  .contact-hero {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  h1 {
    font-size: var(--text-h1);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .intro {
    font-size: var(--text-m);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 480px;
    margin-bottom: var(--space-5);
  }

  .cta-group {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .questionnaire-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-s);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
  }

  .questionnaire-link .arrow {
    font-size: var(--text-xs);
  }

  .email-plain {
    font-size: var(--text-s);
    color: var(--color-text-muted);
    margin-top: var(--space-4);
  }
</style>
