---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import LabSwitcher from "../../components/LabSwitcher.astro";
import { getHomepageProjects } from "../../data/projects";

/**
 * Direction 3: Words.
 *
 * The live homepage ties each word of the headline to the project that earns
 * it. This takes that idea and makes it work in both directions. The three
 * words are real toggle buttons that filter the work below, and pointing at
 * a project lights up the words it belongs to. The chosen word is kept in the
 * URL (?focus=systems), so a link can open straight onto one side of the work.
 */
const projects = getHomepageProjects();

const WORDS = ["systems", "sites", "brands"] as const;
type Word = (typeof WORDS)[number];

// Which part of the headline each project answers to. Kept here rather than
// derived from tags, since tags describe the deliverable and these describe
// the kind of thinking behind it.
const wordsFor: Record<string, Word[]> = {
  "commerce-multi-brand-system": ["systems", "brands"],
  "feedonomics-rebrand-design-system": ["systems", "sites", "brands"],
  "rhow-coffee": ["brands"],
  "figma-project-starter": ["systems"],
  "claude-design-consistency-first-design-second": ["systems", "sites"],
  "new-office-blank-canvas": ["brands"],
};
---

<Layout
  title="Words · Homepage directions"
  description="Homepage direction where the headline's words filter the work."
  noindex
>
  <Nav />
  <main class="words">
    <header class="hero">
      <h1 class="headline">
        Designing{" "}<button type="button" class="word" data-word="systems" aria-pressed="false" aria-controls="work-list" aria-describedby="filter-hint">systems</button>,<br />
        <button type="button" class="word" data-word="sites" aria-pressed="false" aria-controls="work-list" aria-describedby="filter-hint">sites</button>{" "}and{" "}<button type="button" class="word" data-word="brands" aria-pressed="false" aria-controls="work-list" aria-describedby="filter-hint">brands</button>.
      </h1>
      <div class="helper">
        <p id="filter-hint" class="hint">Choose a word to filter the work.</p>
        <p class="status" role="status" data-status>Showing all {projects.length} projects.</p>
        <button type="button" class="clear" data-clear hidden>Show all</button>
      </div>
      <p class="tagline">Based out of Austin, Texas</p>
    </header>

    <section class="work" aria-labelledby="work-heading">
      <h2 id="work-heading" class="visually-hidden">Selected work</h2>
      <ul class="grid" id="work-list">
        {
          projects.map((project) => {
            const words = wordsFor[project.slug] ?? [];
            return (
              <li class="card" data-words={words.join(" ")} style={`view-transition-name: card-${project.slug}`}>
                <a href={`/work/${project.slug}`} class="card-link">
                  <span class="card-image">
                    <Media src={project.thumbnail} alt="" />
                  </span>
                  <span class="card-words">
                    {words.map((word) => (
                      <span class="card-word" data-word={word}>{word}</span>
                    ))}
                  </span>
                  <span class="card-title">{project.title}</span>
                  <span class="badge-list">
                    {project.tags.map((tag) => <span class="badge">{tag}</span>)}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
      <a href="/work" class="view-all-link">View all work</a>
    </section>
  </main>
  <Footer />
  <LabSwitcher current="/homepage-variations/words" />
</Layout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("button.word"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".card"));
  const status = document.querySelector<HTMLElement>("[data-status]")!;
  const clear = document.querySelector<HTMLButtonElement>("[data-clear]")!;
  const headline = document.querySelector<HTMLElement>(".headline")!;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  let focus: string | null = null;

  function apply(word: string | null) {
    focus = word;
    let shown = 0;

    buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.word === word)));
    cards.forEach((card) => {
      const match = !word || card.dataset.words!.split(" ").includes(word);
      card.hidden = !match;
      if (match) shown++;
    });
    document.querySelectorAll<HTMLElement>(".card-word").forEach((el) => {
      el.classList.toggle("is-focus", el.dataset.word === word);
    });

    status.textContent = word
      ? `Showing ${shown} of ${cards.length} projects about ${word}.`
      : `Showing all ${cards.length} projects.`;
    clear.hidden = !word;

    // Keep the choice in the address bar so it survives a refresh and can be
    // shared, without adding a history entry for every tap.
    const url = new URL(window.location.href);
    if (word) url.searchParams.set("focus", word);
    else url.searchParams.delete("focus");
    history.replaceState(null, "", url);
  }

  /** Cards glide to their new places where the browser can, and cut where it cannot or should not. */
  function change(word: string | null) {
    if (word === focus) return;
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !reduceMotion.matches) doc.startViewTransition(() => apply(word));
    else apply(word);
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const word = button.dataset.word!;
      change(focus === word ? null : word);
    });
  });

  clear.addEventListener("click", () => {
    change(null);
    // The button hides itself, so focus goes back to the words rather than
    // falling to the top of the page.
    buttons[0]?.focus();
  });

  // The other direction: a project lights up the words it belongs to.
  function echo(words: string[]) {
    buttons.forEach((button) => button.classList.toggle("is-echo", words.includes(button.dataset.word!)));
    headline.classList.toggle("has-echo", words.length > 0);
  }

  cards.forEach((card) => {
    const words = card.dataset.words!.split(" ");
    card.addEventListener("pointerenter", () => echo(words));
    card.addEventListener("pointerleave", () => echo([]));
    card.addEventListener("focusin", () => echo(words));
    card.addEventListener("focusout", () => echo([]));
  });

  // Arriving on ?focus=systems opens onto that side of the work.
  const initial = new URL(window.location.href).searchParams.get("focus");
  if (initial && buttons.some((button) => button.dataset.word === initial)) apply(initial);

  // A one-time sweep across the three words after load says "these do
  // something" without a tooltip. Skipped under reduced motion.
  if (!reduceMotion.matches && !initial) {
    buttons.forEach((button, i) => {
      window.setTimeout(() => button.classList.add("is-hint"), 700 + i * 260);
      window.setTimeout(() => button.classList.remove("is-hint"), 1300 + i * 260);
    });
  }
</script>

<style>
  .words {
    padding: 0 var(--page-padding);
    --accent: #1c4ed8;
  }

  .hero,
  .work {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero {
    padding: 120px 0 var(--space-7);
  }

  .headline {
    font-size: clamp(2.5rem, 1rem + 5vw, 84px);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  /*
    The words. A button in every way that matters, but set in the headline's
    own type. The dotted underline is the at-rest signal that they can be
    pressed; it goes solid on hover, and pressed fills the word with the accent.
  */
  .word {
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0 0.06em;
    margin: 0 -0.06em;
    border-radius: 0.1em;
    cursor: pointer;
    text-decoration: underline dotted;
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.14em;
    text-decoration-color: color-mix(in srgb, var(--color-text) 45%, transparent);
    transition: color 0.25s ease, background-color 0.25s ease, text-decoration-color 0.25s ease;
  }

  .word:hover {
    text-decoration-style: solid;
    text-decoration-color: var(--color-text);
  }

  .word:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 0.06em;
  }

  .word.is-hint,
  .word.is-echo {
    color: var(--accent);
    text-decoration-style: solid;
    text-decoration-color: var(--accent);
  }

  .word[aria-pressed="true"] {
    color: #ffffff;
    background: var(--accent);
    text-decoration-color: transparent;
  }

  .helper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .status {
    color: var(--color-text);
  }

  .clear {
    font: inherit;
    color: var(--color-text);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 6px 12px;
    cursor: pointer;
  }

  .clear:hover {
    border-color: var(--color-text);
  }

  .clear:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .tagline {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
  }

  .card[hidden] {
    display: none;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--color-text);
  }

  .card-link:hover {
    color: var(--color-text);
  }

  .card-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 6px;
  }

  .card-image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-tag-bg);
    margin-bottom: 4px;
  }

  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  @media (hover: hover) {
    .card-link:hover .card-image :global(img) {
      transform: scale(1.03);
    }
  }

  .card-words {
    display: flex;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .card-word.is-focus {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card-title {
    font-size: 20px;
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .view-all-link {
    display: inline-flex;
    margin-top: var(--space-7);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-bg);
    background: var(--color-text);
    border-radius: 999px;
    padding: 12px 22px;
  }

  .view-all-link:hover {
    color: var(--color-bg);
    background: #333333;
  }

  .view-all-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 96px 0 var(--space-6);
    }

    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word,
    .card-image :global(img) {
      transition: none;
    }
  }
</style>
