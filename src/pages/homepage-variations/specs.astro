---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import LabSwitcher from "../../components/LabSwitcher.astro";
import { getHomepageProjects } from "../../data/projects";

/**
 * Direction 2: Specs.
 *
 * A calm editorial grid that works on its own, with one switch that turns on
 * the layer a design system is actually made of: the layout grid, spacing
 * redlines, and type specs, the same annotations that go into a component
 * handoff. None of it is drawn by hand. Every number is measured off the page
 * as rendered, so resizing the window changes the specs, and the spacing
 * values are named after the site's own --space tokens when they match one.
 */
const projects = getHomepageProjects();

// Feature, pair, pair, feature: a rhythm that gives the newest system work
// and the mural the wide frames, and the rest a clean two-up.
const layout = ["feature", "half", "half", "half", "half", "feature-flip"];
---

<Layout
  title="Specs · Homepage directions"
  description="Homepage direction with an Inspect switch that reveals the layout grid, spacing, and type specs."
  noindex
>
  <Nav />
  <main class="specs" data-specs-root>
    <header class="hero">
      <h1 data-spec="type" data-spec-name="Display">Designing systems,<br />sites and brands.</h1>
      <div class="hero-row">
        <p class="tagline" data-spec="type" data-spec-name="Meta">Based out of Austin, Texas</p>
        <button type="button" class="inspect-toggle" aria-pressed="false" data-inspect>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25">
            <rect x="1.5" y="4.5" width="13" height="7" rx="1" />
            <path d="M4.5 4.5v2.5M7 4.5v1.5M9.5 4.5v2.5M12 4.5v1.5" />
          </svg>
          <span>Inspect this page</span>
        </button>
      </div>
    </header>

    <section class="grid" aria-labelledby="work-heading" data-grid>
      <h2 id="work-heading" class="visually-hidden">Selected work</h2>
      {
        projects.map((project, i) => (
          <a href={`/work/${project.slug}`} class={`card card-${layout[i] ?? "half"}`} data-card>
            <span class="card-image" data-spec="box">
              <Media src={project.thumbnail} alt="" />
            </span>
            <span class="card-meta">
              <span class="card-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="card-title" data-spec={i === 0 ? "type" : undefined} data-spec-name="Title" data-spec-align="end">
                {project.title}
              </span>
              <span class="card-detail">
                {project.client} · {project.tools.join(", ")}
              </span>
              <span class="badge-list">
                {project.tags.map((tag) => <span class="badge">{tag}</span>)}
              </span>
            </span>
          </a>
        ))
      }
    </section>

    <div class="grid-footer">
      <a href="/work" class="view-all-link">View all work</a>
    </div>

    {/* The annotation layer. Decorative by definition: it describes the page
        rather than adding to it, so assistive tech skips it entirely. */}
    <div class="spec-layer" aria-hidden="true" data-spec-layer>
      <div class="spec-columns" data-spec-columns></div>
    </div>
  </main>
  <Footer />
  <LabSwitcher current="/homepage-variations/specs" />
</Layout>

<script>
  const root = document.querySelector<HTMLElement>("[data-specs-root]")!;
  const layer = document.querySelector<HTMLElement>("[data-spec-layer]")!;
  const columns = document.querySelector<HTMLElement>("[data-spec-columns]")!;
  const grid = document.querySelector<HTMLElement>("[data-grid]")!;
  const toggle = document.querySelector<HTMLButtonElement>("[data-inspect]")!;

  const STORAGE_KEY = "homepage-specs-inspect";

  // The site's spacing scale, read from the live tokens so a change to the
  // scale shows up here without touching this file.
  const tokenStyles = getComputedStyle(document.documentElement);
  const spaceTokens = new Map<number, string>();
  for (let n = 1; n <= 8; n++) {
    const value = parseFloat(tokenStyles.getPropertyValue(`--space-${n}`));
    if (!Number.isNaN(value)) spaceTokens.set(value, `space-${n}`);
  }

  const px = (value: number) => Math.round(value);

  function spacingLabel(distance: number) {
    const rounded = px(distance);
    const token = spaceTokens.get(rounded);
    return token ? `${token} · ${rounded}` : `${rounded}`;
  }

  function typeLabel(el: HTMLElement) {
    const s = getComputedStyle(el);
    const size = px(parseFloat(s.fontSize));
    const lineHeight = s.lineHeight === "normal" ? "auto" : px(parseFloat(s.lineHeight));
    const tracking = parseFloat(s.letterSpacing);
    const em = Number.isNaN(tracking) ? "0" : (tracking / parseFloat(s.fontSize)).toFixed(2);
    const family = s.fontFamily.split(",")[0].replace(/["']/g, "");
    return `${el.dataset.specName ?? "Text"} · ${family} ${s.fontWeight} · ${size}/${lineHeight} · ${em}em`;
  }

  function tag(text: string, x: number, y: number, className = "") {
    const el = document.createElement("span");
    el.className = `spec-tag ${className}`.trim();
    el.textContent = text;
    el.style.left = `${x}px`;
    el.style.top = `${y}px`;
    layer.appendChild(el);
    return el;
  }

  function line(x: number, y: number, length: number, axis: "x" | "y", label: string) {
    const el = document.createElement("span");
    el.className = `spec-line spec-line-${axis}`;
    el.style.left = `${x}px`;
    el.style.top = `${y}px`;
    el.style[axis === "x" ? "width" : "height"] = `${length}px`;
    layer.appendChild(el);

    const labelEl = tag(label, 0, 0, "spec-tag-gap");
    if (axis === "x") {
      labelEl.style.left = `${x + length / 2}px`;
      labelEl.style.top = `${y + 8}px`;
      labelEl.style.transform = "translateX(-50%)";
    } else {
      labelEl.style.left = `${x + 8}px`;
      labelEl.style.top = `${y + length / 2}px`;
      labelEl.style.transform = "translateY(-50%)";
    }
  }

  function build() {
    layer.querySelectorAll(".spec-tag, .spec-line").forEach((el) => el.remove());
    if (!root.classList.contains("is-inspecting")) return;

    const origin = root.getBoundingClientRect();
    const rel = (r: DOMRect) => ({
      left: r.left - origin.left,
      top: r.top - origin.top,
      right: r.right - origin.left,
      bottom: r.bottom - origin.top,
      width: r.width,
      height: r.height,
    });

    // Layout grid: laid over the real grid's box with the real column count
    // and gutter, so the columns land exactly where the cards do.
    const gridBox = rel(grid.getBoundingClientRect());
    const gridStyles = getComputedStyle(grid);
    const count = gridStyles.gridTemplateColumns.split(" ").length;
    columns.style.left = `${gridBox.left}px`;
    columns.style.width = `${gridBox.width}px`;
    columns.style.gridTemplateColumns = `repeat(${count}, minmax(0, 1fr))`;
    columns.style.columnGap = gridStyles.columnGap;
    if (columns.childElementCount !== count) {
      columns.replaceChildren(...Array.from({ length: count }, () => document.createElement("span")));
    }
    const gutter = parseFloat(gridStyles.columnGap) || 0;
    const columnWidth = (gridBox.width - gutter * (count - 1)) / count;
    const gridTag = tag(`${count} col · ${px(columnWidth)} wide · ${px(gutter)} gutter`, gridBox.right, gridBox.top - 26, "spec-tag-grid");
    gridTag.style.transform = "translateX(-100%)";

    // Type specs, read from the computed style of each tagged element.
    root.querySelectorAll<HTMLElement>('[data-spec="type"]').forEach((el) => {
      const box = rel(el.getBoundingClientRect());
      // End-aligned tags sit off the right edge, clear of whatever leads the line above.
      const typeTag = tag(typeLabel(el), el.dataset.specAlign === "end" ? box.right : box.left, box.top - 24);
      if (el.dataset.specAlign === "end") typeTag.style.transform = "translateX(-100%)";
    });

    // Every frame gets its rendered size.
    root.querySelectorAll<HTMLElement>('[data-spec="box"]').forEach((el) => {
      const box = rel(el.getBoundingClientRect());
      const sizeTag = tag(`${px(box.width)} × ${px(box.height)}`, box.right - 8, box.bottom - 8, "spec-tag-size");
      sizeTag.style.transform = "translate(-100%, -100%)";
    });

    // Spacing: gutters between neighbours on a row, and the gap down to the
    // next row, measured between the image frames.
    const frames = Array.from(root.querySelectorAll<HTMLElement>("[data-card]")).map((card) =>
      rel(card.getBoundingClientRect())
    );

    for (let i = 0; i < frames.length - 1; i++) {
      const a = frames[i];
      const b = frames[i + 1];
      if (Math.abs(a.top - b.top) < 2 && b.left > a.right) {
        line(a.right, a.top + 40, b.left - a.right, "x", spacingLabel(b.left - a.right));
      } else if (b.top > a.bottom) {
        const rowBottom = Math.max(...frames.filter((f) => Math.abs(f.top - a.top) < 2).map((f) => f.bottom));
        line(b.left + 32, rowBottom, b.top - rowBottom, "y", spacingLabel(b.top - rowBottom));
      }
    }

    // The breath between the hero's last line and the work.
    const hero = rel(root.querySelector<HTMLElement>(".hero-row")!.getBoundingClientRect());
    if (frames[0] && frames[0].top > hero.bottom) {
      line(frames[0].left + 32, hero.bottom, frames[0].top - hero.bottom, "y", spacingLabel(frames[0].top - hero.bottom));
    }
  }

  function setInspecting(on: boolean, remember = true) {
    root.classList.toggle("is-inspecting", on);
    toggle.setAttribute("aria-pressed", String(on));
    toggle.querySelector("span")!.textContent = on ? "Hide specs" : "Inspect this page";
    if (remember) {
      try {
        localStorage.setItem(STORAGE_KEY, on ? "1" : "0");
      } catch {}
    }
    build();
  }

  toggle.addEventListener("click", () => setInspecting(!root.classList.contains("is-inspecting")));

  // Escape closes the specs from anywhere, the same way it would close any
  // overlay, without taking focus away from where someone is.
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && root.classList.contains("is-inspecting")) setInspecting(false);
  });

  let queued = false;
  function rebuild() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      build();
    });
  }

  new ResizeObserver(rebuild).observe(root);
  document.fonts?.ready.then(rebuild);

  let remembered = false;
  try {
    remembered = localStorage.getItem(STORAGE_KEY) === "1";
  } catch {}
  if (remembered) setInspecting(true, false);
</script>

<style>
  .specs {
    position: relative;
    padding: 0 var(--page-padding);
    --redline: #d0164f;
  }

  .hero,
  .grid,
  .grid-footer {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero {
    padding: 120px 0 var(--space-7);
  }

  h1 {
    display: inline-block;
    font-size: clamp(2.25rem, 1.4rem + 3vw, 64px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .hero-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .inspect-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }

  .inspect-toggle:hover {
    border-color: var(--color-text);
  }

  .inspect-toggle:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  .inspect-toggle[aria-pressed="true"] {
    background: var(--redline);
    border-color: var(--redline);
    color: #ffffff;
  }

  /* The grid. Twelve columns on desktop, which is what the overlay reads. */
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-7) var(--space-5);
  }

  .card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    color: var(--color-text);
  }

  .card:hover {
    color: var(--color-text);
  }

  .card:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 6px;
  }

  .card-half {
    grid-column: span 6;
  }

  /* Features span the full row but keep to the same columns inside: image on
     eight, words on four, so the overlay still lines up through them. */
  .card-feature,
  .card-feature-flip {
    grid-column: 1 / -1;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-5);
    align-items: end;
  }

  .card-feature .card-image {
    grid-column: 1 / span 8;
  }

  .card-feature .card-meta {
    grid-column: 9 / -1;
  }

  .card-feature-flip .card-image {
    grid-column: 5 / -1;
    grid-row: 1;
  }

  .card-feature-flip .card-meta {
    grid-column: 1 / span 4;
    grid-row: 1;
  }

  .card-image {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-tag-bg);
  }

  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  @media (hover: hover) {
    .card:hover .card-image :global(img) {
      transform: scale(1.03);
    }
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card-num,
  .card-detail {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .card-title {
    font-size: 22px;
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .card-feature .card-title,
  .card-feature-flip .card-title {
    font-size: clamp(22px, 1rem + 1vw, 30px);
  }

  .grid-footer {
    margin-top: var(--space-7);
  }

  .view-all-link {
    display: inline-flex;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-bg);
    background: var(--color-text);
    border-radius: 999px;
    padding: 12px 22px;
  }

  .view-all-link:hover {
    color: var(--color-bg);
    background: #333333;
  }

  .view-all-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  /* The annotation layer. */
  .spec-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 2;
  }

  .specs.is-inspecting .spec-layer {
    opacity: 1;
  }

  .spec-columns {
    position: absolute;
    top: 0;
    bottom: 0;
    display: grid;
  }

  .spec-columns :global(span) {
    background: color-mix(in srgb, var(--redline) 7%, transparent);
    border-inline: 1px solid color-mix(in srgb, var(--redline) 18%, transparent);
  }

  .specs.is-inspecting [data-spec="box"] {
    outline: 1px dashed var(--redline);
    outline-offset: -1px;
  }

  .specs.is-inspecting [data-spec="type"] {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--redline) 55%, transparent);
  }

  .spec-layer :global(.spec-tag) {
    position: absolute;
    white-space: nowrap;
    padding: 3px 6px;
    border-radius: 3px;
    background: var(--redline);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .spec-layer :global(.spec-tag-grid) {
    background: #ffffff;
    color: var(--redline);
    box-shadow: inset 0 0 0 1px var(--redline);
  }

  .spec-layer :global(.spec-line) {
    position: absolute;
    background: var(--redline);
  }

  .spec-layer :global(.spec-line-x) {
    height: 1px;
  }

  .spec-layer :global(.spec-line-y) {
    width: 1px;
  }

  /* End caps, so a redline reads as a measurement rather than a rule. */
  .spec-layer :global(.spec-line::before),
  .spec-layer :global(.spec-line::after) {
    content: "";
    position: absolute;
    background: var(--redline);
  }

  .spec-layer :global(.spec-line-x::before),
  .spec-layer :global(.spec-line-x::after) {
    top: -4px;
    width: 1px;
    height: 9px;
  }

  .spec-layer :global(.spec-line-x::before) {
    left: 0;
  }

  .spec-layer :global(.spec-line-x::after) {
    right: 0;
  }

  .spec-layer :global(.spec-line-y::before),
  .spec-layer :global(.spec-line-y::after) {
    left: -4px;
    width: 9px;
    height: 1px;
  }

  .spec-layer :global(.spec-line-y::before) {
    top: 0;
  }

  .spec-layer :global(.spec-line-y::after) {
    bottom: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Four columns on a phone: every card spans them all, and the overlay
     reads four, which is the honest answer. */
  @media (max-width: 768px) {
    .hero {
      padding: 96px 0 var(--space-6);
    }

    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6) var(--space-3);
    }

    .card-half,
    .card-feature,
    .card-feature-flip {
      grid-column: 1 / -1;
      grid-template-columns: 1fr;
    }

    .card-feature .card-image,
    .card-feature .card-meta,
    .card-feature-flip .card-image,
    .card-feature-flip .card-meta {
      grid-column: 1;
      grid-row: auto;
    }

    .spec-layer :global(.spec-tag) {
      font-size: 9.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spec-layer,
    .card-image :global(img) {
      transition: none;
    }
  }
</style>
