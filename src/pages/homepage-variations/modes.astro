---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import LabSwitcher from "../../components/LabSwitcher.astro";
import { getHomepageProjects } from "../../data/projects";

/**
 * Direction 1: Modes.
 *
 * The page is built on the same tokens as the rest of the site, and every
 * project carries a brand mode of its own. Pointing at a project, tabbing to
 * it, or (on a phone) scrolling it to the middle of the screen sets that mode
 * on the root, and the whole page, nav and footer included, re-themes the way
 * a Figma frame does when you switch its variable mode. The readout under the
 * preview reads the live values back off the root, so what it shows is what
 * the page is actually using.
 *
 * Every mode is checked for contrast: text sits at 12:1 or better and muted
 * text at 6.2:1 or better against its surface.
 */
const projects = getHomepageProjects();

const modeLabels: Record<string, string> = {
  "commerce-multi-brand-system": "Commerce",
  "feedonomics-rebrand-design-system": "Feedonomics",
  "rhow-coffee": "RHOW Coffee",
  "figma-project-starter": "Claude Skill",
  "claude-design-consistency-first-design-second": "Claude Design",
  "new-office-blank-canvas": "BigCommerce Office",
};
---

<Layout
  title="Modes · Homepage directions"
  description="Homepage direction exploring brand modes that re-theme the page per project."
  noindex
>
  <Nav />
  <main class="modes">
    <header class="hero">
      <h1>Designing systems,<br />sites and brands.</h1>
      <p class="tagline">Based out of Austin, Texas</p>
    </header>

    <section class="index" aria-labelledby="work-heading">
      <h2 id="work-heading" class="visually-hidden">Selected work</h2>

      {/* Decorative: every project in it is also a link in the list, which is
          where keyboard and screen reader users meet the work. */}
      <div class="preview" aria-hidden="true">
        <div class="stage" data-stage>
          {
            projects.map((project, i) => (
              <div class="layer" data-layer={project.slug} style={`--col: ${i % 3}; --row: ${Math.floor(i / 3)}`}>
                <Media src={project.thumbnail} alt="" />
              </div>
            ))
          }
        </div>

        <div class="readout">
          <div class="readout-mode">
            <span class="readout-key">mode</span>
            <span class="mode-chip">
              <span class="mode-dot"></span>
              <span data-readout="label">Default</span>
            </span>
          </div>
          <div class="readout-tokens">
            <span class="token"><span class="swatch" style="background: var(--color-bg)"></span>surface <code data-readout="--color-bg"></code></span>
            <span class="token"><span class="swatch" style="background: var(--color-text)"></span>text <code data-readout="--color-text"></code></span>
            <span class="token"><span class="swatch" style="background: var(--color-text-muted)"></span>muted <code data-readout="--color-text-muted"></code></span>
            <span class="token"><span class="swatch" style="background: var(--mode-accent)"></span>accent <code data-readout="--mode-accent"></code></span>
          </div>
          <p class="readout-hint">Point at or tab through the work to switch the page's brand mode.</p>
        </div>
      </div>

      <ol class="project-list" data-list>
        {
          projects.map((project, i) => (
            <li>
              <a
                href={`/work/${project.slug}`}
                class="project-link"
                data-mode={project.slug}
                data-label={modeLabels[project.slug] ?? project.client}
              >
                <span class="inline-thumb">
                  <Media src={project.thumbnail} alt="" />
                </span>
                <span class="project-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="project-body">
                  <span class="project-title">{project.title}</span>
                  <span class="badge-list">
                    {project.tags.map((tag) => <span class="badge">{tag}</span>)}
                  </span>
                </span>
                <span class="project-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))
        }
      </ol>

      <a href="/work" class="view-all-link">View all work</a>
    </section>
  </main>
  <Footer />
  <LabSwitcher current="/homepage-variations/modes" />
</Layout>

<script>
  const root = document.documentElement;
  const list = document.querySelector<HTMLElement>("[data-list]");
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".project-link"));
  const readouts = Array.from(document.querySelectorAll<HTMLElement>("[data-readout]"));

  let active: string | null = null;

  /** Reads the live tokens back off the root, after the mode has applied. */
  function updateReadout(label: string) {
    const styles = getComputedStyle(root);
    readouts.forEach((el) => {
      const key = el.dataset.readout!;
      el.textContent = key === "label" ? label : styles.getPropertyValue(key).trim().toUpperCase();
    });
  }

  function setMode(slug: string | null) {
    if (slug === active) return;
    active = slug;

    if (slug) root.dataset.mode = slug;
    else delete root.dataset.mode;

    list?.classList.toggle("has-active", Boolean(slug));
    stage?.classList.toggle("has-active", Boolean(slug));
    links.forEach((link) => link.classList.toggle("is-active", link.dataset.mode === slug));
    stage
      ?.querySelectorAll<HTMLElement>("[data-layer]")
      .forEach((layer) => layer.classList.toggle("is-active", layer.dataset.layer === slug));

    const label = links.find((link) => link.dataset.mode === slug)?.dataset.label ?? "Default";
    updateReadout(label);
  }

  updateReadout("Default");

  // Pointer and keyboard drive it wherever there is a pointer that can hover.
  // Leaving the list hands the page back to its own mode, so the default is
  // always one move away.
  const canHover = window.matchMedia("(hover: hover) and (min-width: 769px)");

  links.forEach((link) => {
    link.addEventListener("pointerenter", () => canHover.matches && setMode(link.dataset.mode!));
    link.addEventListener("focus", () => setMode(link.dataset.mode!));
  });

  list?.addEventListener("pointerleave", () => {
    if (!canHover.matches) return;
    if (list.contains(document.activeElement)) {
      setMode((document.activeElement as HTMLElement).dataset.mode ?? null);
    } else {
      setMode(null);
    }
  });

  list?.addEventListener("focusout", (event) => {
    const next = event.relatedTarget as Node | null;
    if (!next || !list.contains(next)) setMode(null);
  });

  // On touch screens there is no hover, so the project crossing the middle of
  // the screen sets the mode instead, the same line the live homepage uses to
  // reveal its headline.
  const middle = new IntersectionObserver(
    (entries) => {
      if (canHover.matches) return;
      entries.forEach((entry) => {
        if (entry.isIntersecting) setMode((entry.target as HTMLElement).dataset.mode!);
      });
    },
    { rootMargin: "-45% 0px -45% 0px" }
  );
  links.forEach((link) => middle.observe(link));

  // Scrolling back above the list, or on past it, returns to the default.
  const edges = new IntersectionObserver(
    (entries) => {
      if (canHover.matches) return;
      entries.forEach((entry) => {
        if (!entry.isIntersecting) setMode(null);
      });
    },
    { rootMargin: "-45% 0px -45% 0px" }
  );
  if (list) edges.observe(list);
</script>

<style is:global>
  /*
    The modes. Each one overrides the same handful of site tokens, so nothing
    on the page needs to know which project it is looking at. That is the whole
    argument of the direction: set the mode on the outer frame and let the
    tokens do the rest.
  */
  :root {
    --mode-accent: #1c4ed8;
  }

  :root[data-mode="commerce-multi-brand-system"] {
    --color-bg: #e6eaf0;
    --color-text: #0f141c;
    --color-text-muted: #465062;
    --color-border: #c9d0dc;
    --mode-accent: #2446c8;
  }

  :root[data-mode="feedonomics-rebrand-design-system"] {
    --color-bg: #0a1a3c;
    --color-text: #f3f6fb;
    --color-text-muted: #aebbd6;
    --color-border: #26396a;
    --mode-accent: #74e2c2;
  }

  :root[data-mode="rhow-coffee"] {
    --color-bg: #eee6d8;
    --color-text: #262422;
    --color-text-muted: #5b5147;
    --color-border: #d4c8b4;
    --mode-accent: #6a4a32;
  }

  :root[data-mode="figma-project-starter"] {
    --color-bg: #111216;
    --color-text: #ececf1;
    --color-text-muted: #a2a4ae;
    --color-border: #2c2d36;
    --mode-accent: #8e91fa;
  }

  :root[data-mode="claude-design-consistency-first-design-second"] {
    --color-bg: #ece9f7;
    --color-text: #17132b;
    --color-text-muted: #4f4a68;
    --color-border: #d3cdea;
    --mode-accent: #4f3fcb;
  }

  :root[data-mode="new-office-blank-canvas"] {
    --color-bg: #d9eeec;
    --color-text: #0b2b3a;
    --color-text-muted: #3a5864;
    --color-border: #b5d6d2;
    --mode-accent: #a34c12;
  }

  body,
  nav,
  footer,
  .menu-overlay {
    transition: background-color 0.6s ease, color 0.6s ease, border-color 0.6s ease;
  }

  .logo,
  .view-all-work,
  .footer-logo,
  .footer-nav a,
  .footer-copyright,
  .badge {
    transition: color 0.6s ease, border-color 0.6s ease;
  }

  .hamburger span {
    transition: transform 0.3s, opacity 0.3s, background-color 0.6s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    body,
    nav,
    footer,
    .menu-overlay,
    .logo,
    .view-all-work,
    .footer-logo,
    .footer-nav a,
    .footer-copyright,
    .badge {
      transition: none;
    }
  }
</style>

<style>
  .modes {
    padding: 0 var(--page-padding);
  }

  .hero,
  .index {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero {
    padding: 120px 0 var(--space-7);
  }

  h1 {
    font-size: clamp(2.25rem, 1.4rem + 3vw, 64px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .tagline {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color 0.6s ease;
  }

  .index {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 0 var(--space-6);
    align-items: start;
  }

  /* Preview: a mosaic of all six at rest, one project filling the frame once
     it is chosen. The layers move rather than swap, so the mosaic visibly
     opens onto the project instead of cutting to it. */
  .preview {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-4));
  }

  .stage {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg));
    transition: background-color 0.6s ease;
  }

  .layer {
    position: absolute;
    top: calc(var(--row) * 50% + 3px);
    left: calc(var(--col) * 33.333% + 3px);
    width: calc(33.333% - 6px);
    height: calc(50% - 6px);
    overflow: hidden;
    transition:
      top 0.7s cubic-bezier(0.7, 0, 0.2, 1),
      left 0.7s cubic-bezier(0.7, 0, 0.2, 1),
      width 0.7s cubic-bezier(0.7, 0, 0.2, 1),
      height 0.7s cubic-bezier(0.7, 0, 0.2, 1),
      opacity 0.5s ease;
  }

  .layer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage.has-active .layer {
    opacity: 0;
  }

  .stage.has-active .layer.is-active {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
    z-index: 1;
  }

  .readout {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    transition: color 0.6s ease;
  }

  .readout-mode {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    transition: border-color 0.6s ease;
  }

  .readout-key {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 10px;
  }

  .mode-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text);
    transition: color 0.6s ease, border-color 0.6s ease;
  }

  .mode-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mode-accent);
    transition: background-color 0.6s ease;
  }

  .readout-tokens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px var(--space-4);
    padding: var(--space-3) 0;
  }

  .token {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .token code {
    margin-left: auto;
    font-family: inherit;
    color: var(--color-text);
    transition: color 0.6s ease;
  }

  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-text) 25%, transparent);
    transition: background-color 0.6s ease;
  }

  .readout-hint {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    transition: border-color 0.6s ease;
  }

  /* The list is the real navigation: plain links in an ordered list. */
  .project-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
    transition: border-color 0.6s ease;
  }

  .project-list li {
    border-bottom: 1px solid var(--color-border);
    transition: border-color 0.6s ease;
  }

  .project-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-4) 0;
    color: var(--color-text);
    transition: color 0.4s ease;
  }

  .project-link:hover {
    color: var(--color-text);
  }

  .project-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .inline-thumb {
    display: none;
  }

  .project-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    transition: color 0.4s ease;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .project-title {
    font-size: clamp(20px, 1rem + 0.7vw, 26px);
    font-weight: 300;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .project-arrow {
    color: var(--mode-accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s ease, transform 0.3s ease, color 0.6s ease;
  }

  /* With one project chosen the others step back to muted, which is still
     past AA in every mode, so they stay readable rather than disabled. */
  .project-list.has-active .project-link {
    color: var(--color-text-muted);
  }

  .project-list.has-active .project-link.is-active {
    color: var(--color-text);
  }

  .project-link.is-active .project-num {
    color: var(--mode-accent);
  }

  .project-link.is-active .project-arrow {
    opacity: 1;
    transform: none;
  }

  .view-all-link {
    grid-column: 2;
    justify-self: start;
    display: inline-flex;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-bg);
    background: var(--color-text);
    border-radius: 999px;
    padding: 12px 22px;
    transition: color 0.6s ease, background-color 0.6s ease;
  }

  .view-all-link:hover {
    color: var(--color-bg);
    opacity: 0.85;
  }

  .view-all-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 96px 0 var(--space-6);
    }

    .index {
      grid-template-columns: 1fr;
    }

    .preview {
      display: none;
    }

    .project-list {
      border-top: 0;
    }

    .project-list li {
      border-bottom: 0;
    }

    .project-link {
      grid-template-columns: auto 1fr;
      padding: var(--space-4) 0 var(--space-5);
    }

    .inline-thumb {
      display: block;
      grid-column: 1 / -1;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg));
    }

    .inline-thumb :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .project-arrow {
      display: none;
    }

    /* Scrolling sets the mode here, so dimming the rest would mute whatever
       is half on screen. Every title stays at full strength. */
    .project-list.has-active .project-link {
      color: var(--color-text);
    }

    .view-all-link {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer,
    .stage,
    .project-link,
    .project-num,
    .project-arrow,
    .tagline,
    .readout,
    .readout *,
    .project-list,
    .project-list li,
    .view-all-link {
      transition: none;
    }
  }
</style>
