---
import Layout from "../layouts/Layout.astro";

const maxCost = 1355;

const drive = {
  low: 850,
  high: 1050,
  items: [
    { label: "Gas", detail: "34 mpg · 2,722 mi round trip · ~$3.60–3.70/gal", low: 290, high: 300 },
    { label: "Hotels", detail: "4 nights · 2 each way · pet-friendly + pet fees", low: 550, high: 750 },
  ],
};

const fly = {
  low: 1105,
  high: 1355,
  items: [
    { label: "Flights", detail: "2 people RT · AUS–CLE · United/Delta/Southwest/American only", low: 650, high: 900 },
    { label: "Dog boarding", detail: "7 nights · $65/night", low: 455, high: 455 },
  ],
};

const itineraryA = [
  { day: "Fri", route: "Austin → Dallas → Texarkana → Little Rock, AR", miles: "~490 mi", time: "~7.5 hrs", note: "Overnight Little Rock" },
  { day: "Sat", route: "Little Rock → Memphis → Nashville", miles: "~360 mi", time: "~5.5 hrs", note: "Overnight Nashville, evening free" },
  { day: "Sun", route: "Nashville → Lexington → Cincinnati → Akron", miles: "~510 mi", time: "~8 hrs", note: "Arrive Akron evening" },
];

const itineraryB = [
  { day: "Fri", route: "Austin → Dallas → Little Rock, AR", miles: "~490 mi", time: "~7.5 hrs", note: "Same first stop as Option A" },
  { day: "Sat", route: "Little Rock → Nashville (bypass Memphis)", miles: "~350 mi", time: "~5.5 hrs", note: "More downtime in Nashville" },
  { day: "Sun", route: "Nashville → Louisville (stop) → Cincinnati → Akron", miles: "~530 mi", time: "~8.5 hrs", note: "Louisville Slugger Museum or bourbon tasting" },
];
---

<Layout title="Ohio or Bust — Trip Planner" description="Private trip planning page.">
  <main class="page">
    <section class="hero">
      <p class="eyebrow">Private trip planner · not for public eyes</p>
      <h1>Ohio or Bust</h1>
      <p class="subhead">Driving vs. flying to Akron, comparing cost, time, and the dog situation.</p>
      <div class="date-pill">Departing Fri, Aug 14</div>
    </section>

    <section class="scenarios">
      <div class="scenario-card drive-card">
        <div class="scenario-head">
          <span class="scenario-icon">🚗</span>
          <div>
            <h2>Road Trip</h2>
            <p class="scenario-meta">21 days · 2,722 mi round trip · dog rides along</p>
          </div>
        </div>

        <div class="cost-range">
          <span class="cost-figure">${drive.low.toLocaleString()}–${drive.high.toLocaleString()}</span>
          <div class="range-bar">
            <div
              class="range-fill drive-fill"
              style={`left:${(drive.low / maxCost) * 100}%; width:${((drive.high - drive.low) / maxCost) * 100}%;`}
            ></div>
          </div>
        </div>

        <ul class="cost-items">
          {drive.items.map((item) => (
            <li>
              <div class="cost-item-row">
                <span class="cost-item-label">{item.label}</span>
                <span class="cost-item-value">
                  {item.low === item.high ? `$${item.low}` : `$${item.low}–${item.high}`}
                </span>
              </div>
              <p class="cost-item-detail">{item.detail}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="vs-divider">
        <span>vs</span>
      </div>

      <div class="scenario-card fly-card">
        <div class="scenario-head">
          <span class="scenario-icon">✈️</span>
          <div>
            <h2>Fly + Board</h2>
            <p class="scenario-meta">8 days · AUS ↔ CLE · dog stays home</p>
          </div>
        </div>

        <div class="cost-range">
          <span class="cost-figure">${fly.low.toLocaleString()}–${fly.high.toLocaleString()}</span>
          <div class="range-bar">
            <div
              class="range-fill fly-fill"
              style={`left:${(fly.low / maxCost) * 100}%; width:${((fly.high - fly.low) / maxCost) * 100}%;`}
            ></div>
          </div>
        </div>

        <ul class="cost-items">
          {fly.items.map((item) => (
            <li>
              <div class="cost-item-row">
                <span class="cost-item-label">{item.label}</span>
                <span class="cost-item-value">
                  {item.low === item.high ? `$${item.low}` : `$${item.low}–${item.high}`}
                </span>
              </div>
              <p class="cost-item-detail">{item.detail}</p>
            </li>
          ))}
        </ul>

        <p class="flight-note">
          Preferred carriers were showing $280–380/person round trip for nearby dates when
          checked, padded up for mid-August peak pricing. Worth pulling actual AUS–CLE fares
          for the exact dates.
        </p>
      </div>
    </section>

    <section class="bottom-line">
      <h3>Bottom line</h3>
      <p>
        Driving comes out roughly <strong>$250–400 cheaper</strong> — but it's not apples to
        apples. The road trip is a <strong>21-day</strong> trip; flying is <strong>8 days</strong>.
        Shorten the road trip to match and driving looks even better on cost, but a bigger share
        of a short trip goes to the car.
      </p>
    </section>

    <section class="itinerary">
      <h3>Driving itinerary options</h3>
      <p class="itinerary-sub">Both ~1,360 mi and 3 days. Leave Austin Friday morning, arrive Akron Sunday.</p>

      <div class="itinerary-options">
        <div class="itinerary-option">
          <h4>Option A — Memphis route</h4>
          <p class="option-note">Closer to what you've done before.</p>
          <ol class="timeline">
            {itineraryA.map((stop) => (
              <li class="timeline-stop">
                <span class="timeline-day">{stop.day}</span>
                <div class="timeline-content">
                  <p class="timeline-route">{stop.route}</p>
                  <p class="timeline-stats">{stop.miles} · {stop.time}</p>
                  <p class="timeline-note">{stop.note}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="itinerary-option">
          <h4>Option B — Louisville swap</h4>
          <p class="option-note">Skips Memphis, breaks up the last day with a stop.</p>
          <ol class="timeline">
            {itineraryB.map((stop) => (
              <li class="timeline-stop">
                <span class="timeline-day">{stop.day}</span>
                <div class="timeline-content">
                  <p class="timeline-route">{stop.route}</p>
                  <p class="timeline-stats">{stop.miles} · {stop.time}</p>
                  <p class="timeline-note">{stop.note}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <p class="itinerary-summary">
        Option A is the familiar route and slightly shorter on the last day. Option B trades
        Memphis for a Louisville stop — Louisville Slugger Museum or a bourbon tasting — to
        break up the final driving day.
      </p>
    </section>
  </main>
</Layout>

<style>
  .page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 80px var(--page-padding) 160px;
  }

  .hero {
    text-align: center;
    margin-bottom: 64px;
  }

  .eyebrow {
    font-size: 13px;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(40px, 2rem + 3vw, 72px);
    font-weight: 400;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .subhead {
    font-size: 17px;
    color: var(--color-text-muted);
    max-width: 480px;
    margin: 0 auto 24px;
  }

  .date-pill {
    display: inline-flex;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 18px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
  }

  .scenarios {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 32px;
    align-items: start;
    margin-bottom: 56px;
  }

  .scenario-card {
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .drive-card {
    background: #f6f9f7;
  }

  .fly-card {
    background: #f6f7fb;
  }

  .scenario-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .scenario-icon {
    font-size: 32px;
    line-height: 1;
  }

  .scenario-head h2 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .scenario-meta {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .cost-range {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cost-figure {
    font-size: clamp(28px, 1.4rem + 1.6vw, 40px);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .range-bar {
    position: relative;
    height: 8px;
    background: var(--color-border);
    border-radius: 999px;
    overflow: hidden;
  }

  .range-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 999px;
  }

  .drive-fill {
    background: #2f6b4f;
  }

  .fly-fill {
    background: #3f4d8c;
  }

  .cost-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cost-item-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 15px;
    font-weight: 500;
  }

  .cost-item-value {
    font-variant-numeric: tabular-nums;
  }

  .cost-item-detail {
    font-size: 12.5px;
    color: var(--color-text-muted);
    margin-top: 3px;
  }

  .flight-note {
    font-size: 12.5px;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-top: 16px;
  }

  .vs-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 100px;
  }

  .vs-divider span {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bottom-line {
    max-width: var(--content-width);
    margin: 0 auto 80px;
    text-align: center;
  }

  .bottom-line h3 {
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }

  .bottom-line p {
    font-size: 18px;
    line-height: 1.7;
  }

  .itinerary h3 {
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-align: center;
    margin-bottom: 8px;
  }

  .itinerary-sub {
    text-align: center;
    font-size: 14px;
    color: var(--color-text-muted);
    margin-bottom: 40px;
  }

  .itinerary-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-bottom: 32px;
  }

  .itinerary-option {
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 28px;
  }

  .itinerary-option h4 {
    font-size: 17px;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .option-note {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 24px;
  }

  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .timeline-stop {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    position: relative;
    padding-bottom: 24px;
  }

  .timeline-stop:last-child {
    padding-bottom: 0;
  }

  .timeline-stop::before {
    content: "";
    position: absolute;
    left: 15px;
    top: 24px;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }

  .timeline-stop:last-child::before {
    display: none;
  }

  .timeline-day {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .timeline-route {
    font-size: 14.5px;
    font-weight: 500;
    margin-bottom: 3px;
  }

  .timeline-stats {
    font-size: 12.5px;
    color: var(--color-text-muted);
    margin-bottom: 3px;
  }

  .timeline-note {
    font-size: 12.5px;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .itinerary-summary {
    max-width: var(--content-width);
    margin: 0 auto;
    text-align: center;
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .scenarios {
      grid-template-columns: 1fr;
    }

    .vs-divider {
      padding-top: 0;
    }

    .itinerary-options {
      grid-template-columns: 1fr;
    }
  }
</style>
