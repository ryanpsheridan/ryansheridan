---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { PERSON_ID, breadcrumbSchema } from "../data/schema";

const schema = [
  { "@type": "ProfilePage", mainEntity: { "@id": PERSON_ID }, about: { "@id": PERSON_ID } },
  breadcrumbSchema([{ name: "About", path: "/about" }]),
];
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
---

<Layout
  title="About — Ryan Sheridan"
  description="About Ryan Sheridan, a Principal Designer at Commerce in Austin, Texas, leading multi-brand design systems, marketing sites, and brand infrastructure."
  ogType="profile"
  schema={schema}
  noindex
>
  <Nav />
  <main id="main" class="about-page">
    <Breadcrumbs class="page-crumbs" items={[{ label: "Home", href: "/" }, { label: "About" }]} />

    <div class="about-hero">
      <div class="about-intro">
        <h1>Ryan Sheridan</h1>
        <p class="role">Principal Designer, Design Systems</p>
        <p class="bio">
          I lead design systems and web experience at Commerce, the parent
          company of BigCommerce. Over the past eight years, I've built and
          scaled brand systems, marketing sites, and design infrastructure
          across multiple brands. I like working in the space between design
          and engineering, turning ideas into systems that are clear,
          flexible, and built to last.
        </p>
        <p class="bio">
          <strong>I like to build fast.</strong> I'm diving headfirst into AI
          tools and increasingly use them throughout my process, from research
          and exploration to design, prototyping, and code. It lets me stay
          hands-on with the work while spending more time on the details that
          matter.
        </p>
        <p class="bio">
          I studied at Fort Lewis College in Durango, Colorado, and I'm based
          in Austin, Texas.
        </p>
      </div>
      <div class="about-photo">
        <img src="/profile-photo.webp" alt="Ryan Sheridan" />
      </div>
    </div>

    <hr class="divider" />

    <section class="experience">
      <h2>Experience</h2>
      <div class="timeline">
        <div class="timeline-item">
          <span class="timeline-period">2025 – Present</span>
          <div class="timeline-detail">
            <span class="timeline-company">Commerce</span>
            <span class="timeline-roles">Principal Designer, Design Systems · Lead Web Designer</span>
          </div>
        </div>
        <div class="timeline-item">
          <span class="timeline-period">2018 – 2025</span>
          <div class="timeline-detail">
            <span class="timeline-company">BigCommerce</span>
            <span class="timeline-roles">Lead Web Designer · Senior Visual Designer · Visual Designer</span>
          </div>
        </div>
        <div class="timeline-item">
          <span class="timeline-period">2016 – 2018</span>
          <div class="timeline-detail">
            <span class="timeline-company">TicketCity</span>
            <span class="timeline-roles">UI Designer · Graphic Designer</span>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="tools-section">
      <h2>Tools</h2>
      <div class="tools-grid">
        <div class="tool-group">
          <h3>Design</h3>
          <ul>
            <li><a href="https://www.figma.com" target="_blank" rel="noopener noreferrer">Figma</a></li>
            <li><a href="https://www.adobe.com/products/photoshop.html" target="_blank" rel="noopener noreferrer">Photoshop</a></li>
            <li><a href="https://www.adobe.com/products/illustrator.html" target="_blank" rel="noopener noreferrer">Illustrator</a></li>
            <li><a href="https://www.adobe.com/products/indesign.html" target="_blank" rel="noopener noreferrer">InDesign</a></li>
          </ul>
        </div>
        <div class="tool-group">
          <h3>Web Platforms</h3>
          <ul>
            <li><a href="https://webflow.com" target="_blank" rel="noopener noreferrer">Webflow</a></li>
            <li><a href="https://www.framer.com" target="_blank" rel="noopener noreferrer">Framer</a></li>
            <li><a href="https://www.makeswift.com" target="_blank" rel="noopener noreferrer">Makeswift</a></li>
            <li><a href="https://www.squarespace.com" target="_blank" rel="noopener noreferrer">Squarespace</a></li>
            <li><a href="https://www.wix.com" target="_blank" rel="noopener noreferrer">Wix</a></li>
            <li><a href="https://www.gohighlevel.com" target="_blank" rel="noopener noreferrer">GoHighLevel</a></li>
          </ul>
        </div>
        <div class="tool-group">
          <h3>AI Workflows</h3>
          <ul>
            <li><a href="https://claude.ai" target="_blank" rel="noopener noreferrer">Claude</a></li>
            <li><a href="https://claude.ai/code" target="_blank" rel="noopener noreferrer">Claude Code</a></li>
            <li><a href="https://claude.ai/design" target="_blank" rel="noopener noreferrer">Claude Design</a></li>
            <li><a href="https://chatgpt.com" target="_blank" rel="noopener noreferrer">ChatGPT</a></li>
            <li><a href="https://gemini.google.com" target="_blank" rel="noopener noreferrer">Gemini</a></li>
            <li><a href="https://www.perplexity.ai" target="_blank" rel="noopener noreferrer">Perplexity</a></li>
          </ul>
        </div>
        <div class="tool-group">
          <h3>DesignOps & Dev</h3>
          <ul>
            <li><a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href="https://vercel.com" target="_blank" rel="noopener noreferrer">Vercel</a></li>
            <li><a href="https://claude.ai/code" target="_blank" rel="noopener noreferrer">Claude Code</a></li>
          </ul>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="certification-section">
      <h2>Certification</h2>
      <div class="certification-item">
        <a href="https://www.udemy.com/certificate/UC-18d85801-2609-449f-b7ed-fefe40a5db46/" target="_blank" rel="noopener noreferrer" class="certification-name link-underline">User Experience (UX): The Ultimate Guide to Usability and UX</a>
        <span class="certification-meta">Udemy · David Travis · 2024</span>
        <p class="certification-desc">A 12-hour course covering usability testing, user research, information architecture, and interaction design principles.</p>
      </div>
    </section>

    <hr class="divider" />

    <section class="contact-section">
      <h2>Get in touch</h2>
      <div class="contact-links">
        <a href="mailto:ryansheridandesign@gmail.com" class="contact-link link-underline">
          ryansheridandesign@gmail.com
        </a>
        <a
          href="https://www.linkedin.com/in/ryansheridandesign/"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-link link-underline"
        >
          LinkedIn <span class="arrow" aria-hidden="true">&nearr;</span><span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .about-page {
    padding: var(--page-top) var(--page-padding) 0;
  }

  .page-crumbs,
  .about-hero,
  .divider,
  .experience,
  .tools-section,
  .certification-section,
  .contact-section {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .about-hero {
    display: grid;
    grid-template-columns: 1fr 384px;
    gap: 80px;
    align-items: start;
  }

  h1 {
    font-size: var(--text-h1);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-2);
  }

  .role {
    font-size: var(--text-s);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .bio {
    font-size: var(--text-m);
    line-height: var(--leading-relaxed);
    max-width: 544px;
    margin-bottom: var(--space-3);
  }

  .bio:last-of-type {
    margin-bottom: 0;
  }

  .bio strong {
    font-weight: var(--weight-medium);
  }

  .about-photo {
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
  }

  .about-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .divider {
    margin-block: 80px;
  }

  h2 {
    font-size: var(--text-s);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-5);
  }

  .timeline-period {
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  .timeline-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .timeline-company {
    font-size: var(--text-l);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }

  .timeline-roles {
    font-size: var(--text-s);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .tool-group h3 {
    font-size: var(--text-s);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    margin-bottom: var(--space-3);
  }

  .tool-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tool-group li {
    font-size: var(--text-s);
  }

  .tool-group a {
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .tool-group a:hover {
    color: var(--color-text);
  }

  .certification-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .certification-name {
    font-size: var(--text-l);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }

  .certification-desc {
    font-size: var(--text-s);
    color: var(--color-text-muted);
    max-width: 544px;
    margin-top: var(--space-2);
  }

  .certification-meta {
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  .contact-links {
    display: flex;
    gap: var(--space-5);
  }

  .contact-link {
    font-size: var(--text-m);
  }

  .arrow {
    font-size: var(--text-s);
  }

  @media (max-width: 768px) {
    .about-hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .timeline-item {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }

    .contact-links {
      flex-direction: column;
      gap: var(--space-3);
    }

    .divider {
      margin-block: 56px;
    }
  }
</style>
