---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { PERSON_ID, breadcrumbSchema } from "../data/schema";

const schema = [
  { "@type": "ProfilePage", mainEntity: { "@id": PERSON_ID }, about: { "@id": PERSON_ID } },
  breadcrumbSchema([{ name: "About", path: "/about" }]),
];
import Blueprint from "../components/Blueprint.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import ToolLink from "../components/ui/ToolLink.astro";
---

<Layout
  title="About — Ryan Sheridan"
  description="About Ryan Sheridan, a Principal Designer at Commerce in Austin, Texas, leading multi-brand design systems, marketing sites, and brand infrastructure."
  ogType="profile"
  schema={schema}
  noindex
>
  <Nav />
  <main id="main" class="about-page">
    <Breadcrumbs class="page-crumbs" items={[{ label: "Home", href: "/" }, { label: "About" }]} />

    <div class="about-hero" data-spec-columns data-spec-flow>
      <div class="about-intro">
        <h1 data-spec="type" data-spec-name="Display">Ryan Sheridan</h1>
        <p class="role">Principal Designer, Design Systems</p>
        <p class="bio" data-spec="type" data-spec-name="Body">
          I lead design systems and web experience at Commerce, the parent
          company of BigCommerce. Over the past eight years, I’ve built and
          scaled brand systems, marketing sites, and design infrastructure
          across multiple brands. I like working in the space between design
          and engineering, turning ideas into systems that are clear,
          flexible, and built to last.
        </p>
        <p class="bio">
          I’m using AI more and more in my workflow, and it’s become part of
          nearly every step, from research and exploration to design,
          prototyping, and code. I’ve started building small tools and
          automations so my team can use it too. It keeps me hands-on with
          the work and leaves more room for the details that matter.
        </p>
        <p class="bio">
          I studied at Fort Lewis College in Durango, Colorado, and I’m based
          in Austin, Texas. Outside of work, I enjoy golf, though I’m not
          always sure golf enjoys me back.{" "}
          {/* Hover (or tap, or focus) "My dog" and a snapshot pops up
              above the words like a print pulled from a pocket, trailing the
              pointer as it moves across them. */}
          <span class="dog" data-dog>
            <button type="button" class="dog-trigger" aria-expanded="false" aria-controls="dog-card">My dog</button>
            <span class="dog-card" id="dog-card">
              <img src="/about-dog.webp" alt="My dog, Peyton Matcha, a white Labradoodle, sitting on the stairs, tongue out" width="480" height="640" loading="lazy" decoding="async" />
              <span class="dog-caption" aria-hidden="true">Peyton Matcha</span>
            </span>
          </span>{" "}
          is my whole world, and I’m always working on a side project that
          pushes my limits.
        </p>
        {/* The way into the blueprint: the page drawing its own specs over
            itself. The shortcut in the sentence is a real toggle for anyone
            with a mouse or a finger; the drawing it adds is hidden from
            assistive tech, since it describes the page rather than adding
            to it. */}
        <p class="peek">
          <button type="button" class="kbd-toggle" aria-pressed="false" aria-label="Show the specs (shortcut Cmd + I)" aria-keyshortcuts="Meta+I Control+I" data-blueprint-toggle><span data-shortcut-mod>Cmd</span> + I</button> to peek under the&nbsp;hood.
        </p>
      </div>
      <div class="about-photo" data-spec="box">
        <img src="/profile-photo.webp" alt="Ryan Sheridan" />
      </div>
    </div>

    <hr class="divider" />

    <section class="experience" data-spec-flow>
      <h2 data-spec="type" data-spec-name="Heading">Experience</h2>
      <div class="timeline">
        <div class="timeline-item">
          <span class="timeline-period">2025 – Present</span>
          <div class="timeline-detail">
            <span class="timeline-company">Commerce</span>
            <span class="timeline-roles">Principal Designer, Design Systems · Lead Web Designer</span>
          </div>
        </div>
        <div class="timeline-item">
          <span class="timeline-period">2018 – 2025</span>
          <div class="timeline-detail">
            <span class="timeline-company">BigCommerce</span>
            <span class="timeline-roles">Lead Web Designer · Senior Visual Designer · Visual Designer</span>
          </div>
        </div>
        <div class="timeline-item">
          <span class="timeline-period">2016 – 2018</span>
          <div class="timeline-detail">
            <span class="timeline-company">TicketCity</span>
            <span class="timeline-roles">UI Designer · Graphic Designer</span>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="tools-section" data-spec-flow>
      <h2>Tools</h2>
      <div class="tools-grid">
        <div class="tool-group">
          <h3>Design</h3>
          <ul>
            <li><ToolLink name="Figma" /></li>
            <li><ToolLink name="Photoshop" /></li>
            <li><ToolLink name="Illustrator" /></li>
            <li><ToolLink name="InDesign" /></li>
          </ul>
        </div>
        <div class="tool-group">
          <h3>Web Platforms</h3>
          <ul>
            <li><ToolLink name="Webflow" /></li>
            <li><ToolLink name="Framer" /></li>
            <li><ToolLink name="Makeswift" /></li>
            <li><ToolLink name="Squarespace" /></li>
            <li><ToolLink name="Wix" /></li>
            <li><ToolLink name="GoHighLevel" /></li>
          </ul>
        </div>
        <div class="tool-group">
          <h3>AI Workflows</h3>
          <ul>
            <li><ToolLink name="Claude" /></li>
            <li><ToolLink name="Claude Code" /></li>
            <li><ToolLink name="Claude Design" /></li>
            <li><ToolLink name="ChatGPT" /></li>
            <li><ToolLink name="Gemini" /></li>
            <li><ToolLink name="Perplexity" /></li>
          </ul>
        </div>
        <div class="tool-group">
          <h3>DesignOps & Dev</h3>
          <ul>
            <li><ToolLink name="GitHub" /></li>
            <li><ToolLink name="Vercel" /></li>
            <li><ToolLink name="Claude Code" /></li>
          </ul>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="certification-section" data-spec-flow>
      <h2>Certification</h2>
      <div class="certification-item">
        <a href="https://www.udemy.com/certificate/UC-18d85801-2609-449f-b7ed-fefe40a5db46/" target="_blank" rel="noopener noreferrer" class="certification-name link-underline">User Experience (UX): The Ultimate Guide to Usability and UX</a>
        <span class="certification-meta">Udemy · David Travis · 2024</span>
        <p class="certification-desc">A 12-hour course covering usability testing, user research, information architecture, and interaction design principles.</p>
      </div>
    </section>

    <hr class="divider" />

    <section class="contact-section" data-spec-flow>
      <h2>Get in touch</h2>
      <div class="contact-links">
        <a href="mailto:ryansheridandesign@gmail.com" class="contact-link link-underline">
          ryansheridandesign@gmail.com
        </a>
        <a
          href="https://www.linkedin.com/in/ryansheridandesign/"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-link link-underline"
        >
          LinkedIn <span class="arrow" aria-hidden="true">&nearr;</span><span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </div>
    </section>
  <Blueprint />
  </main>
  <Footer />
</Layout>

<style>
  .about-page {
    padding: var(--page-top) var(--page-padding) 0;
  }

  .page-crumbs,
  .about-hero,
  .divider,
  .experience,
  .tools-section,
  .certification-section,
  .contact-section {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .about-hero {
    display: grid;
    grid-template-columns: 1fr 384px;
    gap: 80px;
    align-items: start;
  }

  h1 {
    font-size: var(--text-h1);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-2);
  }

  .role {
    font-size: var(--text-s);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .bio {
    font-size: var(--text-m);
    line-height: var(--leading-relaxed);
    max-width: 544px;
    margin-bottom: var(--space-3);
  }

  .bio:last-of-type {
    margin-bottom: 0;
  }

  .peek {
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  /* "My dog": underlined in ink, not link blue, since it opens a picture
     rather than going anywhere. */
  .dog {
    position: relative;
    display: inline-block;
  }

  .dog-trigger {
    padding: 0;
    font: inherit;
    color: var(--color-text);
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .dog.is-open .dog-trigger {
    text-decoration-color: var(--color-text);
  }

  /* The snapshot: a white-bordered print that springs up out of the words,
     tilted, and leans after the pointer. --x and --lean come from the
     script; --nudge keeps it on screen near an edge. */
  .dog-card {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 14px);
    z-index: 20;
    width: 184px;
    padding: 8px 8px 0;
    background: #ffffff;
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.08),
      0 18px 40px -12px rgba(0, 0, 0, 0.32);
    pointer-events: none;
    opacity: 0;
    transform-origin: 50% 100%;
    transform:
      translateX(calc(-50% + var(--x, 0px) + var(--nudge, 0px)))
      translateY(12px)
      rotate(calc(-4deg + var(--lean, 0deg)))
      scale(0.6);
    transition:
      opacity 0.2s ease,
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .dog.is-open .dog-card,
  .dog:has(.dog-trigger:focus-visible) .dog-card {
    opacity: 1;
    transform:
      translateX(calc(-50% + var(--x, 0px) + var(--nudge, 0px)))
      translateY(0)
      rotate(calc(-4deg + var(--lean, 0deg)))
      scale(1);
  }

  /* Hover opens it only where hover is real; on a touch screen a tap would
     leave it stuck open. */
  @media (hover: hover) {
    .dog:hover .dog-trigger {
      text-decoration-color: var(--color-text);
    }

    .dog:hover .dog-card {
      opacity: 1;
      transform:
        translateX(calc(-50% + var(--x, 0px) + var(--nudge, 0px)))
        translateY(0)
        rotate(calc(-4deg + var(--lean, 0deg)))
        scale(1);
    }
  }

  .dog-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 1px;
    background: var(--color-surface);
  }

  .dog-caption {
    display: block;
    padding: 8px 2px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .dog-card,
    .dog:hover .dog-card,
    .dog.is-open .dog-card,
    .dog:has(.dog-trigger:focus-visible) .dog-card {
      transform: translateX(calc(-50% + var(--nudge, 0px))) rotate(-4deg);
      transition: opacity 0.2s ease;
    }
  }

  .about-photo {
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
  }

  .about-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .divider {
    margin-block: 80px;
  }

  h2 {
    font-size: var(--text-s);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-5);
  }

  .timeline-period {
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  .timeline-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .timeline-company {
    font-size: var(--text-l);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }

  .timeline-roles {
    font-size: var(--text-s);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .tool-group h3 {
    font-size: var(--text-s);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    margin-bottom: var(--space-3);
  }

  .tool-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tool-group li {
    font-size: var(--text-s);
  }

  .certification-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .certification-name {
    font-size: var(--text-l);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }

  .certification-desc {
    font-size: var(--text-s);
    color: var(--color-text-muted);
    max-width: 544px;
    margin-top: var(--space-2);
  }

  .certification-meta {
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  .contact-links {
    display: flex;
    gap: var(--space-5);
  }

  .contact-link {
    font-size: var(--text-m);
  }

  .arrow {
    font-size: var(--text-s);
  }

  @media (max-width: 768px) {
    .about-hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .timeline-item {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }

    .contact-links {
      flex-direction: column;
      gap: var(--space-3);
    }

    .divider {
      margin-block: 56px;
    }
  }
</style>

<script>
  // "My dog": the snapshot follows the pointer across the words and leans
  // with its movement, opens on tap for touch screens, and stays on screen
  // near the edges. Escape or a tap elsewhere puts it away.
  const dog = document.querySelector<HTMLElement>("[data-dog]");
  const trigger = dog?.querySelector<HTMLButtonElement>(".dog-trigger");
  const card = dog?.querySelector<HTMLElement>(".dog-card");

  if (dog && trigger && card) {
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let lastX = 0;
    let settle = 0;

    // Keep the card inside the viewport with a small margin.
    function keepOnScreen() {
      dog!.style.setProperty("--nudge", "0px");
      const box = dog!.getBoundingClientRect();
      const half = card!.offsetWidth / 2;
      const center = box.left + box.width / 2;
      const margin = 12;
      const vw = document.documentElement.clientWidth;
      let nudge = 0;
      if (center - half < margin) nudge = margin - (center - half);
      if (center + half > vw - margin) nudge = vw - margin - (center + half);
      dog!.style.setProperty("--nudge", `${nudge}px`);
    }

    function setOpen(open: boolean) {
      dog!.classList.toggle("is-open", open);
      trigger!.setAttribute("aria-expanded", String(open));
    }

    dog.addEventListener("pointerenter", (event) => {
      keepOnScreen();
      lastX = event.clientX;
    });

    dog.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse" || still.matches) return;
      const box = dog.getBoundingClientRect();
      const x = event.clientX - (box.left + box.width / 2);
      const lean = Math.max(-10, Math.min(10, (event.clientX - lastX) * 0.8));
      lastX = event.clientX;
      dog.style.setProperty("--x", `${x.toFixed(1)}px`);
      dog.style.setProperty("--lean", `${lean.toFixed(1)}deg`);
      window.clearTimeout(settle);
      settle = window.setTimeout(() => dog.style.setProperty("--lean", "0deg"), 120);
    });

    dog.addEventListener("pointerleave", () => {
      dog.style.setProperty("--x", "0px");
      dog.style.setProperty("--lean", "0deg");
    });

    trigger.addEventListener("click", () => {
      keepOnScreen();
      setOpen(!dog.classList.contains("is-open"));
    });

    trigger.addEventListener("focus", keepOnScreen);
    trigger.addEventListener("blur", () => setOpen(false));

    document.addEventListener("pointerdown", (event) => {
      if (!dog.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && dog.classList.contains("is-open")) setOpen(false);
    });
  }
</script>
