---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import Accordion from "../components/ui/Accordion.astro";

const FORMSPREE_ENDPOINT = "https://formspree.io/f/mvzennjv";

const pageTitle = "Start a Website Project | Ryan Sheridan, Austin Web Designer";
const pageDescription =
  "Planning a new website or redesign? Tell me about your business and goals. Design-first web design and development from Austin, TX, with technical SEO built in from day one.";

const faqs = [
  {
    q: "What kind of projects do you take on?",
    a: "Mostly websites: marketing sites, small business sites, portfolios, and redesigns of sites that have outgrown themselves. I also take on branding and marketing design work, either on its own or alongside a new site.",
  },
  {
    q: "Do you design, build, or both?",
    a: "Both. Some projects are design only, handed off to your developer or team. Others I design and build end to end. Either way, the design is made with how it will actually be built in mind.",
  },
  {
    q: "What does \"design-first, with technical SEO built in\" mean?",
    a: "The work starts with how your site looks, reads, and feels, because that is what earns trust. Underneath, the structure is set up so search engines can find and understand it: clean markup, fast pages, sensible URLs, metadata, and structured data. SEO shapes the foundation instead of getting bolted on after launch.",
  },
  {
    q: "Do you work with clients outside of Austin?",
    a: "Yes. I'm based in the Austin area and work with clients locally and remotely.",
  },
  {
    q: "What happens after I send this?",
    a: "I read everything you send, then follow up within two business days with any questions and a time to talk. After that conversation I put together a proposal with scope, timeline, and cost.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Website design and development",
    serviceType: "Web design",
    description: pageDescription,
    url: "https://ryansheridan.studio/start-a-project/",
    provider: {
      "@type": "Person",
      name: "Ryan Sheridan",
      url: "https://ryansheridan.studio",
      jobTitle: "Principal Designer",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Austin",
        addressRegion: "TX",
        addressCountry: "US",
      },
    },
    areaServed: [
      { "@type": "City", name: "Austin" },
      { "@type": "Country", name: "United States" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://ryansheridan.studio/" },
      { "@type": "ListItem", position: 2, name: "Contact", item: "https://ryansheridan.studio/contact" },
      { "@type": "ListItem", position: 3, name: "Start a website project" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <Nav />
  <main id="main" class="questions-page">
    <Breadcrumbs
      class="page-crumbs"
      items={[{ label: "Home", href: "/" }, { label: "Contact", href: "/contact" }, { label: "Start a website project" }]}
    />

    <header class="questions-hero">
      <p class="overline">Website design &amp; development</p>
      <h1>Let's plan your new website.</h1>
      <p class="intro">
        Tell me about your business and what you need the site to do. The more
        I know up front, the more useful our first conversation will be. I take
        a design-first approach, with technical SEO built into the foundation
        rather than bolted on at the end.
      </p>
      <p class="aside hero-aside">
        Websites are my focus, but I also take on branding and marketing design
        work. If that's what you're after, this form works for that too.
      </p>
    </header>

    <form
      id="questions-form"
      class="questions-form"
      action={FORMSPREE_ENDPOINT}
      method="POST"
    >
      <input type="hidden" name="_subject" value="New website project inquiry" />

      <section class="form-section" aria-labelledby="step-basics">
        <h2 id="step-basics"><span class="step">1</span> The basics</h2>

        <div class="field-row">
          <div class="field">
            <label class="field-label" for="contact-name">Your name</label>
            <input type="text" class="input" id="contact-name" name="Name" autocomplete="name" />
          </div>
          <div class="field">
            <label class="field-label" for="reply-email">Email <span class="required-marker">*</span></label>
            <input type="email" class="input" id="reply-email" name="_replyto" autocomplete="email" required aria-describedby="email-error" />
            <p class="field-error" id="email-error"></p>
          </div>
        </div>

        <fieldset class="field">
          <legend class="field-label">What do you need help with?</legend>
          <div class="choice-group cols-2">
            <label class="choice">
              <input type="checkbox" name="Project type" value="New website" />
              New website
            </label>
            <label class="choice">
              <input type="checkbox" name="Project type" value="Website redesign" />
              Website redesign
            </label>
            <label class="choice">
              <input type="checkbox" name="Project type" value="Branding / identity" />
              Branding / identity
            </label>
            <label class="choice">
              <input type="checkbox" name="Project type" value="Marketing / campaign design" />
              Marketing / campaign design
            </label>
          </div>
        </fieldset>
      </section>

      <section class="form-section" aria-labelledby="step-route">
        <h2 id="step-route"><span class="step">2</span> How do you want to share the details?</h2>

        <fieldset class="field route-picker">
          <legend class="visually-hidden">Choose how to share project details</legend>
          <label class="choice-card">
            <input type="radio" name="Route" value="Guided questions" />
            <span class="choice-card-title">Answer a few questions</span>
            <span class="choice-card-desc">About five minutes. Mostly checkboxes, skip anything you're unsure of.</span>
          </label>
          <label class="choice-card">
            <input type="radio" name="Route" value="Brain dump" />
            <span class="choice-card-title">Just tell me everything</span>
            <span class="choice-card-desc">One big box. Paste a brief, dictate, or ramble. No structure needed.</span>
          </label>
        </fieldset>
      </section>

      <fieldset id="route-dump" class="route-panel" hidden disabled>
        <legend class="visually-hidden">Tell me everything</legend>
        <section class="form-section">
          <div class="field">
            <label class="field-label" for="brain-dump">Tell me about the project <span class="required-marker">*</span></label>
            <p class="field-note">
              Paste in an existing brief, use your phone's dictation, or just
              start typing. Helpful things to touch on: what your business
              does, who it's for, what the site needs to do, sites you like the
              look of, your timeline, and a rough budget.
            </p>
            <textarea class="input" id="brain-dump" name="Brain dump" rows="14" required></textarea>
          </div>

          <div class="field">
            <label class="field-label" for="dump-current-site">Current website, if you have one</label>
            <input type="text" class="input" id="dump-current-site" name="Current website" inputmode="url" placeholder="yourbusiness.com" />
          </div>
        </section>
      </fieldset>

      <fieldset id="route-guided" class="route-panel" hidden disabled>
        <legend class="visually-hidden">Guided questions</legend>

        <section class="form-section" aria-labelledby="step-business">
          <h2 id="step-business"><span class="step">3</span> Your business</h2>

          <div class="field-row">
            <div class="field">
              <label class="field-label" for="business-name">Business name</label>
              <input type="text" class="input" id="business-name" name="Business name" autocomplete="organization" />
            </div>
            <div class="field">
              <label class="field-label" for="current-site">Current website, if any</label>
              <input type="text" class="input" id="current-site" name="Current website" inputmode="url" placeholder="yourbusiness.com" />
            </div>
          </div>

          <div class="field">
            <label class="field-label" for="business-description">What do you do, and who is it for?</label>
            <textarea class="input"
              id="business-description"
              name="Business description"
              rows="4"
              placeholder="e.g. We're a family-owned landscaping company serving homeowners in south Austin."
            ></textarea>
          </div>
        </section>

        <section class="form-section" aria-labelledby="step-site">
          <h2 id="step-site"><span class="step">4</span> The website</h2>

          <fieldset class="field">
            <legend class="field-label">What should the site help you do?</legend>
            <p class="field-note">Pick all that apply.</p>
            <div class="choice-group cols-2">
              <label class="choice">
                <input type="checkbox" name="Site goals" value="Get inquiries / leads" />
                Get inquiries / leads
              </label>
              <label class="choice">
                <input type="checkbox" name="Site goals" value="Book appointments" data-reveals="tools" />
                Book appointments
              </label>
              <label class="choice">
                <input type="checkbox" name="Site goals" value="Sell products / take payments" data-reveals="tools" />
                Sell or take payments
              </label>
              <label class="choice">
                <input type="checkbox" name="Site goals" value="Show off work / portfolio" />
                Show off work / portfolio
              </label>
              <label class="choice">
                <input type="checkbox" name="Site goals" value="Build credibility" />
                Build credibility
              </label>
              <label class="choice">
                <input type="checkbox" name="Site goals" value="Publish content / blog" />
                Publish content / blog
              </label>
            </div>
            <div class="field field-nested" id="tools-wrap" hidden>
              <label class="field-label" for="tools">Any tools you already use for booking or payments?</label>
              <input type="text" class="input" id="tools" name="Existing tools" placeholder="e.g. Calendly, Square, Stripe, Shopify" />
            </div>
          </fieldset>

          <fieldset class="field">
            <legend class="field-label">Which pages do you think you'll need?</legend>
            <div class="choice-group cols-2">
              <label class="choice">
                <input type="checkbox" name="Pages needed" value="Home" />
                Home
              </label>
              <label class="choice">
                <input type="checkbox" name="Pages needed" value="About" />
                About
              </label>
              <label class="choice">
                <input type="checkbox" name="Pages needed" value="Services" />
                Services
              </label>
              <label class="choice">
                <input type="checkbox" name="Pages needed" value="Portfolio / gallery" />
                Portfolio / gallery
              </label>
              <label class="choice">
                <input type="checkbox" name="Pages needed" value="Blog" />
                Blog
              </label>
              <label class="choice">
                <input type="checkbox" name="Pages needed" value="Contact" />
                Contact
              </label>
            </div>
            <div class="field field-nested">
              <label class="field-label" for="pages-other">Anything else?</label>
              <input type="text" class="input" id="pages-other" name="Other pages" placeholder="e.g. Pricing, FAQ, Careers" />
            </div>
          </fieldset>
        </section>

        <section class="form-section" aria-labelledby="step-look">
          <h2 id="step-look"><span class="step">5</span> Look &amp; feel</h2>

          <fieldset class="field">
            <legend class="field-label">Where is your branding at? (logo, colors, fonts)</legend>
            <div class="choice-group">
              <label class="choice">
                <input type="radio" name="Branding" value="Have it, ready to use" />
                I have it and I'm happy with it
              </label>
              <label class="choice">
                <input type="radio" name="Branding" value="Have some, could use a refresh" />
                I have some, but it could use a refresh
              </label>
              <label class="choice">
                <input type="radio" name="Branding" value="Starting from scratch" />
                Starting from scratch, I'd like help with it
              </label>
            </div>
          </fieldset>

          <div class="field">
            <label class="field-label" for="reference-sites">Sites you like the look of</label>
            <p class="field-note">
              One of the most useful things you can share. A couple of links,
              even just for a color palette or layout you like, tells me more
              than a description alone.
            </p>
            <textarea class="input"
              id="reference-sites"
              name="Reference sites"
              rows="3"
              placeholder="https://example.com, love how clean the typography is"
            ></textarea>
          </div>
        </section>

        <section class="form-section" aria-labelledby="step-logistics">
          <h2 id="step-logistics"><span class="step">6</span> Logistics</h2>

          <fieldset class="field">
            <legend class="field-label">When would you like it live?</legend>
            <div class="choice-group cols-2">
              <label class="choice">
                <input type="radio" name="Timeline" value="As soon as possible" />
                As soon as possible
              </label>
              <label class="choice">
                <input type="radio" name="Timeline" value="1 to 2 months" />
                1 to 2 months
              </label>
              <label class="choice">
                <input type="radio" name="Timeline" value="3+ months" />
                3+ months
              </label>
              <label class="choice">
                <input type="radio" name="Timeline" value="Flexible" />
                Flexible
              </label>
            </div>
          </fieldset>

          <fieldset class="field">
            <legend class="field-label">Rough budget</legend>
            <p class="field-note">Helps me suggest the right scope. No wrong answers.</p>
            <div class="choice-group cols-2">
              <label class="choice">
                <input type="radio" name="Budget" value="Under $1k" />
                Under $1k
              </label>
              <label class="choice">
                <input type="radio" name="Budget" value="$1k to $3k" />
                $1k to $3k
              </label>
              <label class="choice">
                <input type="radio" name="Budget" value="$3k to $7k" />
                $3k to $7k
              </label>
              <label class="choice">
                <input type="radio" name="Budget" value="$7k to $12k" />
                $7k to $12k
              </label>
              <label class="choice">
                <input type="radio" name="Budget" value="$12k+" />
                $12k+
              </label>
              <label class="choice">
                <input type="radio" name="Budget" value="Not sure yet" />
                Not sure yet
              </label>
            </div>
          </fieldset>

          <fieldset class="field">
            <legend class="field-label">After launch, who handles updates?</legend>
            <div class="choice-group">
              <label class="choice">
                <input type="radio" name="Ongoing updates" value="Ryan handles updates" />
                I'd like you to handle them
              </label>
              <label class="choice">
                <input type="radio" name="Ongoing updates" value="Wants to edit some content themselves" />
                I'd like to edit some things myself
              </label>
              <label class="choice">
                <input type="radio" name="Ongoing updates" value="Not sure yet" />
                Not sure yet
              </label>
            </div>
          </fieldset>

          <fieldset class="field">
            <legend class="field-label">Do you own a domain for this?</legend>
            <div class="choice-group cols-3">
              <label class="choice">
                <input type="radio" name="Domain owned" value="Yes" />
                Yes
              </label>
              <label class="choice">
                <input type="radio" name="Domain owned" value="No" />
                No
              </label>
              <label class="choice">
                <input type="radio" name="Domain owned" value="Not sure" />
                Not sure
              </label>
            </div>
          </fieldset>

          <div class="field">
            <label class="field-label" for="anything-else">Anything else?</label>
            <p class="field-note">Rant, ramble, or paste. I'll follow up with any other questions.</p>
            <textarea class="input" id="anything-else" name="Anything else" rows="5"></textarea>
          </div>
        </section>
      </fieldset>

      <div class="submit-wrap" hidden>
        <button type="submit" class="submit-button btn btn-primary btn-lg">
          Send it over <span class="arrow" aria-hidden="true">&rarr;</span>
        </button>
        <p class="submit-status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <div class="thank-you" hidden tabindex="-1">
      <h2>Thanks, got it.</h2>
      <p class="intro">I'll read through everything and follow up within two business days.</p>
    </div>

    <section class="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Common questions</h2>
      <Accordion items={faqs} />
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById("questions-form") as HTMLFormElement | null;
  const status = document.querySelector(".submit-status");
  const thankYou = document.querySelector<HTMLElement>(".thank-you");
  const submitWrap = document.querySelector<HTMLElement>(".submit-wrap");

  const emailField = document.getElementById("reply-email") as HTMLInputElement | null;
  const emailError = document.getElementById("email-error");
  function syncEmailError() {
    if (!emailField || !emailError) return;
    emailError.textContent =
      emailField.value !== "" && !emailField.validity.valid ? "Please enter a valid email address." : "";
  }
  emailField?.addEventListener("blur", syncEmailError);
  emailField?.addEventListener("input", () => {
    if (emailError?.textContent) syncEmailError();
  });

  // Inactive route panels stay disabled so their fields never reach Formspree
  // and their required fields never block submission.
  const panels: Record<string, HTMLFieldSetElement | null> = {
    "Guided questions": document.getElementById("route-guided") as HTMLFieldSetElement | null,
    "Brain dump": document.getElementById("route-dump") as HTMLFieldSetElement | null,
  };
  document.querySelectorAll<HTMLInputElement>('input[name="Route"]').forEach((radio) => {
    radio.addEventListener("change", () => {
      for (const [route, panel] of Object.entries(panels)) {
        const active = route === radio.value;
        panel?.toggleAttribute("hidden", !active);
        if (panel) panel.disabled = !active;
      }
      submitWrap?.removeAttribute("hidden");
    });
  });

  const toolsWrap = document.getElementById("tools-wrap");
  const toolTriggers = document.querySelectorAll<HTMLInputElement>('input[data-reveals="tools"]');
  toolTriggers.forEach((box) => {
    box.addEventListener("change", () => {
      toolsWrap?.toggleAttribute("hidden", ![...toolTriggers].some((b) => b.checked));
    });
  });

  form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[type="text"], input[type="email"], textarea').forEach((field) => {
    const syncFilled = () => field.classList.toggle("is-filled", field.value.trim().length > 0);
    syncFilled();
    field.addEventListener("input", syncFilled);
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const submitButton = form.querySelector<HTMLButtonElement>(".submit-button");
    if (submitButton) submitButton.disabled = true;
    if (status) status.textContent = "Sending…";

    const data = new FormData(form);
    const who = String(data.get("Business name") || data.get("Name") || data.get("_replyto") || "").trim();
    if (who) data.set("_subject", `New website project inquiry: ${who}`);

    const fail = (message = "Something went wrong. Please try again or email me directly.") => {
      if (status) status.textContent = message;
      if (submitButton) submitButton.disabled = false;
    };

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        form.hidden = true;
        thankYou?.removeAttribute("hidden");
        thankYou?.focus();
      } else {
        const body = await response.json().catch(() => null);
        const serverMessage = body?.errors?.map((e: { message: string }) => e.message).join(", ") ?? body?.error;
        console.error("Formspree submission failed", response.status, body);
        fail(serverMessage ? `Something went wrong: ${serverMessage}` : undefined);
      }
    } catch (err) {
      console.error("Formspree submission error", err);
      fail();
    }
  });
</script>

<style>
  .questions-page {
    padding: var(--page-top) var(--page-padding) var(--page-bottom);
  }

  .page-crumbs,
  .questions-hero,
  .questions-form,
  .thank-you,
  .faq {
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .overline {
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: var(--text-headline);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .intro {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .hero-aside {
    margin-top: var(--space-4);
  }

  .questions-hero {
    margin-bottom: var(--space-7);
  }

  .route-panel {
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .form-section {
    margin-top: var(--space-7);
    padding-top: var(--space-7);
    border-top: var(--border-width) solid var(--color-border);
  }

  .questions-form > .form-section:first-of-type {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .form-section h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    margin-bottom: var(--space-5);
  }

  .step {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
  }

  .field-nested {
    margin-top: var(--space-4);
    margin-bottom: 0;
  }

  /* An answered field firms up its outline, so a long form shows at a
     glance what's done. */
  .input.is-filled {
    border-color: var(--color-text-muted);
  }

  .route-picker {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .submit-wrap {
    margin-top: var(--space-7);
  }

  .submit-status {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-3);
  }

  .thank-you {
    padding-top: var(--space-6);
    outline: none;
  }

  .thank-you h2 {
    font-size: var(--text-title);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }

  .faq {
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: var(--border-width) solid var(--color-border);
  }

  .faq h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    margin-bottom: var(--space-4);
  }

  @media (max-width: 640px) {
    .route-picker {
      grid-template-columns: 1fr;
    }
  }
</style>
