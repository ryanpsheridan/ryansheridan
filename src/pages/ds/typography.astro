---
import DsLayout from "../../layouts/DsLayout.astro";
import TokenTable from "../../components/ds/TokenTable.astro";
import CodeBlock from "../../components/ds/CodeBlock.astro";
import DoDont from "../../components/ds/DoDont.astro";
import { typographyTokens } from "../../data/tokens";

const group = (id: string) => typographyTokens.find((g) => g.id === id)!;

// The type scale, loudest to quietest, then the two mono label styles. Each
// row is a recipe of tokens, so a new page reaches for a style by name
// instead of picking numbers.
const roles = [
  { name: "Display 1", sample: "Multi-brand Design System", size: "text-display-1", px: "32–61", weight: "weight-light", leading: "leading-tight", tracking: "tracking-tight", family: "font-sans", where: "Case study titles" },
  { name: "Heading 1", sample: "Designing systems, sites and brands.", size: "text-h1", px: "32–49", weight: "weight-light", leading: "leading-tight", tracking: "tracking-tight", family: "font-sans", where: "Homepage statement, page titles" },
  { name: "Heading 2", sample: "All work", size: "text-h2", px: "28–39", weight: "weight-light", leading: "leading-tight", tracking: "tracking-tight", family: "font-sans", where: "Index and utility page titles" },
  { name: "Heading 3", sample: "Work", size: "text-h3", px: "31", weight: "weight-regular", leading: "leading-tight", tracking: "tracking-tight", family: "font-sans", where: "Menu overlay links" },
  { name: "Heading 4", sample: "One token name, a value per brand", size: "text-h4", px: "25", weight: "weight-light", leading: "leading-snug", tracking: "tracking-snug", family: "font-sans", where: "Case study sections" },
  { name: "Heading 5", sample: "The basics", size: "text-h5", px: "20", weight: "weight-medium", leading: "leading-snug", tracking: "tracking-snug", family: "font-sans", where: "Form steps, FAQ, prose headings" },
  { name: "Type L", sample: "Tell me about your business and what you need the site to do.", size: "text-l", px: "18", weight: "weight-light", leading: "leading-normal", tracking: "", family: "font-sans", where: "Leads, large buttons" },
  { name: "Type M", sample: "The work starts with how your site looks, reads, and feels, because that is what earns trust.", size: "text-m", px: "16", weight: "weight-light", leading: "leading-relaxed", tracking: "", family: "font-sans", where: "Running copy, fields" },
  { name: "Type S", sample: "Principal Designer, Design Systems", size: "text-s", px: "14", weight: "weight-light", leading: "leading-normal", tracking: "", family: "font-sans", where: "Labels, buttons, secondary copy" },
  { name: "Type XS", sample: "Paste the address, with or without https.", size: "text-xs", px: "12", weight: "weight-light", leading: "leading-normal", tracking: "", family: "font-sans", where: "Notes, captions" },
  { name: "Overline", sample: "Project type", size: "text-xs", px: "12", weight: "weight-regular", leading: "leading-normal", tracking: "tracking-wide", family: "font-mono", where: "Labels over metadata, eyebrows" },
  { name: "Meta", sample: "Home / Work / RHOW Coffee", size: "text-s", px: "14", weight: "weight-regular", leading: "leading-normal", tracking: "", family: "font-mono", where: "Breadcrumbs, counts, back links" },
];

const roleCss = (r: (typeof roles)[number]) =>
  [
    `font-family: var(--${r.family})`,
    `font-size: var(--${r.size})`,
    `font-weight: var(--${r.weight})`,
    `line-height: var(--${r.leading})`,
    r.tracking && `letter-spacing: var(--${r.tracking})`,
  ]
    .filter(Boolean)
    .join("; ");
---

<DsLayout
  section="Foundations"
  title="Typography"
  lead="Geist, set light, for everything people read. IBM Plex Mono for everything the site says about itself."
>
  <section aria-labelledby="scale">
    <h2 id="scale">Type scale</h2>
    <p class="ds-text">
      Headings follow the <a href="https://typescale.com/?size=16&scale=1.250" target="_blank" rel="noopener noreferrer">Major Third scale<span class="visually-hidden"> (opens in a new tab)</span></a>:
      each step is 1.25 times the last, from a 16px base. Body sizes sit beside it on an even 2px step. Pick a
      style by name; resize the window and the fluid ones scale with it.
    </p>
    <div class="roles">
      {roles.map((r) => (
        <div class="role">
          <div class="role-meta">
            <span class="role-name">{r.name}</span>
            <span class="role-tokens">--{r.size} · {r.px}px</span>
            <span class="role-tokens">
              {r.weight.replace("weight-", "")} · {r.leading.replace("leading-", "")}{r.family === "font-mono" ? " · mono" : ""}
            </span>
            <span class="role-where">{r.where}</span>
          </div>
          <p class="role-sample" style={roleCss(r)} class:list={{ upper: r.name === "Overline" }}>{r.sample}</p>
        </div>
      ))}
    </div>
    <p class="ds-text">
      Heading styles are visual sizes, not HTML levels. Every page has one <code>&lt;h1&gt;</code>, even when it's
      set in Heading 2, like the title on /work.
    </p>
    <CodeBlock
      lang="css"
      label="A page title in Heading 1"
      code={`h1 {
  font-size: var(--text-h1);
  font-weight: var(--weight-light);
  line-height: var(--leading-tight);
  letter-spacing: var(--tracking-tight);
}`}
    />
  </section>

  <section aria-labelledby="tokens">
    <h2 id="tokens">Tokens</h2>
    <TokenTable group={group("font-family")} preview="font" />
    <TokenTable group={group("font-weight")} preview="weight" />
    <TokenTable group={group("font-size-heading")} preview="size" />
    <TokenTable group={group("font-size-body")} preview="size" />
    <TokenTable group={group("line-height")} preview="leading" />
    <TokenTable group={group("letter-spacing")} preview="tracking" />
    <TokenTable group={group("font-size-deprecated")} />
  </section>

  <section aria-labelledby="rules">
    <h2 id="rules">Rules</h2>
    <ul class="ds-list">
      <li><strong>Light is the voice.</strong> Headlines and body are weight 300. Medium (500) is the only emphasis, used for labels, buttons, and a bolded phrase. Nothing is bold.</li>
      <li><strong>Mono is metadata.</strong> If it describes the content rather than being the content (a date, a count, a tag, a breadcrumb), it's in Plex Mono.</li>
      <li><strong>Sentence case everywhere.</strong> Headlines, buttons, and labels. Uppercase only in the Overline role, and only through <code>text-transform</code>, so screen readers read words, not letters.</li>
      <li><strong>Hold a measure.</strong> Long copy sits in <code>--content-width</code> (656px), about 75 characters a line.</li>
      <li><strong>Sizes come from the scale.</strong> Display 1 and Headings 1 and 2 are fluid; everything else holds its size. All of them respect browser zoom.</li>
    </ul>
  </section>

  <section aria-labelledby="dos">
    <h2 id="dos">Do's and don'ts</h2>
    <DoDont
      doText="Emphasize with weight 500, sparingly."
      dontText="Use bold, italics, and caps all at once."
    >
      <p slot="do" class="dd">I design and build <strong style="font-weight: 500">end to end</strong>.</p>
      <p slot="dont" class="dd">I design and build <strong style="font-weight: 700; font-style: italic; text-transform: uppercase">end to end</strong>.</p>
    </DoDont>
    <div class="spacer"></div>
    <DoDont
      doText="Let headlines wrap at a natural phrase. Use <code>&lt;br&gt;</code> only on the homepage statement."
      dontText="Shrink a headline below its role to make it fit on one line."
    >
      <p slot="do" style="font-size: 28px; font-weight: 300; letter-spacing: -0.03em; line-height: 1.25">Let's plan your<br />new website.</p>
      <p slot="dont" style="font-size: 16px; font-weight: 300">Let's plan your new website, together, this year.</p>
    </DoDont>
  </section>
</DsLayout>

<style>
  .roles {
    margin: var(--space-4) 0 var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }

  .role {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .role-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .role-name {
    font-size: var(--text-s);
    font-weight: var(--weight-medium);
  }

  .role-tokens,
  .role-where {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .role-sample {
    overflow-wrap: anywhere;
  }

  .upper {
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .dd {
    font-size: var(--text-m);
  }

  .spacer {
    height: var(--space-5);
  }

  @media (max-width: 768px) {
    .role {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }
  }
</style>
