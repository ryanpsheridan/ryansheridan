---
import DsLayout from "../../layouts/DsLayout.astro";
import TokenTable from "../../components/ds/TokenTable.astro";
import CodeBlock from "../../components/ds/CodeBlock.astro";
import DoDont from "../../components/ds/DoDont.astro";
import { typographyTokens } from "../../data/tokens";

const group = (id: string) => typographyTokens.find((g) => g.id === id)!;

// The roles type plays on the site, from loudest to quietest. Each one is a
// recipe of tokens, so a new page can reach for a role instead of numbers.
const roles = [
  { name: "Hero", sample: "Multi-brand Design System", size: "text-hero", weight: "weight-light", leading: "leading-tight", tracking: "tracking-tight", family: "font-sans", where: "Case study titles" },
  { name: "Display", sample: "Designing systems, sites and brands.", size: "text-display", weight: "weight-light", leading: "leading-tight", tracking: "tracking-tight", family: "font-sans", where: "The homepage statement" },
  { name: "Headline", sample: "Let's work together.", size: "text-headline", weight: "weight-light", leading: "leading-tight", tracking: "tracking-tight", family: "font-sans", where: "Page titles" },
  { name: "Title", sample: "All work", size: "text-title", weight: "weight-light", leading: "leading-tight", tracking: "tracking-tight", family: "font-sans", where: "Index and utility page titles" },
  { name: "Section", sample: "One token name, a value per brand", size: "text-xl", weight: "weight-light", leading: "leading-snug", tracking: "tracking-snug", family: "font-sans", where: "Headings inside a case study" },
  { name: "Subsection", sample: "The basics", size: "text-lg", weight: "weight-medium", leading: "leading-snug", tracking: "tracking-snug", family: "font-sans", where: "Form steps, FAQ heading, prose h3" },
  { name: "Lead", sample: "Tell me about your business and what you need the site to do.", size: "text-md", weight: "weight-light", leading: "leading-normal", tracking: "", family: "font-sans", where: "The sentence under a headline" },
  { name: "Body", sample: "The work starts with how your site looks, reads, and feels, because that is what earns trust.", size: "text-base", weight: "weight-light", leading: "leading-relaxed", tracking: "", family: "font-sans", where: "Running copy" },
  { name: "Label", sample: "Email", size: "text-sm", weight: "weight-medium", leading: "leading-normal", tracking: "", family: "font-sans", where: "Form labels, buttons" },
  { name: "Overline", sample: "PROJECT TYPE", size: "text-xs", weight: "weight-regular", leading: "leading-normal", tracking: "tracking-wide", family: "font-mono", where: "Labels over metadata, eyebrows" },
  { name: "Meta", sample: "Home / Work / RHOW Coffee", size: "text-sm", weight: "weight-regular", leading: "leading-normal", tracking: "", family: "font-mono", where: "Breadcrumbs, counts, back links" },
];

const roleCss = (r: (typeof roles)[number]) =>
  [
    `font-family: var(--${r.family})`,
    `font-size: var(--${r.size})`,
    `font-weight: var(--${r.weight})`,
    `line-height: var(--${r.leading})`,
    r.tracking && `letter-spacing: var(--${r.tracking})`,
  ]
    .filter(Boolean)
    .join("; ");
---

<DsLayout
  section="Foundations"
  title="Typography"
  lead="Geist, set light, for everything people read. IBM Plex Mono for everything the site says about itself."
>
  <section aria-labelledby="roles">
    <h2 id="roles">Type roles</h2>
    <p class="ds-text">
      Start from a role, not a size. Each role is a fixed recipe of tokens; resize the window and the fluid
      ones scale with it.
    </p>
    <div class="roles">
      {roles.map((r) => (
        <div class="role">
          <div class="role-meta">
            <span class="role-name">{r.name}</span>
            <span class="role-tokens">
              {r.size} · {r.weight.replace("weight-", "")} · {r.leading.replace("leading-", "")}
              {r.family === "font-mono" ? " · mono" : ""}
            </span>
            <span class="role-where">{r.where}</span>
          </div>
          <p class="role-sample" style={roleCss(r)} class:list={{ upper: r.name === "Overline" }}>{r.sample}</p>
        </div>
      ))}
    </div>
    <CodeBlock
      lang="css"
      label="A page title, built from the Headline role"
      code={`h1 {
  font-size: var(--text-headline);
  font-weight: var(--weight-light);
  line-height: var(--leading-tight);
  letter-spacing: var(--tracking-tight);
}`}
    />
  </section>

  <section aria-labelledby="tokens">
    <h2 id="tokens">Tokens</h2>
    <TokenTable group={group("font-family")} preview="font" />
    <TokenTable group={group("font-weight")} preview="weight" />
    <TokenTable group={group("font-size")} preview="size" />
    <TokenTable group={group("font-size-fluid")} preview="size" />
    <TokenTable group={group("line-height")} preview="leading" />
    <TokenTable group={group("letter-spacing")} preview="tracking" />
  </section>

  <section aria-labelledby="rules">
    <h2 id="rules">Rules</h2>
    <ul class="ds-list">
      <li><strong>Light is the voice.</strong> Headlines and body are weight 300. Medium (500) is the only emphasis, used for labels, buttons, and a bolded phrase. Nothing is bold.</li>
      <li><strong>Mono is metadata.</strong> If it describes the content rather than being the content (a date, a count, a tag, a breadcrumb), it's in Plex Mono.</li>
      <li><strong>Sentence case everywhere.</strong> Headlines, buttons, and labels. Uppercase only in the Overline role, and only through <code>text-transform</code>, so screen readers read words, not letters.</li>
      <li><strong>Hold a measure.</strong> Long copy sits in <code>--content-width</code> (656px), about 75 characters a line.</li>
      <li><strong>Sizes in px, scaling in clamp.</strong> Static sizes come from the scale; anything that should grow with the screen uses a fluid token. Both respect browser zoom.</li>
    </ul>
  </section>

  <section aria-labelledby="dos">
    <h2 id="dos">Do's and don'ts</h2>
    <DoDont
      doText="Emphasize with weight 500, sparingly."
      dontText="Use bold, italics, and caps all at once."
    >
      <p slot="do" class="dd">I design and build <strong style="font-weight: 500">end to end</strong>.</p>
      <p slot="dont" class="dd">I design and build <strong style="font-weight: 700; font-style: italic; text-transform: uppercase">end to end</strong>.</p>
    </DoDont>
    <div class="spacer"></div>
    <DoDont
      doText="Let headlines wrap at a natural phrase. Use <code>&lt;br&gt;</code> only on the homepage statement."
      dontText="Shrink a headline below its role to make it fit on one line."
    >
      <p slot="do" style="font-size: 28px; font-weight: 300; letter-spacing: -0.03em; line-height: 1.25">Let's plan your<br />new website.</p>
      <p slot="dont" style="font-size: 16px; font-weight: 300">Let's plan your new website, together, this year.</p>
    </DoDont>
  </section>
</DsLayout>

<style>
  .roles {
    margin: var(--space-4) 0 var(--space-5);
    border-top: var(--border-width) solid var(--color-text);
  }

  .role {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .role-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .role-name {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .role-tokens,
  .role-where {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .role-sample {
    overflow-wrap: anywhere;
  }

  .upper {
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .dd {
    font-size: var(--text-base);
  }

  .spacer {
    height: var(--space-5);
  }

  @media (max-width: 768px) {
    .role {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }
  }
</style>
