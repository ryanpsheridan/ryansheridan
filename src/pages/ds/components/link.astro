---
import DsLayout from "../../../layouts/DsLayout.astro";
import Example from "../../../components/ds/Example.astro";
import PropsTable from "../../../components/ds/PropsTable.astro";
import DoDont from "../../../components/ds/DoDont.astro";
---

<DsLayout
  section="Components"
  title="Link"
  lead="Three kinds, by where the link sits: blue inside a sentence, grey in the chrome around it, underlined when it stands alone."
>
  <section aria-labelledby="usage">
    <h2 id="usage">When to use which</h2>
    <div class="ds-table-wrap">
      <table class="ds-table">
        <thead><tr><th scope="col">Kind</th><th scope="col">Use for</th><th scope="col">On the site</th></tr></thead>
        <tbody>
          <tr><td>Inline</td><td>A link inside running copy.</td><td class="muted">Case study text</td></tr>
          <tr><td>Quiet</td><td>Navigation chrome and secondary routes, where blue would shout.</td><td class="muted">Footer, back links, "Start a website project"</td></tr>
          <tr><td>Underlined</td><td>A standalone link that should still read as one.</td><td class="muted">Client site, email, certification</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="examples">
    <h2 id="examples">Examples</h2>
    <Example
      title="Inline"
      description="Any link inside .prose gets this automatically. Blue, with a light underline that darkens on hover."
      lang="html"
      code={`<div class="prose">
  <p>Commerce is the parent company behind <a href="https://www.bigcommerce.com/">BigCommerce</a>.</p>
</div>`}
    >
      <div class="prose"><p>Commerce is the parent company behind <a href="#examples">BigCommerce</a>.</p></div>
    </Example>

    <Example
      title="Quiet"
      description="Muted until hovered."
      lang="html"
      code={`<a href="/work" class="link-quiet">← All work</a>`}
    >
      <a href="#examples" class="link-quiet" style="font-family: var(--font-mono); font-size: var(--text-s)">← All work</a>
    </Example>

    <Example
      title="Underlined"
      description="Text color with a strong hairline underneath."
      lang="html"
      code={`<a href="mailto:ryansheridandesign@gmail.com" class="link-underline">ryansheridandesign@gmail.com</a>`}
    >
      <a href="#examples" class="link-underline">ryansheridandesign@gmail.com</a>
    </Example>

    <Example
      title="Opening a new tab"
      description="Only for links that leave the site. Say so to screen readers."
      lang="html"
      code={`<a href="https://www.commerce.com/" target="_blank" rel="noopener noreferrer" class="link-underline">
  Commerce <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span>
</a>`}
    >
      <a href="https://www.commerce.com/" target="_blank" rel="noopener noreferrer" class="link-underline">Commerce <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span></a>
    </Example>
  </section>

  <section aria-labelledby="api">
    <h2 id="api">Classes</h2>
    <PropsTable
      kind="Class"
      rows={[
        { name: ".prose a", description: "Inline link, applied by context. No class needed." },
        { name: ".link-quiet", description: "Muted text, text color on hover." },
        { name: ".link-underline", description: "Text color, 1px strong underline offset 4px." },
      ]}
    />
  </section>

  <section aria-labelledby="a11y">
    <h2 id="a11y">Accessibility</h2>
    <ul class="ds-list">
      <li>Inline links are underlined. Blue against black text is only 2.8:1, so color alone wouldn't mark them (WCAG 1.4.1).</li>
      <li>Quiet links only appear in chrome, set apart by position, never in the middle of a sentence.</li>
      <li>Every link text names its destination on its own, since screen reader users often list links out of context.</li>
    </ul>
  </section>

  <section aria-labelledby="content">
    <h2 id="content">Content</h2>
    <DoDont doText="Link the words that name where you're going." dontText="Link &quot;here&quot; or &quot;this&quot;.">
      <p slot="do" class="prose" style="font-size: var(--text-s)">Read the <a href="#content">RHOW Coffee case study</a>.</p>
      <p slot="dont" class="prose" style="font-size: var(--text-s)">For the RHOW Coffee case study, <a href="#content">click here</a>.</p>
    </DoDont>
  </section>
</DsLayout>
