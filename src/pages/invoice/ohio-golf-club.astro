---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { breadcrumbSchema } from "../../data/schema";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";

const venmoUrl = "https://venmo.com/u/ryan-sheridan-44";
---

<Layout
  title="Ohio Golf Club Invoice | Ryan Sheridan"
  description="Invoice for Ohio Golf Club from Ryan Sheridan."
  schema={[breadcrumbSchema([{ name: "Ohio Golf Club invoice", path: "/invoice/ohio-golf-club" }])]}
  noindex
>
  <Nav />
  <main id="main" class="invoice-page">
    <Breadcrumbs class="page-crumbs" items={[{ label: "Home", href: "/" }, { label: "Ohio Golf Club invoice" }]} />

    <div class="invoice-toolbar">
      <button id="reset-btn" type="button" class="btn btn-secondary btn-sm">Reset</button>
      <button id="print-btn" type="button" class="btn btn-secondary btn-sm">Download PDF</button>
    </div>

    <div class="sheet">
      <header class="invoice-header">
        <div class="invoice-heading">
          <h1>Invoice</h1>
          <p class="from-name">Ryan Sheridan</p>
        </div>
        <ul class="contact-list">
          <li><a href="mailto:ryansheridandesign@gmail.com">ryansheridandesign@gmail.com</a></li>
          <li><a href="tel:+17204278262">720-427-8262</a></li>
          <li><a href="https://ryansheridan.studio/" target="_blank" rel="noopener noreferrer">ryansheridan.studio</a></li>
        </ul>
      </header>

      <hr class="divider" />

      <section class="meta-grid">
        <div class="meta-item">
          <label class="meta-label" for="inv-number">Invoice no.</label>
          <input id="inv-number" class="cell" type="text" data-persist placeholder="001" autocomplete="off" />
        </div>
        <div class="meta-item">
          <label class="meta-label" for="inv-date">Date</label>
          <input id="inv-date" class="cell" type="date" data-persist />
        </div>
        <div class="meta-item">
          <label class="meta-label" for="inv-due">Due</label>
          <input id="inv-due" class="cell" type="date" data-persist />
        </div>
      </section>

      <hr class="divider" />

      <section class="bill-to">
        <h2><label for="bill-to">Bill to</label></h2>
        <textarea
          id="bill-to"
          class="cell cell-area"
          data-persist
          rows="3"
          placeholder="Client name&#10;Company&#10;client@email.com"
        ></textarea>
      </section>

      <hr class="divider" />

      <section class="items">
        <h2>Services</h2>
        <div class="item-head" aria-hidden="true">
          <span>Description</span>
          <span class="num">Qty</span>
          <span class="num">Rate</span>
          <span class="num">Amount</span>
          <span class="item-action"></span>
        </div>
        <div id="item-rows"></div>
        <button id="add-row" type="button" class="btn btn-secondary btn-sm add-row">Add line</button>

        <dl class="totals">
          <div class="totals-row total-final">
            <dt>Total due</dt>
            <dd id="total">$0.00</dd>
          </div>
        </dl>
      </section>

      <hr class="divider" />

      <section class="payment">
        <h2>Payment</h2>
        <p class="pay-line">
          Pay with Venmo:{" "}
          <a href={venmoUrl} target="_blank" rel="noopener noreferrer" class="link-underline">venmo.com/u/ryan-sheridan-44</a>
        </p>
      </section>

      <section class="notes" id="notes-section">
        <hr class="divider" />
        <h2><label for="notes">Notes</label></h2>
        <textarea
          id="notes"
          class="cell cell-area"
          data-persist
          rows="2"
          placeholder="Project details, payment terms, thank you."
        ></textarea>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const STORE = "invoice-draft-ohio-golf-club-v2";
  const BILL_TO = "Ohio Golf Club\n2262 S Arlington Rd\nAkron, OH 44319\n(330) 958-0052";
  const ITEMS = [
    "Website audit: contact form security and usability fixes, dependency updates, and team page changes.",
    "SEO foundation: unique page titles and descriptions for all six pages, one official site address, a sitemap, corrected link previews, and a Search Console baseline for measuring results.",
    "Design system cleanup and style guide page, preparing the site for redesign.",
    "Bay Rentals and Memberships pages: design and build, with a shared pricing data file, an updated home page plans section, and fixes to the contact button, footer social links, and button text.",
  ];
  const rowsEl = document.getElementById("item-rows") as HTMLElement;
  const totalEl = document.getElementById("total") as HTMLElement;
  const persisted = () => Array.from(document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-persist]"));

  const money = (n: number) =>
    n.toLocaleString("en-US", { style: "currency", currency: "USD" });

  function addRow(desc = "", qty = "1", rate = "") {
    const row = document.createElement("div");
    row.className = "item-row";
    row.innerHTML = `
      <span class="grow"><textarea class="cell r-desc" rows="1" aria-label="Description" placeholder="Design systems consulting"></textarea></span>
      <input class="cell num r-qty" type="number" inputmode="decimal" min="0" step="any" aria-label="Quantity" />
      <input class="cell num r-rate" type="number" inputmode="decimal" min="0" step="any" aria-label="Rate" placeholder="0.00" />
      <span class="num r-amount">$0.00</span>
      <button type="button" class="item-action remove-row" aria-label="Remove line">Remove</button>
    `;
    (row.querySelector(".r-desc") as HTMLTextAreaElement).value = desc;
    (row.querySelector(".r-qty") as HTMLInputElement).value = qty;
    (row.querySelector(".r-rate") as HTMLInputElement).value = rate;
    rowsEl.appendChild(row);
    grow(row.querySelector(".r-desc") as HTMLTextAreaElement);
  }

  function recalc() {
    let total = 0;
    rowsEl.querySelectorAll<HTMLElement>(".item-row").forEach((row) => {
      const qty = parseFloat((row.querySelector(".r-qty") as HTMLInputElement).value) || 0;
      const rate = parseFloat((row.querySelector(".r-rate") as HTMLInputElement).value) || 0;
      const amount = qty * rate;
      total += amount;
      (row.querySelector(".r-amount") as HTMLElement).textContent = money(amount);
    });
    totalEl.textContent = money(total);
  }

  function save() {
    try {
      const data = {
        fields: Object.fromEntries(persisted().map((el) => [el.id, el.value])),
        rows: Array.from(rowsEl.querySelectorAll<HTMLElement>(".item-row")).map((row) => [
          (row.querySelector(".r-desc") as HTMLTextAreaElement).value,
          (row.querySelector(".r-qty") as HTMLInputElement).value,
          (row.querySelector(".r-rate") as HTMLInputElement).value,
        ]),
      };
      localStorage.setItem(STORE, JSON.stringify(data));
    } catch {
      // Storage can be blocked; the page works without it.
    }
  }

  function defaults() {
    const today = new Date();
    const due = new Date(today);
    due.setDate(due.getDate() + 14);
    const iso = (d: Date) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    persisted().forEach((el) => (el.value = ""));
    (document.getElementById("inv-date") as HTMLInputElement).value = iso(today);
    (document.getElementById("inv-due") as HTMLInputElement).value = iso(due);
    rowsEl.innerHTML = "";
    (document.getElementById("bill-to") as HTMLTextAreaElement).value = BILL_TO;
    ITEMS.forEach((desc) => addRow(desc, "1", ""));
  }

  function load() {
    try {
      const raw = localStorage.getItem(STORE);
      if (!raw) return false;
      const data = JSON.parse(raw);
      persisted().forEach((el) => {
        if (typeof data.fields?.[el.id] === "string") el.value = data.fields[el.id];
      });
      rowsEl.innerHTML = "";
      (data.rows?.length ? data.rows : [["", "1", ""]]).forEach((r: string[]) => addRow(r[0], r[1], r[2]));
      return true;
    } catch {
      return false;
    }
  }

  // An empty notes block is left out of the PDF so it can't spill onto a second page.
  function syncNotes() {
    const notes = document.getElementById("notes") as HTMLTextAreaElement;
    const section = document.getElementById("notes-section") as HTMLElement;
    section.classList.toggle("is-empty", !notes.value.trim());
  }

  // Description boxes size through CSS (a hidden copy of the text sets the
  // height), so they re-wrap correctly when the page prints at a different width.
  function grow(el: HTMLTextAreaElement) {
    (el.parentElement as HTMLElement).dataset.value = el.value;
  }

  function autosize(el: HTMLTextAreaElement) {
    el.style.height = "auto";
    el.style.height = `${el.scrollHeight}px`;
  }
  const areas = () => Array.from(document.querySelectorAll<HTMLTextAreaElement>("textarea.cell-area"));

  if (!load()) defaults();
  recalc();
  syncNotes();
  areas().forEach(autosize);

  document.addEventListener("input", (e) => {
    const target = e.target as HTMLElement;
    if (target instanceof HTMLTextAreaElement) {
      if (target.classList.contains("r-desc")) grow(target);
      else autosize(target);
    }
    recalc();
    syncNotes();
    save();
  });

  rowsEl.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".remove-row");
    if (!btn) return;
    btn.closest(".item-row")?.remove();
    if (!rowsEl.children.length) addRow();
    recalc();
    save();
  });

  document.getElementById("add-row")?.addEventListener("click", () => {
    addRow();
    (rowsEl.lastElementChild?.querySelector(".r-desc") as HTMLInputElement | null)?.focus();
    save();
  });

  document.getElementById("reset-btn")?.addEventListener("click", () => {
    try {
      localStorage.removeItem(STORE);
    } catch {
      // ignore
    }
    defaults();
    recalc();
    syncNotes();
    areas().forEach(autosize);
  });

  document.getElementById("print-btn")?.addEventListener("click", () => {
    (document.activeElement as HTMLElement | null)?.blur();
    areas().forEach(autosize);
    window.print();
  });
</script>

<style is:global>
  /* Rows are created in script, so their styles must not be scoped. */
  .invoice-page .item-row,
  .invoice-page .item-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 48px 80px 100px 56px;
    gap: var(--space-3);
    align-items: start;
  }

  .invoice-page .item-row {
    padding: var(--space-1) 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .invoice-page .num {
    text-align: right;
  }

  .invoice-page .remove-row {
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: right;
  }

  .invoice-page .remove-row:hover {
    color: var(--color-text);
  }

  .invoice-page .r-amount,
  .invoice-page .remove-row {
    padding-block: calc(var(--space-1) + 1px);
  }

  .invoice-page .r-amount {
    font-family: var(--font-mono);
    font-size: var(--text-s);
  }

  .invoice-page textarea.cell-area,
  .invoice-page .grow textarea {
    resize: none;
    overflow: hidden;
  }

  .invoice-page .grow {
    display: grid;
    margin-inline: calc(var(--space-2) * -1);
  }

  .invoice-page .grow::after,
  .invoice-page .grow .cell {
    grid-area: 1 / 1;
    margin: 0;
    width: 100%;
    padding: var(--space-1) var(--space-2);
    font-family: inherit;
    font-size: var(--text-s);
    font-weight: var(--weight-light);
    line-height: var(--leading-normal);
    border: var(--border-width) solid transparent;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  .invoice-page .grow::after {
    content: attr(data-value) " ";
    visibility: hidden;
  }

  .invoice-page .cell {
    display: block;
    width: 100%;
    min-width: 0;
    padding: var(--space-1) var(--space-2);
    margin-inline: calc(var(--space-2) * -1);
    width: calc(100% + var(--space-2) * 2);
    font-family: inherit;
    font-size: var(--text-s);
    font-weight: var(--weight-light);
    line-height: var(--leading-normal);
    color: var(--color-text);
    background: transparent;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .invoice-page .cell::placeholder {
    color: var(--color-placeholder);
  }

  .invoice-page .cell:hover {
    border-color: var(--color-border-strong);
  }

  .invoice-page .cell:focus-visible {
    border-color: var(--color-text);
  }

  .invoice-page input.num {
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--text-s);
  }

  .invoice-page input[type="number"] {
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .invoice-page input[type="number"]::-webkit-outer-spin-button,
  .invoice-page input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
</style>

<style>
  .invoice-page {
    padding: var(--page-top) var(--page-padding) 0;
  }

  .page-crumbs {
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .invoice-toolbar {
    max-width: var(--content-width);
    margin: 0 auto var(--space-4);
    display: flex;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  .sheet {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .invoice-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  h1 {
    font-size: var(--text-h2);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-2);
  }

  .from-name {
    font-size: var(--text-m);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
  }

  .contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .contact-list a {
    text-decoration: underline;
    text-decoration-color: var(--color-link-subtle);
    text-underline-offset: 3px;
    transition:
      color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .contact-list a:hover {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-link-hover);
  }

  .divider {
    margin: var(--space-5) 0;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: var(--text-s);
    font-weight: var(--weight-regular);
    letter-spacing: 0;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .meta-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-s);
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .item-head {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border-strong);
  }

  .add-row {
    margin-top: var(--space-3);
  }

  .totals {
    margin-top: var(--space-4);
    display: flex;
    justify-content: flex-end;
  }

  .totals-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
  }

  .totals dt {
    font-family: var(--font-mono);
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  .totals dd {
    font-size: var(--text-h3, var(--text-m));
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
  }

  .pay-line {
    font-size: var(--text-s);
    line-height: var(--leading-normal);
  }

  .remove-row {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: right;
  }

  @media (max-width: 640px) {
    .invoice-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .contact-list {
      text-align: left;
    }

    .meta-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>

<style is:global>
  @media (max-width: 640px) {
    .invoice-page .item-head {
      display: none;
    }

    .invoice-page .item-row {
      grid-template-columns: 1fr 1fr 1fr;
      row-gap: var(--space-1);
      padding: var(--space-3) 0;
    }

    .invoice-page .item-row .r-desc {
      grid-column: 1 / -1;
    }

    .invoice-page .item-row .r-amount {
      text-align: left;
    }

    .invoice-page .item-row .item-action {
      text-align: right;
    }
  }

  @media print {
    nav,
    footer,
    .page-crumbs,
    .invoice-toolbar,
    .add-row,
    .remove-row,
    .item-head .item-action {
      display: none !important;
    }

    @page {
      margin: 0.5in 0.6in;
    }

    main.invoice-page {
      padding: 0 !important;
    }

    .sheet {
      max-width: 100%;
    }

    body {
      font-size: 13.5px;
    }

    h1 {
      font-size: 26px;
    }

    .divider {
      margin: 10px 0;
    }

    h2 {
      margin-bottom: 6px;
    }

    .invoice-page .cell,
    .invoice-page .grow .cell,
    .invoice-page .grow::after {
      font-size: 12px;
      line-height: 1.4;
      padding-block: 2px;
    }

    .invoice-page .r-amount,
    .invoice-page input.num {
      font-size: 12px;
    }

    .totals {
      margin-top: 8px;
    }

    .invoice-page .item-row {
      padding: 2px 0;
    }

    .invoice-page :focus,
    .invoice-page :focus-visible {
      outline: none !important;
      border-color: transparent !important;
    }

    .invoice-page .notes.is-empty {
      display: none;
    }

    .invoice-page textarea.cell-area {
      resize: none;
    }

    .invoice-page .item-row,
    .invoice-page .item-head {
      grid-template-columns: minmax(0, 1fr) 48px 80px 100px;
    }

    .invoice-page .cell,
    .invoice-page .cell:hover {
      border-color: transparent;
    }

    /* Hide empty-field placeholder text and the date picker icon in the PDF. */
    .invoice-page .cell::placeholder {
      color: transparent;
    }

    .invoice-page input[type="date"]::-webkit-calendar-picker-indicator {
      display: none;
    }

    .invoice-page .item-row {
      break-inside: avoid;
    }

    a {
      color: var(--color-text) !important;
    }
  }
</style>
