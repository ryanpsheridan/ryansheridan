---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import InvoiceSheet from "../../components/InvoiceSheet.astro";
import { breadcrumbSchema } from "../../data/schema";

// Everything on the invoice is edited here. Rates are whole dollars; a rate of 0
// prints as "Included". Leave `qty` off every line to hide the Qty and Rate columns.
const billTo = ["Ohio Golf Club", "2262 S Arlington Rd", "Akron, OH 44319", "(330) 958-0052"];
const items = [
  {
    desc: "Website audit and tune-up: contact form security and accessibility fixes, and dependency updates.",
    rate: 250,
  },
  {
    desc: "SEO foundation: site hours, unique page titles and descriptions for every page, one official site address, corrected link previews, the Google rating badge, and a sitemap.",
    rate: 625,
  },
  {
    desc: "Full site review: fixed the nav Contact button and the footer social links, checked the site\u2019s links, resolved bugs, and removed the dead Instagram feed (replacement grid ready for photos).",
    rate: 250,
  },
  {
    desc: "Style guide page created, design system cleanup and preparing the site for redesign.",
    rate: 0,
  },
  {
    desc: "Bay Rentals and Memberships pages: design and build, with FAQs, reviews, search-ready price data, and an updated home page plans section. Prices come from one shared file, which also prepares them for the CMS.",
    rate: 500,
  },
];
---

<Layout
  title="Ohio Golf Club Invoice | Ryan Sheridan"
  description="Invoice for Ohio Golf Club from Ryan Sheridan."
  schema={[breadcrumbSchema([{ name: "Ohio Golf Club invoice", path: "/invoice/ohio-golf-club" }])]}
  noindex
>
  <Nav />
  <InvoiceSheet
    crumb="Ohio Golf Club invoice"
    invoiceNumber="001"
    date="Oct 25, 2026"
    due="Nov 8, 2026"
    billTo={billTo}
    items={items}
  />
  <Footer />
</Layout>
