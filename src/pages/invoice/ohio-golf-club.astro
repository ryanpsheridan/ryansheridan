---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import InvoiceSheet from "../../components/InvoiceSheet.astro";
import { breadcrumbSchema } from "../../data/schema";

const billTo = "Ohio Golf Club\n2262 S Arlington Rd\nAkron, OH 44319\n(330) 958-0052";
const items = [
  {
    desc: "Website audit and tune-up: contact form security and usability fixes, and dependency updates.",
    rate: "250",
  },
  {
    desc: "SEO foundation: site hours, unique page titles and descriptions for all six pages, one official site address, corrected link previews, the Google rating badge, and a sitemap with all pages submitted to Google Search Console.",
    rate: "625",
  },
  {
    desc: "Full site review: checked and fixed every link, resolved bugs, and removed outdated Instagram feed code that was no longer working.",
    rate: "250",
  },
  {
    desc: "Design system cleanup and style guide page, preparing the site for redesign.",
    rate: "0",
  },
  {
    desc: "Bay Rentals and Memberships pages: design and build, with pricing markup and an updated home page plans section.",
    rate: "500",
  },
];
---

<Layout
  title="Ohio Golf Club Invoice | Ryan Sheridan"
  description="Invoice for Ohio Golf Club from Ryan Sheridan."
  schema={[breadcrumbSchema([{ name: "Ohio Golf Club invoice", path: "/invoice/ohio-golf-club" }])]}
  noindex
>
  <Nav />
  <InvoiceSheet
    crumb="Ohio Golf Club invoice"
    storeKey="invoice-draft-ohio-golf-club-v6"
    billTo={billTo}
    items={items}
    noQty
  />
  <Footer />
</Layout>
