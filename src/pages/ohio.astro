              <div
                class="fill is-green"
                data-left={(drive.low / maxCost) * 100}
                data-width={((drive.high - drive.low) / maxCost) * 100}
                style="width:0; left:0;"
              ></div>
            </div>
            <ul class="lines">
              {drive.items.map((item) => (
                <li>
                  <div class="line-row">
                    <span>{item.label}</span>
                    <span class="num">
                      {item.low === item.high ? `$${item.low}` : `$${item.low}–${item.high}`}
                    </span>
                  </div>
                  <p>{item.detail}</p>
                </li>
              ))}
            </ul>
          </div>

          <div class="card">
            <div class="card-head">
              <span class="card-icon is-blue" set:html={icon("flight")} />
              <div>
                <h3>Fly + board</h3>
                <p>8 days · AUS ↔ CLE · dog stays home</p>
              </div>
            </div>
            <p class="figure">${fly.low.toLocaleString()}–{fly.high.toLocaleString()}</p>
            <div class="bar">
              <div
                class="fill is-blue"
                data-left={(fly.low / maxCost) * 100}
                data-width={((fly.high - fly.low) / maxCost) * 100}
                style="width:0; left:0;"
              ></div>
            </div>
            <ul class="lines">
              {fly.items.map((item) => (
                <li>
                  <div class="line-row">
                    <span>{item.label}</span>
                    <span class="num">
                      {item.low === item.high ? `$${item.low}` : `$${item.low}–${item.high}`}
                    </span>
                  </div>
                  <p>{item.detail}</p>
                </li>
              ))}
            </ul>
            <p class="fine">
              Preferred carriers showed $280–380/person for nearby dates, padded up for peak
              mid-August. Worth pulling real AUS–CLE fares for the exact days.
            </p>
          </div>
        </div>

        <div class="verdict">
          <span class="icon" set:html={icon("insights")} />
          <p>
            Driving lands roughly <b>$250–400 cheaper</b> — though it isn't apples to apples:
            the road trip runs <b>21 days</b> against <b>8</b> for flying. Match the lengths and
            driving wins by more, but a bigger slice of a short trip goes to the car.
          </p>
        </div>
      </div>
    </details>
  </main>

  <script>
    const reveals = document.querySelectorAll(".reveal");
    const fills = document.querySelectorAll(".fill");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const runFills = () =>
      fills.forEach((el) => {
        const f = el as HTMLElement;
        f.style.left = `${f.dataset.left}%`;
        f.style.width = `${f.dataset.width}%`;
      });

    if (reduced) {
      reveals.forEach((el) => el.classList.add("in"));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add("in");
            io.unobserve(e.target);
          });
        },
        { threshold: 0.1 }
      );
      reveals.forEach((el) => io.observe(el));
    }

    document.querySelector(".cost")?.addEventListener("toggle", runFills, { once: true });
  </script>
</Layout>

