---

<Layout title="Ohio Trip" description="Private trip planning page.">
  <main class="page">
    <header class="hero">
      <h1><span class="icon icon-hero" set:html={icon("pets")} />Ohio Trip</h1>
      <p class="subhead">Austin to Akron in three days. 6 AM starts, Whole Foods on the way, dog in the back.</p>
      <div class="stat-strip">
        <div class="stat">
          <span class="icon" set:html={icon("event")} />
          <span><b>Aug 14–16</b><i>Fri–Sun</i></span>
        </div>
        <div class="stat">
          <span class="icon" set:html={icon("route")} />
          <span><b>{totals.miles}</b><i>one way</i></span>
        </div>
        <div class="stat">
          <span class="icon" set:html={icon("schedule")} />
          <span><b>{totals.drive}</b><i>driving</i></span>
        </div>
        <div class="stat">
          <span class="icon" set:html={icon("hotel")} />
          <span><b>{totals.nights}</b><i>on the road</i></span>
        </div>
      </div>
    </header>

    {days.map((day) => (
      <section class="day reveal">
        <div class="day-head">
          <span class="day-badge">Day {day.n}</span>
          <div class="day-head-text">
            <h2>{day.from} <span class="arrow">→</span> {day.to}</h2>
            <p class="day-date">{day.weekday}, {day.date}</p>
          </div>
        </div>

        <div class="day-chips">
          <span class="day-chip"><span class="icon" set:html={icon("route")} />{day.miles}</span>
          <span class="day-chip"><span class="icon" set:html={icon("schedule")} />{day.drive} driving</span>
          <span class="day-chip is-arrive"><span class="icon" set:html={icon("place")} />In by {day.arrive}</span>
        </div>

        <ol class="sched">
          {day.schedule.map((s) => (
