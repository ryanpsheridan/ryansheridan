---
import Layout from "../layouts/Layout.astro";

const maxCost = 1355;

const drive = {
  low: 850,
  high: 1050,
  items: [
    { label: "Gas", detail: "34 mpg · 2,722 mi round trip · ~$3.60–3.70/gal", low: 290, high: 300 },
    { label: "Hotels", detail: "4 nights · 2 each way · pet-friendly + pet fees", low: 550, high: 750 },
  ],
};

const fly = {
  low: 1105,
  high: 1355,
  items: [
    { label: "Flights", detail: "2 people RT · AUS–CLE · United/Delta/Southwest/American only", low: 650, high: 900 },
    { label: "Dog boarding", detail: "7 nights · $65/night", low: 455, high: 455 },
  ],
};

const mapsLink = (name: string, address: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${name}, ${address}`)}`;

// Hotel requirements: gym on-site, dog-friendly, 4.2★ minimum
const hotelLittleRock = {
  name: "La Quinta Inn & Suites by Wyndham Little Rock - Bryant",
  address: "408 West Commerce Dr, Bryant, AR",
  rating: "4.7★ (844 reviews) — #1 of 10 hotels in Bryant on Tripadvisor",
  note: "Right off I-30 just south of Little Rock — quiet, safe suburb with shopping and restaurants nearby. Dog-friendly.",
  fitness: "On-site fitness center with free weights; about 15 min from the Arkansas River Trail for a longer walk.",
};

const hotelNashville = {
  name: "La Quinta Inn & Suites by Wyndham Nashville",
  address: "315 Interstate Dr, Nashville, TN",
  rating: "4.3★ (1,337 reviews)",
  note: "Just across the river from downtown via the pedestrian bridge — the usual spot. Dog-friendly.",
  fitness: "Fitness center and indoor pool on-site; the pedestrian bridge into downtown doubles as a solid walk or morning jog route.",
};

const coffeeAustin = [
  {
    name: "Summer Moon Coffee",
    address: "11005 Burnet Rd Ste 112, Austin, TX",
    rating: "4.6★ (1,880 reviews)",
    note: "Oak-fired coffee, North Austin — easy stop before you hit the highway.",
  },
  {
    name: "Epoch Coffee",
    address: "221 W North Loop Blvd, Austin, TX",
    rating: "4.5★ (2,450 reviews)",
    note: "Open 24/7 — good for an early start, big industrial space, lots of seating.",
  },
  {
    name: "Houndstooth Coffee",
    address: "4200 N Lamar Blvd, Austin, TX",
    rating: "4.2★ (729 reviews)",
    note: "Austin staple, strong cappuccinos.",
  },
];

const coffeeLittleRock = [
  {
    name: "Koffee With A Kause",
    address: "23233 I-30 Frontage Rd, Bryant, AR",
    rating: "4.7★ (218 reviews)",
    note: "Right on the I-30 frontage road — beloved independent roaster.",
  },
  {
    name: "Speakeasy Cafe",
    address: "3411 Main St #6, Bryant, AR",
    rating: "4.7★ (649 reviews)",
    note: "A few minutes from the hotel.",
  },
  {
    name: "La Monarca Café Y Mas",
    address: "612 Office Park Dr Suite 2, Bryant, AR",
    rating: "4.7★ (39 reviews)",
    note: "Small, well-reviewed local spot.",
  },
];

const coffeeNashville = [
  {
    name: "Crema Coffee Roasters",
    address: "15 Hermitage Ave, Nashville, TN",
    rating: "4.5★ (3,203 reviews)",
    note: "Zero-waste, carbon-neutral roaster in SoBro.",
  },
  {
    name: "Frothy Monkey Downtown",
    address: "235 Rep. John Lewis Way N, Nashville, TN",
    rating: "4.1★ (Tripadvisor)",
    note: "Voted Nashville's best coffee shop for 5+ years running — full breakfast menu too.",
  },
  {
    name: "Honest Coffee Roasters",
    address: "803 Lea Ave, Nashville, TN",
    rating: "4.3★ (151 reviews)",
    note: "Newest location — avocado toast and breakfast burritos if you want food too.",
  },
];

const wholeFoodsAustin = {
  name: "Whole Foods Market (Original Flagship)",
  address: "525 N Lamar Blvd, Austin, TX",
  note: "The original flagship store — stock up before you hit the road.",
};

const wholeFoodsLittleRock = {
  name: "Whole Foods Market",
  address: "501 S Bowman Rd, Little Rock, AR",
  note: "About 15 min from the Bryant hotel.",
};

const wholeFoodsNashville = {
  name: "Whole Foods Market (Green Hills)",
  address: "4021 Hillsboro Pike, Nashville, TN",
  note: "A short drive from the hotel before you head out.",
};

const wholeFoodsAkron = {
  name: "Whole Foods Market",
  address: "1745 W Market St, Akron, OH",
  note: "Closest location to Akron — good for stocking the kitchen once you arrive.",
};

const route = {
  tagline: "Skips Memphis — the long day shifts to Saturday with a stop in Louisville.",
  stops: [
    {
      day: "Fri",
      date: "Aug 14",
      route: "Austin → Dallas → Little Rock, AR",
      miles: "~490 mi",
      time: "~7.5 hrs",
      note: "Overnight Little Rock",
      hotels: [hotelLittleRock],
      coffee: coffeeAustin,
      wholeFoods: wholeFoodsAustin,
    },
    {
      day: "Sat",
      date: "Aug 15",
      route: "Little Rock → Nashville (bypass Memphis)",
      miles: "~350 mi",
      time: "~5.5 hrs",
      note: "More downtime in Nashville",
      hotels: [hotelNashville],
      coffee: coffeeLittleRock,
      wholeFoods: wholeFoodsLittleRock,
    },
    {
      day: "Sun",
      date: "Aug 16",
      route: "Nashville → Louisville (stop) → Cincinnati → Akron",
      miles: "~530 mi",
      time: "~8.5 hrs",
      note: "Louisville Slugger Museum or bourbon tasting",
      hotels: [],
      coffee: coffeeNashville,
      wholeFoods: wholeFoodsNashville,
    },
  ],
};
---

<Layout title="Ohio Trip" description="Private trip planning page.">
  <main class="page">
    <section class="hero reveal">
      <h1>Ohio Trip 🐾</h1>
      <p class="subhead">The Austin → Akron road trip plan, with hotels, coffee, and Whole Foods stops along the way.</p>
      <div class="date-pill">Departing Fri, Aug 14</div>
    </section>

    <section class="itinerary reveal">
      <h3>The route</h3>
      <p class="route-tagline">{route.tagline}</p>

      <ol class="timeline">
        {route.stops.map((stop) => (
          <li class="timeline-stop">
            <span class="timeline-day">{stop.day}</span>
            <div class="timeline-content">
              <details class="timeline-details" open>
                <summary>
                  <div class="timeline-summary-text">
                    <p class="timeline-route">{stop.route} <span class="timeline-date">· {stop.date}</span></p>
                    <p class="timeline-stats">{stop.miles} · {stop.time}</p>
                    <p class="timeline-note">{stop.note}</p>
                  </div>
                  <span class="timeline-chevron" aria-hidden="true">⌄</span>
                </summary>

                <div class="stop-details">
                  {stop.hotels.length > 0 && (
                    <div class="stop-block">
                      <p class="stop-block-label"><span aria-hidden="true">🛏️</span> Hotel</p>
                      <div class="hotel-list">
                        {stop.hotels.map((hotel) => (
                          <div class="hotel-card">
                            <p class="hotel-name">
                              <a href={mapsLink(hotel.name, hotel.address)} target="_blank" rel="noopener noreferrer">
                                {hotel.name} <span class="hotel-link-arrow">↗</span>
                              </a>
                            </p>
                            <p class="hotel-address">{hotel.address}</p>
                            <p class="hotel-rating">{hotel.rating}</p>
                            <p class="hotel-note">{hotel.note}</p>
                            <p class="hotel-fitness"><span aria-hidden="true">🧘</span> {hotel.fitness}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  <div class="stop-block">
                    <p class="stop-block-label"><span aria-hidden="true">☕</span> Coffee options</p>
                    <div class="mini-card-list">
                      {stop.coffee.map((cafe) => (
                        <div class="mini-card">
                          <p class="mini-card-name">
                            <a href={mapsLink(cafe.name, cafe.address)} target="_blank" rel="noopener noreferrer">
                              {cafe.name} <span class="hotel-link-arrow">↗</span>
                            </a>
                          </p>
                          <p class="mini-card-address">{cafe.address}</p>
                          <p class="mini-card-rating">{cafe.rating}</p>
                          <p class="mini-card-note">{cafe.note}</p>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="stop-block">
                    <p class="stop-block-label"><span aria-hidden="true">🛒</span> Whole Foods stop</p>
                    <div class="mini-card-list">
                      <div class="mini-card">
                        <p class="mini-card-name">
                          <a href={mapsLink(stop.wholeFoods.name, stop.wholeFoods.address)} target="_blank" rel="noopener noreferrer">
                            {stop.wholeFoods.name} <span class="hotel-link-arrow">↗</span>
                          </a>
                        </p>
                        <p class="mini-card-address">{stop.wholeFoods.address}</p>
                        <p class="mini-card-note">{stop.wholeFoods.note}</p>
                      </div>
                    </div>
                  </div>
                </div>
              </details>
            </div>
          </li>
        ))}
      </ol>

      <div class="stop-block arrival-block">
        <p class="stop-block-label"><span aria-hidden="true">🛒</span> After you arrive</p>
        <div class="mini-card-list">
          <div class="mini-card">
            <p class="mini-card-name">
              <a href={mapsLink(wholeFoodsAkron.name, wholeFoodsAkron.address)} target="_blank" rel="noopener noreferrer">
                {wholeFoodsAkron.name} <span class="hotel-link-arrow">↗</span>
              </a>
            </p>
            <p class="mini-card-address">{wholeFoodsAkron.address}</p>
            <p class="mini-card-note">{wholeFoodsAkron.note}</p>
          </div>
        </div>
      </div>
    </section>

    <details class="cost-accordion reveal">
      <summary class="cost-accordion-summary">
        <span>Driving vs. flying — cost comparison</span>
        <span class="timeline-chevron" aria-hidden="true">⌄</span>
      </summary>

      <div class="cost-accordion-body">
        <section class="scenarios">
          <div class="scenario-card drive-card">
            <div class="scenario-head">
              <span class="scenario-icon">🚗</span>
              <div>
                <h2>Road Trip</h2>
                <p class="scenario-meta">21 days · 2,722 mi round trip · dog rides along</p>
              </div>
            </div>

            <div class="cost-range">
              <span class="cost-figure">${drive.low.toLocaleString()}–${drive.high.toLocaleString()}</span>
              <div class="range-bar">
                <div
                  class="range-fill drive-fill"
                  data-left={(drive.low / maxCost) * 100}
                  data-width={((drive.high - drive.low) / maxCost) * 100}
                  style="width:0; left:0;"
                ></div>
              </div>
            </div>

            <ul class="cost-items">
              {drive.items.map((item) => (
                <li>
                  <div class="cost-item-row">
                    <span class="cost-item-label">{item.label}</span>
                    <span class="cost-item-value">
                      {item.low === item.high ? `$${item.low}` : `$${item.low}–${item.high}`}
                    </span>
                  </div>
                  <p class="cost-item-detail">{item.detail}</p>
                </li>
              ))}
            </ul>
          </div>

          <div class="vs-divider">
            <span>vs</span>
          </div>

          <div class="scenario-card fly-card">
            <div class="scenario-head">
              <span class="scenario-icon">✈️</span>
              <div>
                <h2>Fly + Board</h2>
                <p class="scenario-meta">8 days · AUS ↔ CLE · dog stays home</p>
              </div>
            </div>

            <div class="cost-range">
              <span class="cost-figure">${fly.low.toLocaleString()}–${fly.high.toLocaleString()}</span>
              <div class="range-bar">
                <div
                  class="range-fill fly-fill"
                  data-left={(fly.low / maxCost) * 100}
                  data-width={((fly.high - fly.low) / maxCost) * 100}
                  style="width:0; left:0;"
                ></div>
              </div>
            </div>

            <ul class="cost-items">
              {fly.items.map((item) => (
                <li>
                  <div class="cost-item-row">
                    <span class="cost-item-label">{item.label}</span>
                    <span class="cost-item-value">
                      {item.low === item.high ? `$${item.low}` : `$${item.low}–${item.high}`}
                    </span>
                  </div>
                  <p class="cost-item-detail">{item.detail}</p>
                </li>
              ))}
            </ul>

            <p class="flight-note">
              Preferred carriers were showing $280–380/person round trip for nearby dates when
              checked, padded up for mid-August peak pricing. Worth pulling actual AUS–CLE fares
              for the exact dates.
            </p>
          </div>
        </section>

        <section class="bottom-line">
          <h3>Bottom line</h3>
          <p>
            Driving comes out roughly <strong>$250–400 cheaper</strong> — but it's not apples to
            apples. The road trip is a <strong>21-day</strong> trip; flying is <strong>8 days</strong>.
            Shorten the road trip to match and driving looks even better on cost, but a bigger share
            of a short trip goes to the car.
          </p>
        </section>
      </div>
    </details>
  </main>

  <script>
    const revealTargets = document.querySelectorAll(".reveal");
    const fills = document.querySelectorAll(".range-fill");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const animateFills = () => {
      fills.forEach((el) => {
        const fill = el as HTMLElement;
        fill.style.left = `${fill.dataset.left}%`;
        fill.style.width = `${fill.dataset.width}%`;
      });
    };

    if (prefersReducedMotion) {
      revealTargets.forEach((el) => el.classList.add("in-view"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.2 }
      );
      revealTargets.forEach((el) => observer.observe(el));
    }

    const accordion = document.querySelector(".cost-accordion");
    if (accordion) {
      accordion.addEventListener(
        "toggle",
        () => {
          animateFills();
        },
        { once: true }
      );
    }
  </script>
</Layout>

<style>
  .page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 80px var(--page-padding) 160px;
  }

  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .hero {
    text-align: center;
    margin-bottom: 64px;
  }

  h1 {
    font-size: clamp(40px, 2rem + 3vw, 72px);
    font-weight: 400;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .subhead {
    font-size: 17px;
    color: var(--color-text-muted);
    max-width: 480px;
    margin: 0 auto 24px;
  }

  .date-pill {
    display: inline-flex;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 18px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
  }

  .itinerary {
    margin-bottom: 72px;
  }

  .itinerary h3 {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-align: center;
    margin-bottom: 8px;
  }

  .route-tagline {
    text-align: center;
    font-size: 14px;
    color: var(--color-text-muted);
    font-style: italic;
    max-width: var(--content-width);
    margin: 0 auto 36px;
  }

  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    max-width: var(--content-width);
    margin: 0 auto 32px;
  }

  .timeline-stop {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    position: relative;
    padding-bottom: 32px;
  }

  .timeline-stop:last-child {
    padding-bottom: 0;
  }

  .timeline-stop::before {
    content: "";
    position: absolute;
    left: 15px;
    top: 24px;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }

  .timeline-stop:last-child::before {
    display: none;
  }

  .timeline-day {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .timeline-content {
    min-width: 0;
  }

  .timeline-details {
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 0;
  }

  .timeline-details summary {
    list-style: none;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    padding: 12px 14px;
    margin: -12px -14px;
    border-radius: 14px;
    transition: background 0.2s ease;
  }

  .timeline-details summary::-webkit-details-marker {
    display: none;
  }

  .timeline-details summary:hover {
    background: var(--color-tag-bg);
  }

  .timeline-chevron {
    flex-shrink: 0;
    font-size: 16px;
    color: var(--color-text-muted);
    transition: transform 0.25s ease;
    margin-top: 2px;
  }

  .timeline-details[open] .timeline-chevron {
    transform: rotate(180deg);
  }

  .timeline-route {
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 3px;
  }

  .timeline-date {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .timeline-stats {
    font-size: 12.5px;
    color: var(--color-text-muted);
    margin-bottom: 3px;
  }

  .timeline-note {
    font-size: 12.5px;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .stop-details {
    padding: 8px 0 4px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .stop-block-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }

  .hotel-list,
  .mini-card-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hotel-card,
  .mini-card {
    background: var(--color-tag-bg);
    border-radius: 12px;
    padding: 14px 16px;
  }

  .hotel-name a,
  .mini-card-name a {
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s ease;
  }

  .hotel-name a:hover,
  .mini-card-name a:hover {
    text-decoration-color: var(--color-text);
  }

  .hotel-link-arrow {
    font-size: 11px;
  }

  .hotel-address,
  .mini-card-address {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-top: 2px;
    margin-bottom: 4px;
  }

  .hotel-rating,
  .mini-card-rating {
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .hotel-note,
  .mini-card-note {
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .hotel-fitness {
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px dashed var(--color-border);
  }

  .arrival-block {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .cost-accordion {
    max-width: var(--max-width);
    margin: 0 auto;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 8px;
  }

  .cost-accordion-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    padding: 20px 24px;
    font-size: 16px;
    font-weight: 500;
  }

  .cost-accordion-summary::-webkit-details-marker {
    display: none;
  }

  .cost-accordion[open] .timeline-chevron {
    transform: rotate(180deg);
  }

  .cost-accordion-body {
    padding: 8px 24px 32px;
  }

  .scenarios {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 32px;
    align-items: start;
    margin-bottom: 56px;
  }

  .scenario-card {
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .scenario-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -20px rgba(0, 0, 0, 0.25);
  }

  .drive-card {
    background: #f6f9f7;
  }

  .fly-card {
    background: #f6f7fb;
  }

  .scenario-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .scenario-icon {
    font-size: 32px;
    line-height: 1;
  }

  .scenario-head h2 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .scenario-meta {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .cost-range {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cost-figure {
    font-size: clamp(28px, 1.4rem + 1.6vw, 40px);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .range-bar {
    position: relative;
    height: 8px;
    background: var(--color-border);
    border-radius: 999px;
    overflow: hidden;
  }

  .range-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 999px;
    transition: left 1s cubic-bezier(0.22, 1, 0.36, 1), width 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .drive-fill {
    background: #2f6b4f;
  }

  .fly-fill {
    background: #3f4d8c;
  }

  .cost-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cost-item-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 15px;
    font-weight: 500;
  }

  .cost-item-value {
    font-variant-numeric: tabular-nums;
  }

  .cost-item-detail {
    font-size: 12.5px;
    color: var(--color-text-muted);
    margin-top: 3px;
