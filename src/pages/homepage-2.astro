---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Media from "../components/Media.astro";
import Button from "../components/ui/Button.astro";
import { getHomepageProjects } from "../data/projects";
import { typeHref } from "../data/work";

/*
  A test of the homepage on a visible four-column grid: the columns are drawn
  as hairlines down the work, and the projects are laid across them at
  different widths rather than in one even list. Same type, color, badges and
  tokens as the rest of the site. Kept at its own URL and out of search
  (noindex here, and the sitemap only lists an allowlist in astro.config.mjs).
*/

const projects = getHomepageProjects();

/*
  Where each project sits, repeating down the list: the column it starts in
  and how many of the four it spans, on desktop and then on phones. One
  project to a row, never narrower than two columns, so tiles never touch and
  the empty columns beside them read as chosen.
*/
type Slot = { col: number; span: number; mCol: number; mSpan: number };
const pattern: Slot[] = [
  { col: 1, span: 3, mCol: 1, mSpan: 4 },
  { col: 3, span: 2, mCol: 2, mSpan: 3 },
  { col: 2, span: 3, mCol: 1, mSpan: 3 },
  { col: 1, span: 2, mCol: 2, mSpan: 3 },
  { col: 3, span: 2, mCol: 1, mSpan: 3 },
];

/*
  A tile's right edge lands on a column line, and so does the line itself,
  one pixel to its right: two hairlines side by side. A tile that stops short
  of the grid's right edge reaches one pixel further so its edge covers the
  line instead. (The grid's last line sits inside the grid, so a tile that
  runs to the edge already matches it.) 1 = reach, 0 = don't.
*/
const reach = (col: number, span: number) => (col + span - 1 < 4 ? 1 : 0);
---

<Layout title="Homepage grid test | Ryan Sheridan" description="A test layout of the Ryan Sheridan portfolio homepage on a visible four-column grid." noindex>
  <Nav />
  <main id="main" class="grid-page" data-grid-page>
    {/* The live homepage's opening, held to the first two columns with the
        other two left open. Only the grid's outer edges run past it. */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="band-inner">
        <div class="cell hero-copy">
          <h1 id="hero-title" class="hero-title">
            Designing and<br />
            scaling systems, sites and&nbsp;brands.
          </h1>
          <p class="intro">Principal Designer at Commerce, leading design systems, websites, and AI&nbsp;workflows.</p>
          <div class="cta-row">
            <Button href="/work">View all work</Button>
          </div>
        </div>
      </div>
    </section>

    <section class="work" aria-label="Selected work">
      {/* The four columns, behind the work only. Decorative. */}
      <div class="grid-lines" aria-hidden="true"></div>
      <div class="band-inner work-grid">
        {projects.map((project, i) => {
          const slot = pattern[i % pattern.length];
          return (
            <article
              class="tile"
              style={`--row:${i + 1};--col:${slot.col};--span:${slot.span};--reach:${reach(slot.col, slot.span)};--m-col:${slot.mCol};--m-span:${slot.mSpan};--m-reach:${reach(slot.mCol, slot.mSpan)}`}
            >
              {/* Two cells, one card: the image in its box, and the caption
                  in a box of its own under it. Both are filled, so no
                  column line runs behind the words. */}
              <div class="tile-frame">
                <div class="tile-media">
                  {project.thumbnail && <Media src={project.thumbnail} alt={project.title} loading={i === 0 ? "eager" : "lazy"} />}
                </div>
              </div>
              <div class="tile-caption">
                <h3 class="tile-title">
                  <a href={`/work/${project.slug}`} class="tile-link">{project.title}</a>
                </h3>
                <div class="badge-list">
                  {project.tags.map((tag) => <a href={typeHref(tag)} class="badge">{tag}</a>)}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    {/* A short hello between the work and the closing, pointing on to the
        full About page. The copy is the About page's own opening. */}
    <section class="about" aria-labelledby="about-title">
      <div class="band-inner about-inner">
        <div class="about-photo">
          <div class="about-photo-frame">
            <Media src="/profile-photo.webp" alt="Ryan Sheridan" loading="lazy" />
          </div>
        </div>
        <div class="cell about-copy">
          <p class="overline" id="about-title">About</p>
          <p class="about-lede">
            I lead design systems and web experience at Commerce, the parent
            company of BigCommerce.
          </p>
          <p class="about-body">
            Over the past eight years, I’ve built and scaled brand systems,
            marketing sites, and design infrastructure across multiple brands.
            I like working in the space between design and engineering, and
            I’m based in Austin,&nbsp;Texas.
          </p>
          <a href="/about" class="about-link">More about me <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="band-inner">
        <div class="cell closing-copy">
          <h2 id="closing-title" class="closing-title">
            <span class="quiet">Have a system, site</span><br />
            or brand to build?
          </h2>
          <div class="cta-row">
            <Button href="/start-a-project" arrow="right">Start a project</Button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /*
    The grid: four equal columns, no gutters, inside the same width the nav
    and footer use, so every edge on the page lands on one of five lines.
    --cell-pad is the inset from those lines to the content in a cell.
  */
  .grid-page {
    --grid-w: min(var(--max-width), 100% - 2 * var(--page-padding));
    --cell-pad: calc(var(--space-1) * 3);
    --grid-line: var(--color-border);
    --hairline: var(--border-width) solid var(--grid-line);
  }

  /* On this page the nav always closes with a rule, and the footer sits
     straight under the closing section so its outer lines meet the
     footer's rule. */
  :global(nav:not(.footer-nav)) {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .grid-page + :global(footer) {
    margin-top: 0;
  }

  @media (max-width: 768px) {
    .grid-page {
      --cell-pad: var(--space-2);
    }
  }

  .band-inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: var(--grid-w);
    margin-inline: auto;
  }

  .cell {
    padding-inline: var(--cell-pad);
  }

  .quiet {
    color: var(--color-text-quiet);
  }

  /* ---------- Hero: the homepage's opening, in the first two columns ---------- */

  /* A rule under the opening, and only the grid's outer edges beside it,
     so no line runs through the copy. */
  .hero {
    border-bottom: var(--hairline);
  }

  .hero .band-inner {
    min-height: calc(100svh - var(--nav-height) - var(--space-8));
    align-items: center;
    padding-block: var(--space-8);
    border-inline: var(--hairline);
  }

  .hero-copy {
    grid-column: 1 / span 2;
  }

  .hero-title {
    font-size: var(--text-h1);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-text);
  }

  .intro {
    max-width: 44ch;
    margin-top: var(--space-4);
    font-size: var(--text-l);
    font-weight: var(--weight-light);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  /* ---------- Work ---------- */

  .work {
    position: relative;
    isolation: isolate;
  }

  .grid-lines {
    position: absolute;
    inset: 0 auto 0 50%;
    width: var(--grid-w);
    transform: translateX(-50%);
    z-index: -1;
    pointer-events: none;
    /* A line at the left of each column, plus the right edge of the last. */
    background: linear-gradient(to right, var(--grid-line) var(--border-width), transparent var(--border-width)) 0 0 / 25% 100% repeat-x;
    border-right: var(--hairline);
  }

  .work-grid {
    row-gap: var(--space-8);
    padding-block: var(--space-8);
  }

  .tile {
    position: relative;
    /* Its own row, always: left to auto-placement, two narrow tiles that
       fit side by side would be packed into one row and touch. */
    grid-row: var(--row);
    grid-column: var(--col) / span var(--span);
    /* See `reach` in the frontmatter: covers the column line at the
       tile's right edge rather than sitting beside it. */
    margin-right: calc(var(--reach) * -1 * var(--border-width));
  }

  /* The image's box. A full edge on every side: the sides sit on column
     lines, and drawing them here keeps them where the box's fill would
     cover the line. */
  .tile-frame {
    padding: var(--cell-pad);
    background: var(--color-bg);
    border: var(--hairline);
  }

  .tile-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface);
  }

  .tile-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  @media (hover: hover) {
    .tile:hover .tile-media :global(img) {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-media :global(img) {
      transition: none;
    }
  }

  /* The caption's own box, sharing the image box's bottom edge. */
  .tile-caption {
    padding: var(--space-3) var(--cell-pad);
    background: var(--color-bg);
    border: var(--hairline);
    border-top: 0;
  }

  .tile-title {
    font-size: var(--text-h5);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-3);
  }

  /* The title link covers the whole tile, so the image is a click target
     too; the type badges sit above it as links of their own. */
  .tile-link {
    color: var(--color-text);
  }

  .tile-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .badge-list {
    position: relative;
  }

  .tile-link:focus-visible {
    outline: none;
  }

  .tile-link:focus-visible::after {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  /* ---------- About: photo in the first column, words in the next two ---------- */

  .about {
    border-top: var(--hairline);
  }

  .about-inner {
    align-items: center;
    padding-block: var(--space-8);
    border-inline: var(--hairline);
  }

  .about-photo {
    grid-column: 1 / span 1;
    padding-inline: var(--cell-pad);
  }

  .about-photo-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }

  .about-photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-copy {
    grid-column: 2 / span 2;
    padding-left: var(--space-5);
  }

  .overline {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .about-lede {
    font-size: var(--text-h4);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    color: var(--color-text);
  }

  .about-body {
    max-width: 52ch;
    margin-top: var(--space-3);
    font-size: var(--text-m);
    font-weight: var(--weight-light);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .about-link {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--text-s);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 4px;
  }

  .about-link:hover {
    text-decoration-color: var(--color-text);
  }

  /* ---------- Closing ---------- */

  .closing {
    border-top: var(--hairline);
  }

  /* Only the outer two lines here, running down to the footer's rule. */
  .closing .band-inner {
    padding-block: var(--space-8) calc(var(--space-8) + var(--space-5));
    border-inline: var(--hairline);
  }

  .closing-copy {
    grid-column: 1 / span 2;
  }

  .closing-title {
    font-size: var(--text-h2);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  /* ---------- Tablet: the opening and closing take three columns ---------- */

  @media (max-width: 1024px) {
    .hero .band-inner {
      min-height: 0;
    }

    .hero-copy,
    .closing-copy {
      grid-column: 1 / span 3;
    }

    .about-copy {
      grid-column: 2 / span 3;
    }
  }

  /* ---------- Phones: still four columns, tiles take their phone spans ---------- */

  @media (max-width: 768px) {
    .hero .band-inner {
      padding-block: var(--space-7);
    }

    .hero-copy,
    .closing-copy {
      grid-column: 1 / -1;
    }

    .work-grid {
      row-gap: var(--space-7);
      padding-block: var(--space-7);
    }

    .tile {
      grid-column: var(--m-col) / span var(--m-span);
      margin-right: calc(var(--m-reach) * -1 * var(--border-width));
    }

    .tile-title {
      font-size: var(--text-l);
    }

    /* The photo takes two columns and the words go under it. */
    .about-inner {
      row-gap: var(--space-5);
      padding-block: var(--space-7);
    }

    .about-photo {
      grid-column: 1 / span 2;
    }

    .about-copy {
      grid-column: 1 / -1;
      padding-left: var(--cell-pad);
    }

    .about-lede {
      font-size: var(--text-h5);
    }

    .closing .band-inner {
      padding-block: var(--space-7) calc(var(--space-7) + var(--space-4));
    }
  }
</style>
