---
/**
 * Layout option B for /all: a thumbnail grid. Three across on desktop, two
 * on tablet, one on a phone. Each card is the image, the title, and a
 * single meta line, so the work is recognised by picture first. Private,
 * noindex.
 */
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import { allWorkProjects } from "../../data/work";

const drafts = allWorkProjects.filter((p) => p.draft).length;
---

<Layout title="All projects — Ryan Sheridan" noindex>
  <Nav />
  <main id="main" class="grid-page">
    <div class="inner">
      <header class="head">
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "All projects" }]} />
        <h1>All projects</h1>
        <p class="count">{allWorkProjects.length} projects · {allWorkProjects.length - drafts} live · {drafts} draft</p>
      </header>

      <ul class="cards">
        {allWorkProjects.map((p) => (
          <li class="card">
            <a href={`/work/${p.slug}`} class="card-link">
              <div class="thumb">
                {p.thumbnail && <Media src={p.thumbnail} alt="" />}
                {p.draft && <span class="badge badge-draft">Draft</span>}
              </div>
              <h2 class="title">{p.title}</h2>
              <p class="meta">{p.client} · {p.year} · {p.tags[0]}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .grid-page { padding: var(--page-top) var(--page-padding) 0; }
  .inner { max-width: var(--max-width); margin: 0 auto; padding-bottom: 80px; }
  .head { margin-bottom: var(--space-6); }
  h1 {
    font-size: var(--text-h2); font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight); line-height: var(--leading-tight); margin: 0;
  }
  .count { margin: var(--space-2) 0 0; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-muted); }

  .cards {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7) var(--space-5);
  }
  .card-link { display: block; color: var(--color-text); text-decoration: none; }
  .card-link:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-offset); }
  .thumb {
    position: relative; aspect-ratio: 16 / 10; overflow: hidden;
    background: var(--color-surface);
  }
  .thumb :global(img), .thumb :global(picture), .thumb :global(object) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform var(--duration-slow) var(--ease-standard);
  }
  .card-link:hover .thumb :global(img) { transform: scale(1.03); }
  .badge-draft {
    position: absolute; top: var(--space-3); left: var(--space-3);
    background: var(--color-bg); border-style: dashed;
  }
  .title {
    margin: var(--space-3) 0 0; font-size: var(--text-m); font-weight: var(--weight-regular);
    line-height: var(--leading-snug);
  }
  .meta { margin: var(--space-1) 0 0; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-muted); }

  @media (max-width: 960px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .cards { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); } }
</style>
