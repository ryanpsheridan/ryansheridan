---
/**
 * Layout option C for /all: a large type index with a hover preview. Titles
 * run down the right in big text with client and year beside them; the left
 * column holds a sticky image that swaps to whichever project the pointer or
 * keyboard focus is on. On touch screens each row shows a small thumbnail
 * instead. Private, noindex.
 */
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import { allWorkProjects } from "../../data/work";

const drafts = allWorkProjects.filter((p) => p.draft).length;
---

<Layout title="All projects — Ryan Sheridan" noindex>
  <Nav />
  <main id="main" class="preview-page">
    <div class="inner">
      <header class="head">
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "All projects" }]} />
        <h1>All projects</h1>
        <p class="count">{allWorkProjects.length} projects · {allWorkProjects.length - drafts} live · {drafts} draft</p>
      </header>

      <div class="split">
        <div class="stage" aria-hidden="true">
          <div class="stage-inner">
            {allWorkProjects.map((p, i) => (
              <div class:list={["frame", i === 0 && "is-active"]} data-frame={i}>
                {p.thumbnail && <Media src={p.thumbnail} alt="" loading={i === 0 ? "eager" : "lazy"} />}
              </div>
            ))}
          </div>
        </div>

        <ol class="index">
          {allWorkProjects.map((p, i) => (
            <li>
              <a href={`/work/${p.slug}`} class:list={["row", i === 0 && "is-active"]} data-row={i}>
                <span class="row-thumb" aria-hidden="true">{p.thumbnail && <Media src={p.thumbnail} alt="" />}</span>
                <span class="row-main">
                  <span class="title">{p.title}</span>
                  <span class="meta">
                    {p.client} · {p.year}
                    {p.draft && <span class="badge badge-draft">Draft</span>}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .preview-page { padding: var(--page-top) var(--page-padding) 0; }
  .inner { max-width: var(--max-width); margin: 0 auto; padding-bottom: 80px; }
  .head { margin-bottom: var(--space-6); }
  h1 {
    font-size: var(--text-h2); font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight); line-height: var(--leading-tight); margin: 0;
  }
  .count { margin: var(--space-2) 0 0; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-muted); }

  .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-7); align-items: start; }
  .stage { position: sticky; top: calc(var(--nav-height) + var(--space-5)); }
  .stage-inner { position: relative; aspect-ratio: 16 / 11; background: var(--color-surface); overflow: hidden; }
  .frame {
    position: absolute; inset: 0; opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }
  .frame.is-active { opacity: 1; }
  .frame :global(img), .frame :global(object) { width: 100%; height: 100%; object-fit: cover; display: block; }

  .index { list-style: none; margin: 0; padding: 0; border-top: var(--border-width) solid var(--color-border); }
  .row {
    display: flex; gap: var(--space-4); align-items: center;
    padding: var(--space-4) 0; border-bottom: var(--border-width) solid var(--color-border);
    color: var(--color-text-quiet, var(--color-text-muted)); text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .row.is-active, .row:hover, .row:focus-visible { color: var(--color-text); }
  .row:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: 2px; }
  .row-main { display: flex; flex: 1; min-width: 0; justify-content: space-between; align-items: baseline; gap: var(--space-4); flex-wrap: wrap; }
  .title { font-size: var(--text-h5); font-weight: var(--weight-light); letter-spacing: var(--tracking-snug); line-height: var(--leading-tight); }
  .meta { display: inline-flex; gap: var(--space-2); align-items: center; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-muted); white-space: nowrap; }
  .badge-draft { border-style: dashed; height: 20px; padding: 0 8px; }
  .row-thumb { display: none; }

  @media (hover: none), (max-width: 760px) {
    .split { grid-template-columns: minmax(0, 1fr); }
    .stage { display: none; }
    .row { color: var(--color-text); }
    .row-thumb { display: block; flex: 0 0 88px; aspect-ratio: 16 / 11; overflow: hidden; background: var(--color-surface); }
    .row-thumb :global(img), .row-thumb :global(object) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .row-main { flex-direction: column; gap: var(--space-1); }
    .title { font-size: var(--text-m); font-weight: var(--weight-regular); }
    .meta { white-space: normal; flex-wrap: wrap; }
    .row-main { align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .frame { transition: none; } }
</style>

<script>
  const rows = [...document.querySelectorAll<HTMLElement>("[data-row]")];
  const frames = [...document.querySelectorAll<HTMLElement>("[data-frame]")];
  const show = (i: string) => {
    rows.forEach((r) => r.classList.toggle("is-active", r.dataset.row === i));
    frames.forEach((f) => f.classList.toggle("is-active", f.dataset.frame === i));
  };
  rows.forEach((r) => {
    r.addEventListener("pointerenter", () => show(r.dataset.row!));
    r.addEventListener("focus", () => show(r.dataset.row!));
  });
</script>
