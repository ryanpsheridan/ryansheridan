---
/**
 * Option D for /work: a gallery. Two columns of large frames with a two-line
 * caption each, and nothing else. The right column starts lower and slowly
 * catches up as you scroll, settling level with the left by the end.
 */
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Media from "../../components/Media.astro";
import WorkHeader from "../../components/work/WorkHeader.astro";
import { workProjects } from "../../data/work";
---

<Layout title="Work — Ryan Sheridan" description="Case studies by Ryan Sheridan." noindex>
  <Nav />
  <main id="main" class="work-page">
    <div class="work-inner">
      <WorkHeader />

      <ul class="gallery" data-gallery>
        {
          workProjects.map((project) => (
            <li class="gallery-item" data-tags={project.tags.join("|")}>
              <a href={`/work/${project.slug}`} class="gallery-link">
                <span class="gallery-frame">
                  {project.thumbnail && <Media src={project.thumbnail} alt="" />}
                </span>
                <span class="gallery-caption">
                  <span class="gallery-title">{project.title}</span>
                  <span class="gallery-year"><time datetime={String(project.year)}>{project.year}</time></span>
                </span>
                <span class="gallery-type">{project.tags.join(", ")}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: var(--page-top) var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-bottom: var(--space-8);
  }

  /* --offset is how far the right column starts below the left. --shift
     runs from 0 to --offset as the gallery scrolls past, so the columns meet
     at the bottom. The bottom padding holds the room the offset needs. */
  .gallery {
    --offset: 160px;
    --shift: 0px;
    list-style: none;
    margin: 0;
    padding: 0 0 var(--offset);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-7);
  }

  .gallery-item[hidden] {
    display: none;
  }

  .gallery-item:nth-child(even of :not([hidden])) {
    transform: translateY(calc(var(--offset) - var(--shift)));
  }

  .gallery-link {
    display: block;
    color: var(--color-text);
    text-decoration: none;
  }

  .gallery-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 8px;
  }

  .gallery-frame {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: var(--space-4);
    background: var(--color-surface);
  }

  .gallery-frame :global(img),
  .gallery-frame :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .gallery-caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .gallery-title {
    font-size: var(--text-h5);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }

  .gallery-year,
  .gallery-type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .gallery-year {
    font-variant-numeric: tabular-nums;
  }

  .gallery-type {
    display: block;
    margin-top: var(--space-1);
  }

  @media (hover: hover) {
    .gallery-link:hover .gallery-frame :global(img),
    .gallery-link:hover .gallery-frame :global(video) {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-frame :global(img),
    .gallery-frame :global(video) {
      transition: none;
    }
  }

  /* Tablet: same two columns, closer together, smaller stagger. */
  @media (max-width: 1024px) {
    .gallery {
      --offset: 96px;
      gap: var(--space-7) var(--space-5);
    }
  }

  /* Phone: one column, no stagger. */
  @media (max-width: 640px) {
    .gallery {
      --offset: 0px;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7);
    }
  }
</style>

<script>
  import { initWorkFilter } from "../../scripts/work-filter";

  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  const items = [...document.querySelectorAll<HTMLElement>(".gallery-item")];
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // How far through the gallery the reader is, from its top entering the
  // screen to its bottom leaving, sets how much of the offset is closed.
  function update() {
    if (!gallery) return;
    if (reduceMotion.matches) {
      gallery.style.setProperty("--shift", "0px");
      return;
    }
    const offset = parseFloat(getComputedStyle(gallery).getPropertyValue("--offset")) || 0;
    const rect = gallery.getBoundingClientRect();
    const vh = window.innerHeight;
    const progress = Math.min(1, Math.max(0, (vh - rect.top) / (rect.height + vh * 0.5)));
    gallery.style.setProperty("--shift", `${(offset * progress).toFixed(1)}px`);
  }

  let ticking = false;
  const schedule = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      update();
    });
  };
  window.addEventListener("scroll", schedule, { passive: true });
  window.addEventListener("resize", schedule);
  update();

  initWorkFilter(items, update);
</script>
