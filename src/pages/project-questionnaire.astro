---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const FORMSPREE_ENDPOINT = "https://formspree.io/f/mvzennjv";
---

<Layout
  title="Website Questionnaire — Ryan Sheridan"
  description="A short intake form for prospective clients starting a new website project."
>
  <Nav />
  <main class="questions-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="current">Website Questionnaire</span>
    </nav>

    <div class="questions-hero">
      <h1>Let's scope your website.</h1>
      <p class="intro">
        This questionnaire is for new website projects specifically. Answer
        what you can below — it helps me understand your business and get you
        an accurate plan and timeline faster than a back-and-forth over
        email. Not sure about something? Take your best guess or skip it.
      </p>
    </div>

    <div class="form-progress">
      <p class="form-progress-label">Let's get started</p>
      <div class="form-progress-bar">
        <div class="form-progress-fill"></div>
      </div>
    </div>

    <form
      id="questions-form"
      class="questions-form"
      action={FORMSPREE_ENDPOINT}
      method="POST"
    >
      <div class="honeypot-field" aria-hidden="true">
        <label for="hp-field">Leave this field blank</label>
        <input type="text" id="hp-field" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>

      <div class="field">
        <label for="reply-email">Your email <span class="required-marker">*</span></label>
        <input type="email" id="reply-email" name="_replyto" required />
      </div>

      <section class="form-section">
        <h2>About your business</h2>

        <div class="field">
          <label for="business-name">Business / organization name (can change later)</label>
          <input type="text" id="business-name" name="Business name" />
        </div>

        <div class="field">
          <label for="business-description">Description of what you do</label>
          <textarea id="business-description" name="Business description" rows="4"></textarea>
        </div>

        <fieldset class="field">
          <legend>Who's your target customer / audience?</legend>
          <p class="field-note">Not sure yet? Pick what feels closest — you can always refine it later.</p>
          <div class="checkbox-group">
            <label class="checkbox-label">
              <input type="checkbox" name="Target audience" value="General public" />
              General public
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Target audience" value="Local community" />
              Local community
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Target audience" value="Businesses (B2B)" />
              Businesses (B2B)
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Target audience" value="Young professionals" />
              Young professionals
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Target audience" value="Families" />
              Families
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Target audience" value="Enthusiasts / hobbyists" />
              Enthusiasts / hobbyists
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Target audience" value="Not sure yet" />
              Not sure yet
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Target audience" value="Other" />
              Other
            </label>
          </div>
          <div class="field field-nested">
            <label for="audience-other">Other</label>
            <input type="text" id="audience-other" name="Other audience" />
          </div>
        </fieldset>

        <fieldset class="field">
          <legend>Do you have existing branding? (logo, colors, fonts)</legend>
          <div class="radio-group">
            <label class="radio-label">
              <input type="radio" name="Existing branding" value="Yes" />
              Yes
            </label>
            <label class="radio-label">
              <input type="radio" name="Existing branding" value="No" />
              No
            </label>
          </div>
          <div class="field field-nested" id="branding-details-wrap" hidden>
            <label for="branding-details">Tell me a bit about it — colors, fonts, links to your logo or brand files, anything that helps.</label>
            <textarea id="branding-details" name="Branding details" rows="3"></textarea>
            <p class="field-note">You don't need to upload files here — email the assets separately if it's easier.</p>
          </div>

          <div class="field field-nested" id="branding-help-wrap" hidden>
            <fieldset class="field">
              <legend>Would you like help creating branding?</legend>
              <div class="radio-group">
                <label class="radio-label">
                  <input type="radio" name="Branding help needed" value="Yes" />
                  Yes
                </label>
                <label class="radio-label">
                  <input type="radio" name="Branding help needed" value="No" />
                  No
                </label>
              </div>
            </fieldset>
            <div class="field field-nested">
              <label for="branding-vision">Optional — describe the look/feel you're going for (colors, style, vibe, examples)</label>
              <textarea id="branding-vision" name="Branding vision" rows="3"></textarea>
            </div>
          </div>
        </fieldset>

        <div class="field">
          <label for="reference-sites">Any reference sites you like the look of?</label>
          <p class="field-note">
            This is one of the most useful things you can share — a couple of URLs
            (even just for a color palette, layout, or typography you like) helps
            me understand your taste much faster than a description alone.
          </p>
          <textarea
            id="reference-sites"
            name="Reference sites"
            rows="4"
            placeholder="e.g. https://example.com — love the typography and how clean it feels&#10;https://another-example.com — love this color palette"
          ></textarea>
        </div>
      </section>

      <section class="form-section">
        <h2>Pages you'll need</h2>

        <fieldset class="field">
          <legend>Which pages do you need?</legend>
          <div class="checkbox-group">
            <label class="checkbox-label">
              <input type="checkbox" name="Pages needed" value="Home" />
              Home
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Pages needed" value="About" />
              About
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Pages needed" value="Services" />
              Services
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Pages needed" value="Contact" />
              Contact
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Pages needed" value="Gallery" />
              Gallery
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Pages needed" value="Blog" />
              Blog
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="Pages needed" value="Other" />
              Other
            </label>
          </div>
          <div class="field field-nested">
            <label for="pages-other">Other page(s)</label>
            <input type="text" id="pages-other" name="Other pages" />
          </div>
        </fieldset>
      </section>

      <section class="form-section">
        <h2>Site functionality</h2>

        <div class="subsection">
          <h3>Contact form</h3>

          <fieldset class="field">
            <legend>Do you need a contact form on your site?</legend>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" name="Contact form needed" value="Yes" />
                Yes
              </label>
              <label class="radio-label">
                <input type="radio" name="Contact form needed" value="No" />
                No
              </label>
            </div>
          </fieldset>

          <fieldset class="field field-nested" id="inquiry-volume-wrap" hidden>
            <legend>Expected inquiry volume</legend>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" name="Inquiry volume" value="Low" />
                Low
              </label>
              <label class="radio-label">
                <input type="radio" name="Inquiry volume" value="Medium" />
                Medium
              </label>
              <label class="radio-label">
                <input type="radio" name="Inquiry volume" value="High" />
                High
              </label>
            </div>
          </fieldset>
        </div>

        <div class="subsection">
          <h3>Scheduling</h3>

          <fieldset class="field">
            <legend>Do people need to book appointments/calls with you?</legend>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" name="Booking needed" value="Yes" />
                Yes
              </label>
              <label class="radio-label">
                <input type="radio" name="Booking needed" value="No" />
                No
              </label>
            </div>
          </fieldset>

          <div class="field field-nested" id="booking-tool-wrap" hidden>
            <label for="booking-tool">Do you already use Calendly, Cal.com, or something else?</label>
            <input type="text" id="booking-tool" name="Booking tool" />
          </div>
        </div>

        <div class="subsection">
          <h3>Payments</h3>

          <fieldset class="field">
            <legend>Will the site need to take payments?</legend>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" name="Payments needed" value="Yes" />
                Yes
              </label>
              <label class="radio-label">
                <input type="radio" name="Payments needed" value="No" />
                No
              </label>
            </div>
          </fieldset>

          <div id="payment-details-wrap" hidden>
            <fieldset class="field">
              <legend>One-time payments or recurring/subscriptions?</legend>
              <div class="radio-group">
                <label class="radio-label">
                  <input type="radio" name="Payment type" value="One-time" />
                  One-time
                </label>
                <label class="radio-label">
                  <input type="radio" name="Payment type" value="Recurring / subscriptions" />
                  Recurring / subscriptions
                </label>
              </div>
            </fieldset>

            <fieldset class="field">
              <legend>Existing preference</legend>
              <div class="radio-group">
                <label class="radio-label">
                  <input type="radio" name="Payment preference" value="Stripe" />
                  Stripe
                </label>
                <label class="radio-label">
                  <input type="radio" name="Payment preference" value="PayPal" />
                  PayPal
                </label>
                <label class="radio-label">
                  <input type="radio" name="Payment preference" value="No preference" />
                  No preference
                </label>
              </div>
            </fieldset>
          </div>
        </div>
      </section>

      <section class="form-section">
        <h2>Photos &amp; content</h2>

        <div class="subsection" id="gallery-frequency-wrap" hidden>
          <fieldset class="field">
            <legend>How often do you expect to add new photos?</legend>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" name="Photo update frequency" value="Rarely" />
                Rarely
              </label>
              <label class="radio-label">
                <input type="radio" name="Photo update frequency" value="Occasionally" />
                Occasionally
              </label>
              <label class="radio-label">
                <input type="radio" name="Photo update frequency" value="Frequently" />
                Frequently
              </label>
            </div>
          </fieldset>
        </div>

        <div class="subsection">
          <h3>Ongoing content</h3>
          <div class="field">
            <label for="ongoing-content">Once the site is live, do you expect to want to add photos and edit content yourself, or would you rather I handle updates going forward?</label>
            <textarea id="ongoing-content" name="Ongoing content" rows="3"></textarea>
          </div>
        </div>
      </section>

      <section class="form-section">
        <h2>Wrapping up</h2>

        <fieldset class="field">
          <legend>Do you already own a domain for this?</legend>
          <div class="radio-group">
            <label class="radio-label">
              <input type="radio" name="Domain owned" value="Yes" />
              Yes
            </label>
            <label class="radio-label">
              <input type="radio" name="Domain owned" value="No" />
              No
            </label>
          </div>
        </fieldset>

        <div class="field field-nested" id="domain-ideas-wrap" hidden>
          <label for="domain-ideas">Any domain name ideas, or should I help find one?</label>
          <textarea id="domain-ideas" name="Domain ideas" rows="2"></textarea>
        </div>

        <div class="field">
          <label for="timeline">When would you like this live by?</label>
          <input type="text" id="timeline" name="Timeline" />
        </div>

        <div class="field">
          <label for="anything-else">Want to just rant randomly?</label>
          <p class="field-note">Go ahead — tell me anything else about the project. I'll ask any other questions later.</p>
          <textarea id="anything-else" name="Anything else" rows="5"></textarea>
        </div>
      </section>

      <button type="submit" class="submit-button">
        Submit <span class="arrow">&nearr;</span>
      </button>
      <p class="submit-status" role="status" aria-live="polite"></p>
    </form>

    <div class="thank-you" hidden>
      <h1>Thanks!</h1>
      <p class="intro">I'll review this and follow up within 2 business days.</p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById("questions-form") as HTMLFormElement | null;
  const status = document.querySelector(".submit-status");
  const thankYou = document.querySelector(".thank-you");
  const formLoadTime = Date.now();
  const MIN_FILL_TIME_MS = 3000;

  const brandingDetails = document.getElementById("branding-details-wrap");
  const brandingHelp = document.getElementById("branding-help-wrap");
  document.querySelectorAll<HTMLInputElement>('input[name="Existing branding"]').forEach((radio) => {
    radio.addEventListener("change", () => {
      brandingDetails?.toggleAttribute("hidden", radio.value !== "Yes");
      brandingHelp?.toggleAttribute("hidden", radio.value !== "No");
    });
  });

  const paymentDetails = document.getElementById("payment-details-wrap");
  document.querySelectorAll<HTMLInputElement>('input[name="Payments needed"]').forEach((radio) => {
    radio.addEventListener("change", () => {
      paymentDetails?.toggleAttribute("hidden", radio.value !== "Yes");
    });
  });

  const galleryFrequency = document.getElementById("gallery-frequency-wrap");
  const galleryCheckbox = document.querySelector<HTMLInputElement>('input[name="Pages needed"][value="Gallery"]');
  galleryCheckbox?.addEventListener("change", () => {
    galleryFrequency?.toggleAttribute("hidden", !galleryCheckbox.checked);
  });

  const inquiryVolume = document.getElementById("inquiry-volume-wrap");
  document.querySelectorAll<HTMLInputElement>('input[name="Contact form needed"]').forEach((radio) => {
    radio.addEventListener("change", () => {
      inquiryVolume?.toggleAttribute("hidden", radio.value !== "Yes");
    });
  });

  const bookingTool = document.getElementById("booking-tool-wrap");
  document.querySelectorAll<HTMLInputElement>('input[name="Booking needed"]').forEach((radio) => {
    radio.addEventListener("change", () => {
      bookingTool?.toggleAttribute("hidden", radio.value !== "Yes");
    });
  });

  const domainIdeas = document.getElementById("domain-ideas-wrap");
  document.querySelectorAll<HTMLInputElement>('input[name="Domain owned"]').forEach((radio) => {
    radio.addEventListener("change", () => {
      domainIdeas?.toggleAttribute("hidden", radio.value !== "No");
    });
  });

  form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[type="text"], input[type="email"], textarea').forEach((field) => {
    const syncFilled = () => field.classList.toggle("is-filled", field.value.trim().length > 0);
    syncFilled();
    field.addEventListener("input", syncFilled);
  });

  const otherFieldIds = ["audience-other", "pages-other"];
  otherFieldIds.forEach((inputId) => {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    const checkbox = input
      ?.closest("fieldset")
      ?.querySelector<HTMLInputElement>('input[type="checkbox"][value="Other"]');
    input?.addEventListener("input", () => {
      if (input.value.trim() && checkbox) checkbox.checked = true;
    });
  });

  const progressLabel = document.querySelector(".form-progress-label");
  const progressFill = document.querySelector<HTMLElement>(".form-progress-fill");
  const progressMessages = [
    { at: 0, text: "Let's get started" },
    { at: 20, text: "Nice, off to a good start" },
    { at: 40, text: "Making good progress" },
    { at: 60, text: "More than halfway there" },
    { at: 80, text: "Almost done" },
    { at: 98, text: "So close — just wrapping up" },
  ];

  function updateFormProgress() {
    if (!form) return;
    const rect = form.getBoundingClientRect();
    const scrollable = form.offsetHeight - window.innerHeight;
    const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(scrollable, 0));
    const percent = scrollable > 0 ? Math.round((scrolled / scrollable) * 100) : 0;
    if (progressFill) progressFill.style.width = `${percent}%`;
    if (progressLabel) {
      const message = [...progressMessages].reverse().find((m) => percent >= m.at);
      progressLabel.textContent = message?.text ?? progressMessages[0].text;
    }
  }

  let progressTicking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (progressTicking) return;
      progressTicking = true;
      requestAnimationFrame(() => {
        updateFormProgress();
        progressTicking = false;
      });
    },
    { passive: true }
  );
  updateFormProgress();

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const honeypot = form.querySelector<HTMLInputElement>('input[name="_gotcha"]');
    const filledTooFast = Date.now() - formLoadTime < MIN_FILL_TIME_MS;
    if ((honeypot && honeypot.value.trim() !== "") || filledTooFast) {
      // Likely a bot: pretend it worked without actually submitting.
      form.hidden = true;
      thankYou?.removeAttribute("hidden");
      return;
    }

    const submitButton = form.querySelector<HTMLButtonElement>(".submit-button");
    if (submitButton) submitButton.disabled = true;
    if (status) status.textContent = "Sending…";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        form.hidden = true;
        thankYou?.removeAttribute("hidden");
        if (progressLabel) progressLabel.textContent = "All done!";
        if (progressFill) progressFill.style.width = "100%";
      } else {
        const data = await response.json().catch(() => null);
        const serverMessage = data?.errors?.map((e: { message: string }) => e.message).join(", ") ?? data?.error;
        console.error("Formspree submission failed", response.status, data);
        if (status) {
          status.textContent = serverMessage
            ? `Something went wrong: ${serverMessage}`
            : "Something went wrong — please try again or email me directly.";
        }
        if (submitButton) submitButton.disabled = false;
      }
    } catch (err) {
      console.error("Formspree submission error", err);
      if (status) status.textContent = "Something went wrong — please try again or email me directly.";
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>

<style>
  .questions-page {
    padding: 80px var(--page-padding) 160px;
  }

  .breadcrumbs {
    max-width: var(--content-width);
    margin: 0 auto 48px;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--color-text);
  }

  .breadcrumbs .sep {
    color: var(--color-border);
  }

  .breadcrumbs .current {
    color: var(--color-text);
  }

  .questions-hero,
  .questions-form,
  .thank-you,
  .form-progress {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  h1 {
    font-size: clamp(32px, 1.7rem + 1.2vw, 52px);
    font-weight: 400;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }

  .intro {
    font-size: 16px;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .questions-hero {
    margin-bottom: var(--space-8);
  }

  .form-progress {
    position: sticky;
    top: 68px;
    z-index: 100;
    background: var(--color-bg);
    padding: var(--space-3) 0;
    margin-bottom: var(--space-6);
  }

  .form-progress-label {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .form-progress-bar {
    height: 4px;
    border-radius: 999px;
    background: var(--color-border);
    overflow: hidden;
  }

  .form-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--color-text);
    border-radius: 999px;
    transition: width 0.15s ease-out;
  }

  .form-section {
    margin-top: var(--space-7);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border);
  }

  .form-section:first-of-type {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .form-section h2 {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-5);
  }

  .subsection {
    margin-top: var(--space-6);
  }

  .subsection:first-child {
    margin-top: 0;
  }

  .subsection h3 {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .field {
    margin-bottom: var(--space-5);
  }

  .field:last-child {
    margin-bottom: 0;
  }

  .field-nested {
    margin-top: var(--space-3);
    margin-bottom: 0;
  }

  fieldset.field {
    border: none;
    padding: 0;
  }

  label,
  legend {
    display: block;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .field-note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
    line-height: 1.6;
  }

  input[type="text"],
  input[type="email"],
  textarea {
    width: 100%;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 12px 14px;
    transition: border-color 0.2s;
  }

  textarea {
    resize: vertical;
    line-height: 1.6;
  }

  input[type="text"]:focus-visible,
  input[type="email"]:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
    border-color: var(--color-text);
  }

  input[type="text"].is-filled,
  input[type="email"].is-filled,
  textarea.is-filled {
    border-color: var(--color-text-muted);
  }

  input.is-filled:user-invalid,
  input:user-invalid {
    border-color: #c0392b;
  }

  .required-marker {
    color: var(--color-text-muted);
  }

  .honeypot-field {
    position: absolute;
    left: -9999px;
    top: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .radio-group,
  .checkbox-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .radio-label,
  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-text);
    margin-bottom: 0;
    cursor: pointer;
  }

  input[type="radio"],
  input[type="checkbox"] {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    accent-color: var(--color-text);
  }

  input[type="radio"]:focus-visible,
  input[type="checkbox"]:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .submit-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
