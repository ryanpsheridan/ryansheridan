---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CursorField from "../components/CursorField.astro";
---

<Layout
  title="Cursor Field — Ryan Sheridan"
  description="Cursor-reactive grid patterns."
  noindex
>
  <Nav />
  <main class="dot-grid-page">
    <header class="page-head">
      <h1>Cursor-reactive dot grid</h1>
      <p class="intro">
        Dots sit on a fixed grid and respond to pointer proximity, growing and
        darkening as the cursor approaches. The highlight eases behind the
        cursor rather than tracking it exactly, which is what gives the pattern
        its weight. Move your cursor across each panel.
      </p>
      <p class="intro note">
        The dots top out at #d8d8d8, light enough that text layered on top
        keeps its contrast: 13.3:1 for body text and 3.0:1 for muted text even
        when a character lands directly on a dot at full strength.
      </p>
    </header>

    <section class="demo">
      <h2>Default</h2>
      <div class="panel">
        <CursorField variant="dots" />
      </div>
      <p class="caption">
        28px grid, 240px falloff. Reads as a flat texture until the cursor is
        near it.
      </p>
    </section>

    <section class="demo">
      <h2>Tighter grid, wider falloff</h2>
      <div class="panel">
        <CursorField variant="dots" gap={20} reach={280} height="360px" />
      </div>
      <p class="caption">
        Denser dots with a broader reach, so the highlight reads as a soft pool
        rather than a tight spotlight.
      </p>
    </section>

    <section class="demo">
      <h2>Compass rings, tight pool</h2>
      <div class="panel">
        <CursorField variant="compass" gap={34} reach={150} height="360px" />
      </div>
      <p class="caption">
        Open rings with a needle aimed at the cursor. This variant fades out
        entirely at the edge of its reach, so everywhere the cursor is not stays
        plain white rather than holding a resting texture.
      </p>
    </section>

    <section class="demo">
      <h2>As a section background</h2>
      <div class="panel overlay-panel">
        <CursorField variant="compass" gap={26} reach={190} height="100%" class="overlay-grid" />
        <div class="overlay-content">
          <p class="eyebrow">Design Systems</p>
          <h3>One source of truth across four brands.</h3>
          <p class="overlay-muted">
            This paragraph uses the muted text color, the hardest case to keep
            readable over the pattern. Run the cursor underneath it to see the
            darkest the dots ever get behind live text.
          </p>
        </div>
      </div>
      <p class="caption">
        The same component sitting behind content. It is marked aria-hidden and
        ignores pointer events, so it never interferes with text or links.
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .dot-grid-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-7) var(--page-padding) var(--space-8);
  }

  .page-head {
    max-width: var(--content-width);
    margin-bottom: var(--space-7);
  }

  h1 {
    font-size: var(--text-3xl);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: var(--space-3);
  }

  .intro {
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }

  .note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .demo {
    margin-bottom: var(--space-7);
  }

  .demo h2 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .panel {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .caption {
    margin-top: var(--space-3);
    max-width: var(--content-width);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .overlay-panel {
    position: relative;
    height: 380px;
  }

  .overlay-panel :global(.overlay-grid) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .overlay-content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-6);
    max-width: 520px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .overlay-content h3 {
    font-size: var(--text-2xl);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .overlay-muted {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
