---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getHomepageProjects } from "../data/projects";

const projects = getHomepageProjects();

function excerpt(html: string, length = 170): string {
  const text = html
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .replace(/\s+([,.;:])/g, "$1")
    .trim();
  if (text.length <= length) return text;
  return text.slice(0, text.lastIndexOf(" ", length)) + "…";
}

const sections = [
  { id: "intro", label: "Intro" },
  ...projects.map((p) => ({ id: p.slug, label: p.title })),
];
---

<Layout title="Homepage — Sticky Nav Test" description="Testing layout: sticky contents nav, center column.">
  <Nav />
  <main class="page">
    <div class="page-inner">
      <aside class="side-nav">
        <div class="side-nav-sticky">
          <p class="side-nav-label">Contents</p>
          <ul>
            {sections.map((s) => (
              <li>
                <a href={`#${s.id}`} data-target={s.id}>{s.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>

      <div class="content-col">
        <section id="intro" class="intro-block">
          <h1>Work</h1>
          <p class="intro-sub">Designing systems, sites and brands.</p>
        </section>

        {projects.map((project, i) => {
          const firstText = project.content.find((b) => b.type === "text" && "body" in b && b.body);
          const desc = firstText && "body" in firstText ? excerpt(firstText.body) : "";
          return (
            <>
              <section id={project.slug} class="entry">
                <div class="entry-meta">
                  {project.client}
                  {project.tags.length > 0 && <> &middot; {project.tags.join(" · ")}</>}
                </div>
                <a href={`/work/${project.slug}`} class="entry-image">
                  {project.thumbnail && <img src={project.thumbnail} alt={project.title} loading="lazy" />}
                </a>
                <h2>{project.title}</h2>
                {desc && <p class="entry-desc">{desc}</p>}
                <a href={`/work/${project.slug}`} class="case-study-link">View case study</a>
              </section>
              {i < projects.length - 1 && (
                <div class="entry-divider" aria-hidden="true"><span></span></div>
              )}
            </>
          );
        })}
      </div>

      <div class="side-spacer" aria-hidden="true"></div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>(".side-nav a");
  const targets = document.querySelectorAll<HTMLElement>("[id]");
  const sections = Array.from(targets).filter((el) =>
    Array.from(links).some((link) => link.dataset.target === el.id)
  );

  function setActive(id: string) {
    links.forEach((link) => {
      link.classList.toggle("active", link.dataset.target === id);
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
        }
      });
    },
    { rootMargin: "-15% 0px -70% 0px" }
  );

  sections.forEach((section) => observer.observe(section));
</script>

<style>
  :root {
    --accent: #2563eb;
  }

  .page {
    padding: 0 var(--page-padding) var(--space-8);
  }

  .page-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-top: var(--space-7);
    display: grid;
    grid-template-columns: 200px minmax(0, var(--content-width)) 200px;
    justify-content: center;
    gap: var(--space-6);
  }

  .side-nav {
    grid-column: 1;
  }

  .side-nav-sticky {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-6));
  }

  .side-nav-label {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .side-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .side-nav a {
    position: relative;
    display: block;
    padding-left: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.4;
    transition: color 0.2s;
  }

  .side-nav a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-border);
    transition: background 0.2s;
  }

  .side-nav a:hover {
    color: var(--color-text);
  }

  .side-nav a.active {
    color: var(--color-text);
    font-weight: 500;
  }

  .side-nav a.active::before {
    background: var(--accent);
  }

  .content-col {
    grid-column: 2;
    min-width: 0;
  }

  .side-spacer {
    grid-column: 3;
  }

  .intro-block {
    padding-bottom: var(--space-7);
  }

  .intro-block h1 {
    font-size: var(--text-3xl);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }

  .intro-sub {
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }

  .entry {
    scroll-margin-top: calc(var(--nav-height) + var(--space-4));
  }

  .entry-meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .entry-image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-tag-bg);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
  }

  .entry-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  @media (hover: hover) {
    .entry-image:hover img {
      transform: scale(1.02);
    }
  }

  .entry h2 {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  .entry-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    max-width: 60ch;
  }

  .case-study-link {
    display: inline-flex;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
  }

  .case-study-link:hover {
    text-decoration: underline;
  }

  .entry-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-7) 0;
  }

  .entry-divider span {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-border);
  }

  @media (max-width: 900px) {
    .page-inner {
      grid-template-columns: minmax(0, var(--content-width));
      padding-top: var(--space-6);
    }

    .side-nav,
    .side-spacer {
      display: none;
    }
  }
</style>
