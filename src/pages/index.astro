---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getHomepageProjects } from "../data/projects";

const projects = getHomepageProjects();
---

<Layout title="Ryan Sheridan — Designing systems, sites and brands." description="Portfolio of Ryan Sheridan, Principal Designer specializing in design systems, marketing sites, and brand infrastructure.">
  <Nav />
  <main class="split-layout">
    <div class="left-panel">
      <h1 class="sticky-title">Designing systems,<br />sites and brands.</h1>
    </div>
    <div class="right-panel">
      {projects.map((project) => (
        <a href={`/work/${project.slug}`} class="project-row">
          <div class="row-grid">
            <div class="cell cell-image">
              {project.thumbnail && <img src={project.thumbnail} alt={project.title} loading="lazy" />}
            </div>
            <div class="cell cell-info">
              <h2 class="project-title">{project.title}</h2>
              <div class="badge-list project-tags">
                {project.tags.map((tag) => <span class="badge">{tag}</span>)}
              </div>
              <span class="discover-link">View project</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .split-layout {
    display: flex;
    min-height: 100vh;
    padding-top: 0;
  }

  .left-panel {
    position: sticky;
    top: 0;
    width: 50%;
    height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 var(--page-padding);
    flex-shrink: 0;
  }

  .sticky-title {
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .right-panel {
    width: 50%;
  }

  .project-row {
    display: block;
    padding: 0 var(--page-padding);
    border-bottom: 1px solid var(--color-border);
    transition: background 0.15s;
  }

  .project-row:first-child {
    border-top: 1px solid var(--color-border);
  }

  @media (hover: hover) {
    .project-row:hover {
      background: var(--color-tag-bg);
    }

    .project-row:hover .cell-image img {
      opacity: 0.85;
    }
  }

  .row-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    align-items: center;
    gap: 32px;
    padding: 32px 0;
  }

  .cell {
    min-width: 0;
  }

  .cell-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-tag-bg);
  }

  .cell-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s;
  }

  .cell-info {
    border-left: 1px solid var(--color-border);
    padding-left: 20px;
  }

  .project-title {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }

  .project-tags {
    margin-bottom: 16px;
  }

  .discover-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--color-text);
    padding-bottom: 1px;
  }

  @media (max-width: 768px) {
    .split-layout {
      flex-direction: column;
    }

    .left-panel {
      position: relative;
      width: 100%;
      height: auto;
      padding: 120px var(--page-padding) 48px;
      align-items: flex-start;
    }

    .right-panel {
      width: 100%;
    }

    .row-grid {
      grid-template-columns: 1fr;
      row-gap: 20px;
      padding: 28px 0;
    }

    .cell-image {
      aspect-ratio: 16 / 10;
    }

    .cell-info {
      border-left: none;
      padding-left: 0;
    }
  }
</style>
