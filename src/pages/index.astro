---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getHomepageProjects } from "../data/projects";

const projects = getHomepageProjects();
---

<Layout title="Ryan Sheridan — Designing systems, sites and brands." description="Portfolio of Ryan Sheridan, Principal Designer specializing in design systems, marketing sites, and brand infrastructure.">
  <Nav />
  <main class="split-layout">
    <div class="split-inner">
      <div class="left-panel">
        <div class="headline-block">
          <h1 class="sticky-title">
            <span class="reveal-wrap" data-load-reveal><span class="reveal-inner">Designing <span class="accent">systems</span></span></span><span class="reveal-wrap" data-reveal-index="1"><span class="reveal-inner">,</span></span><br />
            <span class="reveal-wrap" data-reveal-index="1"><span class="reveal-inner"><span class="accent">sites</span></span></span><span class="reveal-wrap" data-reveal-index="2"><span class="reveal-inner">{" and "}<span class="accent">brands</span>.</span></span>
          </h1>
          <p class="tagline" data-reveal-index="3">Based out of Austin, Texas</p>
          <a href="/work" class="view-all-link" data-reveal-index={projects.length - 1}>View all work</a>
        </div>
      </div>
      <div class="right-panel">
        {projects.map((project, i) => {
          const row = (
            <a href={`/work/${project.slug}`} class={`project-row${i === 0 ? " entrance-hidden" : ""}`} data-index={i}>
              <div class="cell-image">
                {project.thumbnail && <img src={project.thumbnail} alt={project.title} loading="lazy" />}
              </div>
              <div class="cell-info">
                <h2 class="project-title">{project.title}</h2>
                <div class="badge-list project-tags">
                  {project.tags.map((tag) => <span class="badge">{tag}</span>)}
                </div>
              </div>
            </a>
          );
          return i === 0 ? <div class="first-project-frame">{row}</div> : row;
        })}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const revealTargets = document.querySelectorAll<HTMLElement>("[data-reveal-index]");
  const rows = document.querySelectorAll<HTMLElement>(".project-row");

  function revealUpTo(index: number) {
    revealTargets.forEach((el) => {
      const revealIndex = Number(el.dataset.revealIndex);
      if (revealIndex > index) return;
      el.classList.add("visible");
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          revealUpTo(Number((entry.target as HTMLElement).dataset.index));
        }
      });
    },
    { rootMargin: "-45% 0px -45% 0px" }
  );

  rows.forEach((row) => observer.observe(row));

  const firstProject = document.querySelector<HTMLElement>('.project-row[data-index="0"]');
  const introWrap = document.querySelector<HTMLElement>(".reveal-wrap[data-load-reveal]");

  requestAnimationFrame(() => {
    firstProject?.classList.add("visible");
    setTimeout(() => introWrap?.classList.add("visible"), 400);
  });
</script>

<style>
  .split-layout {
    min-height: 100vh;
    padding: 0 var(--page-padding);
  }

  .split-inner {
    display: flex;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .left-panel {
    position: sticky;
    top: var(--nav-height);
    width: 50%;
    height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .headline-block {
    /* Nudge up to counter the nav bar eating into the visible viewport,
       so the block reads as centered on the whole page, not just this panel. */
    transform: translateY(calc(var(--nav-height) / -2));
  }

  .sticky-title {
    max-width: 100%;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 50px);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .tagline {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.55s ease 0.15s, transform 0.55s ease 0.15s;
  }

  .tagline.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 12px 22px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.55s ease 0.15s, transform 0.55s ease 0.15s, border-color 0.2s;
  }

  .view-all-link:hover {
    border-color: var(--color-text);
  }

  .view-all-link.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .entrance-hidden {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .entrance-hidden.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-wrap {
    display: inline-grid;
    grid-template-columns: 0fr;
    vertical-align: bottom;
    transition: grid-template-columns 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-wrap.visible {
    grid-template-columns: 1fr;
  }

  .reveal-inner {
    display: inline-block;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.55s ease 0.15s, transform 0.55s ease 0.15s;
  }

  .reveal-wrap.visible .reveal-inner {
    opacity: 1;
    transform: translateY(0);
  }

  .right-panel {
    width: 50%;
  }

  .project-row {
    display: block;
    padding: var(--space-8) 0;
  }

  .cell-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-tag-bg);
    margin-bottom: var(--space-4);
  }

  .cell-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-title {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  @media (hover: hover) {
    .project-row:hover .cell-image img {
      transform: scale(1.03);
    }
  }

  .project-tags {
    margin-bottom: 0;
  }

  @media (min-width: 769px) {
    .first-project-frame {
      min-height: calc(100vh - var(--nav-height));
      display: flex;
      align-items: center;
      transform: translateY(calc(var(--nav-height) / -2));
    }

    .first-project-frame .project-row {
      padding-top: 0;
      padding-bottom: 0;
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .split-inner {
      flex-direction: column;
    }

    .left-panel {
      position: relative;
      width: 100%;
      height: auto;
      padding: 120px 0 48px;
      align-items: flex-start;
    }

    .headline-block {
      transform: none;
    }

    .right-panel {
      width: 100%;
    }

    .project-row {
      padding: var(--space-5) 0;
    }

    /* Show everything immediately on mobile; skip the scroll/entrance choreography. */
    .reveal-wrap {
      grid-template-columns: 1fr !important;
      transition: none !important;
    }

    .reveal-inner {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .tagline,
    .view-all-link,
    .entrance-hidden {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
