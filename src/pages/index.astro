---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import IntroLoader from "../components/IntroLoader.astro";
import { getHomepageProjects } from "../data/projects";
import Media from "../components/Media.astro";

const projects = getHomepageProjects();
---

<Layout title="Ryan Sheridan — Designing systems, sites and brands." description="Portfolio of Ryan Sheridan, Principal Designer specializing in design systems, marketing sites, and brand infrastructure.">
  {/* First in the document on purpose: the intro's blocking inline script
      stamps the page before the nav below it can paint, otherwise the nav
      flashes for a frame before the scrim covers it. */}
  <IntroLoader />
  <Nav />
  <main class="split-layout" data-blueprint-scope>
    <div class="split-inner">
      <div class="left-panel">
        <div class="headline-block" data-blueprint-scope>
          <h1 class="sticky-title" data-spec="type" data-spec-name="Display">
            Designing <span class="accent">systems</span>,<br />
            <span class="accent">sites</span> and <span class="accent">brands</span>.
          </h1>
          <p class="intro" data-spec="type" data-spec-name="Body">
            I build intuitive, scalable web experiences rooted in solid fundamentals. Based out of Austin, Texas.
          </p>
          {/* The way into the blueprint: the page drawing its own specs over
              itself. The key in the line is a real toggle too, for anyone
              reading with a mouse; the drawing it adds is hidden from
              assistive tech, since it describes the page rather than adding
              to it. */}
          <p class="tagline" data-spec="type" data-spec-name="Meta">
            <span class="hint-key"><span class="hint-press">Press</span><span class="hint-tap">Tap</span> <button type="button" class="kbd-toggle" aria-pressed="false" aria-label="Show the specs (shortcut I)" data-blueprint-toggle>I</button></span> to peek under the&nbsp;hood.
          </p>
          <div class="cta-row">
            <a href="/work" class="view-all-link">View all work</a>
          </div>
          <div class="blueprint-tags" aria-hidden="true"></div>
        </div>
      </div>
      <div class="right-panel">
        {projects.map((project, i) => {
          const row = (
            <a href={`/work/${project.slug}`} class={`project-row${i === 0 ? " entrance-hidden" : ""}`} data-index={i}>
              <div class="cell-image" data-spec="box">
                {project.thumbnail && <Media src={project.thumbnail} alt={project.title} />}
              </div>
              <div class="cell-info">
                <h2 class="project-title" data-spec={i === 0 ? "type" : undefined} data-spec-name="Title" data-spec-align="end">{project.title}</h2>
                <div class="badge-list project-tags">
                  {project.tags.map((tag) => <span class="badge">{tag}</span>)}
                </div>
              </div>
            </a>
          );
          return i === 0 ? <div class="first-project-frame">{row}</div> : row;
        })}
        <div class="scroll-spacer"></div>
      </div>
    </div>

    {/* The blueprint's own layers: the panel columns, fixed to the screen so
        they run the full height as the page scrolls, and the tags for the
        work column, which scroll with it. */}
    <div class="blueprint-columns" aria-hidden="true" data-blueprint-columns></div>
    <div class="blueprint-tags" aria-hidden="true"></div>

    {/* The toggle lives at the end of the work, so while the specs are up
        this is the way out wherever you are on the page. */}
    <div class="blueprint-bar" data-blueprint-bar>
      <span class="blueprint-bar-label">Specs on</span>
      <button type="button" class="blueprint-bar-hide" data-blueprint-off>Hide</button>
      <span class="blueprint-bar-keys"><kbd>I</kbd> or <kbd>Esc</kbd></span>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const rows = document.querySelectorAll<HTMLElement>(".project-row");
  const firstProject = document.querySelector<HTMLElement>('.project-row[data-index="0"]');

  requestAnimationFrame(() => firstProject?.classList.add("visible"));

  // Line the first project's image up with the headline block. Centering the
  // whole row would count its caption too and leave the image sitting high,
  // so measure both and shift the frame by the difference.
  const firstFrame = document.querySelector<HTMLElement>(".first-project-frame");
  const firstImage = firstFrame?.querySelector<HTMLElement>(".cell-image");
  const headline = document.querySelector<HTMLElement>(".headline-block");
  const splitView = window.matchMedia("(min-width: 769px)");

  function alignFirstProject() {
    if (!firstFrame || !firstImage || !headline) return;
    if (!splitView.matches) {
      firstFrame.style.removeProperty("--align-shift");
      return;
    }
    const current = parseFloat(firstFrame.style.getPropertyValue("--align-shift")) || 0;
    const head = headline.getBoundingClientRect();
    const image = firstImage.getBoundingClientRect();
    // The headline is sticky, so its place on screen holds while scrolling;
    // compare it with where the image sits when the page is at the top.
    // Leave out the row's entrance slide, which may still be in flight.
    const entrance = firstProject ? new DOMMatrixReadOnly(getComputedStyle(firstProject).transform).m42 : 0;
    const imageCenterAtTop = image.top + window.scrollY - current - entrance + image.height / 2;
    const shift = (head.top + head.bottom) / 2 - imageCenterAtTop;
    firstFrame.style.setProperty("--align-shift", `${shift.toFixed(1)}px`);
  }

  alignFirstProject();
  document.fonts?.ready.then(alignFirstProject);
  window.addEventListener("resize", alignFirstProject);
  if (firstFrame && headline) {
    const alignObserver = new ResizeObserver(alignFirstProject);
    alignObserver.observe(firstFrame);
    alignObserver.observe(headline);
  }

  // Size the trailing spacer so the sticky headline releases right as the
  // last project becomes vertically centered in the viewport, instead of
  // releasing only once the project has scrolled away entirely.
  const spacer = document.querySelector<HTMLElement>(".scroll-spacer");
  const lastRow = rows[rows.length - 1];

  function updateSpacer() {
    if (!spacer || !lastRow) return;
    if (window.innerWidth < 769) {
      spacer.style.height = "0px";
      return;
    }
    const rowHeight = lastRow.getBoundingClientRect().height;
    const height = Math.max(0, (window.innerHeight - rowHeight) / 2);
    spacer.style.height = `${height}px`;
  }

  updateSpacer();
  window.addEventListener("resize", updateSpacer);

  /**
   * The blueprint: the page drawing its own specs over itself. The columns,
   * type specs, frame sizes, and spacing are all measured off the page as it
   * renders, so resizing the window changes the numbers, and a spacing value
   * is named after the site's --space token when it lands on one.
   *
   * Tags are drawn into the nearest [data-blueprint-scope], so the ones for
   * the sticky headline travel with it and the ones for the work scroll with
   * the work.
   */
  const page = document.querySelector<HTMLElement>("main[data-blueprint-scope]");
  const blueprintToggle = document.querySelector<HTMLButtonElement>("[data-blueprint-toggle]");
  const columns = document.querySelector<HTMLElement>("[data-blueprint-columns]");

  if (page && blueprintToggle && columns) {
    const splitInner = page.querySelector<HTMLElement>(".split-inner")!;
    const panels = [page.querySelector<HTMLElement>(".left-panel")!, page.querySelector<HTMLElement>(".right-panel")!];

    const tokens = getComputedStyle(document.documentElement);
    const space = new Map<number, string>();
    for (let n = 1; n <= 8; n++) {
      const value = parseFloat(tokens.getPropertyValue(`--space-${n}`));
      if (!Number.isNaN(value)) space.set(value, `space-${n}`);
    }

    const px = (value: number) => Math.round(value);

    // The floating bar hangs off the body too, so it rides above the footer.
    const bar = document.querySelector<HTMLElement>("[data-blueprint-bar]");
    if (bar) document.body.append(bar);

    // The rest of the canvas: the page gutters, the nav, and the footer. They
    // live outside main, so their layers hang off the body, above the sticky
    // nav: one fixed to the screen (gutters, nav) and one that scrolls with
    // the document (footer). The column bands move out with them so they run
    // through the nav and footer too. Each layer borrows main's scope
    // attribute so it picks up the same tag and line styles.
    const nav = document.querySelector<HTMLElement>("nav:not(.footer-nav)");
    const footer = document.querySelector<HTMLElement>("footer");
    const scopeAttr = Array.from(columns.attributes).find((a) => a.name.startsWith("data-astro-cid"))?.name;
    document.body.append(columns);
    const [screenLayer, docLayer] = ["bp-screen", "bp-doc"].map((name) => {
      const layer = document.createElement("div");
      layer.className = `blueprint-tags ${name}`;
      layer.setAttribute("aria-hidden", "true");
      if (scopeAttr) layer.setAttribute(scopeAttr, "");
      document.body.append(layer);
      return layer;
    });
    const outlined: Element[] = [];
    function outline(el: Element | null | undefined, kind: "type" | "box") {
      if (!el) return;
      el.classList.add(`bp-outline-${kind}`);
      outlined.push(el);
    }

    function spacingLabel(distance: number) {
      const d = px(distance);
      if (space.has(d)) return `${space.get(d)} · ${d}`;
      // Two paddings meeting, top of one row against the bottom of the last.
      if (d % 2 === 0 && space.has(d / 2)) return `${space.get(d / 2)} × 2 · ${d}`;
      return `${d}`;
    }

    function typeLabel(el: HTMLElement, name?: string) {
      const s = getComputedStyle(el);
      const size = parseFloat(s.fontSize);
      const lineHeight = s.lineHeight === "normal" ? "auto" : px(parseFloat(s.lineHeight));
      const tracking = parseFloat(s.letterSpacing);
      const em = Number.isNaN(tracking) ? "0" : (tracking / size).toFixed(2);
      const family = s.fontFamily.split(",")[0].replace(/["']/g, "");
      return `${name ?? el.dataset.specName ?? "Text"} · ${family} ${s.fontWeight} · ${px(size)}/${lineHeight} · ${em}em`;
    }

    function scopeOf(el: Element) {
      const scope = el.closest<HTMLElement>("[data-blueprint-scope]") ?? page!;
      const layer = scope.querySelector<HTMLElement>(":scope > .blueprint-tags")!;
      const origin = scope.getBoundingClientRect();
      return { layer, x: origin.left, y: origin.top };
    }

    function tag(layer: HTMLElement, text: string, x: number, y: number, shift = "") {
      const el = document.createElement("span");
      el.className = "blueprint-tag";
      el.textContent = text;
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      if (shift) el.style.transform = shift;
      layer.appendChild(el);
      return el;
    }

    function vertical(layer: HTMLElement, x: number, top: number, length: number) {
      const el = document.createElement("span");
      el.className = "blueprint-line";
      el.style.left = `${x}px`;
      el.style.top = `${top}px`;
      el.style.height = `${length}px`;
      layer.appendChild(el);
      tag(layer, spacingLabel(length), x + 8, top + length / 2, "translateY(-50%)");
    }

    function build() {
      page!.querySelectorAll(".blueprint-tag, .blueprint-line").forEach((el) => el.remove());
      screenLayer.replaceChildren();
      docLayer.replaceChildren();
      outlined.splice(0).forEach((el) => el.classList.remove("bp-outline-type", "bp-outline-box"));
      if (!page!.classList.contains("is-blueprint")) return;

      // Columns: the layout's real ones. Side by side on desktop, the two
      // panels; stacked on a phone, one. Judged across only, since the sticky
      // headline panel drifts vertically as the work scrolls past it.
      const inner = splitInner.getBoundingClientRect();
      const [left, right] = panels.map((panel) => panel.getBoundingClientRect());
      const sideBySide = right.left >= left.right - 1;
      const count = sideBySide ? 2 : 1;
      columns.style.left = `${inner.left}px`;
      columns.style.width = `${inner.width}px`;
      columns.style.gridTemplateColumns = `repeat(${count}, minmax(0, 1fr))`;
      if (columns.childElementCount !== count) {
        columns.replaceChildren(...Array.from({ length: count }, () => document.createElement("span")));
      }

      const pageScope = scopeOf(page!);
      tag(
        pageScope.layer,
        `${count} col · ${px(inner.width / count)} wide · max ${px(inner.width)}`,
        right.right - pageScope.x,
        8,
        "translateX(-100%)"
      );

      page!.querySelectorAll<HTMLElement>('[data-spec="type"]').forEach((el) => {
        const { layer, x, y } = scopeOf(el);
        const box = el.getBoundingClientRect();
        const end = el.dataset.specAlign === "end";
        tag(layer, typeLabel(el), (end ? box.right : box.left) - x, box.top - y - 24, end ? "translateX(-100%)" : "");
      });

      page!.querySelectorAll<HTMLElement>('[data-spec="box"]').forEach((el) => {
        const { layer, x, y } = scopeOf(el);
        const box = el.getBoundingClientRect();
        tag(layer, `${px(box.width)} × ${px(box.height)}`, box.right - x - 8, box.bottom - y - 8, "translate(-100%, -100%)");
      });

      // Spacing down the work column: frame to title inside each project,
      // and the last line of one project to the frame of the next.
      const { layer, x, y } = pageScope;
      rows.forEach((row, i) => {
        const image = row.querySelector<HTMLElement>(".cell-image")!.getBoundingClientRect();
        const title = row.querySelector<HTMLElement>(".project-title")!.getBoundingClientRect();
        // The spec'd title carries its own tag in that gap, so it skips the line.
        const titleEl = row.querySelector<HTMLElement>(".project-title")!;
        if (!titleEl.dataset.spec && title.top > image.bottom) vertical(layer, image.left - x + 32, image.bottom - y, title.top - image.bottom);

        const next = rows[i + 1];
        if (!next) return;
        const tags = row.querySelector<HTMLElement>(".project-tags")!.getBoundingClientRect();
        const nextImage = next.querySelector<HTMLElement>(".cell-image")!.getBoundingClientRect();
        if (nextImage.top > tags.bottom) vertical(layer, image.left - x + 32, tags.bottom - y, nextImage.top - tags.bottom);
      });

      drawCanvas(inner);
    }

    function drawCanvas(inner: DOMRect) {
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      const pad = parseFloat(tokens.getPropertyValue("--page-padding")) || 0;

      // Gutters, edge of the screen to the content on each side: the page
      // padding next to the content, and whatever auto margin centers the
      // layout beyond it. Labeled up the middle, since a gutter is narrow.
      for (const [from, to] of [[0, inner.left], [inner.right, vw]]) {
        const width = to - from;
        if (width < 1) continue;
        const band = document.createElement("span");
        band.className = "bp-gutter";
        band.style.left = `${from}px`;
        band.style.width = `${width}px`;
        const strip = document.createElement("span");
        strip.className = "bp-pad";
        strip.style.left = `${from === 0 ? to - Math.min(pad, width) : from}px`;
        strip.style.width = `${Math.min(pad, width)}px`;
        screenLayer.append(band, strip);
        const margin = width - pad;
        const label = margin > 1 ? `page-padding ${px(pad)} + margin ${px(margin)}` : `page-padding · ${px(pad)}`;
        tag(screenLayer, label, from + width / 2, vh / 2, "translate(-50%, -50%) rotate(-90deg)");
      }

      // The nav: sticky, so it is drawn on the screen layer and stays put.
      if (nav) {
        const box = nav.getBoundingClientRect();
        const navInner = nav.querySelector(".nav-inner")?.getBoundingClientRect();
        const logo = nav.querySelector<HTMLElement>(".logo");
        const menu = nav.querySelector<HTMLElement>(".hamburger");
        outline(nav, "box");
        if (logo) {
          outline(logo, "type");
          const b = logo.getBoundingClientRect();
          // On a phone there's no room beside the logo, and below it is where
          // the column tag sits, so the outline speaks for itself there.
          if (vw > 700) tag(screenLayer, typeLabel(logo, "Logo"), b.right + 12, b.top + b.height / 2, "translateY(-50%)");
        }
        if (menu) {
          outline(menu, "box");
          const b = menu.getBoundingClientRect();
          tag(screenLayer, `${px(b.width)} × ${px(b.height)}`, b.left - 10, b.top + b.height / 2, "translate(-100%, -50%)");
        }
        if (navInner && vw > 700) {
          const lx = navInner.left + navInner.width * 0.6;
          vertical(screenLayer, lx, box.top, navInner.top - box.top);
          vertical(screenLayer, lx, navInner.bottom, box.bottom - navInner.bottom);
        }
      }

      // The footer: drawn in document coordinates so it scrolls with the page.
      if (footer) {
        const sx = window.scrollX;
        const sy = window.scrollY;
        const at = (el: Element) => {
          const b = el.getBoundingClientRect();
          return { left: b.left + sx, right: b.right + sx, top: b.top + sy, bottom: b.bottom + sy, width: b.width };
        };
        const f = at(footer);
        const fInner = footer.querySelector(".footer-inner");
        const fTop = footer.querySelector(".footer-top");
        const fBottom = footer.querySelector(".footer-bottom");
        outline(footer, "box");
        if (fInner && fTop && fBottom) {
          const fi = at(fInner);
          const ft = at(fTop);
          const fb = at(fBottom);
          const lx = fi.left + fi.width * 0.36;
          const main = at(page!);
          if (f.top - main.bottom > 1) vertical(docLayer, lx, main.bottom, f.top - main.bottom);
          // Measured inside the top border, so it reads as the padding.
          const inside = f.top + footer.clientTop;
          vertical(docLayer, lx, inside, fi.top - inside);
          vertical(docLayer, lx, ft.bottom, fb.top - ft.bottom);
          vertical(docLayer, lx, fb.bottom, f.bottom - fb.bottom);
        }
        const texts: [string, string, boolean][] = [
          [".footer-logo", "Logo", false],
          [".footer-nav a", "Link", true],
          [".footer-copyright", "Meta", false],
        ];
        for (const [selector, name, end] of texts) {
          const el = footer.querySelector<HTMLElement>(selector);
          if (!el) continue;
          outline(el, "type");
          const b = at(el);
          tag(docLayer, typeLabel(el, name), end ? b.right : b.left, b.top - 24, end ? "translateX(-100%)" : "");
        }
      }
    }

    function setBlueprint(on: boolean) {
      page!.classList.toggle("is-blueprint", on);
      document.documentElement.classList.toggle("blueprint-on", on);
      blueprintToggle!.setAttribute("aria-pressed", String(on));
      blueprintToggle!.setAttribute("aria-label", `${on ? "Hide" : "Show"} the specs (shortcut I)`);
      build();
    }

    blueprintToggle.addEventListener("click", () => setBlueprint(!page.classList.contains("is-blueprint")));

    document.querySelector("[data-blueprint-off]")?.addEventListener("click", () => setBlueprint(false));

    // Escape puts it away from anywhere, like any overlay, without moving focus.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && page.classList.contains("is-blueprint")) setBlueprint(false);
    });

    // I toggles it in place, from anywhere on the page. Left alone while
    // typing or holding a modifier, so it never steals a browser shortcut.
    document.addEventListener("keydown", (event) => {
      if (event.key !== "i" && event.key !== "I") return;
      if (event.metaKey || event.ctrlKey || event.altKey || event.repeat) return;
      const target = event.target as HTMLElement | null;
      if (target?.closest("input, textarea, select, [contenteditable]")) return;
      setBlueprint(!page.classList.contains("is-blueprint"));
    });

    let queued = false;
    const rebuild = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        build();
      });
    };

    new ResizeObserver(rebuild).observe(page);
    window.addEventListener("resize", rebuild);
    document.fonts?.ready.then(rebuild);
  }
</script>

<style>
  .split-layout {
    min-height: 100vh;
    padding: 0 var(--page-padding);
    /* Kept above the intro scrim's stacking context so the hand-off has
       something to land on. */
    position: relative;
    z-index: 1;
  }

  .split-inner {
    display: flex;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .left-panel {
    position: sticky;
    top: var(--nav-height);
    width: 50%;
    height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .headline-block {
    /* Nudge up to counter the nav bar eating into the visible viewport,
       so the block reads as centered on the whole page, not just this panel. */
    transform: translateY(calc(var(--nav-height) / -2));
  }

  .sticky-title {
    max-width: 100%;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 50px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--color-text);
  }

  /* A line or two on what the work is and where it's made. Held to a
     reading measure so it never runs the width of the
     headline. */
  .intro {
    max-width: 44ch;
    margin-top: var(--space-4);
    font-size: 17px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* The way into the blueprint, on its own line in the Meta style. Only the
     verb and its key hold together, so the key never starts a line. */
  .hint-key {
    white-space: nowrap;
  }

  /* The key in the sentence, drawn as a key and working as one. */
  .kbd-toggle {
    display: inline-block;
    min-width: 1.7em;
    margin: 0 1px;
    padding: 0 6px;
    font-family: var(--font-mono);
    font-size: 0.82em;
    line-height: 1.55;
    text-align: center;
    vertical-align: 0.1em;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 5px;
    box-shadow: none;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, color 0.2s, transform 0.1s;
  }

  .kbd-toggle:hover {
    border-color: var(--color-text);
  }

  .kbd-toggle:active {
    transform: translateY(1px);
  }

  .kbd-toggle[aria-pressed="true"] {
    color: #ffffff;
    background: var(--blueprint);
    border-color: var(--blueprint);
  }

  /* Room above for the blueprint's Meta tag, which hangs off the top of
     this line and would otherwise sit on the body copy. */
  .intro + .tagline {
    margin-top: var(--space-5);
  }

  .tagline {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: var(--space-5);
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.6;
    border-radius: 999px;
    padding: 11px 22px;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  .view-all-link {
    color: var(--color-bg);
    background: var(--color-text);
    border: 1px solid var(--color-text);
  }

  .view-all-link:hover {
    color: var(--color-bg);
    background: #333333;
    border-color: #333333;
  }

  .view-all-link:focus-visible,
  .kbd-toggle:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  /*
    The blueprint. Drawn in the site's own link blue, so the page is annotated
    in a color the system already has rather than one invented for it. White
    on it is 6.7:1.
  */
  .split-layout {
    --blueprint: var(--color-link);
  }

  .headline-block {
    position: relative;
  }

  .blueprint-tags {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .blueprint-columns {
    position: fixed;
    top: 0;
    bottom: 0;
    z-index: 205;
