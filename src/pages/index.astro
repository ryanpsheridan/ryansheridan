---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getHomepageProjects } from "../data/projects";

const projects = getHomepageProjects();
---

<Layout title="Ryan Sheridan — Designing systems, sites and brands." description="Portfolio of Ryan Sheridan, Principal Designer specializing in design systems, marketing sites, and brand infrastructure.">
  <Nav />
  <main class="split-layout">
    <div class="left-panel">
      <h1 class="sticky-title entrance-hidden">
        Designing systems<span class="reveal-wrap" data-reveal-index="1"><span class="reveal-inner">,</span></span><br />
        <span class="reveal-wrap" data-reveal-index="1"><span class="reveal-inner">sites</span></span><span class="reveal-wrap" data-reveal-index="2"><span class="reveal-inner">{" and brands."}</span></span>
      </h1>
    </div>
    <div class="right-panel">
      {projects.map((project, i) => (
        <a href={`/work/${project.slug}`} class={`project-row${i === 0 ? " entrance-hidden" : ""}`} data-index={i}>
          <div class="cell-image">
            {project.thumbnail && <img src={project.thumbnail} alt={project.title} loading="lazy" />}
          </div>
          <div class="cell-info">
            <h2 class="project-title">{project.title}</h2>
            <div class="badge-list project-tags">
              {project.tags.map((tag) => <span class="badge">{tag}</span>)}
            </div>
            <span class="discover-link">View project</span>
          </div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const revealWraps = document.querySelectorAll<HTMLElement>(".reveal-wrap");
  const rows = document.querySelectorAll<HTMLElement>(".project-row");

  function revealUpTo(index: number) {
    revealWraps.forEach((wrap) => {
      const revealIndex = Number(wrap.dataset.revealIndex);
      if (revealIndex > index) return;
      wrap.classList.add("visible");
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          revealUpTo(Number((entry.target as HTMLElement).dataset.index));
        }
      });
    },
    { rootMargin: "-45% 0px -45% 0px" }
  );

  rows.forEach((row) => observer.observe(row));

  const firstProject = document.querySelector<HTMLElement>('.project-row[data-index="0"]');
  const headline = document.querySelector<HTMLElement>(".sticky-title");

  requestAnimationFrame(() => {
    firstProject?.classList.add("visible");
    setTimeout(() => headline?.classList.add("visible"), 350);
  });
</script>

<style>
  .split-layout {
    display: flex;
    min-height: 100vh;
    padding-top: 0;
  }

  .left-panel {
    position: sticky;
    top: var(--nav-height);
    width: 50%;
    height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    padding: 0 var(--page-padding);
    flex-shrink: 0;
  }

  .sticky-title {
    max-width: 480px;
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .entrance-hidden {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .entrance-hidden.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-wrap {
    display: inline-grid;
    grid-template-columns: 0fr;
    vertical-align: bottom;
    transition: grid-template-columns 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-wrap.visible {
    grid-template-columns: 1fr;
  }

  .reveal-inner {
    display: inline-block;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease 0.1s, transform 0.4s ease 0.1s;
  }

  .reveal-wrap.visible .reveal-inner {
    opacity: 1;
    transform: translateY(0);
  }

  .right-panel {
    width: 50%;
  }

  .project-row {
    display: block;
    padding: var(--space-8) var(--page-padding);
  }

  .project-row:first-child {
    padding-top: 0;
  }

  .cell-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-tag-bg);
    margin-bottom: var(--space-4);
  }

  .cell-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-title {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
  }

  @media (hover: hover) {
    .project-row:hover .cell-image img {
      transform: scale(1.03);
    }

    .project-row:hover .discover-link {
      border-bottom-color: var(--color-text-muted);
    }
  }

  .project-tags {
    margin-bottom: var(--space-3);
  }

  .discover-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--color-text);
    padding-bottom: 1px;
    transition: border-color 0.15s;
  }

  @media (max-width: 768px) {
    .split-layout {
      flex-direction: column;
    }

    .left-panel {
      position: relative;
      width: 100%;
      height: auto;
      padding: 120px var(--page-padding) 48px;
      align-items: flex-start;
    }

    .right-panel {
      width: 100%;
    }

    .project-row {
      padding: var(--space-5) var(--page-padding);
    }
  }
</style>
