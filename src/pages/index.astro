---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import IntroLoader from "../components/IntroLoader.astro";
import { getHomepageProjects } from "../data/projects";
import Media from "../components/Media.astro";

const projects = getHomepageProjects();
---

<Layout title="Ryan Sheridan — Designing systems, sites and brands." description="Portfolio of Ryan Sheridan, Principal Designer specializing in design systems, marketing sites, and brand infrastructure.">
  {/* First in the document on purpose: the intro's blocking inline script
      stamps the page before the nav below it can paint, otherwise the nav
      flashes for a frame before the scrim covers it. */}
  <IntroLoader />
  <Nav />
  <main class="split-layout" data-blueprint-scope>
    <div class="split-inner">
      <div class="left-panel">
        <div class="headline-block" data-blueprint-scope>
          <h1 class="sticky-title" data-spec="type" data-spec-name="Display">
            Designing <span class="accent">systems</span>,<br />
            <span class="accent">sites</span> and <span class="accent">brands</span>.
          </h1>
          <p class="tagline" data-spec="type" data-spec-name="Meta">Based out of Austin, Texas</p>
          <div class="cta-row">
            <a href="/work" class="view-all-link">View all work</a>
            {/* The page drawing its own specs over itself. Plain toggle
                semantics, and the drawing it adds is hidden from assistive
                tech, since it describes the page rather than adding to it. */}
            <button type="button" class="blueprint-toggle" aria-pressed="false" data-blueprint-toggle>
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25">
                <rect x="1.5" y="1.5" width="13" height="13" rx="1" />
                <path d="M1.5 6h13M6 6v8.5" />
              </svg>
              <span data-blueprint-label>See the blueprint</span>
            </button>
          </div>
          <div class="blueprint-tags" aria-hidden="true"></div>
        </div>
      </div>
      <div class="right-panel">
        {projects.map((project, i) => {
          const row = (
            <a href={`/work/${project.slug}`} class={`project-row${i === 0 ? " entrance-hidden" : ""}`} data-index={i}>
              <div class="cell-image" data-spec="box">
                {project.thumbnail && <Media src={project.thumbnail} alt={project.title} />}
              </div>
              <div class="cell-info">
                <h2 class="project-title" data-spec={i === 0 ? "type" : undefined} data-spec-name="Title" data-spec-align="end">{project.title}</h2>
                <div class="badge-list project-tags">
                  {project.tags.map((tag) => <span class="badge">{tag}</span>)}
                </div>
              </div>
            </a>
          );
          return i === 0 ? <div class="first-project-frame">{row}</div> : row;
        })}
        <div class="scroll-spacer"></div>
      </div>
    </div>

    {/* The blueprint's own layers: the panel columns, fixed to the screen so
        they run the full height as the page scrolls, and the tags for the
        work column, which scroll with it. */}
    <div class="blueprint-columns" aria-hidden="true" data-blueprint-columns></div>
    <div class="blueprint-tags" aria-hidden="true"></div>
  </main>

  {/* Outside main so it can hold the left margin for the whole page rather
      than the headline panel. Decorative: the work is reachable by scrolling
      whether or not anyone sees this, so it is hidden from assistive tech
      rather than announced as something to act on. */}
  <div class="scroll-rail" data-scroll-rail aria-hidden="true">
    <span class="scroll-rail-label">Scroll</span>
    <span class="scroll-rail-track"><span class="scroll-rail-fill"></span></span>
  </div>

  <Footer />
</Layout>

<script>
  const rows = document.querySelectorAll<HTMLElement>(".project-row");
  const firstProject = document.querySelector<HTMLElement>('.project-row[data-index="0"]');

  requestAnimationFrame(() => firstProject?.classList.add("visible"));

  // Size the trailing spacer so the sticky headline releases right as the
  // last project becomes vertically centered in the viewport, instead of
  // releasing only once the project has scrolled away entirely.
  const spacer = document.querySelector<HTMLElement>(".scroll-spacer");
  const lastRow = rows[rows.length - 1];

  function updateSpacer() {
    if (!spacer || !lastRow) return;
    if (window.innerWidth < 769) {
      spacer.style.height = "0px";
      return;
    }
    const rowHeight = lastRow.getBoundingClientRect().height;
    const height = Math.max(0, (window.innerHeight - rowHeight) / 2);
    spacer.style.height = `${height}px`;
  }

  updateSpacer();
  window.addEventListener("resize", updateSpacer);

  /**
   * The scroll rail: an invitation until the page moves, a progress reading
   * after that, and back to an invitation if someone returns to the top.
   *
   * It waits out the intro rather than counting frames against it, so it never
   * animates behind the scrim.
   */
  const rail = document.querySelector<HTMLElement>("[data-scroll-rail]");

  if (rail) {
    let shown = false;
    let scrolled = false;
    let queued = false;

    const reveal = () => {
      if (shown) return;
      shown = true;
      rail.classList.add("visible");
    };

    function measure() {
      queued = false;
      // How far the document can travel. A page shorter than the viewport has
      // nowhere to go, so it reads as untouched rather than as complete.
      const span = document.documentElement.scrollHeight - window.innerHeight;
      const progress = span > 0 ? Math.min(Math.max(window.scrollY / span, 0), 1) : 0;
      rail.style.setProperty("--progress", String(progress));

      // One way only. Someone who has scrolled knows how, and being told again
      // on the way back up reads as the page forgetting. A stray trackpad
      // twitch is not a scroll, hence the threshold. From here the rail is
      // only ever a progress reading, including at the top, where it reads
      // empty rather than inviting.
      if (scrolled || window.scrollY <= 40) return;
      scrolled = true;
      rail.classList.add("is-scrolled");
    }

    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(measure);
    }

    const root = document.documentElement;

    if (root.classList.contains("intro-open")) {
      // The intro drops this class on hand-off; that is the page's own signal
      // that it is on screen, and it beats guessing at the intro's duration.
      const watcher = new MutationObserver(() => {
        if (root.classList.contains("intro-open")) return;
        watcher.disconnect();
        window.setTimeout(reveal, 900);
      });
      watcher.observe(root, { attributes: true, attributeFilter: ["class"] });
    } else {
      window.setTimeout(reveal, 1200);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    // The document's height is what progress is measured against, and both the
    // spacer above and a resize change it.
    window.addEventListener("resize", onScroll);
    // Landing mid-page, on a refresh or a back-navigation, starts in progress.
    measure();
  }
  /**
   * The blueprint: the page drawing its own specs over itself. The columns,
   * type specs, frame sizes, and spacing are all measured off the page as it
   * renders, so resizing the window changes the numbers, and a spacing value
   * is named after the site's --space token when it lands on one.
   *
   * Tags are drawn into the nearest [data-blueprint-scope], so the ones for
   * the sticky headline travel with it and the ones for the work scroll with
   * the work.
   */
  const page = document.querySelector<HTMLElement>("main[data-blueprint-scope]");
  const blueprintToggle = document.querySelector<HTMLButtonElement>("[data-blueprint-toggle]");
  const blueprintLabel = document.querySelector<HTMLElement>("[data-blueprint-label]");
  const columns = document.querySelector<HTMLElement>("[data-blueprint-columns]");

  if (page && blueprintToggle && blueprintLabel && columns) {
    const splitInner = page.querySelector<HTMLElement>(".split-inner")!;
    const panels = [page.querySelector<HTMLElement>(".left-panel")!, page.querySelector<HTMLElement>(".right-panel")!];

    const tokens = getComputedStyle(document.documentElement);
    const space = new Map<number, string>();
    for (let n = 1; n <= 8; n++) {
      const value = parseFloat(tokens.getPropertyValue(`--space-${n}`));
      if (!Number.isNaN(value)) space.set(value, `space-${n}`);
    }

    const px = (value: number) => Math.round(value);

    function spacingLabel(distance: number) {
      const d = px(distance);
      if (space.has(d)) return `${space.get(d)} · ${d}`;
      // Two paddings meeting, top of one row against the bottom of the last.
      if (d % 2 === 0 && space.has(d / 2)) return `${space.get(d / 2)} × 2 · ${d}`;
      return `${d}`;
    }

    function typeLabel(el: HTMLElement) {
      const s = getComputedStyle(el);
      const size = parseFloat(s.fontSize);
      const lineHeight = s.lineHeight === "normal" ? "auto" : px(parseFloat(s.lineHeight));
      const tracking = parseFloat(s.letterSpacing);
      const em = Number.isNaN(tracking) ? "0" : (tracking / size).toFixed(2);
      const family = s.fontFamily.split(",")[0].replace(/["']/g, "");
      return `${el.dataset.specName ?? "Text"} · ${family} ${s.fontWeight} · ${px(size)}/${lineHeight} · ${em}em`;
    }

    function scopeOf(el: Element) {
      const scope = el.closest<HTMLElement>("[data-blueprint-scope]") ?? page!;
      const layer = scope.querySelector<HTMLElement>(":scope > .blueprint-tags")!;
      const origin = scope.getBoundingClientRect();
      return { layer, x: origin.left, y: origin.top };
    }

    function tag(layer: HTMLElement, text: string, x: number, y: number, shift = "") {
      const el = document.createElement("span");
      el.className = "blueprint-tag";
      el.textContent = text;
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      if (shift) el.style.transform = shift;
      layer.appendChild(el);
      return el;
    }

    function vertical(layer: HTMLElement, x: number, top: number, length: number) {
      const el = document.createElement("span");
      el.className = "blueprint-line";
      el.style.left = `${x}px`;
      el.style.top = `${top}px`;
      el.style.height = `${length}px`;
      layer.appendChild(el);
      tag(layer, spacingLabel(length), x + 8, top + length / 2, "translateY(-50%)");
    }

    function build() {
      page!.querySelectorAll(".blueprint-tag, .blueprint-line").forEach((el) => el.remove());
      if (!page!.classList.contains("is-blueprint")) return;

      // Columns: the layout's real ones. Side by side on desktop, the two
      // panels; stacked on a phone, one. Judged across only, since the sticky
      // headline panel drifts vertically as the work scrolls past it.
      const inner = splitInner.getBoundingClientRect();
      const [left, right] = panels.map((panel) => panel.getBoundingClientRect());
      const sideBySide = right.left >= left.right - 1;
      const count = sideBySide ? 2 : 1;
      columns.style.left = `${inner.left}px`;
      columns.style.width = `${inner.width}px`;
      columns.style.gridTemplateColumns = `repeat(${count}, minmax(0, 1fr))`;
      if (columns.childElementCount !== count) {
        columns.replaceChildren(...Array.from({ length: count }, () => document.createElement("span")));
      }

      const pageScope = scopeOf(page!);
      tag(
        pageScope.layer,
        `${count} col · ${px(inner.width / count)} wide · max ${px(inner.width)}`,
        right.right - pageScope.x,
        8,
        "translateX(-100%)"
      );

      page!.querySelectorAll<HTMLElement>('[data-spec="type"]').forEach((el) => {
        const { layer, x, y } = scopeOf(el);
        const box = el.getBoundingClientRect();
        const end = el.dataset.specAlign === "end";
        tag(layer, typeLabel(el), (end ? box.right : box.left) - x, box.top - y - 24, end ? "translateX(-100%)" : "");
      });

      page!.querySelectorAll<HTMLElement>('[data-spec="box"]').forEach((el) => {
        const { layer, x, y } = scopeOf(el);
        const box = el.getBoundingClientRect();
        tag(layer, `${px(box.width)} × ${px(box.height)}`, box.right - x - 8, box.bottom - y - 8, "translate(-100%, -100%)");
      });

      // Spacing down the work column: frame to title inside each project,
      // and the last line of one project to the frame of the next.
      const { layer, x, y } = pageScope;
      rows.forEach((row, i) => {
        const image = row.querySelector<HTMLElement>(".cell-image")!.getBoundingClientRect();
        const title = row.querySelector<HTMLElement>(".project-title")!.getBoundingClientRect();
        // The spec'd title carries its own tag in that gap, so it skips the line.
        const titleEl = row.querySelector<HTMLElement>(".project-title")!;
        if (!titleEl.dataset.spec && title.top > image.bottom) vertical(layer, image.left - x + 32, image.bottom - y, title.top - image.bottom);

        const next = rows[i + 1];
        if (!next) return;
        const tags = row.querySelector<HTMLElement>(".project-tags")!.getBoundingClientRect();
        const nextImage = next.querySelector<HTMLElement>(".cell-image")!.getBoundingClientRect();
        if (nextImage.top > tags.bottom) vertical(layer, image.left - x + 32, tags.bottom - y, nextImage.top - tags.bottom);
      });
    }

    function setBlueprint(on: boolean) {
      page!.classList.toggle("is-blueprint", on);
      blueprintToggle!.setAttribute("aria-pressed", String(on));
      blueprintLabel!.textContent = on ? "Hide the blueprint" : "See the blueprint";
      build();
    }

    blueprintToggle.addEventListener("click", () => setBlueprint(!page.classList.contains("is-blueprint")));

    // Escape puts it away from anywhere, like any overlay, without moving focus.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && page.classList.contains("is-blueprint")) setBlueprint(false);
    });

    let queued = false;
    const rebuild = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        build();
      });
    };

    new ResizeObserver(rebuild).observe(page);
    document.fonts?.ready.then(rebuild);
  }
</script>

<style>
  .split-layout {
    min-height: 100vh;
    padding: 0 var(--page-padding);
    /* Kept above the intro scrim's stacking context so the hand-off has
       something to land on. */
    position: relative;
    z-index: 1;
  }

  .split-inner {
    display: flex;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .left-panel {
    position: sticky;
    top: var(--nav-height);
    width: 50%;
    height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .headline-block {
    /* Nudge up to counter the nav bar eating into the visible viewport,
       so the block reads as centered on the whole page, not just this panel. */
    transform: translateY(calc(var(--nav-height) / -2));
  }

  .sticky-title {
    max-width: 100%;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 50px);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .tagline {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Two actions, one clearly first: the work is filled, the blueprint is an
     outline beside it, so the extra never outranks the reason people came. */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: var(--space-5);
  }

  .view-all-link,
  .blueprint-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.6;
    border-radius: 999px;
    padding: 11px 22px;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  .view-all-link {
    color: var(--color-bg);
    background: var(--color-text);
    border: 1px solid var(--color-text);
  }

  .view-all-link:hover {
    color: var(--color-bg);
    background: #333333;
    border-color: #333333;
  }

  .blueprint-toggle {
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    cursor: pointer;
  }

  .blueprint-toggle:hover {
    border-color: var(--color-text);
  }

  .blueprint-toggle[aria-pressed="true"] {
    color: #ffffff;
    background: var(--blueprint);
    border-color: var(--blueprint);
  }

  .view-all-link:focus-visible,
  .blueprint-toggle:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  /*
    The blueprint. Drawn in the site's own link blue, so the page is annotated
    in a color the system already has rather than one invented for it. White
    on it is 6.7:1.
  */
  .split-layout {
    --blueprint: var(--color-link);
  }

  .headline-block {
    position: relative;
  }

  .blueprint-tags {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .blueprint-columns {
    position: fixed;
    top: 0;
    bottom: 0;
    display: grid;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .split-layout.is-blueprint .blueprint-columns {
    opacity: 1;
  }

  .blueprint-columns :global(span) {
    background: color-mix(in srgb, var(--blueprint) 5%, transparent);
    border-inline: 1px solid color-mix(in srgb, var(--blueprint) 22%, transparent);
  }

  .split-layout.is-blueprint [data-spec="box"] {
    outline: 1px dashed var(--blueprint);
    outline-offset: -1px;
  }

  .split-layout.is-blueprint [data-spec="type"] {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--blueprint) 55%, transparent);
  }

  .blueprint-tags :global(.blueprint-tag) {
    position: absolute;
    white-space: nowrap;
    padding: 3px 6px;
    border-radius: 3px;
    background: var(--blueprint);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.01em;
    animation: blueprint-in 0.25s ease both;
  }

  .blueprint-tags :global(.blueprint-line) {
    position: absolute;
    width: 1px;
    background: var(--blueprint);
    animation: blueprint-in 0.25s ease both;
  }

  /* End caps, so a line reads as a measurement rather than a rule. */
  .blueprint-tags :global(.blueprint-line::before),
  .blueprint-tags :global(.blueprint-line::after) {
    content: "";
    position: absolute;
    left: -4px;
    width: 9px;
    height: 1px;
    background: var(--blueprint);
  }

  .blueprint-tags :global(.blueprint-line::before) {
    top: 0;
  }

  .blueprint-tags :global(.blueprint-line::after) {
    bottom: 0;
  }

  @keyframes blueprint-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blueprint-columns {
      transition: none;
    }

    .blueprint-tags :global(.blueprint-tag),
    .blueprint-tags :global(.blueprint-line) {
      animation: none;
    }
  }

  /*
    A rail in the left margin, centered on the screen and fixed there, so it
    holds one position for the whole page instead of belonging to any section.

    It is two things in sequence. Before the page moves it is an invitation: a
    segment travels down the track under a label. Once the page moves it is a
    reading of how far through you are, the same track filling from the top.
    Nothing is swapped out between the two; the fill and the traveller trade
    places on one line.

    Sized to live inside the page's own margin: a quarter of the space either
    side of the content column puts it between the viewport edge and the text,
    and the clamp keeps it off both when that space runs out.
  */
  .scroll-rail {
    position: fixed;
    left: clamp(14px, calc((100vw - var(--max-width)) / 4), 72px);
    top: 50%;
    /* The rail's box is the track and nothing else, so this centers the line
       itself. The label hangs off it absolutely for the same reason: in flow
       it would push the track down by its own height and the bar would sit
       below the middle of the screen. */
    height: 180px;
    transform: translateY(-50%);
    z-index: 3;
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
  }

  .scroll-rail.visible {
    opacity: 1;
  }

  /* Vertical, because the margin it sits in is narrower than the word. */
  .scroll-rail-label {
    position: absolute;
    bottom: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    writing-mode: vertical-rl;
    transition: opacity 0.5s ease;
  }

  /* The label is the invitation, and the invitation is spent once the page
     moves. The track carries on as the progress reading. */
  .scroll-rail.is-scrolled .scroll-rail-label {
    opacity: 0;
  }

  .scroll-rail-track {
    position: relative;
    display: block;
    width: 1px;
    height: 100%;
    background: var(--color-border);
    overflow: hidden;
  }

  /* Progress. Scaled rather than resized, so it is a transform per frame
     instead of a layout pass, and anchored to the top so it grows downward. */
  .scroll-rail-fill {
    position: absolute;
    inset: 0 auto auto 0;
    width: 1px;
    height: 100%;
    background: var(--color-text);
    transform-origin: top;
    transform: scaleY(var(--progress, 0));
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .scroll-rail.is-scrolled .scroll-rail-fill {
    opacity: 1;
  }

  /* The traveller: only ever visible before the first scroll, which is what
     keeps the rail an invitation until it has a reading to give. */
  .scroll-rail-track::after {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 1px;
    height: 22%;
    background: var(--color-text);
    animation: scroll-rail-travel 2.6s cubic-bezier(0.7, 0, 0.3, 1) infinite;
    transition: opacity 0.4s ease;
  }

  .scroll-rail.is-scrolled .scroll-rail-track::after {
    opacity: 0;
    animation: none;
  }

  @keyframes scroll-rail-travel {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      transform: translateY(455%);
      opacity: 0;
    }
  }

  /* Reduced motion keeps both readings and drops the travel: the invitation
     becomes a still mark, the progress still tracks. */
  @media (prefers-reduced-motion: reduce) {
    .scroll-rail-track::after {
      animation: none;
      height: 100%;
      opacity: 0.3;
    }
  }

  .entrance-hidden {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .entrance-hidden.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .right-panel {
    width: 50%;
  }

  .scroll-spacer {
    height: 0;
  }

  .project-row {
    display: block;
    color: var(--color-text);
    padding: var(--space-8) 0;
  }

  .cell-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-tag-bg);
    margin-bottom: var(--space-4);
  }

  .cell-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-title {
    font-size: 22px;
    font-weight: 300;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  @media (hover: hover) {
    .project-row:hover .cell-image :global(img) {
      transform: scale(1.03);
    }
  }

  .project-tags {
