---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getHomepageProjects } from "../data/projects";

const projects = getHomepageProjects();
---

<Layout title="Ryan Sheridan — Designing systems, sites and brands." description="Portfolio of Ryan Sheridan, Principal Designer specializing in design systems, marketing sites, and brand infrastructure.">
  <Nav />
  <main class="split-layout">
    <div class="left-panel">
      <h1 class="sticky-title">Designing systems,<br />sites and brands.</h1>
    </div>
    <div class="right-panel">
      {projects.map((project) => (
        <a href={`/work/${project.slug}`} class="project-row">
          <div class="cell-image">
            {project.thumbnail && <img src={project.thumbnail} alt={project.title} loading="lazy" />}
          </div>
          <div class="cell-info">
            <h2 class="project-title">{project.title}</h2>
            <div class="badge-list project-tags">
              {project.tags.map((tag) => <span class="badge">{tag}</span>)}
            </div>
            <span class="discover-link">View project</span>
          </div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .split-layout {
    display: flex;
    min-height: 100vh;
    padding-top: 0;
  }

  .left-panel {
    position: sticky;
    top: 0;
    width: 50%;
    height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 var(--page-padding);
    flex-shrink: 0;
  }

  .sticky-title {
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .right-panel {
    width: 50%;
  }

  .project-row {
    display: block;
    padding: var(--space-6) var(--page-padding);
    border-bottom: 1px solid var(--color-border);
  }

  .project-row:first-child {
    padding-top: 0;
  }

  .cell-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-tag-bg);
    margin-bottom: var(--space-4);
  }

  .cell-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-title {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
    transition: opacity 0.15s;
  }

  @media (hover: hover) {
    .project-row:hover .project-title {
      opacity: 0.6;
    }

    .project-row:hover .discover-link {
      border-bottom-color: var(--color-text-muted);
    }
  }

  .project-tags {
    margin-bottom: var(--space-3);
  }

  .discover-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--color-text);
    padding-bottom: 1px;
    transition: border-color 0.15s;
  }

  @media (max-width: 768px) {
    .split-layout {
      flex-direction: column;
    }

    .left-panel {
      position: relative;
      width: 100%;
      height: auto;
      padding: 120px var(--page-padding) 48px;
      align-items: flex-start;
    }

    .right-panel {
      width: 100%;
    }

    .project-row {
      padding: var(--space-5) var(--page-padding);
    }
  }
</style>
