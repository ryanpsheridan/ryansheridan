---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getHomepageProjects } from "../data/projects";

const projects = getHomepageProjects();
---

<Layout title="Ryan Sheridan — Designing systems, sites and brands." description="Portfolio of Ryan Sheridan, Principal Designer specializing in design systems, marketing sites, and brand infrastructure.">
  <Nav />
  <main class="split-layout">
    <div class="left-panel">
      <h1 class="sticky-title">Designing systems,<br />sites and brands.</h1>
    </div>
    <div class="right-panel">
      {projects.map((project, i) => (
        <a href={`/work/${project.slug}`} class="project-row">
          <div class="project-number">{String(i + 1).padStart(2, "0")}</div>
          <div class="project-image">
            {project.thumbnail && <img src={project.thumbnail} alt={project.title} loading="lazy" />}
          </div>
          <div class="project-info">
            <h2 class="project-title">{project.title}</h2>
            <div class="project-tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <span class="discover-link">View project</span>
          </div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .split-layout {
    display: flex;
    min-height: 100vh;
    padding-top: 0;
  }

  .left-panel {
    position: sticky;
    top: 0;
    width: 50%;
    height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 var(--page-padding);
    flex-shrink: 0;
  }

  .sticky-title {
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .right-panel {
    width: 50%;
  }

  .project-row {
    display: block;
    padding: 48px var(--page-padding) 48px 40px;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.2s;
    position: relative;
  }

  .project-row:first-child {
    border-top: none;
  }

  @media (hover: hover) {
    .project-row:hover {
      background: var(--color-tag-bg);
    }

    .project-row:hover .project-image img {
      transform: scale(1.02);
    }
  }

  .project-number {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 20px;
    font-variant-numeric: tabular-nums;
  }

  .project-image {
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 24px;
    background: #f3f3f3;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-title {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .tag {
    font-size: 12px;
    font-weight: 400;
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    color: var(--color-tag-text);
    border-radius: 99px;
  }

  .discover-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--color-text);
    padding-bottom: 1px;
  }

  @media (max-width: 768px) {
    .split-layout {
      flex-direction: column;
    }

    .left-panel {
      position: relative;
      width: 100%;
      height: auto;
      padding: 120px var(--page-padding) 48px;
      align-items: flex-start;
    }

    .right-panel {
      width: 100%;
    }

    .project-row {
      padding: 40px var(--page-padding);
    }
  }
</style>
