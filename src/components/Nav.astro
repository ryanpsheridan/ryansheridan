---

---

<nav>
  <div class="nav-inner">
    <a href="/" class="logo">ryan sheridan design</a>
    <div class="nav-actions">
      <button class="hamburger" aria-label="Menu" aria-expanded="false">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<div class="menu-overlay" aria-hidden="true">
  <div class="menu-content">
    <a href="/" class="menu-link">Home</a>
    <a href="/work" class="menu-link">Work</a>
    <a href="/about" class="menu-link">About</a>
    <a href="/contact" class="menu-link">Contact</a>
    <a
      href="https://www.linkedin.com/in/ryansheridandesign/"
      target="_blank"
      rel="noopener noreferrer"
      class="menu-link menu-link-external"
    >
      LinkedIn <span class="arrow">&nearr;</span>
    </a>
  </div>
  <a href="/start-a-project" class="menu-cta">
    Start a website project <span class="arrow">&nearr;</span>
  </a>
</div>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 200;
    padding: 18px var(--page-padding);
    background: var(--color-bg);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 14.4px;
    font-weight: 400;
    letter-spacing: -0.01em;
    position: relative;
    z-index: 300;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .hamburger {
    position: relative;
    z-index: 300;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 0;
  }

  .hamburger span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--color-text);
    transition: transform 0.3s, opacity 0.3s;
  }

  .hamburger.active span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .hamburger.active span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .menu-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .menu-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .menu-link {
    font-size: 32px;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-text);
    transition: color 0.2s;
  }

  .menu-link:hover {
    color: var(--color-text-muted);
  }

  .menu-link-external .arrow {
    font-size: 24px;
  }

  .menu-cta {
    display: none;
  }

  @media (max-width: 768px) {
    .menu-cta {
      position: absolute;
      left: var(--page-padding);
      right: var(--page-padding);
      bottom: calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 16px 28px;
      border-radius: 999px;
      font-size: 17px;
      font-weight: 500;
      letter-spacing: -0.01em;
      color: var(--color-bg);
      background: var(--color-text);
      transition: opacity 0.2s;
    }

    .menu-cta:hover {
      color: var(--color-bg);
      opacity: 0.85;
    }

    .menu-cta:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: 3px;
    }

    .menu-cta .arrow {
      font-size: 13px;
    }
  }
</style>

<script>
  const hamburger = document.querySelector(".hamburger")!;
  const overlay = document.querySelector(".menu-overlay")!;

  hamburger.addEventListener("click", () => {
    const isOpen = hamburger.classList.toggle("active");
    overlay.classList.toggle("open", isOpen);
    hamburger.setAttribute("aria-expanded", String(isOpen));
    overlay.setAttribute("aria-hidden", String(!isOpen));
    document.body.style.overflow = isOpen ? "hidden" : "";
  });

  overlay.querySelectorAll(".menu-link, .menu-cta").forEach((link) => {
    link.addEventListener("click", () => {
      hamburger.classList.remove("active");
      overlay.classList.remove("open");
      hamburger.setAttribute("aria-expanded", "false");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    });
  });
</script>
