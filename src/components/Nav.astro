---

---

<nav>
  <div class="nav-inner">
    <a href="/" class="logo">ryan sheridan design</a>
    <div class="nav-actions">
      <button type="button" class="theme-btn" aria-label="Dark mode" aria-pressed="false" data-theme-toggle>
        <!-- Moon on light, sun on dark: the icon shows where a press goes. -->
        <svg class="theme-icon is-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
        </svg>
        <svg class="theme-icon is-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
        </svg>
      </button>
      <button type="button" class="hamburger" aria-label="Menu" aria-expanded="false" aria-controls="site-menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<div class="menu-overlay" id="site-menu" inert>
  <div class="menu-content">
    <a href="/" class="menu-link">Home</a>
    <a href="/work" class="menu-link">Work</a>
    <a href="/about" class="menu-link">About</a>
    <a href="/contact" class="menu-link">Contact</a>
    <a
      href="https://www.linkedin.com/in/ryansheridandesign/"
      target="_blank"
      rel="noopener noreferrer"
      class="menu-link menu-link-external"
    >
      LinkedIn <span class="arrow">&nearr;</span>
    </a>
  </div>
</div>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    /* 8 + the 48px menu button + 8 = --nav-height. */
    padding: var(--space-2) var(--page-padding);
    background: var(--color-bg);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-s);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-snug);
    position: relative;
    z-index: 300;
  }

  .nav-actions {
    display: flex;
    align-items: center;
  }

  /* Same 48px target as the menu button beside it, with no fill, so it sits
     in the nav as quietly as the logo. */
  .theme-btn {
    position: relative;
    z-index: 300;
    width: var(--control-md);
    height: var(--control-md);
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--color-text);
    background: none;
    border: 0;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .theme-btn:hover {
    color: var(--color-text-muted);
  }

  .theme-icon {
    grid-area: 1 / 1;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity var(--duration-moderate) var(--ease-standard),
      transform var(--duration-moderate) var(--ease-emphasized);
  }

  .theme-btn .is-sun,
  .theme-btn[aria-pressed="true"] .is-moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }

  .theme-btn[aria-pressed="true"] .is-sun {
    opacity: 1;
    transform: none;
  }

  .hamburger {
    position: relative;
    z-index: 300;
    /* 48px to meet the touch target guideline. The negative margin keeps
       the bars lined up with the content edge, as the old 32px box did. */
    width: var(--control-md);
    height: var(--control-md);
    margin-right: calc(var(--space-2) * -1);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 0;
  }

  .hamburger span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--color-text);
    transition:
      transform var(--duration-moderate) var(--ease-standard),
      opacity var(--duration-moderate) var(--ease-standard);
  }

  .hamburger.active span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .hamburger.active span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-moderate) var(--ease-standard);
  }

  .menu-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .menu-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .menu-link {
    font-size: var(--text-h3);
    font-weight: var(--weight-regular);
    letter-spacing: -0.02em;
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .menu-link:hover {
    color: var(--color-text-muted);
  }

  .menu-link-external .arrow {
    font-size: var(--text-h4);
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger span,
    .menu-overlay,
    .theme-icon {
      transition: none;
    }
  }
</style>

<script>
  import { onThemeChange, toggleTheme } from "../scripts/theme";

  const themeBtn = document.querySelector<HTMLButtonElement>(".theme-btn")!;
  themeBtn.addEventListener("click", toggleTheme);
  onThemeChange((theme) => themeBtn.setAttribute("aria-pressed", String(theme === "dark")));

  const hamburger = document.querySelector<HTMLButtonElement>(".hamburger")!;
  const overlay = document.querySelector<HTMLElement>(".menu-overlay")!;

  // Closed, the menu is inert: invisible links stay out of the tab order and
  // away from screen readers. Open, it takes over the page, so Escape closes
  // it and focus goes back to the button that opened it.
  function setMenu(open: boolean) {
    hamburger.classList.toggle("active", open);
    overlay.classList.toggle("open", open);
    overlay.inert = !open;
    hamburger.setAttribute("aria-expanded", String(open));
    hamburger.setAttribute("aria-label", open ? "Close menu" : "Menu");
    document.body.style.overflow = open ? "hidden" : "";
  }

  hamburger.addEventListener("click", () => setMenu(!overlay.classList.contains("open")));

  overlay.querySelectorAll(".menu-link").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && overlay.classList.contains("open")) {
      setMenu(false);
      hamburger.focus();
    }
  });
</script>
