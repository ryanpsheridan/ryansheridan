<nav>
  <div class="nav-inner">
    <a href="/" class="logo">ryan sheridan design</a>
    <div class="nav-actions">
      {/* Desktop shows every destination in the bar; below 769px they fold
          into the menu. Home is left out here, since the logo is the way
          home. */}
      <ul class="nav-links">
        <li><a href="/work">Work</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li>
          <a href="https://www.linkedin.com/in/ryansheridandesign/" target="_blank" rel="noopener noreferrer">
            LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>
      <button type="button" class="hamburger" aria-label="Menu" aria-expanded="false" aria-controls="site-menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<div class="menu-overlay" id="site-menu" inert>
  <div class="menu-content">
    <a href="/" class="menu-link">Home</a>
    <a href="/work" class="menu-link">Work</a>
    <a href="/about" class="menu-link">About</a>
    <a href="/contact" class="menu-link">Contact</a>
    <a
      href="https://www.linkedin.com/in/ryansheridandesign/"
      target="_blank"
      rel="noopener noreferrer"
      class="menu-link menu-link-external"
    >
      LinkedIn <span class="arrow">&nearr;</span>
    </a>
  </div>
</div>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    /* 8 + the 48px menu button + 8 = --nav-height (64px) on smaller
       screens. Desktop gives it more air below. */
    padding: var(--space-2) var(--page-padding);
    background: var(--color-bg);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-s);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-snug);
    position: relative;
    z-index: 300;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Set exactly like the logo, so the bar reads as one line of type. Hover
     and the current page are marked with an underline, not a color. */
  .nav-links a {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-s);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-snug);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    color: var(--color-text);
    text-decoration-color: currentColor;
  }

  /* Wide enough for the links, the bar carries them and the menu button
     steps aside. Kept in step with the homepage's split breakpoint. */
  @media (min-width: 769px) {
    /* 16 + 48 + 16 = the desktop --nav-height (80px). */
    nav {
      padding-top: var(--space-3);
      padding-bottom: var(--space-3);
    }

    .nav-inner {
      min-height: var(--control-md);
    }

    .nav-links {
      display: flex;
    }
  }

  .hamburger {
    position: relative;
    z-index: 300;
    /* 48px to meet the touch target guideline. The negative margin keeps
       the bars lined up with the content edge, as the old 32px box did. */
    width: var(--control-md);
    height: var(--control-md);
    margin-right: calc(var(--space-2) * -1);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 0;
  }

  @media (min-width: 769px) {
    .hamburger {
      display: none;
    }
  }

  .hamburger span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--color-text);
    transition:
      transform var(--duration-moderate) var(--ease-standard),
      opacity var(--duration-moderate) var(--ease-standard);
  }

  .hamburger.active span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .hamburger.active span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-moderate) var(--ease-standard);
  }

  .menu-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .menu-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .menu-link {
    font-size: var(--text-h3);
    font-weight: var(--weight-regular);
    letter-spacing: -0.02em;
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .menu-link:hover {
    color: var(--color-text-muted);
  }

  .menu-link-external .arrow {
    font-size: var(--text-h4);
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger span,
    .menu-overlay {
      transition: none;
    }
  }
</style>

<script>
  const hamburger = document.querySelector<HTMLButtonElement>(".hamburger")!;
  const overlay = document.querySelector<HTMLElement>(".menu-overlay")!;

  // Closed, the menu is inert: invisible links stay out of the tab order and
  // away from screen readers. Open, it takes over the page, so Escape closes
  // it and focus goes back to the button that opened it.
  function setMenu(open: boolean) {
    hamburger.classList.toggle("active", open);
    overlay.classList.toggle("open", open);
    overlay.inert = !open;
    hamburger.setAttribute("aria-expanded", String(open));
    hamburger.setAttribute("aria-label", open ? "Close menu" : "Menu");
    document.body.style.overflow = open ? "hidden" : "";
  }

  hamburger.addEventListener("click", () => setMenu(!overlay.classList.contains("open")));

  overlay.querySelectorAll(".menu-link").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  // Widening past the breakpoint hides the menu button, so don't leave the
  // overlay open with no way to close it.
  matchMedia("(min-width: 769px)").addEventListener("change", (event) => {
    if (event.matches && overlay.classList.contains("open")) setMenu(false);
  });

  // Mark the current section in the bar.
  const path = location.pathname.replace(/\/$/, "");
  document.querySelectorAll<HTMLAnchorElement>(".nav-links a").forEach((link) => {
    const href = link.getAttribute("href")!;
    if (href.startsWith("/") && (path === href || path.startsWith(`${href}/`))) link.setAttribute("aria-current", "page");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && overlay.classList.contains("open")) {
      setMenu(false);
      hamburger.focus();
    }
  });
</script>
