---
interface Props {
  showBack?: boolean;
}

const { showBack = false } = Astro.props;
---

<nav>
  <div class="nav-inner">
    <a href="/" class="logo">rsd</a>
    <div class="nav-links">
      {showBack ? <a href="/">Home</a> : <a href="#work">Work</a>}
    </div>
  </div>
</nav>

<style>
  nav {
    padding: 24px var(--page-padding);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .nav-links a {
    font-size: 14px;
    font-weight: 400;
    color: var(--color-text);
  }

  .nav-links a:hover {
    color: var(--color-text-muted);
  }
</style>
