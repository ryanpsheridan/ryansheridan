---
/**
 * The /work list, shared by /work and every project type and tool page
 * (/work/type/…, /work/tool/…). Breadcrumbs and title on the left, a
 * dropdown on the right that jumps between those pages, then one row per
 * project: thumbnail, title, type badges and summary, and "View project".
 * Documented at /ds/patterns/project-card.
 */
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import Media from "./Media.astro";
import Breadcrumbs from "./ui/Breadcrumbs.astro";
import Select from "./ui/Select.astro";
import { workProjects, projectTypes, projectTools, typeHref, toolHref, type Facet } from "../data/work";
import { SITE_URL, WEBSITE_ID, breadcrumbSchema } from "../data/schema";

interface Props {
  /** The type or tool this page lists. Leave out for all work. */
  active?: { kind: "type" | "tool"; facet: Facet };
}

const { active } = Astro.props;

const list = active
  ? workProjects.filter((p) => (active.kind === "type" ? p.tags : p.tools).includes(active.facet.name))
  : workProjects;

const title = active ? active.facet.name : "All work";
const path = active ? (active.kind === "type" ? typeHref : toolHref)(active.facet.name) : "/work";
const crumbs = active
  ? [{ label: "Home", href: "/" }, { label: "Work", href: "/work" }, { label: active.facet.name }]
  : [{ label: "Home", href: "/" }, { label: "Work" }];

const schema = [
  {
    "@type": "CollectionPage",
    name: title,
    isPartOf: { "@id": WEBSITE_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: list.map((project, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE_URL}/work/${project.slug}`,
        name: project.title,
      })),
    },
  },
  breadcrumbSchema(
    active
      ? [
          { name: "Work", path: "/work" },
          { name: active.facet.name, path },
        ]
      : [{ name: "Work", path: "/work" }],
  ),
];
---

<Layout
  title={`${active ? `${active.facet.name} work` : "Work"} — Ryan Sheridan`}
  description={active
    ? `${active.facet.name} work by Ryan Sheridan.`
    : "Case studies by Ryan Sheridan: multi-brand design systems, brand identities, Webflow and Makeswift websites, illustration, and AI design workflows."}
  schema={schema}
  noindex
>
  <Nav />
  <main id="main" class="work-page">
    <div class="work-inner">
      {/* Title on the left, the dropdown on the right, both sitting on the
          title's baseline. */}
      <header class="work-header">
        <div>
          <Breadcrumbs items={crumbs} />
          <h1>{title}</h1>
        </div>
        <div class="work-filter">
          <label for="work-browse" class="visually-hidden">Browse by project type or tool</label>
          <Select id="work-browse" data-work-browse>
            <option value="/work" selected={!active}>All projects ({workProjects.length})</option>
            <optgroup label="Project type">
              {projectTypes.map((t) => (
                <option value={typeHref(t.name)} selected={active?.kind === "type" && active.facet.name === t.name}>
                  {t.name} ({t.count})
                </option>
              ))}
            </optgroup>
            <optgroup label="Tools">
              {projectTools.map((t) => (
                <option value={toolHref(t.name)} selected={active?.kind === "tool" && active.facet.name === t.name}>
                  {t.name} ({t.count})
                </option>
              ))}
            </optgroup>
          </Select>
        </div>
      </header>

      <ul class="project-list">
        {
          list.map((project) => (
            <li class="project-row">
              <a href={`/work/${project.slug}`} class="row-thumb" tabindex="-1" aria-hidden="true">
                {project.thumbnail && <Media src={project.thumbnail} alt="" />}
              </a>
              <div class="row-body">
                <h2>
                  <a href={`/work/${project.slug}`} class="row-link">{project.title}</a>
                </h2>
                <div class="badge-list">
                  {project.tags.map((tag) => (
                    <a
                      href={typeHref(tag)}
                      class="badge"
                      aria-current={active?.kind === "type" && active.facet.name === tag ? "page" : undefined}
                    >
                      {tag}
                    </a>
                  ))}
                </div>
                <p class="row-description">{project.description}</p>
              </div>
              <span class="row-cta" aria-hidden="true">
                View project
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 10h12M11 5l5 5-5 5" />
                </svg>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: var(--page-top) var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-bottom: 80px;
  }

  .work-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }

  h1 {
    font-size: var(--text-h2);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .work-filter {
    flex: 0 0 auto;
    width: 260px;
  }

  /* A lighter edge than a form field: here the dropdown is a quiet tool
     beside the title, and the chevron already says what it is. It darkens
     on hover and on keyboard focus. */
  .work-filter :global(.input) {
    border-color: var(--color-border);
  }

  .work-filter :global(.input:hover) {
    border-color: var(--color-border-strong);
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* One project per row, split by a hairline: thumbnail on the left, then
     the name, tags and summary as one column, then the link out on its own at
     the far right. Generous gutters and padding keep each row breathing. */
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) auto;
    grid-template-areas: "thumb body cta";
    column-gap: var(--space-7);
    align-items: start;
    padding: var(--space-7) 0;
    border-top: 1px solid var(--color-border);
  }

  .row-body {
    grid-area: body;
    /* Keeps the summary to a comfortable measure on wide screens, leaving
       open space between the text and the link. */
    max-width: 52ch;
  }

  .row-body h2 {
    font-size: var(--text-h5);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-1);
  }

  .row-body h2 + .badge-list {
    margin-top: var(--space-3);
  }

  .row-link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The title link covers the whole row, so the thumbnail and the CTA are
     click targets too, without nesting everything inside one long link. The
     badges sit above it as links of their own. */
  .row-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .row-link:focus-visible {
    outline: none;
  }

  .row-link:focus-visible::after {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  /* Same frame as the homepage cards: 16:10, cropped to fill. The thumbnail is
     its own link (hidden from assistive tech, since the title link already
     names the project) so a click on the image always lands, even while the
     hover zoom lifts it above the row-wide title link. */
  .row-thumb {
    grid-area: thumb;
    display: block;
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface);
  }

  .row-thumb :global(img),
  .row-thumb :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .row-description {
    margin-top: var(--space-4);
    font-size: var(--text-m);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .row-cta {
    grid-area: cta;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-l);
    color: var(--color-text);
    white-space: nowrap;
  }

  .row-cta svg {
    width: 18px;
    height: 18px;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  @media (hover: hover) {
    .project-row:hover .row-cta svg {
      transform: translateX(4px);
    }

    .project-row:hover .row-thumb :global(img),
    .project-row:hover .row-thumb :global(video) {
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-cta svg,
    .row-thumb :global(img),
    .row-thumb :global(video) {
      transition: none;
    }
  }

  /* Tablet: the link drops under the summary so the image and text keep room. */
  @media (max-width: 1024px) {
    .project-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "thumb body"
        "thumb cta";
      grid-template-rows: auto 1fr;
      column-gap: var(--space-5);
      row-gap: var(--space-4);
      padding: var(--space-6) 0;
    }
  }

  /* Phone: the dropdown drops under the title at full width, and each row
     stacks thumbnail, name and summary, link. */
  @media (max-width: 768px) {
    .work-header {
      flex-direction: column;
      align-items: stretch;
    }

    .work-filter {
      width: 100%;
    }

    .project-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "thumb"
        "body"
        "cta";
      grid-template-rows: none;
      gap: var(--space-4);
      padding: var(--space-5) 0;
      /* Stacked rows read as separate cards on their own, so no rules. */
      border-top: none;
    }
  }
</style>

<script>
  // Choosing a type or tool goes to its page.
  const browse = document.querySelector<HTMLSelectElement>("[data-work-browse]");
  browse?.addEventListener("change", () => {
    window.location.href = browse.value;
  });
</script>
