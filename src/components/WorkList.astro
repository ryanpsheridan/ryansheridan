---
/**
 * The /work grid, shared by /work, every project type and tool page
 * (/work/type/…, /work/tool/…) and the private /all page. Breadcrumbs and
 * title on the left, a dropdown on the right that jumps between the public
 * pages, then a three-column grid of cards, newest first: the 16:10
 * thumbnail (with a Draft badge top-left on drafts), then the title and up
 * to two type badges.
 * With `everything`, it is the private /all page: drafts are listed in
 * production too, and the dropdown is left out because the type and tool
 * pages only list published work.
 * Documented at /ds/patterns/project-card.
 */
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import Media from "./Media.astro";
import Breadcrumbs from "./ui/Breadcrumbs.astro";
import Select from "./ui/Select.astro";
import { workProjects, allWorkProjects, projectTypes, projectTools, typeHref, toolHref, type Facet } from "../data/work";
import { SITE_URL, WEBSITE_ID, breadcrumbSchema } from "../data/schema";

interface Props {
  /** The type or tool this page lists. Leave out for all work. */
  active?: { kind: "type" | "tool"; facet: Facet };
  /** List drafts too, in production as well. Only for the private /all page. */
  everything?: boolean;
}

const { active, everything = false } = Astro.props;

const list = active
  ? workProjects.filter((p) => (active.kind === "type" ? p.tags : p.tools).includes(active.facet.name))
  : everything
    ? allWorkProjects
    : workProjects;

// Up to two type badges. On a type page, that type leads so the badge
// matching the page always shows, even if it's third in the project's list.
const shownTags = (tags: string[]) =>
  (active?.kind === "type" && tags.includes(active.facet.name)
    ? [active.facet.name, ...tags.filter((t) => t !== active.facet.name)]
    : tags
  ).slice(0, 2);

const title = active ? active.facet.name : everything ? "All projects" : "All work";
const path = active ? (active.kind === "type" ? typeHref : toolHref)(active.facet.name) : everything ? "/all" : "/work";
const crumbs = active
  ? [{ label: "Home", href: "/" }, { label: "Work", href: "/work" }, { label: active.facet.name }]
  : everything
    ? [{ label: "Home", href: "/" }, { label: "All projects" }]
    : [{ label: "Home", href: "/" }, { label: "Work" }];

const schema = [
  {
    "@type": "CollectionPage",
    name: title,
    isPartOf: { "@id": WEBSITE_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: list.map((project, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE_URL}/work/${project.slug}`,
        name: project.title,
      })),
    },
  },
  breadcrumbSchema(
    active
      ? [
          { name: "Work", path: "/work" },
          { name: active.facet.name, path },
        ]
      : [{ name: everything ? "All projects" : "Work", path }],
  ),
];
---

<Layout
  title={`${active ? `${active.facet.name} work` : everything ? "All projects" : "Work"} — Ryan Sheridan`}
  description={active
    ? `${active.facet.name} work by Ryan Sheridan.`
    : "Case studies by Ryan Sheridan: multi-brand design systems, brand identities, Webflow and Makeswift websites, illustration, and AI design workflows."}
  schema={schema}
  noindex
>
  <Nav />
  <main id="main" class="work-page">
    <div class="work-inner">
      {/* Title on the left, the dropdown on the right, both sitting on the
          title's baseline. */}
      <header class="work-header">
        <div>
          <Breadcrumbs items={crumbs} />
          <h1>{title}</h1>
        </div>
        {!everything && <div class="work-filter">
          <label for="work-browse" class="visually-hidden">Browse by project type or tool</label>
          <Select id="work-browse" data-work-browse>
            <option value="/work" selected={!active}>All projects ({workProjects.length})</option>
            <optgroup label="Project type">
              {projectTypes.map((t) => (
                <option value={typeHref(t.name)} selected={active?.kind === "type" && active.facet.name === t.name}>
                  {t.name} ({t.count})
                </option>
              ))}
            </optgroup>
            <optgroup label="Tools">
              {projectTools.map((t) => (
                <option value={toolHref(t.name)} selected={active?.kind === "tool" && active.facet.name === t.name}>
                  {t.name} ({t.count})
                </option>
              ))}
            </optgroup>
          </Select>
        </div>}
      </header>

      <ul class="project-grid">
        {list.map((project) => (
          <li class="project-card">
            <div class="card-thumb">
              {project.thumbnail && <Media src={project.thumbnail} alt="" />}
              {project.draft && <span class="badge thumb-badge badge-draft" aria-hidden="true">Draft</span>}
            </div>
            <h2 class="card-title">
              <a href={`/work/${project.slug}`} class="card-link">
                {project.title}{project.draft && <span class="visually-hidden">, draft</span>}
              </a>
            </h2>
            <div class="badge-list">
              {shownTags(project.tags).map((tag) => (
                <a
                  href={typeHref(tag)}
                  class="badge"
                  aria-current={active?.kind === "type" && active.facet.name === tag ? "page" : undefined}
                >
                  {tag}
                </a>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: var(--page-top) var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-bottom: 80px;
  }

  .work-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }

  h1 {
    font-size: var(--text-h2);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .work-filter {
    flex: 0 0 auto;
    width: 260px;
  }

  /* A lighter edge than a form field: here the dropdown is a quiet tool
     beside the title, and the chevron already says what it is. It darkens
     on hover and on keyboard focus. */
  .work-filter :global(.input) {
    border-color: var(--color-border);
  }

  .work-filter :global(.input:hover) {
    border-color: var(--color-border-strong);
  }

  /* Three across on desktop, two on tablet, one on a phone. */
  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7) var(--space-5);
  }

  .project-card {
    position: relative;
  }

  /* Same frame as the homepage cards: 16:10, cropped to fill. */
  .card-thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--color-surface);
  }

  .card-thumb :global(img),
  .card-thumb :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  /* The Draft badge pinned to the image's top-left. A solid page-colored
     fill keeps it legible over any artwork. */
  .thumb-badge {
    position: absolute;
    z-index: 1;
    background: var(--color-bg);
  }

  .badge-draft {
    top: var(--space-3);
    left: var(--space-3);
    border-style: dashed;
    color: var(--color-text);
  }

  .card-title {
    margin: var(--space-4) 0 0;
    font-size: var(--text-l);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }

  .card-title + .badge-list {
    margin-top: var(--space-3);
  }

  .card-link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The title link covers the whole card, so the thumbnail is a click
     target too. The type badges sit above it as links of their own. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card-link:focus-visible::after {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .project-card:hover .card-thumb :global(img),
    .project-card:hover .card-thumb :global(video) {
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-thumb :global(img),
    .card-thumb :global(video) {
      transition: none;
    }
  }

  @media (max-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Phone: the dropdown drops under the title at full width, and the grid
     goes to one column. */
  @media (max-width: 768px) {
    .work-header {
      flex-direction: column;
      align-items: stretch;
    }

    .work-filter {
      width: 100%;
    }

    .project-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>

<script>
  // Choosing a type or tool goes to its page.
  const browse = document.querySelector<HTMLSelectElement>("[data-work-browse]");
  browse?.addEventListener("change", () => {
    window.location.href = browse.value;
  });
</script>
