---
import Breadcrumbs from "./ui/Breadcrumbs.astro";

interface Item {
  desc: string;
  /** Leave out on every line to drop the Qty and Rate columns. */
  qty?: number;
  /** Price per unit, or the whole line amount when there is no qty. 0 prints "Included". */
  rate: number;
}

interface Props {
  /** Breadcrumb label for the current page. */
  crumb: string;
  invoiceNumber?: string;
  /** Shown as written, e.g. "Oct 25, 2026". */
  date: string;
  due: string;
  /** One entry per line of the Bill to block. */
  billTo: string[];
  items: Item[];
  notes?: string;
}

const { crumb, invoiceNumber, date, due, billTo, items, notes } = Astro.props;

const hasQty = items.some((item) => item.qty !== undefined);
const money = (n: number) => n.toLocaleString("en-US", { style: "currency", currency: "USD" });
const lines = items.map((item) => {
  const qty = item.qty ?? 1;
  return { ...item, qty, amount: qty * item.rate, included: item.rate === 0 };
});
const total = lines.reduce((sum, line) => sum + line.amount, 0);

const venmoUrl = "https://venmo.com/u/ryan-sheridan-44";
---

<main id="main" class:list={["invoice-page", { "has-qty": hasQty }]}>
  <Breadcrumbs class="page-crumbs" items={[{ label: "Home", href: "/" }, { label: crumb }]} />

  <div class="invoice-toolbar">
    <button id="print-btn" type="button" class="btn btn-secondary btn-sm">Download PDF</button>
  </div>

  <div class="sheet">
    <header class="invoice-header">
      <div>
        <h1>Invoice</h1>
        <p class="from-name">Ryan Sheridan</p>
      </div>
      <ul class="contact-list">
        <li><a href="mailto:ryansheridandesign@gmail.com">ryansheridandesign@gmail.com</a></li>
        <li><a href="tel:+17204278262">720-427-8262</a></li>
        <li><a href="https://ryansheridan.studio/" target="_blank" rel="noopener noreferrer">ryansheridan.studio</a></li>
      </ul>
    </header>

    <hr class="divider" />

    <section class="parties">
      <div class="bill-to">
        <p class="label">Bill to</p>
        <p class="bill-lines">
          {billTo.map((line) => <span>{line}</span>)}
        </p>
      </div>
      <dl class="meta">
        {
          invoiceNumber && (
            <div class="meta-row">
              <dt class="label">Invoice no.</dt>
              <dd>{invoiceNumber}</dd>
            </div>
          )
        }
        <div class="meta-row">
          <dt class="label">Date</dt>
          <dd>{date}</dd>
        </div>
        <div class="meta-row">
          <dt class="label">Due</dt>
          <dd>{due}</dd>
        </div>
      </dl>
    </section>

    <section class="items">
      <div class="item-head" aria-hidden="true">
        <span>Description</span>
        {hasQty && <span class="num">Qty</span>}
        {hasQty && <span class="num">Rate</span>}
        <span class="num">Amount</span>
      </div>
      <ul class="item-list">
        {
          lines.map((line) => (
            <li class="item-row">
              <span class="desc">{line.desc}</span>
              {hasQty && (
                <span class="num qty">
                  <span class="mobile-label">Qty </span>
                  {line.qty}
                </span>
              )}
              {hasQty && (
                <span class="num rate">
                  <span class="mobile-label">Rate </span>
                  {money(line.rate)}
                </span>
              )}
              <span class="num amount">{line.included ? "Included" : money(line.amount)}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="summary">
      <p class="pay-line">
        Pay with Venmo:{" "}
        <a href={venmoUrl} target="_blank" rel="noopener noreferrer" class="link-underline">venmo.com/u/ryan-sheridan-44</a>
      </p>
      <p class="total">
        <span class="label">Total due</span>
        <span>{money(total)}</span>
      </p>
    </section>

    {
      notes && (
        <section class="notes">
          <p class="label">Notes</p>
          <p class="notes-text">{notes}</p>
        </section>
      )
    }
  </div>
</main>

<script>
  document.getElementById("print-btn")?.addEventListener("click", () => window.print());
</script>

<style>
  /* No weight on this page goes above 400. */
  .invoice-page {
    padding: var(--page-top) var(--page-padding) 0;
    font-weight: var(--weight-regular);
  }

  .page-crumbs,
  .invoice-toolbar,
  .sheet {
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .invoice-toolbar {
    margin-bottom: var(--space-4);
    display: flex;
    justify-content: flex-end;
  }

  .invoice-toolbar .btn {
    font-weight: var(--weight-regular);
  }

  .invoice-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
  }

  h1 {
    font-size: var(--text-h2);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .from-name {
    font-size: var(--text-s);
    margin-top: var(--space-1);
  }

  .contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .contact-list a {
    text-decoration: underline;
    text-decoration-color: var(--color-link-subtle);
    text-underline-offset: 3px;
    transition:
      color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .contact-list a:hover {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-link-hover);
  }

  .divider {
    margin: var(--space-4) 0;
  }

  .label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Bill to on the left, invoice details on the right. */
  .parties {
    display: grid;
    grid-template-columns: 1fr minmax(0, 260px);
    gap: var(--space-5);
  }

  .bill-lines {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-1);
    font-size: var(--text-s);
    line-height: var(--leading-normal);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .meta-row {
    display: grid;
    grid-template-columns: 88px 1fr;
    align-items: baseline;
    font-size: var(--text-s);
  }

  .meta-row dd {
    text-align: right;
  }

  .items {
    margin-top: var(--space-5);
  }

  .item-head,
  .item-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 110px;
    gap: var(--space-3);
    align-items: start;
  }

  .has-qty .item-head,
  .has-qty .item-row {
    grid-template-columns: minmax(0, 1fr) 48px 80px 100px;
  }

  .item-head {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding-bottom: var(--space-1);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .item-list {
    list-style: none;
  }

  .item-row {
    padding: var(--space-2) 0;
    border-bottom: var(--border-width) solid var(--color-border);
    font-size: var(--text-s);
    line-height: var(--leading-normal);
  }

  .num {
    text-align: right;
  }

  .qty,
  .rate,
  .amount {
    font-family: var(--font-mono);
  }

  .mobile-label {
    display: none;
  }

  /* Payment link on the left, total on the right. */
  .summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .pay-line {
    font-size: var(--text-s);
  }

  .total {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    font-size: var(--text-m);
    letter-spacing: var(--tracking-snug);
  }

  .notes {
    margin-top: var(--space-5);
  }

  .notes-text {
    margin-top: var(--space-1);
    font-size: var(--text-s);
    line-height: var(--leading-normal);
    white-space: pre-line;
  }

  @media (max-width: 640px) {
    .invoice-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .contact-list {
      text-align: left;
    }

    .parties {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .meta-row dd {
      text-align: left;
    }

    .item-head {
      display: none;
    }

    .item-row,
    .has-qty .item-row {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--space-1);
      padding: var(--space-3) 0;
    }

    .desc {
      grid-column: 1 / -1;
    }

    /* Without Qty and Rate the amount sits under the description. */
    .item-row .amount {
      grid-column: 1 / -1;
      text-align: left;
    }

    .has-qty .item-row .qty {
      text-align: left;
    }

    .has-qty .item-row .rate {
      text-align: right;
    }

    .has-qty .item-row .amount {
      grid-column: 1 / -1;
      text-align: left;
    }

    .mobile-label {
      display: inline;
      color: var(--color-text-muted);
    }

    .summary {
      flex-direction: column;
    }
  }

  @media print {
    :global(nav),
    :global(footer),
    .page-crumbs,
    .invoice-toolbar {
      display: none !important;
    }

    @page {
      margin: 0.5in 0.6in;
    }

    .invoice-page {
      padding: 0;
    }

    .sheet {
      max-width: 100%;
    }

    :global(body) {
      font-size: 13px;
    }

    h1 {
      font-size: 26px;
    }

    .divider {
      margin: 12px 0;
    }

    .items,
    .summary,
    .notes {
      margin-top: 14px;
    }

    .item-row {
      padding: 4px 0;
      font-size: 12px;
      break-inside: avoid;
    }

    a {
      color: var(--color-text) !important;
    }
  }
</style>
