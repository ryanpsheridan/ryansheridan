---
/**
 * IntroLoader — a first-visit intro that hands off to the page behind it.
 *
 * A count climbs from 0 to 100 in the middle of the screen, on nothing but the
 * page's own background. Then the scrim lifts.
 *
 * Shows once ever per browser, never under reduced motion. It is rendered
 * hidden and only revealed by the inline script below, so a browser without
 * JS sees the page directly rather than a scrim that never lifts.
 */
interface Props {
  /** How long the count takes to climb, ms. The intro lasts at least this. */
  minDuration?: number;
  /** Longest it can last, ms. It always hands off, even if a font stalls. */
  maxDuration?: number;
}

const { minDuration = 1688, maxDuration = 2025 } = Astro.props;
---

<div
  class="intro"
  id="intro"
  data-min={minDuration}
  data-max={maxDuration}
  hidden
>
  <div class="intro-count" aria-hidden="true">
    <span class="intro-num" id="intro-count">0</span><span class="intro-pct">%</span>
  </div>
</div>

<script is:inline>
  // Runs before paint so the scrim either appears immediately or never, with
  // no flash of the page in between.
  (function () {
    var el = document.getElementById("intro");
    if (!el) return;

    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var seen = false;
    try {
      seen = localStorage.getItem("intro-seen") === "1";
    } catch (e) {
      seen = false;
    }

    if (reduce || seen) {
      el.remove();
      return;
    }

    el.hidden = false;
    document.documentElement.classList.add("intro-open");
    try {
      localStorage.setItem("intro-seen", "1");
    } catch (e) {}
  })();
</script>

<style is:global>
  /* Hold the page still underneath. */
  html.intro-open,
  html.intro-open body {
    overflow: hidden;
  }

  /* The nav sits above the scrim on its own z-index, so the real wordmark can
     carry the intro instead of a copy painted onto the scrim. It never fades
     or moves, which means the hand-off costs it nothing. The nav actions are
     the pieces held back, arriving a beat after the scrim clears so the nav
     finishes assembling rather than snapping into place. */
  html.intro-open .hamburger,
  html.intro-open .view-all-work {
    opacity: 0;
    pointer-events: none;
  }

  .hamburger {
    transition: opacity 0.5s ease 0.35s;
  }
</style>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: var(--color-bg);
    opacity: 1;
    transition: opacity 0.6s ease;
  }

  .intro.is-done {
    opacity: 0;
    pointer-events: none;
  }

  .intro-count {
    position: absolute;
    /* Dead centre of the screen, the same on every size. The count is the only
       thing on the scrim, so it has no row to line up with and nothing to sit
       out of the way of. Its own box is a fixed width, so centering the box
       holds the digits still rather than sliding them as the number grows. */
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 70;
    display: flex;
    align-items: baseline;
    pointer-events: none;
    color: var(--color-text);
  }

  .intro-num {
    /* Fixed box so 0, 47 and 100 all sit in the same place instead of the
       number shunting sideways as digits are added. */
    display: inline-block;
    min-width: 3ch;
    text-align: right;
    font-family: var(--font-mono);
    font-size: clamp(17.5px, 3.4375vw, 41.25px);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .intro-pct {
    font-family: var(--font-mono);
    font-size: clamp(8.75px, 0.9375vw, 10px);
    color: var(--color-text-muted);
    line-height: 1;
    margin-left: 0.1em;
  }

  /* Phones keep the size they had: the 25% bump is a desktop change, and the
     clamp above would otherwise bottom out smaller than this. */
  @media (max-width: 640px) {
    .intro-num {
      font-size: 31.5px;
    }

    .intro-pct {
      font-size: 15.75px;
    }
  }
</style>

<script>
  const intro = document.getElementById("intro");
  const countEl = document.getElementById("intro-count");

  if (intro && countEl) {
    const minDuration = Number(intro.dataset.min) || 1688;
    const maxDuration = Number(intro.dataset.max) || 2025;
    const started = performance.now();

    // The count follows real signals rather than a timer, but eases toward
    // them so it reads as a measurement instead of a series of jumps.
    let target = 0;
    let shown = 0;
    let finished = false;

    /**
     * A real load surges and stalls, it does not sweep evenly. Cut the run
     * into segments at irregular points in both time and progress, then walk
     * them: a segment that covers little progress over a long stretch reads as
     * a stall, the reverse reads as a jump.
     *
     * Each cut is blended halfway back toward an even spread, which keeps the
     * irregularity from ever producing a dead stop or a leap from 20 to 90.
     */
    function cuts(count: number) {
      const raw = Array.from({ length: count - 1 }, () => Math.random()).sort(
        (a, b) => a - b,
      );
      const all = [0, ...raw, 1];
      return all.map((v, i) => 0.5 * v + 0.5 * (i / (all.length - 1)));
    }

    const SEGMENTS = 7;
    const atTime = cuts(SEGMENTS);
    const atValue = cuts(SEGMENTS);

    /** Progress at a given fraction of the run, 0..1, always increasing. */
    function paceAt(k: number) {
      if (k <= 0) return 0;
      if (k >= 1) return 1;
      let i = 1;
      while (i < atTime.length - 1 && atTime[i] < k) i++;
      const span = atTime[i] - atTime[i - 1];
      const local = span <= 0 ? 1 : (k - atTime[i - 1]) / span;
      const eased = local * local * (3 - 2 * local);
      return atValue[i - 1] + (atValue[i] - atValue[i - 1]) * eased;
    }

    const bump = (to: number) => {
      target = Math.max(target, Math.min(1, to));
    };

    document.fonts?.ready.then(() => bump(0.55));
    if (document.readyState === "complete") bump(1);
    else window.addEventListener("load", () => bump(1), { once: true });

    function finish() {
      if (finished) return;
      finished = true;
      countEl.textContent = "100";
      intro.classList.add("is-done");
      document.documentElement.classList.remove("intro-open");
      window.setTimeout(() => intro.remove(), 700);
    }

    function tick() {
      const elapsed = performance.now() - started;

      if (elapsed >= maxDuration) {
        finish();
        return;
      }

      // Pace the climb across the whole duration rather than chasing the real
      // signal, which on a static site resolves almost immediately and would
      // park the count near 100 for the rest of the wait. The real signal is
      // still a ceiling, so a genuinely slow load holds the count back.
      const pace = paceAt(Math.min(1, elapsed / minDuration));
      shown += (Math.min(target, pace) - shown) * 0.25;

      countEl.textContent = String(Math.min(Math.round(shown * 100), 100));

      if (elapsed >= minDuration && target >= 1) {
        finish();
        return;
      }
      requestAnimationFrame(tick);
    }

    // Four and a half seconds is still a hold on a site that is already
    // parsed. Any deliberate input means "I am ready", so let it through
    // rather than trapping someone behind the animation.
    const skip = () => finish();
    window.addEventListener("pointerdown", skip, { once: true });
    window.addEventListener("keydown", skip, { once: true });
    window.addEventListener("wheel", skip, { once: true, passive: true });
    window.addEventListener("touchstart", skip, { once: true, passive: true });

    requestAnimationFrame(tick);
  }
</script>
