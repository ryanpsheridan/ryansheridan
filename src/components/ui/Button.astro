---
/**
 * The site's one button. Renders an <a> when given an href and a <button>
 * otherwise, so a link that looks like a button is still a link to assistive
 * tech. Documented at /ds/components/button.
 */
import type { HTMLAttributes } from "astro/types";

type Props = {
  variant?: "primary" | "secondary";
  size?: "sm" | "md" | "lg";
  href?: string;
  /** Adds a trailing arrow: "right" for moving forward, "external" for leaving the site. */
  arrow?: "right" | "external";
  type?: "button" | "submit" | "reset";
  class?: string;
} & Omit<HTMLAttributes<"button">, "type"> &
  Omit<HTMLAttributes<"a">, "type">;

const {
  variant = "primary",
  size = "md",
  href,
  arrow,
  type = "button",
  class: className,
  ...rest
} = Astro.props;

const classes = ["btn", `btn-${variant}`, size !== "md" && `btn-${size}`, className];
const external = arrow === "external";
---

{href ? (
  <a
    href={href}
    class:list={classes}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
    {...rest}
  >
    <slot />
    {arrow && <span class="arrow" aria-hidden="true">{external ? "↗" : "→"}</span>}
    {external && <span class="visually-hidden">(opens in a new tab)</span>}
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    <slot />
    {arrow && <span class="arrow" aria-hidden="true">{external ? "↗" : "→"}</span>}
  </button>
)}
