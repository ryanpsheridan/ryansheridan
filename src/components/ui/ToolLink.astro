---
/**
 * A tool named on the site, linked to the tool's own site with its mark in
 * front. Quiet, like the About page's lists always were: muted text that
 * darkens on hover, with the mark in ink so it reads as a logo. Every list of tools uses this, so they all read
 * the same. A name with no entry in data/tools.ts renders as plain text.
 */
import { getTool } from "../../data/tools";
import ToolIcon from "./ToolIcon.astro";

type Props = {
  /** The tool's name or an alias, as listed in data/tools.ts. */
  name: string;
  /** Shown instead of the name, when a list wants a shorter label. */
  label?: string;
};

const { name, label = name } = Astro.props;
const tool = getTool(name);
---

{tool ? (
  <a class="tool-link" href={tool.url} target="_blank" rel="noopener noreferrer">
    <ToolIcon name={name} />
    <span>{label}</span><span class="visually-hidden">(opens in a new tab)</span>
  </a>
) : (
  <span>{label}</span>
)}

<style>
  .tool-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .tool-link:hover {
    color: var(--color-text);
  }

  .tool-link :global(.tool-icon) {
    width: 1.1em;
    height: 1.1em;
    color: var(--color-text);
  }
</style>
