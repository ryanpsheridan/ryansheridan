---
/**
 * One project in the /work grid: a 16:10 frame, the title, a summary held to
 * three lines, and the project's type badges. The title link stretches over
 * the whole card. Documented at /ds/patterns/project-card.
 */
import Media from "../Media.astro";
import type { Project } from "../../data/projects";

interface Props {
  project: Project;
  hidden?: boolean;
  /** Turns the badges into links to each type's page, for layouts that have them. */
  typeHref?: (tag: string) => string;
}

const { project, hidden = false, typeHref } = Astro.props;
---

<li class="work-card" data-year={project.year} data-tags={project.tags.join("|")} hidden={hidden}>
  <a href={`/work/${project.slug}`} class="work-card-thumb" tabindex="-1" aria-hidden="true">
    {project.thumbnail && <Media src={project.thumbnail} alt="" />}
    <span class="work-card-arrow">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 14 14 6M7 6h7v7" />
      </svg>
    </span>
  </a>
  <h2>
    <a href={`/work/${project.slug}`} class="work-card-link">{project.title}</a>
  </h2>
  <p class="visually-hidden"><time datetime={String(project.year)}>{project.year}</time></p>
  <p class="work-card-description">{project.description}</p>
  <div class="badge-list">
    {
      project.tags.map((tag) =>
        typeHref ? (
          <a href={typeHref(tag)} class="badge badge-link">{tag}</a>
        ) : (
          <span class="badge">{tag}</span>
        ),
      )
    }
  </div>
</li>

<style>
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .work-card[hidden] {
    display: none;
  }

  /* Cards that come into view after a filter change or "further back" rise
     into place, one after another. */
  .work-card:global(.is-entering) {
    animation: card-in var(--duration-slower) var(--ease-emphasized) both;
    animation-delay: calc(var(--i, 0) * 50ms);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* The thumbnail is its own link (hidden from assistive tech, since the
     title link already names the project) so a click on the image always
     lands, even while the hover zoom lifts it above the card-wide link. */
  .work-card-thumb {
    display: block;
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-bottom: var(--space-4);
    background: var(--color-surface);
  }

  .work-card-thumb :global(img),
  .work-card-thumb :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: auto;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .work-card-arrow {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--color-text);
    background: var(--color-bg);
    border-radius: var(--radius-full);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-moderate) var(--ease-emphasized);
  }

  .work-card-arrow svg {
    width: 16px;
    height: 16px;
  }

  h2 {
    font-size: var(--text-h5);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin: 0;
  }

  .work-card-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .work-card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .work-card-link:focus-visible {
    outline: none;
  }

  .work-card-link:focus-visible::after {
    outline: 2px solid var(--color-text);
    outline-offset: 8px;
  }

  /* Always exactly three lines, so every card in a row has the same shape.
     Longer summaries end in an ellipsis; the full text is on the project
     page. */
  .work-card-description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    min-height: calc(3 * var(--leading-normal) * 1em);
    margin: var(--space-2) 0 var(--space-3);
    font-size: var(--text-s);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  /* Linked badges sit above the card-wide link so they can be clicked. */
  .badge-link {
    position: relative;
    z-index: 1;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .badge-link:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  @media (hover: hover) {
    .work-card:hover .work-card-thumb :global(img),
    .work-card:hover .work-card-thumb :global(video) {
      transform: scale(1.03);
    }

    .work-card:hover .work-card-arrow {
      opacity: 1;
      transform: none;
    }
  }

  .work-card:focus-within .work-card-arrow {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card-arrow,
    .work-card-thumb :global(img),
    .work-card-thumb :global(video) {
      transition: none;
    }

    .work-card:global(.is-entering) {
      animation: none;
    }
  }
</style>
