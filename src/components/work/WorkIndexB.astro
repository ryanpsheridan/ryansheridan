---
/**
 * Option B for /work: a two-column grid with a sticky sidebar of project
 * types and tools. Every badge is a link to its own page that uses this same
 * layout with that badge active, like a small CMS. Previewed under /work-b.
 */
import Layout from "../../layouts/Layout.astro";
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import Select from "../ui/Select.astro";
import WorkCard from "./WorkCard.astro";
import FurtherBack from "./FurtherBack.astro";
import { workProjects, projectTypes, projectTools, projectCount, toSlug, type Facet } from "../../data/work";

interface Props {
  active?: { kind: "type" | "tool"; facet: Facet };
}

const { active } = Astro.props;
const base = "/work-b";
const typeHref = (name: string) => `${base}/type/${toSlug(name)}`;
const toolHref = (name: string) => `${base}/tool/${toSlug(name)}`;

const list = active
  ? workProjects.filter((p) => (active.kind === "type" ? p.tags : p.tools).includes(active.facet.name))
  : workProjects;

// The newest eight show up front (four rows of two); the rest wait behind
// "Go further back".
const CAP = 8;
const archive = list.slice(CAP);
const years = archive.map((p) => p.year);
const range = !archive.length
  ? ""
  : Math.max(...years) === Math.min(...years)
    ? String(years[0])
    : `${Math.max(...years)} to ${Math.min(...years)}`;

const title = active ? active.facet.name : "All work";
const isActive = (kind: "type" | "tool", name: string) => active?.kind === kind && active.facet.name === name;
const currentHref = active ? (active.kind === "type" ? typeHref : toolHref)(active.facet.name) : base;
---

<Layout
  title={`${active ? `${active.facet.name} work` : "Work"} — Ryan Sheridan`}
  description="Case studies by Ryan Sheridan: multi-brand design systems, brand identities, Webflow and Makeswift websites, illustration, and AI design workflows."
  noindex
>
  <Nav />
  <main id="main" class="work-page">
    <div class="work-inner" data-work-grid>
      <header class="work-header">
        <Breadcrumbs
          items={active
            ? [{ label: "Home", href: "/" }, { label: "Work", href: base }, { label: active.facet.name }]
            : [{ label: "Home", href: "/" }, { label: "Work" }]}
        />
        <div class="work-title">
          <h1>{title}</h1>
          <span class="work-count">
            {active && <>{active.kind === "type" ? "Project type" : "Tool"} · </>}{projectCount(list.length)}
          </span>
        </div>
      </header>

      <div class="work-layout">
        <div class="work-main">
          <ul class="work-grid">
            {list.map((project, i) => <WorkCard project={project} hidden={i >= CAP} typeHref={typeHref} />)}
          </ul>
          <FurtherBack more={archive.length} range={range} />
        </div>

        <aside class="work-sidebar" aria-label="Browse work">
          <div class="sidebar-inner">
            {/* Tablets and phones: one dropdown that jumps to the chosen page. */}
            <div class="sidebar-select">
              <label for="work-browse" class="overline">Browse</label>
              <Select id="work-browse" data-work-browse>
                <option value={base} selected={!active}>All work ({workProjects.length})</option>
                <optgroup label="Project type">
                  {projectTypes.map((t) => (
                    <option value={typeHref(t.name)} selected={isActive("type", t.name)}>{t.name} ({t.count})</option>
                  ))}
                </optgroup>
                <optgroup label="Tools">
                  {projectTools.map((t) => (
                    <option value={toolHref(t.name)} selected={isActive("tool", t.name)}>{t.name} ({t.count})</option>
                  ))}
                </optgroup>
              </Select>
            </div>

            <div class="meta-group">
              <span class="overline">Project type</span>
              <div class="badge-list">
                <a href={base} class="badge facet" aria-current={!active ? "page" : undefined}>
                  All <span class="facet-count">{workProjects.length}</span>
                </a>
                {projectTypes.map((t) => (
                  <a href={typeHref(t.name)} class="badge facet" aria-current={isActive("type", t.name) ? "page" : undefined}>
                    {t.name} <span class="facet-count">{t.count}</span>
                  </a>
                ))}
              </div>
            </div>
            <div class="meta-group">
              <span class="overline">Tools</span>
              <div class="badge-list">
                {projectTools.map((t) => (
                  <a href={toolHref(t.name)} class="badge facet" aria-current={isActive("tool", t.name) ? "page" : undefined}>
                    {t.name} <span class="facet-count">{t.count}</span>
                  </a>
                ))}
              </div>
            </div>
            {active && (
              <a href={base} class="clear link-quiet">
                <span aria-hidden="true">&times;</span> Clear filter
              </a>
            )}
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .work-page {
    padding: var(--page-top) var(--page-padding) 0;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-bottom: var(--space-8);
  }

  .work-header {
    margin-bottom: var(--space-6);
  }

  .work-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  h1 {
    font-size: var(--text-h2);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .work-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* Same proportions as a case study: content three parts, sidebar one. */
  .work-layout {
    display: flex;
    align-items: stretch;
    gap: var(--space-7);
  }

  .work-main {
    flex: 3 1 0%;
    min-width: 0;
  }

  .work-sidebar {
    flex: 1 1 0%;
    min-width: 0;
  }

  .sidebar-inner {
    position: sticky;
    top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .meta-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
  }

  .sidebar-select {
    display: none;
  }

  /* Badges that act as links: quiet at rest, darker on hover, filled when
     they name the page you are on. */
  .facet {
    gap: 6px;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }

  .facet:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .facet[aria-current="page"] {
    color: var(--color-bg);
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .facet-count {
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .clear {
    font-family: var(--font-mono);
    font-size: var(--text-s);
    align-self: flex-start;
  }

  .work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--space-5);
  }

  /* Tablets and phones: the sidebar becomes one dropdown above the grid. */
  @media (max-width: 1024px) {
    .work-layout {
      flex-direction: column;
      gap: var(--space-6);
    }

    .work-sidebar {
      order: -1;
    }

    .sidebar-inner {
      position: static;
    }

    .meta-group,
    .clear {
      display: none;
    }

    .sidebar-select {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      max-width: 360px;
    }
  }

  @media (max-width: 640px) {
    .work-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .sidebar-select {
      max-width: none;
    }
  }
</style>

<script>
  import { initWorkGrid } from "../../scripts/work-grid";

  const root = document.querySelector<HTMLElement>("[data-work-grid]");
  if (root) initWorkGrid(root, 8);

  const browse = document.querySelector<HTMLSelectElement>("[data-work-browse]");
  browse?.addEventListener("change", () => {
    window.location.href = browse.value;
  });
</script>
