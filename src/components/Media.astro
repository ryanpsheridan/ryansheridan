---
import fs from "node:fs";
import path from "node:path";

interface Props {
  src: string;
  alt?: string;
  class?: string;
  loading?: "lazy" | "eager";
}

const { src, alt = "", class: className, loading = "lazy" } = Astro.props;

/**
 * Animated SVGs and GIFs are loaded with a plain src and native lazy loading.
 *
 * This used to withhold src and hand it over on scroll, so the animation
 * started for someone actually looking at it. On iOS that left the two
 * smallest animated SVGs painting frame one and never starting, while the
 * larger ones happened to load slowly enough to escape it. The same files
 * animate correctly wherever a plain src is used, so that is what we use.
 * These loops all run forever, so there is nothing to miss by starting early.
 */
/**
 * Reserve the right box up front so neither a deferred animation nor a
 * lazy-loaded photo shifts the page when it arrives.
 */
function intrinsicRatio(publicPath: string): string | undefined {
  if (!publicPath.startsWith("/")) return undefined;
  const file = path.join(process.cwd(), "public", publicPath.split(/[?#]/)[0]);

  try {
    if (/\.(png|jpe?g)$/i.test(file)) {
      const buf = fs.readFileSync(file);

      // Sniff the header rather than trusting the extension: a PNG saved as
      // .jpg would otherwise be walked as JPEG segments and yield a bogus
      // ratio, which stretches the image on the page.
      const isPng = buf.length > 24 &&
        buf.readUInt32BE(0) === 0x89504e47 && buf.readUInt32BE(4) === 0x0d0a1a0a;

      if (isPng) {
        // IHDR always leads a PNG: width and height are big-endian at 16 and 20.
        return `${buf.readUInt32BE(16)} / ${buf.readUInt32BE(20)}`;
      }

      // JPEG: walk the segment headers to the start-of-frame, which carries size.
      let offset = 2;
      while (offset < buf.length - 9) {
        if (buf[offset] !== 0xff) {
          offset++;
          continue;
        }
        const marker = buf[offset + 1];
        const isFrame = marker >= 0xc0 && marker <= 0xcf &&
          marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc;
        if (isFrame) return `${buf.readUInt16BE(offset + 7)} / ${buf.readUInt16BE(offset + 5)}`;
        offset += 2 + buf.readUInt16BE(offset + 2);
      }
      return undefined;
    }

    if (/\.webp$/i.test(file)) {
      const buf = fs.readFileSync(file).subarray(0, 30);
      const chunk = buf.toString("ascii", 12, 16);

      // Three encodings, three header layouts. VP8X (alpha or animation)
      // stores width-1 and height-1 as 24-bit little-endian values.
      if (chunk === "VP8X") {
        return `${buf.readUIntLE(24, 3) + 1} / ${buf.readUIntLE(27, 3) + 1}`;
      }
      // Lossy: 14-bit dimensions after the keyframe start code.
      if (chunk === "VP8 ") {
        return `${buf.readUInt16LE(26) & 0x3fff} / ${buf.readUInt16LE(28) & 0x3fff}`;
      }
      // Lossless: 14-bit width-1 and height-1 packed after the signature byte.
      if (chunk === "VP8L") {
        const bits = buf.readUInt32LE(21);
        return `${(bits & 0x3fff) + 1} / ${((bits >> 14) & 0x3fff) + 1}`;
      }
      return undefined;
    }

    if (/\.svg$/i.test(file)) {
      const head = fs.readFileSync(file, "utf8").slice(0, 4000);
      const tag = head.match(/<svg[^>]*>/i)?.[0];
      if (!tag) return undefined;

      const width = tag.match(/\bwidth="([\d.]+)(?:px)?"/i)?.[1];
      const height = tag.match(/\bheight="([\d.]+)(?:px)?"/i)?.[1];
      if (width && height) return `${width} / ${height}`;

      const viewBox = tag.match(/\bviewBox="[-\d.]+\s+[-\d.]+\s+([\d.]+)\s+([\d.]+)"/i);
      if (viewBox) return `${viewBox[1]} / ${viewBox[2]}`;
      return undefined;
    }

    if (/\.gif$/i.test(file)) {
      const header = Buffer.alloc(10);
      const fd = fs.openSync(file, "r");
      fs.readSync(fd, header, 0, 10, 0);
      fs.closeSync(fd);
      return `${header.readUInt16LE(6)} / ${header.readUInt16LE(8)}`;
    }
  } catch {
    // Remote or missing file: fall back to whatever the stylesheet already sets.
  }

  return undefined;
}

/**
 * Screen recordings are MP4s that play like an animated image: muted, looping
 * forever, no controls. A WebP with the same basename is the poster, and it is
 * also where the reserved box gets its ratio, since an MP4 header is not worth
 * parsing here.
 */
const isVideo = /\.(mp4|webm)$/i.test(src);
const poster = isVideo ? src.replace(/\.(mp4|webm)$/i, ".webp") : undefined;

// Offer both encodings when both exist: WebM (VP9) for browsers built without
// H.264, MP4 for everything else. Listed WebM first, since it is smaller.
const videoSources = isVideo
  ? [".webm", ".mp4"]
      .map((ext) => src.replace(/\.(mp4|webm)$/i, ext))
      .filter((candidate) => fs.existsSync(path.join(process.cwd(), "public", candidate)))
  : [];

const ratio = intrinsicRatio(poster ?? src);
// Handed over as a custom property, not aspect-ratio itself, so a stylesheet
// that wants a deliberate crop (the carousel's 3/4 frame) still wins.
const sizing = ratio ? `--media-ratio: ${ratio}` : undefined;
---

{isVideo ? (
  <video
    poster={poster}
    class="media-video"
    style={sizing}
    aria-label={alt || undefined}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    data-media-video
  >
    {(videoSources.length ? videoSources : [src]).map((source) => (
      <source src={source} type={source.endsWith(".webm") ? "video/webm" : "video/mp4"} />
    ))}
  </video>
) : (
  <img src={src} alt={alt} class={className} loading={loading} style={sizing} />
)}

{isVideo && (
  <script>
    // Hold on the poster frame for anyone who asks for less motion.
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const sync = () => {
      document.querySelectorAll<HTMLVideoElement>("[data-media-video]").forEach((video) => {
        if (reduce.matches) {
          video.pause();
          video.currentTime = 0;
        } else {
          video.play().catch(() => {});
        }
      });
    };
    sync();
    reduce.addEventListener("change", sync);
  </script>
)}
