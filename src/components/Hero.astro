    letter-spacing: -0.03em;
    color: var(--color-text-muted);
  }

  .location {
    margin-top: 24px;
    font-size: 15px;
    color: var(--color-text-muted);
  }

  .hero-divider {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  hr {
    border: none;
    border-top: 1px solid var(--color-border);
  }
