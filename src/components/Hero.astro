---

---

<section class="hero">
  <div class="hero-inner">
    <h1>Designing systems,<br />sites and brands.</h1>
  </div>
  <div class="hero-divider">
    <hr />
  </div>
</section>

<style>
  .hero {
    padding: 140px var(--page-padding) 0;
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-bottom: 80px;
  }

  h1 {
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
  }

  .location,
  .current-role {
    font-size: 15px;
    color: var(--color-text-muted);
  }

  .meta-sep {
    color: var(--color-border);
    font-size: 14px;
  }

  .hero-divider {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  hr {
    border: none;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 480px) {
    .hero-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .meta-sep {
      display: none;
    }
  }
</style>
