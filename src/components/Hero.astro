    <h1>Designing systems,<br />sites and brands.</h1>
    <p class="location">based in Austin</p>
  </div>
  <div class="hero-divider">
    <hr />
  </div>
</section>

<style>
  .hero {
    padding: 140px var(--page-padding) 0;
  }

  .hero-inner {
    max-width: var(--max-width);
