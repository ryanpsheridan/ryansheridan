<section class="hero">
  <div class="hero-inner">
    <h1>Designing systems,<br />sites and brands.</h1>
    <p class="location">based in Austin</p>
  </div>
  <div class="hero-divider">
    <hr />
  </div>
</section>

<style>
  .hero {
    padding: 80px var(--page-padding) 0;
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-bottom: 48px;
  }

  h1 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .location {
    margin-top: 16px;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .hero-divider {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--page-padding);
  }

  hr {
    border: none;
    border-top: 1px solid var(--color-border);
    max-width: var(--max-width);
  }
</style>
