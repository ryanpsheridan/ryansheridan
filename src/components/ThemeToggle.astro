---
/**
 * The light/dark button, used in the nav and the footer. A moon on light and
 * a sun on dark: the icon shows where a press goes. The new theme spreads
 * out from the button as a circle (src/scripts/theme.ts). Every copy on the page
 * drives the same setting (src/scripts/theme.ts) and stays in step.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button type="button" class:list={["theme-btn", className]} aria-label="Dark mode" aria-pressed="false" data-theme-toggle>
  <svg class="theme-icon is-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
  </svg>
  <svg class="theme-icon is-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
  </svg>
</button>

<style>
  /* A 48px target with no fill, so it sits as quietly as the text around it. */
  .theme-btn {
    position: relative;
    width: var(--control-md);
    height: var(--control-md);
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--color-text);
    background: none;
    border: 0;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .theme-btn:hover {
    color: var(--color-text-muted);
  }

  .theme-icon {
    grid-area: 1 / 1;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity var(--duration-moderate) var(--ease-standard),
      transform var(--duration-moderate) var(--ease-emphasized);
  }

  .theme-btn .is-sun,
  .theme-btn[aria-pressed="true"] .is-moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }

  .theme-btn[aria-pressed="true"] .is-sun {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-icon {
      transition: none;
    }
  }
</style>

<script>
  import { onThemeChange, toggleTheme } from "../scripts/theme";

  const buttons = document.querySelectorAll<HTMLButtonElement>(".theme-btn");
  buttons.forEach((btn) => btn.addEventListener("click", () => toggleTheme(btn)));
  onThemeChange((theme) => buttons.forEach((btn) => btn.setAttribute("aria-pressed", String(theme === "dark"))));
</script>
