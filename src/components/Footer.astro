---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <a href="/" class="footer-logo">ryan sheridan design</a>
      <nav class="footer-nav">
        <a href="/work">Work</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a
          href="https://www.linkedin.com/in/ryansheridandesign/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn <span class="arrow" aria-hidden="true">&nearr;</span><span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span class="footer-copyright">&copy; {year} Ryan Sheridan</span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: var(--border-width) solid var(--color-border);
    padding: var(--space-7) var(--page-padding) var(--space-6);
    margin-top: 120px;
    /* Opaque and lifted, matching the nav. A fixed element at z-index 0 paints
       over static content, so without this the CursorField would sit on top of
       the footer, and without the background its rings would still show
       through the footer's own area. */
    position: relative;
    z-index: var(--z-raised);
    background: var(--color-bg);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-7);
  }

  .footer-logo {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text);
  }

  .footer-nav {
    display: flex;
    gap: var(--space-5);
  }

  .footer-nav a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .footer-nav a:hover {
    color: var(--color-text);
  }

  .arrow {
    font-size: var(--text-xs);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-copyright {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    footer {
      margin-top: 80px;
      padding: var(--space-6) var(--page-padding) var(--space-5);
    }

    .footer-top {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
      margin-bottom: var(--space-5);
    }

    .footer-nav {
      gap: var(--space-4);
    }
  }
</style>
