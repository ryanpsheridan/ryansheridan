---

<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <a href="/" class="footer-logo">rsd</a>
      <nav class="footer-nav">
        <a href="/work">Work</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a
          href="https://www.linkedin.com/in/ryansheridandesign/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn <span class="arrow">&nearr;</span>
        </a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span class="footer-copyright">&copy; Ryan Sheridan</span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    padding: 64px var(--page-padding) 48px;
    margin-top: 120px;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 64px;
  }

  .footer-logo {
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .footer-nav {
    display: flex;
    gap: 32px;
  }

  .footer-nav a {
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: var(--color-text);
  }

  .arrow {
    font-size: 12px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-copyright {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    footer {
      margin-top: 80px;
      padding: 48px var(--page-padding) 40px;
    }

    .footer-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      margin-bottom: 40px;
    }

    .footer-nav {
      gap: 24px;
    }
  }
</style>
