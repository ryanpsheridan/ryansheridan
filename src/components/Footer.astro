---
interface Props {
  /** The page draws the blueprint (its own specs over itself), so the footer offers the way in. */
  blueprint?: boolean;
}

const { blueprint = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <a href="/" class="footer-logo">ryan sheridan design</a>
      <nav class="footer-nav">
        <a href="/work">Work</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a
          href="https://www.linkedin.com/in/ryansheridandesign/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn <span class="arrow" aria-hidden="true">&nearr;</span><span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span class="footer-copyright">&copy; {year} Ryan Sheridan</span>
      <div class="footer-actions">
      {blueprint && (
        /* The way into the blueprint, kept down here as a colophon-style
           extra for whoever reads to the end. A real toggle, the same as the
           Cmd/Ctrl + I shortcut, labelled for what a press does next, with
           the shortcut after it as in a menu. Touch screens, where there is
           no shortcut, get the words only. */
        <button type="button" class="footer-peek" aria-pressed="false" aria-keyshortcuts="Meta+I Control+I" data-blueprint-toggle>
          <span class="footer-peek-label is-show">Show the specs</span>
          <span class="footer-peek-label is-hide">Hide the specs</span>
          <kbd class="footer-peek-key"><span data-shortcut-mod>Cmd</span> + I</kbd>
        </button>
      )}
        <button type="button" class="footer-theme" role="switch" aria-checked="false" data-theme-toggle>
          Dark mode
          <span class="footer-theme-track" aria-hidden="true"><span class="footer-theme-thumb"></span></span>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: var(--border-width) solid var(--color-border);
    padding: var(--space-7) var(--page-padding) var(--space-6);
    margin-top: 120px;
    /* Opaque and lifted, matching the nav, so a fixed layer behind the page
       (such as the homepage blueprint) never paints over the footer. */
    position: relative;
    z-index: var(--z-raised);
    background: var(--color-bg);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-7);
  }

  .footer-logo {
    font-family: var(--font-mono);
    font-size: var(--text-s);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text);
  }

  .footer-nav {
    display: flex;
    gap: var(--space-5);
  }

  .footer-nav a {
    font-family: var(--font-mono);
    font-size: var(--text-s);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .footer-nav a:hover {
    color: var(--color-text);
  }

  .arrow {
    font-size: var(--text-xs);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  /* A small switch in the footer's mono voice. It and the nav icon drive the
     same setting and stay in step. */
  .footer-theme {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-s);
    color: var(--color-text-muted);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .footer-theme:hover,
  .footer-theme[aria-checked="true"] {
    color: var(--color-text);
  }

  .footer-theme-track {
    position: relative;
    width: 28px;
    height: 16px;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-full);
    transition: background var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard);
  }

  .footer-theme-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--color-text-muted);
    transition: transform var(--duration-fast) var(--ease-emphasized), background var(--duration-fast) var(--ease-standard);
  }

  .footer-theme[aria-checked="true"] .footer-theme-track {
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .footer-theme[aria-checked="true"] .footer-theme-thumb {
    background: var(--color-bg);
    transform: translateX(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-theme-thumb {
      transition: none;
    }
  }

  .footer-peek {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-s);
    color: var(--color-text-muted);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .footer-peek:hover,
  .footer-peek[aria-pressed="true"] {
    color: var(--color-text);
  }

  .footer-peek-key {
    padding: 0 var(--space-1);
    font: inherit;
    font-size: 0.9em;
    line-height: 1.5;
    color: inherit;
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
    border-radius: var(--radius-sm);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .footer-peek[aria-pressed="true"] .footer-peek-key {
    color: var(--color-on-blueprint);
    background: var(--blueprint, var(--color-link));
  }

  .footer-peek-label.is-hide,
  .footer-peek[aria-pressed="true"] .footer-peek-label.is-show {
    display: none;
  }

  .footer-peek[aria-pressed="true"] .footer-peek-label.is-hide {
    display: inline;
  }

  @media (hover: none) and (pointer: coarse) {
    .footer-peek-key {
      display: none;
    }
  }

  .footer-copyright {
    font-family: var(--font-mono);
    font-size: var(--text-s);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    footer {
      margin-top: 80px;
      padding: var(--space-6) var(--page-padding) var(--space-5);
    }

    .footer-top {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
      margin-bottom: var(--space-5);
    }

    .footer-nav {
      gap: var(--space-4);
    }

    .footer-bottom {
      flex-wrap: wrap;
      gap: var(--space-3);
    }
  }
</style>

<script>
  import { onThemeChange, toggleTheme } from "../scripts/theme";

  const themeSwitch = document.querySelector<HTMLButtonElement>(".footer-theme");
  if (themeSwitch) {
    themeSwitch.addEventListener("click", toggleTheme);
    onThemeChange((theme) => themeSwitch.setAttribute("aria-checked", String(theme === "dark")));
  }
</script>
