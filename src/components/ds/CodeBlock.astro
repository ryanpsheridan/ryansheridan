---
/**
 * A highlighted snippet with a copy button. The button carries the raw code,
 * so the clipboard gets exactly what is shown.
 */
import { Code } from "astro:components";

interface Props {
  code: string;
  lang?: "astro" | "html" | "css" | "ts" | "js" | "bash";
  /** Label in the bar above the code. Defaults to the language. */
  label?: string;
}

const { code, lang = "astro", label } = Astro.props;
const trimmed = code.replace(/^\n+|\s+$/g, "");
const names: Record<string, string> = { astro: "Astro", html: "HTML", css: "CSS", ts: "TypeScript", js: "JavaScript", bash: "Terminal" };
---

<div class="ds-code">
  <div class="ds-code-bar">
    <span>{label ?? names[lang]}</span>
    <button type="button" class="ds-copy" data-copy={trimmed} data-copy-label="Code copied" data-copy-flash>Copy</button>
  </div>
  <Code code={trimmed} lang={lang} theme="github-light" />
</div>

<style>
  .ds-code {
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }

  .ds-code-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--control-sm);
    padding: 0 var(--space-1) 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .ds-copy {
    height: 32px;
    padding: 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .ds-copy:hover {
    border-color: var(--color-text);
  }

  .ds-code :global(pre) {
    margin: 0;
    padding: var(--space-3);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-s);
    line-height: var(--leading-normal);
    background: transparent !important;
    tab-size: 2;
  }
</style>
