---
/**
 * LabSwitcher: a small fixed bar for moving between the homepage directions
 * under /homepage-variations while they are being tested. It exists only on
 * those noindex pages and never ships on the real homepage.
 */
interface Props {
  /** The path of the page it sits on, so that link reads as current. */
  current: string;
}

const { current } = Astro.props;

const links = [
  { href: "/", label: "Live" },
  { href: "/homepage-variations/modes", label: "1 Modes" },
  { href: "/homepage-variations/specs", label: "2 Specs" },
  { href: "/homepage-variations/words", label: "3 Words" },
];
---

<nav class="lab-switcher" aria-label="Homepage directions">
  <span class="lab-label" aria-hidden="true">Directions</span>
  {
    links.map((link) => (
      <a href={link.href} aria-current={link.href === current ? "page" : undefined}>
        {link.label}
      </a>
    ))
  }
</nav>

<style>
  .lab-switcher {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 400;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: #111111;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
  }

  .lab-label {
    padding: 0 10px 0 12px;
    color: #a3a3a3;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 10px;
  }

  .lab-switcher a {
    padding: 9px 12px;
    border-radius: 999px;
    white-space: nowrap;
    color: #f2f2f2;
  }

  .lab-switcher a:hover {
    color: #ffffff;
    background: #2b2b2b;
  }

  .lab-switcher a[aria-current="page"] {
    color: #111111;
    background: #ffffff;
  }

  .lab-switcher a:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .lab-switcher {
      left: 50%;
      transform: translateX(-50%);
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    }

    .lab-label {
      display: none;
    }
  }
</style>
