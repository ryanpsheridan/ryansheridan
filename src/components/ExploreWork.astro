---
/**
 * The way into the rest of the work from the bottom of the homepage: every
 * project type and every tool, each a badge linking to its /work page.
 * Read from data/work.ts, so it follows whatever the projects use.
 */
import { projectTypes, projectTools, typeHref, toolHref } from "../data/work";
import ToolIcon from "./ui/ToolIcon.astro";
---

<section class="explore" aria-labelledby="explore-title">
  <div class="explore-inner">
    <h2 id="explore-title" class="explore-title">Browse by type or tool</h2>
    <div class="explore-row">
      <span class="overline">Project type</span>
      <div class="badge-list">
        {projectTypes.map((t) => <a href={typeHref(t.name)} class="badge">{t.name}</a>)}
      </div>
    </div>
    <div class="explore-row">
      <span class="overline">Tools</span>
      <div class="badge-list">
        {projectTools.map((t) => (
          <a href={toolHref(t.name)} class="badge badge-tool"><ToolIcon name={t.name} />{t.name}</a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* On desktop the homepage's scroll spacer already leaves room above. */
  .explore {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-top: var(--space-7);
    border-top: var(--border-width) solid var(--color-border);
  }

  /* The rule runs the full width; the content keeps to the left column,
     the same width as the headline panel above it. */
  @media (min-width: 769px) {
    .explore-inner {
      width: 50%;
      padding-right: var(--space-5);
    }
  }

  .explore-title {
    margin-bottom: var(--space-5);
    font-size: var(--text-h5);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
  }

  /* Label in a narrow column, badges beside it; stacked on a phone. */
  .explore-row {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
  }

  .explore-row + .explore-row {
    margin-top: var(--space-4);
  }

  .explore-row .overline {
    padding-top: 2px;
  }

  @media (max-width: 768px) {
    .explore {
      margin-top: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .explore-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .explore-row + .explore-row {
      margin-top: var(--space-5);
    }
  }
</style>
