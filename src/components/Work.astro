---
import { getHomepageProjects } from "../data/projects";

const projects = getHomepageProjects();
---

<section id="work" class="work">
  <div class="work-inner">
    <div class="project-grid">
      {
        projects.map((project) => (
          <a href={`/work/${project.slug}`} class="project-card">
            <div class="project-thumbnail">
              <img src={project.thumbnail} alt={project.title} loading="lazy" />
            </div>
            <h3>{project.title}</h3>
            <div class="tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    padding: 48px var(--page-padding) 80px;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 24px;
  }

  .project-card {
    display: block;
  }

  .project-card:hover img {
    opacity: 0.85;
  }

  .project-thumbnail {
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 12px;
    background: #f3f3f3;
  }

  .project-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s;
  }

  h3 {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 11px;
    font-weight: 400;
    padding: 4px 10px;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: 99px;
  }

  @media (max-width: 540px) {
    .work {
      padding: 32px var(--page-padding) 60px;
    }
    .project-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
