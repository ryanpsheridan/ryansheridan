---
import { getHomepageProjects } from "../data/projects";

const projects = getHomepageProjects();
---

<section id="work" class="work">
  <div class="work-inner">
    <div class="project-grid">
      {
        projects.map((project) => (
          <a href={`/work/${project.slug}`} class="project-card">
            <div class="project-thumbnail">
              {project.thumbnail && <img src={project.thumbnail} alt={project.title} loading="lazy" />}
            </div>
            <h3>{project.title}</h3>
            <div class="badge-list tags">
              {project.tags.map((tag) => <span class="badge">{tag}</span>)}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    padding: 48px var(--page-padding) 80px;
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 32px;
  }

  .project-card {
    display: block;
  }

  .project-card:hover img {
    opacity: 0.85;
  }

  .project-thumbnail {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: 16px;
    background: var(--color-tag-bg);
  }

  .project-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s;
  }

  h3 {
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
