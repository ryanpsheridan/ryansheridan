---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /**
   * Keep this page out of search. Off by default: the site is indexable, and
   * a page opts out only if it is a demo, a private share, or an error page.
   */
  noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://ryansheridan.studio");
const { title, description = "Ryan Sheridan — Principal Designer specializing in design systems, marketing sites, and brand infrastructure.", ogImage = "/og-default.png", noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL.href} />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FT00G2328N"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-FT00G2328N");
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL.origin).href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonicalURL.origin).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      import Lenis from "lenis";
      const lenis = new Lenis({
        duration: 0.72,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Matches Geist's box metrics so the fallback system font doesn't reflow
     layout once the webfont swaps in (prevents CLS on first load). */
  @font-face {
    font-family: "Geist Fallback";
    src: local("Arial");
    ascent-override: 90.44%;
    descent-override: 22.52%;
    line-gap-override: 0%;
    size-adjust: 107.12%;
  }

  :root {
    --color-bg: #ffffff;
    --color-text: #111111;
    /* Secondary copy sits at ~5.7:1 on white, comfortably past AA, so long
       passages of it read as text rather than as something switched off. */
    --color-text-muted: #5c5c60;
    --color-border: #e5e5e5;
    --color-tag-bg: #f9f9f9;
    --color-tag-text: #5c5c60;

    /* Links. Chrome (nav, footer, cards, buttons) pins its own color, so this
       applies to links sitting in running text. */
    --color-link: #1c4ed8;
    --color-link-hover: #14379b;
    --color-link-subtle: #a8bcf1;

    /* Status. Each pairs a text-safe foreground with a tint for fills. The
       reading is fixed by the shape it sits in, never by hue alone. */
    --color-positive: #17663f;
    --color-positive-bg: #eaf4ee;
    --color-positive-border: #bcdcc9;
    --color-caution: #8a5000;
    --color-caution-bg: #fcf3e6;
    --color-caution-border: #ecd5ad;
    --color-critical: #a3302a;
    --color-critical-bg: #fbeeed;
    --color-critical-border: #eec9c6;
    --color-accent-bg: #eef2fe;
    --color-accent-border: #c3d0f6;
    --font-sans: "Geist", "Geist Fallback", -apple-system, system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", "Courier New", monospace;
    --max-width: 1140px;
    --content-width: 656px;
    --page-padding: 40px;
    --nav-height: 74px;

    /* 8px spacing scale */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 16px;
    --space-4: 24px;
    --space-5: 32px;
    --space-6: 48px;
    --space-7: 64px;
    --space-8: 96px;

    /* type scale, ~1.25 ratio off a 16px base */
    --text-xs: 12px;
    --text-sm: 13px;
    --text-base: 16px;
    --text-md: 18px;
    --text-lg: 20px;
    --text-xl: 25px;
    --text-2xl: 32px;
    --text-3xl: 40px;
    --text-4xl: 50px;
    --text-5xl: 64px;
  }

  html {
    scroll-behavior: smooth;
    scrollbar-gutter: stable;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font-sans);
    font-weight: 300;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    font-size: 15px;
  }

  a {
    color: var(--color-link);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-link-hover);
  }

  img {
    max-width: 100%;
    display: block;
    border-radius: 0;
    /* Media.astro measures the file at build time and passes the result down,
       so an image holds its box before it loads. Any rule with a class in it
       outranks this, which is how the carousel keeps its own crop. */
    aspect-ratio: var(--media-ratio, auto);
  }

  ::selection {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    padding: 5px 12px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    :root {
      --page-padding: 20px;
    }
  }
</style>
