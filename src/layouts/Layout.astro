---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Describes ogImage for screen readers in link previews. */
  ogImageAlt?: string;
  /** "article" for case studies, "profile" for the about page. */
  ogType?: "website" | "article" | "profile";
  /**
   * Page-level schema.org nodes, merged into the site graph below. Reference
   * the shared nodes by id (PERSON_ID, WEBSITE_ID) rather than repeating them.
   */
  schema?: Record<string, unknown>[];
  /**
   * Keep this page out of search. Off by default: the site is indexable, and
   * a page opts out only if it is a demo, a private share, or an error page.
   */
  noindex?: boolean;
}

import { SITE_URL, personSchema, websiteSchema } from "../data/schema";
import { tokensToCss } from "../data/tokens";
import "../styles/global.css";

// Every token as a custom property on :root. Inlined so it is in place before
// the first paint, and generated from the same file the /ds pages document.
const tokenCss = tokensToCss();

// Internal links, the sitemap, and Vercel (trailingSlash: false) all use the
// bare path, so the canonical drops the trailing slash the build adds too.
// Two spellings of one URL split ranking signals between them.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalURL = new URL(pathname, Astro.site || SITE_URL);
const {
  title,
  description = "Ryan Sheridan is a Principal Designer specializing in design systems, marketing sites, and brand infrastructure.",
  ogImage = "/og-default.png",
  ogImageAlt = "Ryan Sheridan, Principal Designer",
  ogType = "website",
  schema = [],
  noindex = false,
} = Astro.props;
const ogImageURL = new URL(ogImage, canonicalURL.origin).href;

// One graph per page: who Ryan is and what the site is, then whatever the
// page adds. Search engines and AI assistants read this to tie every page back
// to the same person. Noindex pages skip it, since nothing should cite them.
const jsonLd = noindex
  ? undefined
  : JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [personSchema, websiteSchema, ...schema],
    }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL.href} />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FT00G2328N"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-FT00G2328N");
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Ryan Sheridan" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <style is:inline set:html={tokenCss} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import Lenis from "lenis";
      // Smooth scrolling is motion the reader didn't ask for, so anyone who
      // has asked for less motion gets the browser's own scroll.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis({
          duration: 0.72,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>
