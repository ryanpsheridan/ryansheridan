---
/**
 * Shell for every page under /ds: the site nav, a sidebar listing the
 * system, and the documentation styles. Kept out of search on purpose; the
 * design system is a back room of the site, not a landing page.
 */
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import { dsNav, DS_VERSION } from "../data/ds";

interface Props {
  title: string;
  /** One or two sentences under the title. */
  lead?: string;
  /** Small label above the title, like "Foundations". */
  section?: string;
}

const { title, lead, section } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const crumbs = [{ label: "Design system", href: "/ds" }];
if (path !== "/ds") {
  if (section) {
    const group = dsNav.find((g) => g.title === section);
    if (group && group.base !== "/ds" && path !== group.base) {
      crumbs.push({ label: section, href: group.base === "/ds/patterns" ? "/ds/components#patterns" : group.base });
    }
  }
  crumbs.push({ label: title, href: "" });
}
---

<Layout title={`${title} | Design system | Ryan Sheridan`} description={lead} noindex>
  <Nav />
  <div class="ds">
    <details class="ds-mobile-nav">
      <summary>Design system menu</summary>
      <nav aria-label="Design system">
        {dsNav.map((group) => (
          <div class="ds-nav-group">
            <p class="overline">{group.title}</p>
            <ul>
              {group.pages.map((page) => {
                const href = page.slug ? `${group.base}/${page.slug}` : group.base;
                return <li><a href={href} aria-current={href === path ? "page" : undefined}>{page.title}</a></li>;
              })}
            </ul>
          </div>
        ))}
      </nav>
    </details>

    <aside class="ds-sidebar">
      <nav aria-label="Design system">
        <a href="/ds" class="ds-wordmark">
          <span>ds</span>
          <span class="ds-version">v{DS_VERSION}</span>
        </a>
        {dsNav.map((group) => (
          <div class="ds-nav-group">
            <p class="overline">{group.title}</p>
            <ul>
              {group.pages.map((page) => {
                const href = page.slug ? `${group.base}/${page.slug}` : group.base;
                return <li><a href={href} aria-current={href === path ? "page" : undefined}>{page.title}</a></li>;
              })}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <main id="main" class="ds-main">
      {path !== "/ds" && <Breadcrumbs items={crumbs} />}
      <header class="ds-header">
        {section && <p class="overline">{section}</p>}
        <h1>{title}</h1>
        {lead && <p class="ds-lead">{lead}</p>}
      </header>
      <div class="ds-content">
        <slot />
      </div>
    </main>
  </div>
  <Footer />
  <p class="ds-toast" role="status" aria-live="polite" data-ds-toast></p>
</Layout>

<script>
  // Every copy button on the page: code snippets and token names. The text to
  // copy rides on the button, so what lands on the clipboard is exactly what
  // the snippet shows, without the highlighting markup.
  const toast = document.querySelector<HTMLElement>("[data-ds-toast]");
  let hide: number | undefined;

  document.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
    if (!button) return;
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      const label = button.dataset.copyLabel ?? "Copied";
      if (toast) {
        toast.textContent = `${label} to clipboard`;
        toast.classList.add("is-visible");
        clearTimeout(hide);
        hide = window.setTimeout(() => toast.classList.remove("is-visible"), 1600);
      }
      if (button.dataset.copyFlash !== undefined) {
        const original = button.textContent;
        button.textContent = "Copied";
        setTimeout(() => (button.textContent = original), 1600);
      }
    } catch {
      if (toast) toast.textContent = "Couldn't reach the clipboard. Select the text and copy it instead.";
    }
  });
</script>

<style>
  .ds {
    display: grid;
    grid-template-columns: 224px minmax(0, 1fr);
    gap: var(--space-7);
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-6) var(--page-padding) 0;
  }

  .ds-sidebar nav {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-4));
    max-height: calc(100vh - var(--nav-height) - var(--space-6));
    overflow-y: auto;
    padding-bottom: var(--space-5);
    scrollbar-width: thin;
  }

  .ds-wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .ds-wordmark:hover {
    color: var(--color-text);
  }

  .ds-version {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .ds-nav-group + .ds-nav-group {
    margin-top: var(--space-4);
  }

  .ds-nav-group .overline {
    margin-bottom: var(--space-2);
  }

  .ds-nav-group ul {
    list-style: none;
  }

  .ds-nav-group a {
    display: block;
    padding: var(--space-1) 0 var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    border-left: var(--border-width) solid var(--color-border);
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .ds-nav-group a:hover {
    color: var(--color-text);
  }

  .ds-nav-group a[aria-current="page"] {
    color: var(--color-text);
    font-weight: var(--weight-medium);
    border-left: var(--focus-width) solid var(--color-text);
    padding-left: calc(var(--space-3) - 1px);
  }

  .ds-mobile-nav {
    display: none;
  }

  .ds-main {
    min-width: 0;
    padding-bottom: var(--space-8);
  }

  .ds-header {
    margin-bottom: var(--space-7);
    max-width: var(--content-width);
  }

  .ds-header .overline {
    margin-bottom: var(--space-3);
  }

  .ds-header h1 {
    font-size: var(--text-headline);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .ds-lead {
    margin-top: var(--space-3);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .ds-toast {
    position: fixed;
    left: 50%;
    bottom: var(--space-4);
    z-index: var(--z-modal);
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-bg);
    background: var(--color-text);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-overlay);
    opacity: 0;
    transform: translate(-50%, var(--space-2));
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-emphasized);
    pointer-events: none;
  }

  .ds-toast:global(.is-visible) {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-toast {
      transition: none;
    }
  }

  @media (max-width: 1024px) {
    .ds {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-top: var(--space-4);
    }

    .ds-sidebar {
      display: none;
    }

    .ds-mobile-nav {
      display: block;
      margin-bottom: var(--space-5);
      border: var(--border-width) solid var(--color-border-strong);
      border-radius: var(--radius-md);
    }

    .ds-mobile-nav summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: var(--control-md);
      padding: 0 var(--space-3);
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      cursor: pointer;
      list-style: none;
    }

    .ds-mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    .ds-mobile-nav summary::after {
      content: "+";
      font-family: var(--font-mono);
      color: var(--color-text-muted);
    }

    .ds-mobile-nav[open] summary::after {
      content: "\2212";
    }

    .ds-mobile-nav nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
      padding: var(--space-2) var(--space-3) var(--space-4);
    }

    .ds-mobile-nav .ds-nav-group + .ds-nav-group {
      margin-top: 0;
    }
  }

  @media (max-width: 480px) {
    .ds-mobile-nav nav {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Documentation content ---------- */

  .ds-content > :global(section + section) {
    margin-top: var(--space-8);
  }

  .ds-content :global(h2) {
    font-size: var(--text-xl);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-3);
    scroll-margin-top: calc(var(--nav-height) + var(--space-4));
  }

  .ds-content :global(h3) {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin: var(--space-6) 0 var(--space-2);
    scroll-margin-top: calc(var(--nav-height) + var(--space-4));
  }

  .ds-content :global(h2 + h3) {
    margin-top: var(--space-4);
  }

  .ds-content :global(.ds-text) {
    max-width: var(--content-width);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .ds-content :global(.ds-text + .ds-text) {
    margin-top: var(--space-3);
  }

  .ds-content :global(.ds-text a),
  .ds-content :global(.ds-list a),
  .ds-content :global(.ds-card-body a),
  .ds-content :global(.ds-table a) {
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-color: var(--color-link-subtle);
    text-underline-offset: 3px;
  }

  .ds-content :global(.ds-text a:hover),
  .ds-content :global(.ds-list a:hover),
  .ds-content :global(.ds-card-body a:hover),
  .ds-content :global(.ds-table a:hover) {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-link-hover);
  }

  .ds-content :global(.ds-text strong),
  .ds-content :global(.ds-list strong) {
    font-weight: var(--weight-medium);
  }

  .ds-content :global(code:not(pre code)) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0 var(--space-1);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .ds-content :global(.ds-list) {
    max-width: var(--content-width);
    padding-left: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .ds-content :global(.ds-list li + li) {
    margin-top: var(--space-2);
  }

  .ds-content :global(.ds-text + .ds-list),
  .ds-content :global(.ds-list + .ds-text) {
    margin-top: var(--space-3);
  }

  .ds-content :global(.ds-text + .ds-example),
  .ds-content :global(.ds-text + .ds-table-wrap),
  .ds-content :global(.ds-list + .ds-table-wrap),
  .ds-content :global(.ds-text + .ds-grid),
  .ds-content :global(.ds-text + .ds-dodont),
  .ds-content :global(.ds-list + .ds-example),
  .ds-content :global(.ds-text + .ds-code) {
    margin-top: var(--space-4);
  }

  .ds-content :global(.ds-example + .ds-example),
  .ds-content :global(.ds-example + .ds-text),
  .ds-content :global(.ds-table-wrap + .ds-text),
  .ds-content :global(.ds-code + .ds-text),
  .ds-content :global(.ds-grid + .ds-text),
  .ds-content :global(.ds-dodont + .ds-text) {
    margin-top: var(--space-5);
  }

  /* Tables */

  .ds-content :global(.ds-table-wrap) {
    overflow-x: auto;
    border-top: var(--border-width) solid var(--color-text);
  }

  .ds-content :global(.ds-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .ds-content :global(.ds-table th) {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom: var(--border-width) solid var(--color-border);
    white-space: nowrap;
  }

  .ds-content :global(.ds-table td) {
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    vertical-align: top;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .ds-content :global(.ds-table td:last-child),
  .ds-content :global(.ds-table th:last-child) {
    padding-right: 0;
  }

  .ds-content :global(.ds-table .mono) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .ds-content :global(.ds-table .muted) {
    color: var(--color-text-muted);
  }

  /* Grids of cards */

  .ds-content :global(.ds-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .ds-content :global(.ds-card) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    color: var(--color-text);
    border: var(--border-width) solid var(--color-border);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .ds-content :global(a.ds-card:hover) {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  .ds-content :global(.ds-card-title) {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
  }

  .ds-content :global(.ds-card-body) {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .ds-content > :global(section + section) {
      margin-top: var(--space-7);
    }
  }
</style>
