{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/proposals/ohio-golf-club", "destination": "/ohio-golf-club", "permanent": true },
    { "source": "/proposals/ohio-golf-club/:path*", "destination": "/ohio-golf-club/:path*", "permanent": true },
    { "source": "/invoice/template", "destination": "/invoice-template", "permanent": true },
    { "source": "/invoice/ohio-golf-club", "destination": "/invoice-ohio-golf-club-1", "permanent": true },
    { "source": "/project-questionnaire", "destination": "/start-a-project", "permanent": true },
    { "source": "/work/claude-design-consistency-first-design-second", "destination": "/work/brand-systems-claude-design", "permanent": true }
  ],
  "headers": [
    { "source": "/work/ohio-golf-club", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/project-ogc-before-(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/project-ohio-golf-club-indoor-thumbnail.webp", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/embeds/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
